---
/**
 * The Log activity sheet on /health: a run, a swim, a gym session, put on the day next to your
 * focus sessions (src/lib/workouts.ts). Opened by [data-sheet-open="log"]; with
 * data-workout="<id>" it opens that workout to change or delete, with data-day="<YYYY-MM-DD>"
 * it starts on that day.
 */
import Sheet from './Sheet.astro';
import { WORKOUT_TYPES } from '../lib/workouts';

const PRESETS = [15, 30, 45, 60];
---

<Sheet id="log" title="Log activity">
  <form class="wl" data-wl novalidate>
    <fieldset class="wl__group">
      <legend class="wl__legend">Type</legend>
      <div class="wl__types">
        {WORKOUT_TYPES.map((t) => (
          <label class="wl__chip" style={`--tint: ${t.color}`}>
            <input type="radio" name="type" value={t.id} />
            <i aria-hidden="true"></i>
            {t.label}
          </label>
        ))}
      </div>
    </fieldset>

    <div class="wl__pair">
      <label class="wl__field">
        Day
        <input type="date" name="day" required />
      </label>
      <label class="wl__field">
        Start
        <input type="time" name="time" required />
      </label>
    </div>

    <fieldset class="wl__group">
      <legend class="wl__legend">Duration</legend>
      <div class="wl__presets">
        {PRESETS.map((m) => (
          <button type="button" class="wl__preset" data-wl-preset={m} aria-pressed="false">{m} min</button>
        ))}
      </div>
      <label class="wl__field wl__field--inline">
        Minutes
        <input type="number" name="minutes" min="1" max="600" inputmode="numeric" required />
      </label>
    </fieldset>

    <label class="wl__field" data-wl-distance>
      <span>Distance (<span data-wl-unit>km</span>)</span>
      <input type="number" name="distance" min="0" step="0.1" inputmode="decimal" placeholder="Optional" />
    </label>

    <div class="wl__swim" data-wl-swim>
      <div class="wl__pair">
        <label class="wl__field">
          Laps
          <input type="number" name="laps" min="0" inputmode="numeric" placeholder="Optional" />
        </label>
        <fieldset class="wl__group">
          <legend class="wl__legend">Pool</legend>
          <div class="wl__presets wl__presets--two">
            <label class="wl__chip wl__chip--plain"><input type="radio" name="pool" value="25" checked />25 m</label>
            <label class="wl__chip wl__chip--plain"><input type="radio" name="pool" value="50" />50 m</label>
          </div>
        </fieldset>
      </div>
      <p class="muted wl__small" data-wl-swim-total></p>
    </div>

    <label class="wl__field">
      <span class="wl__effort-label">Effort <output data-wl-effort-out></output></span>
      <input type="range" name="effort" min="1" max="10" step="1" />
    </label>

    <label class="wl__field">
      Note
      <input type="text" name="note" maxlength="120" placeholder="Optional" autocomplete="off" />
    </label>

    <p class="wl__fit" data-wl-fit aria-live="polite"></p>
    <p class="wl__error" data-wl-error role="alert" hidden></p>

    <div class="wl__actions">
      <button type="button" class="btn btn--ghost" data-wl-delete hidden>Delete</button>
      <button type="submit" class="btn wl__save" data-wl-save>Save</button>
    </div>
  </form>
</Sheet>

<script>
  import { EFFORT_WORDS, getWorkouts, isWorkoutType, lastWorkoutType, overlappingSession, removeWorkout, saveWorkout, workoutType, type Workout, type WorkoutType } from '../lib/workouts';
  import { getSessions } from '../lib/storage';
  import { dayKey, fromDayKey, isDayKey } from '../lib/dates';
  import { cleanups, listen, onPage } from '../lib/page';

  const MILES = /^en-(US|LR)|^my/i.test(navigator.language);
  const M_PER_UNIT = MILES ? 1609.344 : 1000;
  const timeFmt = new Intl.DateTimeFormat(undefined, { hour: '2-digit', minute: '2-digit' });
  const pad = (n: number) => String(n).padStart(2, '0');
  const hhmm = (d: Date) => `${pad(d.getHours())}:${pad(d.getMinutes())}`;

  onPage('workout-log', () => {
    const found = document.querySelector<HTMLFormElement>('[data-wl]');
    const dialog = found?.closest<HTMLDialogElement>('dialog');
    if (!found || !dialog) return;
    const form = found;
    const c = cleanups();
    const $ = <E extends Element>(s: string) => form.querySelector<E>(s)!;
    const field = <E extends HTMLInputElement>(name: string) => form.elements.namedItem(name) as E;
    const error = $<HTMLElement>('[data-wl-error]');
    $('[data-wl-unit]').textContent = MILES ? 'mi' : 'km';

    /** The workout being changed; null for a new one. */
    let editing: Workout | null = null;
    let dirty = false;

    const type = (): WorkoutType => {
      const v = (form.elements.namedItem('type') as RadioNodeList).value;
      return isWorkoutType(v) ? v : 'run';
    };
    const startMs = (): number | null => {
      const day = field('day').value;
      const [h, m] = field('time').value.split(':').map(Number);
      if (!isDayKey(day) || !Number.isFinite(h) || !Number.isFinite(m)) return null;
      const d = fromDayKey(day);
      d.setHours(h!, m!, 0, 0);
      return d.getTime();
    };
    const minutes = () => Math.round(Number(field('minutes').value));

    function sync(): void {
      const t = workoutType(type());
      const min = minutes();
      $<HTMLElement>('[data-wl-distance]').hidden = !t.distance;
      $<HTMLElement>('[data-wl-swim]').hidden = t.id !== 'swim';
      form.querySelectorAll<HTMLElement>('[data-wl-preset]').forEach((b) => b.setAttribute('aria-pressed', String(Number(b.dataset.wlPreset) === min)));
      const laps = Number(field('laps').value);
      const pool = Number((form.elements.namedItem('pool') as RadioNodeList).value);
      $('[data-wl-swim-total]').textContent = laps > 0 ? `${(laps * pool).toLocaleString()} m in all` : '';
      const effort = Number(field('effort').value);
      $('[data-wl-effort-out]').textContent = `${effort} · ${EFFORT_WORDS[effort]}`;
      $('[data-wl-save]').textContent = `Save ${t.label.toLowerCase()}${min > 0 ? ` · ${min} min` : ''}`;

      // Where it lands in your day: against the focus sessions already there.
      const fit = $<HTMLElement>('[data-wl-fit]');
      const start = startMs();
      if (start === null || !(min > 0)) {
        fit.textContent = '';
        return;
      }
      const end = new Date(start + min * 60_000);
      const clash = overlappingSession(start, min, getSessions());
      fit.dataset.clash = String(!!clash);
      fit.textContent = clash
        ? `Ends ${timeFmt.format(end)}. That overlaps your focus session at ${timeFmt.format(clash.start)}${clash.label ? ` (${clash.label})` : ''}.`
        : `Ends ${timeFmt.format(end)}. No focus session at that time.`;
    }

    function fill(detail: Record<string, string | undefined>): void {
      editing = (detail.workout && getWorkouts().find((w) => w.id === detail.workout)) || null;
      error.hidden = true;
      $<HTMLElement>('[data-wl-delete]').hidden = !editing;
      dialog!.querySelector('.sheet__title')!.textContent = editing ? `Edit ${workoutType(editing.type).label.toLowerCase()}` : 'Log activity';
      const today = dayKey(new Date());
      field('day').max = today;
      if (editing) {
        const s = new Date(editing.start);
        (form.elements.namedItem('type') as RadioNodeList).value = editing.type;
        field('day').value = dayKey(s);
        field('time').value = hhmm(s);
        field('minutes').value = String(editing.minutes);
        field('distance').value = editing.distanceM ? String(Math.round((editing.distanceM / M_PER_UNIT) * 10) / 10) : '';
        field('laps').value = editing.laps ? String(editing.laps) : '';
        (form.elements.namedItem('pool') as RadioNodeList).value = String(editing.poolM ?? 25);
        field('effort').value = String(editing.effort);
        field('note').value = editing.note ?? '';
      } else {
        // Most people log after the workout: it ended just now, or in the evening of an earlier day.
        const day = detail.day && isDayKey(detail.day) && detail.day <= today ? detail.day : today;
        const start = new Date(Date.now() - 30 * 60_000);
        start.setMinutes(start.getMinutes() - (start.getMinutes() % 5));
        form.reset();
        (form.elements.namedItem('type') as RadioNodeList).value = lastWorkoutType();
        field('day').value = day;
        field('time').value = day === today ? hhmm(start) : '18:00';
        field('minutes').value = '30';
        field('effort').value = '5';
      }
      dirty = false;
      sync();
    }

    c.add(listen(dialog, 'sheet:open', (e) => fill((e as CustomEvent<Record<string, string>>).detail ?? {})));
    c.add(
      listen(dialog, 'sheet:dismiss', (e) => {
        if (dirty && !window.confirm(editing ? 'Leave without saving your changes?' : 'Discard this workout?')) e.preventDefault();
      }),
    );
    c.add(
      listen(form, 'input', () => {
        dirty = true;
        sync();
      }),
    );
    c.add(
      listen(form, 'click', (e) => {
        const preset = (e.target as HTMLElement).closest<HTMLElement>('[data-wl-preset]');
        if (!preset) return;
        field('minutes').value = preset.dataset.wlPreset!;
        dirty = true;
        sync();
      }),
    );
    c.add(
      listen($('[data-wl-delete]'), 'click', () => {
        if (!editing || !window.confirm('Delete this workout?')) return;
        removeWorkout(editing.id);
        dialog.close();
      }),
    );
    c.add(
      listen(form, 'submit', (e) => {
        e.preventDefault();
        const start = startMs();
        const min = minutes();
        const say = (text: string) => {
          error.textContent = text;
          error.hidden = false;
        };
        if (start === null) return say('Pick a day and a start time.');
        if (start > Date.now()) return say('That start is still to come. Log a workout once it has happened.');
        if (!(min > 0 && min <= 600)) return say('Duration should be between 1 and 600 minutes.');
        const t = type();
        const distance = Number(field('distance').value);
        const laps = Math.round(Number(field('laps').value));
        const note = field('note').value.trim();
        saveWorkout({
          id: editing?.id ?? `w${Date.now().toString(36)}${Math.random().toString(36).slice(2, 6)}`,
          type: t,
          start,
          minutes: min,
          effort: Number(field('effort').value),
          ...(workoutType(t).distance && distance > 0 ? { distanceM: Math.round(distance * M_PER_UNIT) } : {}),
          ...(t === 'swim' && laps > 0 ? { laps, poolM: Number((form.elements.namedItem('pool') as RadioNodeList).value) } : {}),
          ...(note ? { note } : {}),
        });
        dirty = false;
        dialog.close();
      }),
    );
    return c.run;
  });
</script>

<style>
  .wl {
    display: grid;
    gap: var(--space-4);
  }

  .wl [hidden] {
    display: none;
  }

  .wl__group {
    min-inline-size: 0;
    margin: 0;
    padding: 0;
    border: 0;
    display: grid;
    gap: var(--space-2);
  }

  .wl__legend {
    padding: 0;
    margin-bottom: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .wl__types {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-2);
  }

  .wl__chip,
  .wl__preset {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-block-size: 44px;
    padding: 0 var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-btn);
    background: var(--color-surface-2);
    color: var(--color-text);
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
  }

  .wl__chip input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .wl__chip i {
    inline-size: 10px;
    block-size: 10px;
    border-radius: 50%;
    background: var(--tint);
  }

  .wl__chip:has(input:checked),
  .wl__preset[aria-pressed='true'] {
    border-color: var(--color-accent);
    background: var(--color-accent-soft);
    box-shadow: inset 0 0 0 1px var(--color-accent);
  }

  .wl__chip:has(input:focus-visible),
  .wl__preset:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }

  .wl__presets {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-2);
  }

  .wl__presets--two {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .wl__pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    align-items: end;
  }

  .wl__field {
    display: grid;
    gap: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .wl__field--inline {
    grid-template-columns: auto 1fr;
    align-items: center;
  }

  .wl__field input:not([type='range']) {
    min-block-size: 44px;
    box-sizing: border-box;
    inline-size: 100%;
    padding: 0 var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--well-bg, var(--color-bg));
    color: var(--color-text);
    font: inherit;
  }

  .wl__field input[type='range'] {
    inline-size: 100%;
    block-size: 28px;
    accent-color: var(--color-accent);
  }

  .wl__effort-label {
    display: flex;
    justify-content: space-between;
  }

  .wl__effort-label output {
    color: var(--color-text);
    font-weight: 600;
  }

  .wl__small,
  .wl__fit,
  .wl__error {
    margin: 0;
    font-size: var(--text-sm);
  }

  .wl__fit:empty {
    display: none;
  }

  .wl__fit {
    padding: var(--space-3);
    border-radius: var(--radius-md);
    background: var(--color-surface-2);
  }

  .wl__fit[data-clash='true'] {
    box-shadow: inset 0 0 0 1px var(--cat-reward);
  }

  .wl__error {
    color: var(--color-danger);
  }

  .wl__actions {
    display: flex;
    gap: var(--space-3);
  }

  .wl__actions .btn {
    min-block-size: 52px;
  }

  .wl__save {
    flex: 1;
  }
</style>
