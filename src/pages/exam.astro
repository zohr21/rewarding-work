---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExamGoal from '../components/ExamGoal.astro';
import ExamChapters from '../components/ExamChapters.astro';
import ExamBank from '../components/ExamBank.astro';
import ExamPast from '../components/ExamPast.astro';
import FocusTabs from '../components/FocusTabs.astro';
import { NATIVE_APP } from '../config/app';
import { url } from '../lib/paths';
---

<BaseLayout title="Study" titleKey="module.exam" description="Study for an exam, a course or anything you learn: set the goal, list the chapters, focus on one at a time and practise test questions.">
  <div class="container">
    <FocusTabs />
    {/* In the app the goal's own title heads the page; the word "Study" is already the tab above. */}
    <header class={NATIVE_APP ? 'visually-hidden' : 'page-header'}>
      <h1 data-t="exam.examPrep">Study</h1>
      {/* The app goes straight to the plan; the website explains the page first. */}
      {
        !NATIVE_APP && (
          <p>
            <span data-t="exam.introBefore">Set the goal, list the parts, and work through them one at a time. Focus opens the</span>{' '}
            <a data-t="exam.timer" href={url('/timer')}>timer</a>{' '}
            <span data-t="exam.introAfter">on a chapter, and the time shows up here.</span>
          </p>
        )
      }
    </header>

    <div class="exam-page">
      <ExamGoal />
      <div class="exam-page__grid">
        <ExamChapters />
        <ExamBank />
      </div>
      {/* Another plan next to the ones running (ExamGoal shows the form). */}
      <button data-t="exam.newPlan" type="button" class="btn btn--ghost btn--small exam-page__new" data-eg-new hidden>+ New plan</button>
      <ExamPast />
    </div>
  </div>
</BaseLayout>

<style>
  .exam-page,
  .exam-page__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    align-items: start;
  }

  .exam-page__new {
    justify-self: start;
    min-height: 44px;
  }

  .exam-page__new[hidden] {
    display: none;
  }

  @media (min-width: 56rem) {
    .exam-page__grid {
      grid-template-columns: minmax(0, 1fr) 20rem;
    }
  }
</style>
