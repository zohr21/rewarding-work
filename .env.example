# Optional: Firebase project for accounts and sync. Copy to .env and fill in.
# Firebase console → Project settings → General → Your apps → Web app → SDK setup and configuration.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=your-project
PUBLIC_FIREBASE_APP_ID=
# Local testing against `npx firebase-tools emulators:start --only auth,firestore`:
# PUBLIC_FIREBASE_EMULATOR=true
