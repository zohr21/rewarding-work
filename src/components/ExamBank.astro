---
/**
 * The exam's question bank: import multiple-choice questions from a .csv or .json file
 * (matching the file's chapters to yours, and showing which rows can't be used before
 * anything is added), then practise them a round at a time. The answer and its
 * explanation show after each question; questions you flag or miss come back first.
 */
import { NATIVE_APP } from '../config/app';
import Sheet from './Sheet.astro';
---

{/* Practice starts from the goal card's chips and a chapter's sheet (event exam:practise); this card keeps the bank itself. */}
<section class="card bank" data-exam-bank hidden aria-labelledby="bank-heading">
  <div class="bank__head">
    <h2 data-t="exam.questionBank" id="bank-heading" class="panel-title">Question bank</h2>
    <p class="muted bank__count" data-eb-count></p>
  </div>
  <div class="bank__tools">
    <button data-t="exam.addAQuestion" type="button" class="btn btn--ghost btn--small" data-sheet-open="exam-question" data-chapter="" data-eb-add>+ Add a question</button>
    <button data-t="exam.importAFile" type="button" class="btn btn--ghost btn--small" data-eb-import-open>Import a file</button>
  </div>
  <p data-t="exam.fromACsvOrJson" class="muted bank__note" data-eb-note>From a .csv or .json file of multiple-choice questions.</p>
  <button data-t="exam.removeAllQuestions" type="button" class="bank__clear" data-eb-clear hidden>Remove all questions</button>
  <p class="visually-hidden" aria-live="polite" data-eb-live></p>
</section>

<Sheet id="exam-question" title="Add a question" titleKey="exam.addAQuestionTitle">
  <form class="ask" data-eq-form novalidate>
    <label class="ask__field">
      <span data-t="exam.chapter">Chapter</span>
      <select class="input" data-eq-chapter></select>
    </label>
    <label class="ask__field">
      <span data-t="exam.question">Question</span>
      <textarea class="input" rows="3" maxlength="1000" required data-eq-text></textarea>
    </label>
    <fieldset class="ask__options">
      <legend><span data-t="exam.options">Options</span> <span data-t="exam.tickTheRightOne" class="muted">(tick the right one, or several)</span></legend>
      <div class="ask__list" data-eq-options></div>
      <button data-t="exam.anotherOption" type="button" class="btn btn--ghost btn--small" data-eq-more>+ Another option</button>
    </fieldset>
    <label class="ask__field">
      <span><span data-t="exam.explanation">Why it's right</span> <span data-t="exam.optional" class="muted">(optional)</span></span>
      <textarea class="input" rows="2" maxlength="1000" data-eq-why></textarea>
    </label>
    <p class="ask__error" role="alert" data-eq-error hidden></p>
    <div class="ask__foot">
      <p class="muted ask__added" aria-live="polite" data-eq-added></p>
      <button data-t="exam.addQuestion" type="submit" class="btn">Add question</button>
    </div>
  </form>
</Sheet>

<dialog class="exam-dialog popover" data-eb-import aria-labelledby="eb-import-title">
  <div class="exam-dialog__head">
    <div>
      <h2 data-t="exam.importTestQuestions" id="eb-import-title" class="exam-dialog__title">Import test questions</h2>
      <p data-t="exam.chooseAFileMatchIts" class="muted exam-dialog__sub">Choose a file, match its chapters to yours, then import.</p>
    </div>
    <button data-t-aria-label="exam.close" type="button" class="icon-btn" aria-label="Close" data-ei-close>
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
    </button>
  </div>

  <div class="exam-dialog__body import">
    <div class="import__file">
      <label class="btn btn--ghost import__pick">
        <input type="file" class="visually-hidden" accept=".csv,.json,.txt,text/csv,application/json" data-ei-file />
        <span data-t="exam.chooseAFile">Choose a file</span>
      </label>
      <span data-t="exam.noFileChosen" class="muted" data-ei-filename>No file chosen</span>
    </div>
    <p class="import__error" role="alert" data-ei-error hidden></p>

    <section class="import__result" data-ei-result hidden>
      <p class="import__counts" data-ei-counts></p>
      <div data-ei-map-wrap>
        <h3 data-t="exam.matchChapters" class="import__heading">Match chapters</h3>
        <p data-t="exam.whereTheQuestionsForEach" class="muted import__hint">Where the questions for each chapter named in the file should go.</p>
        <div class="import__map" data-ei-map></div>
      </div>
      <details class="disclosure" data-ei-problems-wrap>
        <summary data-ei-problems-summary></summary>
        <div class="import__table-wrap">
          <table class="import__table">
            <thead>
              <tr><th data-t="exam.row" scope="col">Row</th><th data-t="exam.question" scope="col">Question</th><th data-t="exam.whyItSSkipped" scope="col">Why it's skipped</th></tr>
            </thead>
            <tbody data-ei-problems></tbody>
          </table>
        </div>
      </details>
    </section>

    <details class="disclosure import__format" open data-ei-format>
      <summary data-t="exam.fileFormat">File format</summary>
      <p data-t="exam.oneQuestionPerRowThe">One question per row. The first row names the columns:</p>
      <dl class="import__cols">
        <div><dt><code>chapter</code></dt><dd data-t="exam.optionalMatchedToYourChapters">Optional. Matched to your chapters.</dd></div>
        <div><dt><code>question</code></dt><dd data-t="exam.required">Required.</dd></div>
        <div><dt><code>option_a … option_h</code></dt><dd data-t="exam.twoToEightOptions">Two to eight options.</dd></div>
        <div><dt><code>answer</code></dt><dd data-t="exam.theLetterOfTheRight">The letter of the right option, or several: A,C</dd></div>
        <div><dt><code>explanation</code></dt><dd data-t="exam.optionalShownAfterYouAnswer">Optional. Shown after you answer.</dd></div>
      </dl>
      <button data-t="exam.downloadCsvTemplate" type="button" class="btn btn--ghost btn--small" data-ei-template>Download CSV template</button>
      <p class="muted import__hint"><span data-t="exam.jsonBefore">JSON works too: a list of objects with the same names, where</span> <code>options</code> <span data-t="exam.jsonAfter">is a list.</span></p>
    </details>
  </div>

  <div class="exam-dialog__foot">
    <p class="muted exam-dialog__trust" data-t={NATIVE_APP ? 'exam.trustPhone' : 'exam.trustBrowser'}>Questions stay {NATIVE_APP ? 'on this phone' : 'in this browser'}, and in your account if you're signed in. Only import material you're allowed to use.</p>
    <button data-t="exam.import" type="button" class="btn" data-ei-go disabled>Import</button>
  </div>
</dialog>

<dialog class="exam-dialog exam-dialog--practice popover" data-eb-practice aria-labelledby="eb-practice-title">
  <div class="exam-dialog__head">
    <div class="practice__top">
      <h2 data-t="exam.practice" id="eb-practice-title" class="exam-dialog__title" data-ep-title>Practice</h2>
      <div class="practice__dots" data-ep-dots aria-hidden="true"></div>
    </div>
    <button data-t-aria-label="exam.endPractice" type="button" class="icon-btn" aria-label="End practice" data-ep-close>
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
    </button>
  </div>

  <div class="exam-dialog__body practice">
    <div class="practice__view" data-ep-question>
      <p class="badge practice__chapter" data-ep-chapter hidden></p>
      <p class="practice__text" data-ep-text></p>
      <p data-t="exam.chooseEveryAnswerThatApplies" class="muted practice__hint" data-ep-hint hidden>Choose every answer that applies, then press Check answer.</p>
      <div data-t-aria-label="exam.answerOptions" class="practice__options" role="group" aria-label="Answer options" data-ep-options></div>
      <div class="practice__why well" data-ep-why hidden>
        <p class="practice__verdict" data-ep-verdict></p>
        <p data-ep-explanation></p>
      </div>
    </div>
    <div class="practice__view" data-ep-summary hidden>
      <p class="practice__score" data-ep-score></p>
      <p data-ep-summary-text></p>
    </div>
  </div>

  <div class="exam-dialog__foot">
    <button data-t="exam.askMeThisAgain" type="button" class="btn btn--ghost" aria-pressed="false" data-ep-again hidden>Ask me this again</button>
    <button data-t="exam.anotherRound" type="button" class="btn btn--ghost" data-ep-more hidden>Another round</button>
    <span class="practice__spacer"></span>
    <button data-t="exam.checkAnswer" type="button" class="btn" data-ep-check hidden>Check answer</button>
    <button data-t="exam.nextQuestion" type="button" class="btn" data-ep-next hidden>Next question</button>
    <button data-t="exam.done" type="button" class="btn" data-ep-done hidden>Done</button>
  </div>
  <p class="visually-hidden" aria-live="polite" data-ep-live></p>
</dialog>

<script>
  import { getExam, subscribe, type ExamQuestion } from '../lib/storage';
  import {
    addQuestion,
    CHOICE_NEW,
    CHOICE_NONE,
    clearQuestions,
    guessChapter,
    importQuestions,
    isRight,
    OPTIONS_MAX,
    parseQuestionFile,
    pickRound,
    recordAnswer,
    recordRound,
    setAgain,
    TEMPLATE_CSV,
    type ChapterChoice,
    type ParsedFile,
  } from '../lib/exam';
  import { celebrate } from '../lib/appearance';
  import { el } from '../lib/dom';
  import { cleanups, listen, onPage } from '../lib/page';
  import { t, tn } from '../lib/i18n';

  const letter = (i: number) => String.fromCharCode(65 + i);
  const CHECK_SVG =
    '<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>';
  const X_SVG =
    '<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg>';

  onPage('exam-bank', () => {
    const root = document.querySelector<HTMLElement>('[data-exam-bank]');
    const importDialog = document.querySelector<HTMLDialogElement>('[data-eb-import]');
    const practiceDialog = document.querySelector<HTMLDialogElement>('[data-eb-practice]');
    if (!root || !importDialog || !practiceDialog) return;
    const c = cleanups();
    const $ = <E extends Element>(s: string) => document.querySelector<E>(s)!;

    // ---------- The card ----------

    const count = $<HTMLElement>('[data-eb-count]');
    const clear = $<HTMLButtonElement>('[data-eb-clear]');
    const live = $<HTMLElement>('[data-eb-live]');
    let clearArmed = false;

    const announce = (node: HTMLElement, text: string) => {
      node.textContent = '';
      window.setTimeout(() => (node.textContent = text), 50);
    };

    function render(): void {
      const exam = getExam();
      root!.hidden = !exam;
      if (!exam) return;
      const n = exam.questions.length;
      const withQuestions = exam.chapters.filter((ch) => exam.questions.some((q) => q.chapterId === ch.id));
      count.textContent = n
        ? withQuestions.length
          ? `${tn('exam.questionsN', n)} · ${tn('exam.chaptersN', withQuestions.length)}`
          : tn('exam.questionsN', n)
        : t('exam.noQuestionsYetDot');
      clear.hidden = n === 0;
      // What a file should hold, only until there are questions.
      $<HTMLElement>('[data-eb-note]').hidden = n > 0;
      renderAsk();
    }

    // ---------- One question by hand ----------

    const askSheet = $<HTMLDialogElement>('[data-sheet="exam-question"]');
    const askForm = $<HTMLFormElement>('[data-eq-form]');
    const askChapter = $<HTMLSelectElement>('[data-eq-chapter]');
    const askText = $<HTMLTextAreaElement>('[data-eq-text]');
    const askOptions = $<HTMLElement>('[data-eq-options]');
    const askMore = $<HTMLButtonElement>('[data-eq-more]');
    const askWhy = $<HTMLTextAreaElement>('[data-eq-why]');
    const askError = $<HTMLElement>('[data-eq-error]');
    const askAdded = $<HTMLElement>('[data-eq-added]');

    function optionRow(i: number): HTMLElement {
      const row = el('div', 'ask__option');
      const right = el('input');
      right.type = 'checkbox';
      right.setAttribute('aria-label', t('exam.optionIsRight', { letter: letter(i) }));
      const box = el('input', 'input');
      box.type = 'text';
      box.maxLength = 300;
      box.setAttribute('aria-label', t('exam.optionN', { letter: letter(i) }));
      row.append(el('span', 'ask__letter', letter(i)), box, right);
      return row;
    }

    function resetAsk(chapterId: string): void {
      askText.value = askWhy.value = '';
      askOptions.replaceChildren(...[0, 1, 2, 3].map(optionRow));
      askMore.hidden = false;
      askError.hidden = true;
      renderAsk();
      askChapter.value = [...askChapter.options].some((o) => o.value === chapterId) ? chapterId : '';
    }

    /** The chapter list, kept in step with the exam. */
    function renderAsk(): void {
      const exam = getExam();
      const before = askChapter.value;
      const option = (value: string, text: string) => Object.assign(document.createElement('option'), { value, textContent: text });
      askChapter.replaceChildren(...(exam?.chapters ?? []).map((ch) => option(ch.id, ch.name)), option('', t('exam.noChapter')));
      askChapter.value = [...askChapter.options].some((o) => o.value === before) ? before : askChapter.options[0]?.value ?? '';
    }

    askSheet.addEventListener('sheet:open', (e) => {
      askAdded.textContent = '';
      resetAsk((e as CustomEvent<Record<string, string>>).detail.chapter ?? '');
    });

    askMore.addEventListener('click', () => {
      const n = askOptions.children.length;
      if (n >= OPTIONS_MAX) return;
      const row = optionRow(n);
      askOptions.append(row);
      askMore.hidden = n + 1 >= OPTIONS_MAX;
      row.querySelector<HTMLInputElement>('.input')!.focus();
    });

    askForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const rows = [...askOptions.children];
      const why = addQuestion({
        chapterId: askChapter.value || undefined,
        text: askText.value,
        options: rows.map((r) => r.querySelector<HTMLInputElement>('.input')!.value),
        answer: rows.flatMap((r, i) => (r.querySelector<HTMLInputElement>('[type="checkbox"]')!.checked ? [i] : [])),
        explanation: askWhy.value,
      });
      if (why) {
        askError.textContent = t(`exam.ask.${why}`);
        askError.hidden = false;
        (why === 'text' ? askText : why === 'options' ? rows[0]?.querySelector<HTMLInputElement>('.input') : rows[0]?.querySelector<HTMLInputElement>('[type="checkbox"]'))?.focus();
        return;
      }
      // Ready for the next one, in the same chapter.
      const chapterId = askChapter.value;
      resetAsk(chapterId);
      askAdded.textContent = t('exam.questionAdded');
      askText.focus();
    });

    // A half-written question asks before it is put away.
    askSheet.addEventListener('sheet:dismiss', (e) => {
      if (askText.value.trim() && !window.confirm(t('exam.discardQuestion'))) e.preventDefault();
    });

    // Press twice to remove: the first press says what will happen.
    function disarmClear(): void {
      clearArmed = false;
      clear.textContent = t('exam.removeAllQuestions');
    }
    clear.addEventListener('click', () => {
      if (!clearArmed) {
        clearArmed = true;
        clear.textContent = t('exam.pressAgainToRemove');
        announce(live, t('exam.pressAgainToRemoveSaid'));
        window.setTimeout(disarmClear, 6000);
        return;
      }
      disarmClear();
      clearQuestions();
      announce(live, t('exam.allRemoved'));
    });

    // ---------- Import ----------

    const file = $<HTMLInputElement>('[data-ei-file]');
    const fileName = $<HTMLElement>('[data-ei-filename]');
    const error = $<HTMLElement>('[data-ei-error]');
    const result = $<HTMLElement>('[data-ei-result]');
    const counts = $<HTMLElement>('[data-ei-counts]');
    const mapWrap = $<HTMLElement>('[data-ei-map-wrap]');
    const map = $<HTMLElement>('[data-ei-map]');
    const problemsWrap = $<HTMLDetailsElement>('[data-ei-problems-wrap]');
    const problemsSummary = $<HTMLElement>('[data-ei-problems-summary]');
    const problems = $<HTMLElement>('[data-ei-problems]');
    const format = $<HTMLDetailsElement>('[data-ei-format]');
    const go = $<HTMLButtonElement>('[data-ei-go]');
    let parsed: Extract<ParsedFile, { ok: true }> | null = null;
    const choices = new Map<string, ChapterChoice>();

    function resetImport(): void {
      parsed = null;
      choices.clear();
      file.value = '';
      fileName.textContent = t('exam.noFileChosen');
      error.hidden = result.hidden = true;
      format.open = true;
      go.disabled = true;
      go.textContent = t('exam.import');
    }

    function renderImport(): void {
      const exam = getExam();
      if (!parsed || !exam) return;
      const ready = parsed.questions.length;
      result.hidden = false;
      format.open = false;
      counts.replaceChildren(el('span', 'badge import__ready', t('exam.nReady', { n: ready })));
      if (parsed.problems.length) counts.append(' ', el('span', 'badge import__skipped', t('exam.nSkipped', { n: parsed.problems.length })));

      mapWrap.hidden = parsed.chapters.length === 0;
      map.replaceChildren(
        ...parsed.chapters.map((label) => {
          const n = parsed!.questions.filter((q) => q.chapter === label).length;
          const row = el('div', 'import__row');
          const from = el('p', 'import__from');
          from.append(el('strong', '', label), el('span', 'muted', ` · ${tn('exam.questionsN', n)}`));
          const select = el('select', 'input');
          select.setAttribute('aria-label', t('exam.yourChapterFor', { label }));
          const option = (value: string, text: string) => Object.assign(document.createElement('option'), { value, textContent: text });
          select.append(
            ...exam.chapters.map((ch) => option(ch.id, ch.name)),
            option(CHOICE_NEW, t('exam.addAsNew', { label })),
            option(CHOICE_NONE, t('exam.noChapter')),
          );
          select.value = choices.get(label)!;
          select.addEventListener('change', () => choices.set(label, select.value));
          row.append(from, select);
          return row;
        }),
      );

      problemsWrap.hidden = parsed.problems.length === 0;
      problemsSummary.textContent = tn('exam.rowsUnusable', parsed.problems.length);
      problems.replaceChildren(
        ...parsed.problems.slice(0, 200).map((p) => {
          const tr = el('tr');
          tr.append(el('td', 'muted', String(p.row)), el('td', '', p.text || t('exam.empty')), el('td', 'import__reason', p.reason));
          return tr;
        }),
      );

      go.disabled = ready === 0;
      go.textContent = ready ? tn('exam.importN', ready) : t('exam.nothingToImport');
    }

    file.addEventListener('change', async () => {
      const picked = file.files?.[0];
      if (!picked) return;
      const exam = getExam();
      parsed = null;
      choices.clear();
      result.hidden = error.hidden = true;
      go.disabled = true;
      fileName.textContent = picked.name;
      let text: string;
      try {
        if (picked.size > 5_000_000) throw new Error('too big');
        text = await picked.text();
      } catch {
        error.textContent = t('exam.couldNotRead');
        error.hidden = false;
        return;
      }
      const outcome = parseQuestionFile(text, exam?.questions ?? []);
      if (!outcome.ok) {
        error.textContent = outcome.error;
        error.hidden = false;
        return;
      }
      parsed = outcome;
      outcome.chapters.forEach((label) => choices.set(label, guessChapter(label, exam?.chapters ?? [])));
      renderImport();
    });

    $<HTMLButtonElement>('[data-ei-template]').addEventListener('click', () => {
      const a = document.createElement('a');
      a.href = URL.createObjectURL(new Blob([TEMPLATE_CSV], { type: 'text/csv' }));
      a.download = 'exam-questions-template.csv';
      document.body.append(a);
      a.click();
      a.remove();
      window.setTimeout(() => URL.revokeObjectURL(a.href), 1000);
    });

    go.addEventListener('click', () => {
      if (!parsed) return;
      const added = importQuestions(parsed.questions, choices);
      importDialog.close();
      announce(live, tn('exam.importedN', added));
    });

    $<HTMLButtonElement>('[data-eb-import-open]').addEventListener('click', () => {
      resetImport();
      importDialog.showModal();
    });

    // ---------- Practice ----------

    const title = $<HTMLElement>('[data-ep-title]');
    const dots = $<HTMLElement>('[data-ep-dots]');
    const questionView = $<HTMLElement>('[data-ep-question]');
    const summaryView = $<HTMLElement>('[data-ep-summary]');
    const chapter = $<HTMLElement>('[data-ep-chapter]');
    const text = $<HTMLElement>('[data-ep-text]');
    const hint = $<HTMLElement>('[data-ep-hint]');
    const options = $<HTMLElement>('[data-ep-options]');
    const why = $<HTMLElement>('[data-ep-why]');
    const verdict = $<HTMLElement>('[data-ep-verdict]');
    const explanation = $<HTMLElement>('[data-ep-explanation]');
    const score = $<HTMLElement>('[data-ep-score]');
    const summaryText = $<HTMLElement>('[data-ep-summary-text]');
    const again = $<HTMLButtonElement>('[data-ep-again]');
    const more = $<HTMLButtonElement>('[data-ep-more]');
    const check = $<HTMLButtonElement>('[data-ep-check]');
    const next = $<HTMLButtonElement>('[data-ep-next]');
    const done = $<HTMLButtonElement>('[data-ep-done]');
    const practiceLive = $<HTMLElement>('[data-ep-live]');

    let round: ExamQuestion[] = [];
    let index = 0;
    let picked = new Set<number>();
    let answered = false;
    /** Right or wrong for each question answered so far. */
    let results: boolean[] = [];
    /** The round has been added to the exam's practice rounds. */
    let saved = false;

    function saveRound(): void {
      if (saved || !results.length) return;
      saved = true;
      recordRound(results.length, results.filter(Boolean).length);
    }

    function renderDots(): void {
      dots.replaceChildren(
        ...round.map((_, i) => el('span', i < results.length ? (results[i] ? 'is-right' : 'is-miss') : i === index ? 'is-now' : '')),
      );
    }

    function renderQuestion(): void {
      const q = round[index]!;
      const multi = q.answer.length > 1;
      const exam = getExam();
      questionView.hidden = false;
      summaryView.hidden = true;
      title.textContent = t('exam.questionOf', { i: index + 1, n: round.length });
      renderDots();
      const name = exam?.chapters.find((ch) => ch.id === q.chapterId)?.name;
      chapter.hidden = !name;
      chapter.textContent = name ?? '';
      text.textContent = q.text;
      hint.hidden = !multi || answered;

      options.replaceChildren(
        ...q.options.map((label, i) => {
          const isAnswer = q.answer.includes(i);
          const isPicked = picked.has(i);
          const b = el('button', 'practice__option');
          b.type = 'button';
          b.append(el('span', 'practice__letter', letter(i)), el('span', 'practice__label', label));
          if (answered) {
            b.disabled = true;
            if (isAnswer) b.classList.add('is-answer');
            else if (isPicked) b.classList.add('is-miss');
            if (isAnswer || isPicked) {
              const mark = el('span', 'practice__mark');
              mark.innerHTML = isAnswer ? CHECK_SVG : X_SVG;
              mark.append(isAnswer ? (isPicked ? t('exam.yourAnswerCorrect') : t('exam.correctAnswer')) : t('exam.yourAnswer'));
              b.append(mark);
            }
          } else {
            b.setAttribute('aria-pressed', String(isPicked));
            b.addEventListener('click', () => {
              if (multi) {
                if (picked.has(i)) picked.delete(i);
                else picked.add(i);
                renderQuestion();
                (options.children[i] as HTMLElement).focus();
              } else {
                picked = new Set([i]);
                answer();
              }
            });
          }
          return b;
        }),
      );

      why.hidden = !answered;
      if (answered) {
        const right = results[index]!;
        verdict.textContent = right ? t('exam.correct') : t('exam.notQuite');
        verdict.classList.toggle('is-right', right);
        explanation.textContent = q.explanation ?? '';
        explanation.hidden = !q.explanation;
      }
      again.hidden = next.hidden = !answered;
      again.setAttribute('aria-pressed', 'false');
      check.hidden = answered || !multi;
      check.disabled = picked.size === 0;
      more.hidden = done.hidden = true;
      next.textContent = index === round.length - 1 ? t('exam.seeResults') : t('exam.nextQuestion');
    }

    function answer(): void {
      const q = round[index]!;
      const right = isRight(q, [...picked]);
      answered = true;
      results.push(right);
      recordAnswer(q.id, right);
      renderQuestion();
      next.focus();
      announce(
        practiceLive,
        `${right ? t('exam.correct') : t('exam.notQuiteAnswer', { answer: q.answer.map(letter).join(', ') })} ${q.explanation ?? ''}`,
      );
    }

    function renderSummary(): void {
      saveRound();
      const correct = results.filter(Boolean).length;
      questionView.hidden = true;
      summaryView.hidden = false;
      title.textContent = t('exam.roundFinished');
      index = round.length;
      renderDots();
      score.textContent = t('exam.score', { correct, n: round.length });
      const exam = getExam();
      const misses = new Map<string, number>();
      round.forEach((q, i) => {
        const name = exam?.chapters.find((ch) => ch.id === q.chapterId)?.name;
        if (!results[i] && name) misses.set(name, (misses.get(name) ?? 0) + 1);
      });
      const top = [...misses.entries()].sort((a, b) => b[1] - a[1])[0];
      summaryText.textContent =
        correct === round.length
          ? t('exam.everyOneRight')
          : top
            ? t('exam.mostMisses', { name: top[0], n: top[1] })
            : t('exam.missedComeBack');
      again.hidden = check.hidden = next.hidden = true;
      more.hidden = done.hidden = false;
      done.focus();
      if (correct === round.length) celebrate();
    }

    /** What the round is drawn from: 'all', a chapter id or MISTAKES. "Another round" keeps it. */
    let scope = 'all';

    function startRound(): void {
      const exam = getExam();
      if (!exam) return;
      round = pickRound(exam, scope);
      // The mistakes may all be put right; the next round is then the whole bank.
      if (!round.length && scope !== 'all') round = pickRound(exam, (scope = 'all'));
      if (!round.length) return;
      index = 0;
      picked = new Set();
      answered = false;
      results = [];
      saved = false;
      renderQuestion();
      if (!practiceDialog!.open) practiceDialog!.showModal();
    }

    // Asked for by the goal card's chips and a chapter's sheet.
    c.add(
      listen(document, 'exam:practise', (e) => {
        scope = String((e as CustomEvent<string>).detail || 'all');
        startRound();
      }),
    );
    more.addEventListener('click', startRound);
    check.addEventListener('click', answer);
    done.addEventListener('click', () => practiceDialog.close());
    next.addEventListener('click', () => {
      if (index >= round.length - 1) return renderSummary();
      index++;
      picked = new Set();
      answered = false;
      renderQuestion();
      (options.firstElementChild as HTMLElement | null)?.focus();
    });
    again.addEventListener('click', () => {
      const on = again.getAttribute('aria-pressed') !== 'true';
      again.setAttribute('aria-pressed', String(on));
      setAgain(round[index]!.id, on);
    });
    // Ending part-way still counts the questions answered.
    practiceDialog.addEventListener('close', saveRound);

    for (const [dialog, close] of [
      [importDialog, '[data-ei-close]'],
      [practiceDialog, '[data-ep-close]'],
    ] as const) {
      $<HTMLButtonElement>(close).addEventListener('click', () => dialog.close());
      // A click on the backdrop (the dialog element itself, outside its content) closes it.
      dialog.addEventListener('click', (e) => {
        if (e.target === dialog) dialog.close();
      });
      c.add(() => dialog.close());
    }

    render();
    c.add(subscribe('exam', render));
    return c.run;
  });
</script>

