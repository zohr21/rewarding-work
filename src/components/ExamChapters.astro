---
/**
 * The chapters (or parts) of the exam, one slim row each: a box to tick it off, the name
 * with the focus time against the time planned, how often its questions are answered
 * right, and a play button that starts a timer session on it. Finished ones fold into one
 * row. A tap on the name opens the chapter's sheet: practice, adding a question, its
 * name, planned hours and notes, order, and removal.
 *
 * With several study plans, each plan is a group of its own (nearest exam first, open), with
 * a pencil to edit the plan, "+ Add chapter" and a practice round on its questions.
 */
import { url } from '../lib/paths';
import Sheet from './Sheet.astro';

const timerUrl = url('/timer');
---

<section class="card chapters" data-exam-chapters data-timer-url={timerUrl} hidden aria-labelledby="chapters-heading">
  <div class="chapters__head">
    <h2 data-t="exam.chapters" id="chapters-heading" class="panel-title">Chapters</h2>
    <p class="muted chapters__count" data-ec-count></p>
  </div>

  <ol class="chapters__items" data-ec-list></ol>
  <p data-t="exam.noChaptersYetAddThe" class="muted chapters__empty" data-ec-empty>No chapters yet. Add the parts you need to study below.</p>

  <details class="disclosure chapters__done" data-ec-done-box hidden>
    <summary data-ec-done-title></summary>
    <ol class="chapters__items" data-ec-done></ol>
  </details>

  <div class="chapters__groups" data-ec-groups hidden></div>

  <button data-t="exam.addChapter" type="button" class="btn btn--ghost btn--small chapters__add" data-ec-add-open>+ Add chapter</button>
  <form class="chapters__form" data-ec-form hidden>
    <label data-t="exam.newChapterName" for="ec-new" class="visually-hidden">New chapter name</label>
    <input data-t-placeholder="exam.addAChapterOrPart" id="ec-new" class="input" type="text" maxlength="120" autocomplete="off" placeholder="Add a chapter or part…" data-ec-name />
    <label data-t="exam.plannedHours" for="ec-new-hours" class="visually-hidden">Planned hours</label>
    <input data-t-placeholder="exam.hours" id="ec-new-hours" class="input chapters__hours" type="number" min="0.5" max="10000" step="0.5" inputmode="decimal" placeholder="Hours" data-ec-hours />
    <button data-t="exam.addChapter2" type="submit" class="btn btn--ghost">Add chapter</button>
  </form>
  <p class="visually-hidden" aria-live="polite" data-ec-live></p>
</section>

<Sheet id="exam-chapter" labelledby="ec-sheet-title">
  <div class="ch-sheet" data-ec-sheet>
    <h2 id="ec-sheet-title" class="ch-sheet__title" data-ecs-title></h2>
    <p class="muted ch-sheet__meta" data-ecs-meta></p>
    <div class="ch-sheet__go">
      <a class="btn" data-ecs-focus></a>
      <button type="button" class="btn btn--ghost" data-ecs-practise></button>
      <button data-t="exam.addAQuestion" type="button" class="btn btn--ghost" data-sheet-open="exam-question" data-ecs-ask>+ Add a question</button>
    </div>
    <label class="ch-sheet__field">
      <span data-t="exam.name">Name</span>
      <input class="input" type="text" maxlength="120" autocomplete="off" data-ecs-name />
    </label>
    <label class="ch-sheet__field ch-sheet__field--short">
      <span data-t="exam.plannedHours">Planned hours</span>
      <input class="input" type="number" min="0.5" max="10000" step="0.5" inputmode="decimal" data-ecs-hours />
    </label>
    <label class="ch-sheet__field">
      <span data-t="exam.notes">Notes</span>
      <textarea class="input" rows="3" data-ecs-notes></textarea>
    </label>
    <div class="ch-sheet__tools">
      <button type="button" class="btn btn--ghost btn--small" data-ecs-done></button>
      <button data-t="exam.moveUp" type="button" class="btn btn--ghost btn--small" data-ecs-up>Move up</button>
      <button data-t="exam.moveDown" type="button" class="btn btn--ghost btn--small" data-ecs-down>Move down</button>
      <button data-t="exam.remove" type="button" class="btn btn--ghost btn--small ch-sheet__remove" data-ecs-remove>Remove</button>
    </div>
  </div>
</Sheet>

<script>
  import { getExamStore, getPlans, getSessions, planOfChapter, subscribe, type Exam, type ExamChapter } from '../lib/storage';
  import { addChapter, byDate, chapterScores, EXAM_NOTES_MAX, examTime, formatHM, moveChapter, nextChapter, removeChapter, ROUND_SIZE, updateChapter } from '../lib/exam';
  import { celebrate } from '../lib/appearance';
  import { offerUndo } from '../lib/undo';
  import { el } from '../lib/dom';
  import { cleanups, onPage } from '../lib/page';
  import { t, tn } from '../lib/i18n';

  const CHECK_SVG =
    '<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>';
  const EDIT_SVG =
    '<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M4 20h4L19 9l-4-4L4 16v4zM14 6l4 4" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/></svg>';
  const PLAY_SVG = '<svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M8 5.5v13l10.5-6.5z" fill="currentColor"/></svg>';

  /** "64%", and a word for the colour band, from answers so far. */
  function scoreOf(s: { seen: number; correct: number } | undefined): { text: string; band: string } | null {
    if (!s?.seen) return null;
    const pct = Math.round((s.correct / s.seen) * 100);
    return { text: `${pct}%`, band: pct < 50 ? 'low' : pct < 75 ? 'mid' : 'high' };
  }

  onPage('exam-chapters', () => {
    const root = document.querySelector<HTMLElement>('[data-exam-chapters]');
    const sheet = document.querySelector<HTMLDialogElement>('[data-sheet="exam-chapter"]');
    if (!root || !sheet) return;
    const c = cleanups();
    const $ = <E extends Element>(s: string) => root.querySelector<E>(s)!;
    const s$ = <E extends Element>(s: string) => sheet.querySelector<E>(s)!;
    const list = $<HTMLOListElement>('[data-ec-list]');
    const doneBox = $<HTMLDetailsElement>('[data-ec-done-box]');
    const doneList = $<HTMLOListElement>('[data-ec-done]');
    const addOpen = $<HTMLButtonElement>('[data-ec-add-open]');
    const empty = $<HTMLElement>('[data-ec-empty]');
    const form = $<HTMLFormElement>('[data-ec-form]');
    const nameInput = $<HTMLInputElement>('[data-ec-name]');
    const hoursInput = $<HTMLInputElement>('[data-ec-hours]');
    const live = $<HTMLElement>('[data-ec-live]');
    const timerUrl = root.dataset.timerUrl!;
    const focusUrl = (id: string) => `${timerUrl}?chapter=${encodeURIComponent(id)}`;
    /** Removed chapters still offered for Undo (src/lib/undo.ts). */
    const removing = new Set<string>();
    /** The chapter the sheet shows. */
    let sheetId = '';
    const groupsBox = $<HTMLElement>('[data-ec-groups]');
    /** Groups opened or closed by hand, by plan id; the nearest plan starts open. */
    const openGroups = new Map<string, boolean>();
    /** The plan "+ Add chapter" adds to. */
    let addPlanId = '';

    const announce = (text: string) => {
      live.textContent = '';
      window.setTimeout(() => (live.textContent = text), 50);
    };

    function remove(chapter: ExamChapter): void {
      removing.add(chapter.id);
      render();
      offerUndo({
        message: t('exam.removedName', { name: chapter.name }),
        commit: () => {
          removeChapter(chapter.id);
          removing.delete(chapter.id);
        },
        undo: () => {
          removing.delete(chapter.id);
          render();
          announce(t('exam.restored', { name: chapter.name }));
        },
      });
      announce(t('exam.removedSaid', { name: chapter.name }));
    }

    function setDone(chapter: ExamChapter, done: boolean): void {
      updateChapter(chapter.id, { done });
      if (done) celebrate();
      announce(done ? t('exam.finishedName', { name: chapter.name }) : t('exam.reopened', { name: chapter.name }));
    }

    function renderChapter(chapter: ExamChapter, seconds: number, score: ReturnType<typeof scoreOf>, isNext: boolean): HTMLLIElement {
      const li = el('li', `chapter${chapter.done ? ' is-done' : ''}${isNext ? ' is-next' : ''}`);

      const check = el('button', 'chapter__check');
      check.type = 'button';
      check.innerHTML = `<span class="chapter__box">${CHECK_SVG}</span>`;
      check.setAttribute('aria-pressed', String(chapter.done));
      check.setAttribute('aria-label', t(chapter.done ? 'exam.markNotFinished' : 'exam.markFinished', { name: chapter.name }));
      check.addEventListener('click', () => setDone(chapter, !chapter.done));

      // The name opens the sheet with everything else.
      const open = el('button', 'chapter__open');
      open.type = 'button';
      open.dataset.sheetOpen = 'exam-chapter';
      open.dataset.chapter = chapter.id;
      const time = seconds >= 60 ? formatHM(seconds) : '';
      const meta = chapter.plannedHours
        ? t('exam.timeOfPlanned', { time: time || '0', planned: t('unit.h', { n: chapter.plannedHours }) })
        : time || t('exam.notStarted');
      open.append(el('span', 'chapter__name', chapter.name), el('span', 'chapter__meta', meta.replace(/(\d) (?=\S)/g, '$1 ')));
      if (chapter.plannedHours && !chapter.done) {
        const meter = el('span', 'chapter__meter');
        const fill = el('span');
        fill.style.inlineSize = `${Math.min(100, Math.round((seconds / (chapter.plannedHours * 3600)) * 100))}%`;
        meter.append(fill);
        open.append(meter);
      }

      const right = el('span', `chapter__score${score ? ` is-${score.band}` : ''}`, score?.text ?? '');
      if (score) right.title = t('exam.rightShare', { pct: score.text });

      const play = el('a', 'chapter__play');
      play.href = focusUrl(chapter.id);
      play.innerHTML = PLAY_SVG;
      play.setAttribute('aria-label', t(chapter.done ? 'exam.reviewLabel' : 'exam.focusLabel', { name: chapter.name }));

      li.append(check, open, right, play);
      return li;
    }

    /** The plan's chapter rows: open ones in the plan's order, then the finished ones. */
    function planRows(exam: Exam) {
      const chapters = exam.chapters.filter((ch) => !removing.has(ch.id));
      const time = examTime(exam, getSessions());
      const next = nextChapter(exam, time);
      const scores = chapterScores(exam);
      const rows = chapters.map((ch) => ({ ch, li: renderChapter(ch, time.byChapter.get(ch.id) ?? 0, scoreOf(scores.get(ch.id)), ch.id === next?.id) }));
      return { rows, open: rows.filter((r) => !r.ch.done), done: rows.filter((r) => r.ch.done) };
    }

    function render(): void {
      const store = getExamStore();
      const exam = store.exam;
      root!.hidden = !exam;
      if (!exam) return;
      const plans = byDate(getPlans(store));
      const many = plans.length > 1;
      groupsBox.hidden = !many;
      $<HTMLElement>('[data-ec-count]').hidden = many;
      if (!plans.some((p) => p.id === addPlanId)) addPlanId = exam.id;
      // Each group has its own "+ Add chapter".
      addOpen.hidden = many || !form.hidden;
      if (many) {
        list.hidden = doneBox.hidden = empty.hidden = true;
        groupsBox.replaceChildren(...plans.map((p, i) => renderGroup(p, i)));
        nameInput.placeholder = t('exam.addChapterTo', { name: plans.find((p) => p.id === addPlanId)?.title ?? '' });
        if (sheet!.open) renderSheet(false);
        return;
      }
      addPlanId = exam.id;
      nameInput.placeholder = t('exam.addAChapterOrPart');
      const { rows, open, done } = planRows(exam);
      empty.hidden = rows.length > 0;
      // The plan's order; only the finished ones fold away.
      list.replaceChildren(...open.map((r) => r.li));
      list.hidden = rows.length > 0 && done.length === rows.length;
      doneList.replaceChildren(...done.map((r) => r.li));
      doneBox.hidden = !done.length;
      $<HTMLElement>('[data-ec-done-title]').textContent = tn('exam.nFinished', done.length);
      const todo = rows.length - done.length;
      $<HTMLElement>('[data-ec-count]').textContent = rows.length ? (todo ? `${tn('exam.nToDo', todo)} · ${tn('exam.nFinished', done.length)}` : t('exam.allFinished')) : '';
      // The add form waits behind its button, except when there is nothing yet.
      if (!rows.length) showForm();
      if (sheet!.open) renderSheet(false);
    }

    /** One plan's group: its name and count, a pencil, its chapters, "+ Add chapter" and practice. */
    function renderGroup(plan: Exam, index: number): HTMLDetailsElement {
      const box = el('details', 'chapters__group');
      box.open = openGroups.get(plan.id) ?? index === 0;
      box.addEventListener('toggle', () => openGroups.set(plan.id, box.open));
      const { rows, open, done } = planRows(plan);

      const head = el('summary', 'chapters__group-head');
      const name = el('span', 'chapters__group-name');
      name.append(
        el('span', 'chapters__group-title', plan.title),
        el('span', 'muted chapters__group-count', rows.length ? (open.length ? tn('exam.nToDo', open.length) : t('exam.allFinished')) : t('exam.noChaptersShort')),
      );
      const edit = el('button', 'icon-btn chapters__group-edit');
      edit.type = 'button';
      edit.innerHTML = EDIT_SVG;
      edit.setAttribute('aria-label', t('exam.editPlan', { name: plan.title }));
      edit.title = t('exam.editGoal');
      edit.addEventListener('click', (e) => {
        e.preventDefault();
        document.dispatchEvent(new CustomEvent('exam:edit', { detail: plan.id }));
      });
      head.append(name, edit);

      const ol = el('ol', 'chapters__items');
      ol.append(...open.map((r) => r.li));
      box.append(head, ol);
      if (done.length) {
        const fold = el('details', 'disclosure chapters__done');
        fold.append(el('summary', '', tn('exam.nFinished', done.length)));
        const doneOl = el('ol', 'chapters__items');
        doneOl.append(...done.map((r) => r.li));
        fold.append(doneOl);
        box.append(fold);
      }

      const tools = el('div', 'chapters__group-tools');
      const add = el('button', 'btn btn--ghost btn--small', t('exam.addChapter'));
      add.type = 'button';
      add.addEventListener('click', () => {
        addPlanId = plan.id;
        nameInput.placeholder = t('exam.addChapterTo', { name: plan.title });
        showForm();
        nameInput.focus();
      });
      tools.append(add);
      const n = Math.min(ROUND_SIZE, plan.questions.length);
      if (n) {
        const practise = el('button', 'btn btn--ghost btn--small', tn('exam.practiseShort', n));
        practise.type = 'button';
        practise.addEventListener('click', () => document.dispatchEvent(new CustomEvent('exam:practise', { detail: { plan: plan.id, scope: 'all' } })));
        tools.append(practise);
      }
      box.append(tools);
      return box;
    }

    // ---------- The chapter's sheet ----------

    const sName = s$<HTMLInputElement>('[data-ecs-name]');
    const sHours = s$<HTMLInputElement>('[data-ecs-hours]');
    const sNotes = s$<HTMLTextAreaElement>('[data-ecs-notes]');
    sNotes.maxLength = EXAM_NOTES_MAX;

    /** `fields`: also fill the inputs (not while you are typing in them). */
    function renderSheet(fields: boolean): void {
      const exam = planOfChapter(sheetId);
      const chapters = exam?.chapters.filter((ch) => !removing.has(ch.id)) ?? [];
      const index = chapters.findIndex((ch) => ch.id === sheetId);
      const chapter = chapters[index];
      if (!exam || !chapter) {
        sheet!.close();
        return;
      }
      const seconds = examTime(exam, getSessions()).byChapter.get(chapter.id) ?? 0;
      const questions = exam.questions.filter((q) => q.chapterId === chapter.id).length;
      const score = scoreOf(chapterScores(exam).get(chapter.id));
      s$<HTMLElement>('[data-ecs-title]').textContent = chapter.name;
      s$<HTMLElement>('[data-ecs-meta]').textContent = [
        seconds >= 60 ? t('exam.studied', { time: formatHM(seconds) }) : t('exam.notStarted'),
        questions ? tn('exam.questionsN', questions) : t('exam.noQuestionsYet'),
        score ? t('exam.rightShare', { pct: score.text }) : '',
      ]
        .filter(Boolean)
        .join(' · ');

      const focus = s$<HTMLAnchorElement>('[data-ecs-focus]');
      focus.href = focusUrl(chapter.id);
      focus.textContent = chapter.done ? t('exam.review') : seconds >= 60 ? t('exam.focus') : t('exam.start');
      const practise = s$<HTMLButtonElement>('[data-ecs-practise]');
      practise.hidden = questions === 0;
      practise.textContent = t('exam.practiseThis');
      s$<HTMLButtonElement>('[data-ecs-ask]').dataset.chapter = chapter.id;

      if (fields) {
        sName.value = chapter.name;
        sHours.value = chapter.plannedHours ? String(chapter.plannedHours) : '';
        sNotes.value = chapter.notes ?? '';
      }
      s$<HTMLButtonElement>('[data-ecs-done]').textContent = chapter.done ? t('exam.reopen') : t('exam.markDone');
      s$<HTMLButtonElement>('[data-ecs-up]').disabled = index === 0;
      s$<HTMLButtonElement>('[data-ecs-down]').disabled = index === chapters.length - 1;
    }

    const current = () => planOfChapter(sheetId)?.chapters.find((ch) => ch.id === sheetId);

    sheet.addEventListener('sheet:open', (e) => {
      sheetId = (e as CustomEvent<Record<string, string>>).detail.chapter ?? '';
      renderSheet(true);
    });
    sName.addEventListener('change', () => updateChapter(sheetId, { name: sName.value }));
    sHours.addEventListener('change', () => {
      const n = Number(sHours.value);
      updateChapter(sheetId, { plannedHours: n > 0 ? Math.round(n * 10) / 10 : undefined });
    });
    sNotes.addEventListener('change', () => updateChapter(sheetId, { notes: sNotes.value }));
    s$<HTMLButtonElement>('[data-ecs-practise]').addEventListener('click', () => {
      sheet.close();
      document.dispatchEvent(new CustomEvent('exam:practise', { detail: sheetId }));
    });
    s$<HTMLButtonElement>('[data-ecs-done]').addEventListener('click', () => {
      const chapter = current();
      if (chapter) setDone(chapter, !chapter.done);
    });
    s$<HTMLButtonElement>('[data-ecs-up]').addEventListener('click', () => moveChapter(sheetId, -1));
    s$<HTMLButtonElement>('[data-ecs-down]').addEventListener('click', () => moveChapter(sheetId, 1));
    s$<HTMLButtonElement>('[data-ecs-remove]').addEventListener('click', () => {
      const chapter = current();
      if (!chapter) return;
      sheet.close();
      remove(chapter);
    });

    // ---------- Adding ----------

    function showForm(): void {
      form.hidden = false;
      addOpen.hidden = true;
    }
    addOpen.addEventListener('click', () => {
      showForm();
      nameInput.focus();
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const added = addChapter(nameInput.value, hoursInput.value ? Number(hoursInput.value) : undefined, addPlanId || undefined);
      if (!added) return;
      nameInput.value = '';
      hoursInput.value = '';
      nameInput.focus();
      announce(t('exam.added', { name: added.name }));
    });

    render();
    c.add(subscribe('exam', render));
    c.add(subscribe('sessions', render));
    c.add(() => sheet.close());
    return c.run;
  });
</script>

<style>
  .chapters[hidden],
  .chapters [hidden],
  .ch-sheet [hidden] {
    display: none;
  }

  .chapters__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-1) var(--space-3);
  }

  .chapters__head .panel-title {
    margin: 0;
  }

  .chapters__count {
    font-size: var(--text-sm);
  }

  .chapters__items {
    display: grid;
    margin-top: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .chapters__done {
    margin-top: var(--space-2);
  }

  .chapters__done > summary {
    min-height: 44px;
    align-content: center;
    font-weight: 600;
  }

  /* Several plans: one group each (made in the script, hence :global). */
  .chapters__groups {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }

  .chapters :global(.chapters__group) {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-1);
  }

  .chapters :global(.chapters__group:first-child) {
    border-top: 0;
    padding-top: 0;
  }

  .chapters :global(.chapters__group-head) {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    cursor: pointer;
    list-style: none;
  }

  .chapters :global(.chapters__group-head::-webkit-details-marker) {
    display: none;
  }

  /* A small arrow that turns when the group opens. */
  .chapters :global(.chapters__group-head::before) {
    content: '›';
    flex: none;
    inline-size: 1em;
    color: var(--color-text-muted);
    font-weight: 700;
    transition: transform 0.15s;
  }

  .chapters :global(.chapters__group[open] > .chapters__group-head::before) {
    transform: rotate(90deg);
  }

  .chapters :global(.chapters__group-name) {
    display: grid;
    flex: 1;
    min-width: 0;
  }

  .chapters :global(.chapters__group-title) {
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .chapters :global(.chapters__group-count) {
    font-size: var(--text-sm);
  }

  .chapters :global(.chapters__group-edit) {
    flex: none;
    min-inline-size: 44px;
    min-block-size: 44px;
  }

  .chapters :global(.chapters__group .chapters__items) {
    display: grid;
    margin: var(--space-1) 0 0;
    padding: 0;
    list-style: none;
  }

  .chapters :global(.chapters__group .chapters__done) {
    margin-top: var(--space-1);
  }

  .chapters :global(.chapters__group .chapters__done > summary) {
    min-height: 44px;
    align-content: center;
    font-weight: 600;
  }

  .chapters :global(.chapters__group-tools) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }

  .chapters :global(.chapters__group-tools .btn) {
    min-height: 44px;
  }

  .chapters__empty {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
  }

  .chapters__add {
    margin-top: var(--space-2);
    min-height: 44px;
  }

  .chapters__form {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
    padding: var(--space-3);
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius-md);
  }

  .chapters__form .input {
    flex: 1 1 12rem;
    min-width: 0;
  }

  .chapters__form .chapters__hours {
    flex: 0 1 6.5rem;
  }

  /* A chapter is one line: tick, name and time, accuracy, play. */
  .chapters :global(.chapter) {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    border-top: 1px solid var(--color-border);
  }

  .chapters :global(.chapter:first-child) {
    border-top: 0;
  }

  .chapters :global(.chapter__check),
  .chapters :global(.chapter__play) {
    flex: none;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
