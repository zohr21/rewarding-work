---
/**
 * Task breakdown: split a big task into small steps and tick them off.
 * Edits the *current* task (tasks in src/lib/storage.ts); /tasks lists them all.
 * Ticked steps are also logged in the Done list (unticking removes them again).
 * Also the task's notes (saved as you type) and its session log from the timer.
 */
import { url } from '../lib/paths';
import { NOTES_MAX } from '../lib/storage';
import type { Key } from '../lib/i18n';

interface Props {
  heading?: string;
  /** The heading's key in src/lib/i18n, when it is not the default one. */
  headingT?: Key;
  intro?: string;
  introT?: Key;
  /** Off on the tasks page itself. */
  linkToTasks?: boolean;
}
const {
  heading = 'Try it: break it down',
  headingT = 'tasks.bdHeading',
  introT = 'tasks.bdIntro',
  linkToTasks = true,
  intro = 'Make each step small enough that you could start it in two minutes.',
} = Astro.props;
---

<section class="card breakdown" data-breakdown aria-labelledby="bd-heading">
  <h2 id="bd-heading" class="panel-title" data-t={headingT}>{heading}</h2>
  <p class="muted bd__intro" data-t={introT}>{intro}</p>

  <label data-t="tasks.theBigTask" class="bd__label" for="bd-task">The big task</label>
  <input data-t-placeholder="tasks.eGWriteTheProject" id="bd-task" class="input" type="text" maxlength="120" autocomplete="off" placeholder="e.g. Write the project report" data-bd-task />

  <form class="bd__add" data-bd-form>
    <label data-t="tasks.addAStep" class="bd__label" for="bd-step">Add a step</label>
    <div class="bd__row">
      <input data-t-placeholder="tasks.eGOpenTheDoc" id="bd-step" class="input" type="text" maxlength="120" autocomplete="off" placeholder="e.g. Open the doc and write the headings" data-bd-step />
      <button data-t="tasks.add" type="submit" class="btn">Add</button>
    </div>
  </form>

  <div class="bd__progress" data-bd-progress hidden>
    <div class="bd__progress-head">
      <p class="bd__count" data-bd-count></p>
      <button data-t="tasks.editSteps" type="button" class="btn btn--ghost btn--small bd__edit" data-bd-edit aria-pressed="false">Edit steps</button>
    </div>
    <div class="bd__meter" aria-hidden="true"><span class="bd__meter-fill" data-bd-fill></span></div>
    <p class="bd__now" data-bd-now></p>
  </div>
  <p data-t="tasks.removeAStepYouDon" class="muted bd__edit-hint" data-bd-edit-hint hidden>Remove a step you don't need. You can bring it back with Undo.</p>
  <p data-t="tasks.tapAStepToWork" class="muted bd__how" data-bd-how hidden>Tap a step to work on it. Tap its circle when it's done.</p>
  <ol class="bd__steps" data-bd-steps></ol>

  <div class="bd__finish" data-bd-finish hidden>
    <button data-t="tasks.markTheWholeTaskDone" type="button" class="btn" data-bd-done>Mark the whole task done</button>
  </div>
  <div class="bd__finish" data-bd-finished hidden>
    <p data-t="tasks.finishedItSInYour" class="bd__finished-text">Finished — it's in your Done list.</p>
    <button data-t="tasks.reopen" type="button" class="btn btn--ghost btn--small" data-bd-reopen>Reopen</button>
  </div>

  <div class="bd__notes" data-bd-notes-wrap hidden>
    <div class="bd__notes-head">
      <label data-t="tasks.notes" class="bd__label" for="bd-notes">Notes</label>
      <span class="muted bd__saved" data-bd-saved></span>
    </div>
    <textarea data-t-placeholder="tasks.linksIdeasWhereYouLeft"
      id="bd-notes"
      class="input bd__notes-input"
      rows="4"
      maxlength={NOTES_MAX}
      placeholder="Links, ideas, where you left off…"
      data-bd-notes></textarea>
  </div>

  <details class="disclosure bd__log" data-bd-log-wrap hidden>
    <summary data-t="tasks.sessionLog" data-bd-log-summary>Session log</summary>
    <ol class="bd__log-list" data-bd-log></ol>
  </details>

  <div class="bd__footer" data-bd-footer hidden>
    <button data-t="tasks.startANewTask" type="button" class="btn btn--ghost btn--small" data-bd-clear>Start a new task</button>
    <span class="muted bd__note"><span data-t="tasks.tickedSteps">Ticked steps also appear in your Done list.</span> {linkToTasks && <a data-t="tasks.allYourTasks" href={url('/tasks')}>All your tasks</a>}</span>
  </div>
  <p class="visually-hidden" aria-live="polite" data-bd-live></p>
</section>

<script>
  import { createTask, getCurrentTask, setCurrentTask, subscribe, updateTask, type Task, type TaskStep } from '../lib/storage';
  import { addStep, doStepNext, ensureCurrentTask, finishTask, formatFocus, removeStep, reopenTask, setStepDone, setTaskNotes } from '../lib/tasks';
  import { currentStep, liveTaskId, stateWords, stepIcon, stepStates } from '../lib/parts';
  import { dateFormat, t } from '../lib/i18n';
  import { celebrate } from '../lib/appearance';
  import { offerUndo } from '../lib/undo';
  import { cleanups, onPage } from '../lib/page';

  const X_SVG =
    '<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>';
  /** Edit mode shows the remove buttons; kept for the visit. */
  let editing = false;

  const logFmt = dateFormat({ weekday: 'short', day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit' });
  const NOTES_SAVE_MS = 500;

  onPage('breakdown', () => {
    const c = cleanups();
    document.querySelectorAll<HTMLElement>('[data-breakdown]').forEach((root) => {
      const $ = <E extends Element>(s: string) => root.querySelector<E>(s)!;
      const title = $<HTMLInputElement>('[data-bd-task]');
      const form = $<HTMLFormElement>('[data-bd-form]');
      const stepInput = $<HTMLInputElement>('[data-bd-step]');
      const progress = $<HTMLElement>('[data-bd-progress]');
      const count = $<HTMLElement>('[data-bd-count]');
      const fill = $<HTMLElement>('[data-bd-fill]');
      const nowLine = $<HTMLElement>('[data-bd-now]');
      const edit = $<HTMLButtonElement>('[data-bd-edit]');
      const editHint = $<HTMLElement>('[data-bd-edit-hint]');
      const how = $<HTMLElement>('[data-bd-how]');
      /** After a re-render, put keyboard focus back on the control that was used. */
      let refocus: string | null = null;
      const list = $<HTMLOListElement>('[data-bd-steps]');
      const finish = $<HTMLElement>('[data-bd-finish]');
      const finished = $<HTMLElement>('[data-bd-finished]');
      const reopen = $<HTMLButtonElement>('[data-bd-reopen]');
      const footer = $<HTMLElement>('[data-bd-footer]');
      const live = $<HTMLElement>('[data-bd-live]');
      const notesWrap = $<HTMLElement>('[data-bd-notes-wrap]');
      const notes = $<HTMLTextAreaElement>('[data-bd-notes]');
      const saved = $<HTMLElement>('[data-bd-saved]');
      const logWrap = $<HTMLDetailsElement>('[data-bd-log-wrap]');
      const logSummary = $<HTMLElement>('[data-bd-log-summary]');
      const logList = $<HTMLOListElement>('[data-bd-log]');

      /** Notes save shortly after you stop typing; this is the task they belong to. */
      let notesFor: string | null = null;
      let shownTask: string | null = null;
      let notesTimer = 0;
      function saveNotes(): void {
        window.clearTimeout(notesTimer);
        if (!notesFor) return;
        const id = notesFor;
        notesFor = null;
        setTaskNotes(id, notes.value);
        saved.textContent = t('tasks.saved');
      }

      /** Removed steps still offered for Undo (src/lib/undo.ts). */
      const removing = new Set<string>();

      const announce = (text: string) => {
        live.textContent = '';
        window.setTimeout(() => (live.textContent = text), 50);
      };

      /**
       * The steps sheet's focus button (tasks.astro), when this breakdown is in it: it starts
       * the timer on the step you're on and says which one.
       */
      function updateFocusLink(task: Task | null, now: TaskStep | undefined): void {
        const go = root.closest('dialog')?.querySelector<HTMLAnchorElement>('[data-task-steps-focus]');
        if (!go || !task) return;
        const u = new URL(go.href);
        u.search = '';
        u.searchParams.set('task', task.id);
        if (now) u.searchParams.set('step', now.id);
        go.href = u.pathname + u.search;
        go.textContent = now ? t('tasks.focusOnStep', { step: now.text }) : t('tasks.startFocusing');
      }

      function render(): void {
        const task = getCurrentTask();
        const steps = (task?.steps ?? []).filter((s) => !removing.has(s.id));
        if (document.activeElement !== title) title.value = task?.title ?? '';
        const done = steps.filter((s) => s.done).length;
        const isDone = task?.status === 'done';
        const live = !!task && !isDone && task.id === liveTaskId();
        const pct = steps.length ? Math.round((done / steps.length) * 100) : 0;
        progress.hidden = steps.length === 0;
        progress.classList.toggle('is-live', live);
        count.textContent = `${done} of ${steps.length} step${steps.length === 1 ? '' : 's'} done · ${pct}%`;
        fill.style.inlineSize = `${Math.max(pct, 3)}%`;
        const now = isDone ? undefined : currentStep(steps);
        nowLine.textContent = now ? t(live ? 'tasks.focusingNow' : 'tasks.upNow', { step: now.text }) : done > 0 ? t('tasks.allStepsDone') : '';
        if (!steps.length) editing = false;
        edit.setAttribute('aria-pressed', String(editing));
        edit.textContent = editing ? t('tasks.doneEditing') : t('tasks.editSteps');
        editHint.hidden = !editing || !steps.length;
        // How the two taps work, while there's an open step to pick.
        how.hidden = editing || isDone || !steps.some((st) => !st.done);
        updateFocusLink(task, now);
        list.classList.toggle('is-editing', editing);
        // Offer to finish the task once every step is ticked.
        finish.hidden = !task || isDone || steps.length === 0 || done < steps.length;
        finished.hidden = !isDone;
        footer.hidden = !task;

        // Switching task mid-typing: save the old task's notes first.
        if (notesFor && notesFor !== task?.id) saveNotes();
        if (shownTask !== (task?.id ?? null)) saved.textContent = '';
        shownTask = task?.id ?? null;
        notesWrap.hidden = !task;
        if (document.activeElement !== notes) notes.value = task?.notes ?? '';

        const log = [...(task?.log ?? [])].reverse();
        logWrap.hidden = log.length === 0;
        logSummary.textContent = t('tasks.sessionLogCount', { n: log.length });
        logList.replaceChildren(
          ...log.map((entry) => {
            const li = document.createElement('li');
            li.className = 'bd__log-item';
            const when = document.createElement('p');
            when.className = 'bd__log-when muted';
            const time = document.createElement('time');
            time.dateTime = new Date(entry.at).toISOString();
            time.textContent = logFmt.format(entry.at);
            when.append(time, entry.focusSeconds >= 60 ? ` · ${t('tasks.logFocus', { time: formatFocus(entry.focusSeconds) })}` : '');
            li.append(when);
            for (const [label, text] of [[t('tasks.logDid'), entry.did], [t('tasks.logNext'), entry.next]] as const) {
              if (!text) continue;
              const p = document.createElement('p');
              const b = document.createElement('strong');
              b.textContent = `${label}: `;
              p.append(b, text);
              li.append(p);
            }
            return li;
          }),
        );

        // States from the visible steps, so a step waiting on Undo doesn't count as the one you're on.
        const states = task ? stepStates({ ...task, steps }, live) : new Map();
        list.replaceChildren(
          ...steps.map((step) => {
            const state = states.get(step.id) ?? (step.done ? 'done' : 'waiting');
            const li = document.createElement('li');
            li.className = `bd__step is-${state}${step.done ? ' is-done' : ''}`;

            // Two targets: the circle ticks the step done (or back), the name picks it as the one you're on.
            const tick = document.createElement('button');
            tick.type = 'button';
            tick.className = 'bd__tick';
            tick.dataset.bdTick = step.id;
            tick.setAttribute('aria-pressed', String(step.done));
            tick.setAttribute('aria-label', t(step.done ? 'tasks.markNotDoneStep' : 'tasks.markDoneStep', { step: step.text }));
            tick.title = t(step.done ? 'tasks.markNotDone' : 'tasks.markDone');
            tick.append(stepIcon(state, 26));
            tick.addEventListener('click', () => {
              if (!task) return;
              if (!step.done) celebrate(tick);
              refocus = `[data-bd-tick="${step.id}"]`;
              setStepDone(task.id, step.id, !step.done);
              announce(t(step.done ? 'tasks.stepNotDoneSaid' : 'tasks.stepDoneSaid', { step: step.text }));
            });

            let name: HTMLElement;
            if (step.done) {
              name = document.createElement('span');
            } else {
              const pick = document.createElement('button');
              pick.type = 'button';
              pick.dataset.bdPick = step.id;
              const isNow = state === 'now' || state === 'live';
              if (isNow) pick.setAttribute('aria-current', 'step');
              pick.setAttribute('aria-label', isNow ? `${step.text}, ${stateWords(state)}` : t('tasks.workOnNow', { step: step.text }));
              pick.addEventListener('click', () => {
                if (!task || isNow) return;
                refocus = `[data-bd-pick="${step.id}"]`;
                doStepNext(task.id, step.id);
                announce(t('tasks.upNowSaid', { step: step.text }));
              });
              name = pick;
            }
            name.classList.add('bd__step-text');
            name.textContent = step.text;
            li.append(tick, name);
            if (!editing) return li;

            const tools = document.createElement('div');
            tools.className = 'bd__step-tools';

            const del = document.createElement('button');
            del.type = 'button';
            del.className = 'icon-btn bd__remove';
            del.setAttribute('aria-label', t('tasks.removeStep', { step: step.text }));
            del.title = t('tasks.remove');
            del.innerHTML = X_SVG;
            del.addEventListener('click', () => {
              if (!task) return;
              stepInput.focus();
              removing.add(step.id);
              render();
              offerUndo({
                message: t('tasks.removedStep', { step: step.text }),
                commit: () => {
                  removeStep(task.id, step.id);
                  removing.delete(step.id);
                },
                undo: () => {
                  removing.delete(step.id);
                  render();
                  announce(t('tasks.restoredStep', { step: step.text }));
                },
              });
              announce(t('tasks.removedStepSaid', { step: step.text }));
            });
            tools.append(del);
            li.append(tools);
            return li;
          }),
        );

        if (refocus) {
          root.querySelector<HTMLElement>(refocus)?.focus();
          refocus = null;
        }
      }

      edit.addEventListener('click', () => {
        editing = !editing;
        render();
        edit.focus();
        announce(editing ? t('tasks.editingSaid') : t('tasks.doneEditingSaid'));
      });

      notes.addEventListener('input', () => {
        const task = getCurrentTask();
        if (!task) return;
        notesFor = task.id;
        saved.textContent = '';
        window.clearTimeout(notesTimer);
        notesTimer = window.setTimeout(saveNotes, NOTES_SAVE_MS);
      });
      notes.addEventListener('blur', saveNotes);
      c.add(saveNotes); // leaving the page mid-typing

      title.addEventListener('input', () => {
        const task = getCurrentTask();
        if (task) updateTask(task.id, () => ({ title: title.value }));
        else if (title.value.trim()) createTask(title.value);
      });

      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const text = stepInput.value.trim();
        if (!text) return;
        addStep(ensureCurrentTask().id, text);
        stepInput.value = '';
        stepInput.focus();
        announce(t('tasks.stepAdded', { step: text }));
      });

      $<HTMLButtonElement>('[data-bd-done]').addEventListener('click', (e) => {
        const task = getCurrentTask();
        if (!task) return;
        celebrate(e.currentTarget as HTMLElement);
        finishTask(task.id);
        announce(t('tasks.finishedLogged'));
        reopen.focus();
      });

      reopen.addEventListener('click', () => {
        const task = getCurrentTask();
        if (!task) return;
        reopenTask(task.id);
        announce(t('tasks.reopenedTask'));
        stepInput.focus();
      });

      $<HTMLButtonElement>('[data-bd-clear]').addEventListener('click', () => {
        setCurrentTask(null);
        title.focus();
        announce(t('tasks.readyNew'));
      });

      render();
      c.add(subscribe('tasks', render));
      c.add(subscribe('timer', render)); // the step you're on turns while a session runs on this task
    });
    return c.run;
  });
</script>

<style>
  .bd__intro {
    font-size: var(--text-sm);
    margin-bottom: var(--space-4);
  }

  .bd__label {
    display: block;
    margin-bottom: var(--space-1);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .bd__add {
    margin-top: var(--space-4);
  }

  .bd__row {
    display: flex;
    gap: var(--space-2);
  }

  .bd__row .input {
    flex: 1;
    min-width: 0;
  }

  /* Installer-style progress: a sunken track that fills, with a sheen running along it while you focus. */
  .bd__progress {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-5);
  }

  .bd__progress[hidden],
  .bd__edit-hint[hidden] {
    display: none;
  }

  .bd__progress-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .bd__count {
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .bd__edit {
    min-height: 44px;
  }

  .bd__edit[aria-pressed='true'] {
    background: var(--color-accent-soft);
    color: var(--color-accent);
  }

  .bd__meter {
    position: relative;
    block-size: 12px;
    border-radius: var(--radius-pill);
    background: var(--well-bg);
    box-shadow: var(--well-shadow);
    overflow: hidden;
  }

  .bd__meter-fill {
    display: block;
    block-size: 100%;
    inline-size: 3%;
    border-radius: inherit;
    background: var(--accent-grad);
    transition: inline-size var(--duration-slow) var(--ease-out);
  }

  .bd__progress.is-live .bd__meter-fill {
    background:
      linear-gradient(90deg, transparent, rgb(255 255 255 / 0.45), transparent) 0 0 / 120px 100% no-repeat,
      var(--accent-grad);
    box-shadow: 0 0 calc(10px * var(--glow-strength)) var(--glow-soft);
    animation: bd-sheen 1.5s linear infinite;
  }

  @keyframes bd-sheen {
    from {
      background-position: -120px 0, 0 0;
    }
    to {
      background-position: 400px 0, 0 0;
    }
  }

  .bd__now {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    overflow-wrap: anywhere;
  }

  .bd__progress.is-live .bd__now {
    color: var(--color-accent);
    font-weight: 600;
  }

  .bd__now:empty {
    display: none;
  }

  .bd__edit-hint {
    margin-top: var(--space-2);
    font-size: var(--text-xs);
  }

  .bd__steps {
    display: grid;
    gap: 2px;
    margin-top: var(--space-3);
    padding: var(--space-1);
    border-radius: var(--radius-md);
    background: var(--well-bg);
    box-shadow: var(--well-shadow);
    list-style: none;
  }

  .bd__steps:empty {
    display: none;
  }

  .breakdown :global(.bd__step) {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    border-radius: var(--radius-sm);
    max-width: none;
  }

  /* The step you're on stands out; it glows while a session runs on this task. */
  .breakdown :global(.bd__step.is-now),
  .breakdown :global(.bd__step.is-live) {
    background: color-mix(in srgb, var(--color-accent-soft) 85%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-accent) 35%, transparent);
  }

  .breakdown :global(.bd__step.is-live) {
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--glow) 45%, transparent),
      0 0 calc(16px * var(--glow-strength)) -6px var(--glow-soft);
  }

  /* The circle: a 48px target of its own, so ticking a step is a deliberate tap. */
  .breakdown :global(.bd__tick) {
    flex: none;
    display: grid;
    place-items: center;
    inline-size: 48px;
    block-size: 52px;
    border: 0;
    border-radius: var(--radius-sm);
    background: none;
    color: var(--color-text);
    cursor: pointer;
  }

  .breakdown :global(.bd__tick:hover) {
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
  }

  /* The name: picks the step as the one you're on. */
  .breakdown :global(.bd__step-text) {
    flex: 1;
    min-width: 0;
    min-height: 52px;
    display: flex;
    align-items: center;
    padding: var(--space-2) var(--space-2) var(--space-2) 0;
    border: 0;
    border-radius: var(--radius-sm);
    background: none;
    color: var(--color-text);
    font: inherit;
    text-align: start;
    overflow-wrap: anywhere;
    transition: color var(--duration-base) var(--ease-out);
  }

  .breakdown :global(button.bd__step-text) {
    cursor: pointer;
  }

  .breakdown :global(button.bd__step-text[aria-current]) {
    cursor: default;
    font-weight: 600;
  }

  .breakdown :global(button.bd__step-text:not([aria-current]):hover) {
    color: var(--color-accent);
  }

  .bd__how {
    margin-top: var(--space-2);
    font-size: var(--text-xs);
  }

  .bd__how[hidden] {
    display: none;
  }

  .breakdown :global(.bd__step.is-done .bd__step-text) {
    color: var(--color-text-muted);
    text-decoration: line-through;
    text-decoration-thickness: 1.5px;
  }

  .breakdown :global(.bd__step-tools) {
    display: flex;
    flex: none;
    padding-inline-end: var(--space-1);
  }

  .breakdown :global(.bd__remove) {
    color: var(--color-danger);
  }

  @media (prefers-reduced-motion: reduce) {
    .bd__progress.is-live .bd__meter-fill {
      animation: none;
    }
  }

  :global(html[data-motion='off']) .bd__progress.is-live .bd__meter-fill {
    animation: none;
  }

  .bd__finish,
  .bd__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    margin-top: var(--space-4);
  }

  .bd__finish[hidden],
  .bd__footer[hidden] {
    display: none;
  }

  .bd__finished-text {
    font-weight: 600;
    color: var(--color-accent);
  }

  .bd__note {
    font-size: var(--text-xs);
  }

  .bd__notes {
    margin-top: var(--space-5);
  }

  .bd__notes[hidden],
  .bd__log[hidden] {
    display: none;
  }

  .bd__notes-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .bd__saved {
    font-size: var(--text-xs);
  }

  .bd__notes-input {
    display: block;
    inline-size: 100%;
    min-block-size: 6rem;
    field-sizing: content;
    max-block-size: 24rem;
    resize: vertical;
    line-height: 1.5;
  }

  .bd__log {
