---
/**
 * Your data, a sheet opened from the You page in the Android app: what your finding and
 * tomorrow's plan (src/lib/findings.ts) learn from, what they have learned, and a way to
 * forget it or take it with you.
 */
import Sheet from './Sheet.astro';
import { SOURCES } from '../lib/findings';
---

<Sheet id="mydata" title="Your data" titleKey="you.yourData">
  <div class="yd" data-yd>
    <p data-t="you.yourFindingAndTomorrowS" class="muted yd__small">Your finding and tomorrow's plan are worked out on this phone. Health data never leaves it.</p>

    <fieldset class="yd__group">
      <legend data-t="you.grovynLearnsFrom" class="yd__legend">Grovyn learns from</legend>
      {
        SOURCES.map((s) => (
          <label class="yd__row">
            <span class="yd__text">
              <strong data-t={`you.src.${s.id}`}>{s.label}</strong>
              <span class="muted yd__small" data-t={`you.src.${s.id}Where`}>{s.where}</span>
            </span>
            <input type="checkbox" role="switch" data-yd-source={s.id} />
          </label>
        ))
      }
    </fieldset>
    <p data-t="you.withSleepOrFocusOff" class="muted yd__small" data-yd-off-note hidden>With sleep or focus off, your finding is turned off too.</p>

    <section class="yd__group" aria-labelledby="yd-learned">
      <h3 data-t="you.whatGrovynHasLearned" id="yd-learned" class="yd__legend">What Grovyn has learned</h3>
      <ul class="yd__facts" role="list" data-yd-facts></ul>
      <p data-t="you.nothingYetItNeedsA" class="muted yd__small" data-yd-none hidden>Nothing yet. It needs a couple of weeks of your nights and sessions.</p>
      <p data-t="you.forgettingKeepsYourSleepSessions" class="muted yd__small">Forgetting keeps your sleep, sessions and workouts. Grovyn only starts learning again from today.</p>
    </section>

    <div class="yd__actions">
      <button data-t="you.export" type="button" class="btn btn--ghost" data-yd-export>Export</button>
      <button data-t="you.forgetEverything" type="button" class="btn btn--ghost yd__danger" data-yd-forget-all>Forget everything</button>
    </div>
    <p class="muted yd__small" role="status" data-yd-msg></p>
  </div>
</Sheet>

<script>
  import { getSessions, subscribe } from '../lib/storage';
  import { bodyDays } from '../lib/body';
  import { getWorkouts } from '../lib/workouts';
  import { exportFile, finding, forget, forgetAll, learned, rows, setSourceOn, sourceOn, type FactId, type Source } from '../lib/findings';
  import { dayKey } from '../lib/dates';
  import { cleanups, listen, onPage } from '../lib/page';
  import { el } from '../lib/dom';
  import { t } from '../lib/i18n';

  onPage('your-data', () => {
    const root = document.querySelector<HTMLElement>('[data-yd]');
    if (!root) return;
    const c = cleanups();
    const $ = <E extends Element>(s: string) => root.querySelector<E>(s)!;
    const msg = $<HTMLElement>('[data-yd-msg]');

    function render(): void {
      for (const box of root!.querySelectorAll<HTMLInputElement>('[data-yd-source]')) box.checked = sourceOn(box.dataset.ydSource as Source);
      $<HTMLElement>('[data-yd-off-note]').hidden = sourceOn('sleep') && sourceOn('focus');
      const sessions = getSessions();
      const workouts = getWorkouts();
      const facts = learned(finding(rows(bodyDays(), sessions)), sessions, workouts);
      $('[data-yd-facts]').replaceChildren(
        ...facts.map((f) => {
          const li = el('li', 'yd__fact');
          const text = el('span', 'yd__text');
          text.append(el('span', '', f.text), el('span', 'muted yd__small', f.from));
          const b = el('button', 'btn btn--ghost btn--small', t('you.forget'));
          b.type = 'button';
          b.dataset.ydForget = f.id;
          b.setAttribute('aria-label', t('you.forgetFact', { fact: f.text }));
          li.append(text, b);
          return li;
        }),
      );
      $<HTMLElement>('[data-yd-none]').hidden = facts.length > 0;
    }

    c.add(
      listen(root, 'change', (e) => {
        const box = (e.target as HTMLElement).closest<HTMLInputElement>('[data-yd-source]');
        if (box) setSourceOn(box.dataset.ydSource as Source, box.checked);
      }),
    );
    c.add(
      listen(root, 'click', (e) => {
        const target = e.target as HTMLElement;
        const one = target.closest<HTMLElement>('[data-yd-forget]');
        if (one) {
          forget(one.dataset.ydForget as FactId);
          msg.textContent = t('you.forgotten');
        } else if (target.closest('[data-yd-forget-all]')) {
          if (!window.confirm(t('you.forgetAllConfirm'))) return;
          forgetAll();
          msg.textContent = t('you.forgotAll');
        } else if (target.closest('[data-yd-export]')) {
          const file = exportFile(bodyDays(), getSessions(), getWorkouts());
          const blob = new Blob([JSON.stringify(file, null, 2)], { type: 'application/json' });
          const a = document.createElement('a');
          a.href = URL.createObjectURL(blob);
          a.download = `grovyn-finding-${dayKey(new Date())}.json`;
          document.body.append(a);
          a.click();
          a.remove();
          window.setTimeout(() => URL.revokeObjectURL(a.href), 1000);
          msg.textContent = t('you.findingSaved', { file: a.download, n: file.rows.length });
        }
      }),
    );
    c.add(listen(root.closest('dialog')!, 'sheet:open', () => (msg.textContent = '')));
    for (const store of ['findings', 'body', 'body-manual', 'sessions', 'workouts'] as const) c.add(subscribe(store, render));
    render();
    return c.run;
  });
</script>

<style>
  .yd {
    display: grid;
    gap: var(--space-4);
  }

  .yd [hidden] {
    display: none;
  }

  .yd :global(.yd__small) {
    margin: 0;
    font-size: var(--text-sm);
  }

  .yd__group {
    display: grid;
    gap: var(--space-2);
    min-inline-size: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .yd__legend {
    margin: 0 0 var(--space-1);
    padding: 0;
    font-size: var(--text-base);
    font-weight: 600;
  }

  .yd__row,
  .yd__facts :global(.yd__fact) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-3);
    align-items: center;
    min-block-size: 52px;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    background: var(--color-surface-2);
  }

  .yd__row {
    cursor: pointer;
  }

  .yd__row input {
    inline-size: 1.5rem;
    block-size: 1.5rem;
    accent-color: var(--color-accent);
  }

  .yd :global(.yd__text) {
    display: grid;
  }

  .yd__facts {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .yd__actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2);
  }

  .yd__actions .btn {
    min-block-size: 48px;
  }

  .yd__danger {
    color: var(--color-danger);
  }
</style>
