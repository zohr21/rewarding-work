---
/**
 * Google + email sign-in / sign-up / password reset. Used twice on /account:
 * signed out ("Create account"), and for guests ("Save with email", which keeps the
 * guest's data and account). Behaviour lives in src/scripts/account-ui.ts.
 */
import PasswordField from './PasswordField.astro';

interface Props {
  /** Prefix for element ids, so the panel can appear twice. */
  id: string;
  guest?: boolean;
}

const { id, guest = false } = Astro.props;
---

<div class="auth" data-auth-panel>
  <div class="auth__tabs" role="group" aria-label="Choose">
    <button type="button" class="auth__tab" data-auth-tab="create" aria-pressed={guest ? 'true' : 'false'}>
      {guest ? 'Save with email' : 'Create account'}
    </button>
    <button type="button" class="auth__tab" data-auth-tab="signin" aria-pressed={guest ? 'false' : 'true'}>
      {guest ? 'I already have an account' : 'Sign in'}
    </button>
  </div>

  <button type="button" class="btn btn--ghost auth__google" data-google>
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
      <path fill="#4285F4" d="M22.6 12.3c0-.8-.1-1.5-.2-2.2H12v4.2h5.9a5 5 0 0 1-2.2 3.3v2.7h3.6c2.1-1.9 3.3-4.8 3.3-8z"></path>
      <path fill="#34A853" d="M12 23c3 0 5.5-1 7.3-2.7l-3.6-2.7c-1 .7-2.2 1-3.7 1-2.9 0-5.3-1.9-6.2-4.5H2.1v2.8A11 11 0 0 0 12 23z"></path>
      <path fill="#FBBC05" d="M5.8 14.1a6.6 6.6 0 0 1 0-4.2V7.1H2.1a11 11 0 0 0 0 9.8l3.7-2.8z"></path>
      <path fill="#EA4335" d="M12 5.4c1.6 0 3.1.6 4.2 1.7l3.2-3.2A11 11 0 0 0 2.1 7.1l3.7 2.8C6.7 7.3 9.1 5.4 12 5.4z"></path>
    </svg>
    {guest ? 'Save with Google' : 'Continue with Google'}
  </button>

  <p class="auth__or"><span>or with email</span></p>

  <form class="auth__form" data-form="create" hidden={!guest} novalidate>
    <div class="field">
      <label for={`${id}-create-email`}>Email</label>
      <input id={`${id}-create-email`} class="input" type="email" name="email" autocomplete="email" required maxlength="254" />
    </div>
    <PasswordField id={`${id}-create-pw`} label="Choose a password" isNew />
    <button type="submit" class="btn">{guest ? 'Save my account' : 'Create account'}</button>
    <p class="auth__fine muted">
      {guest ? 'Your guest data stays exactly as it is. ' : ''}We'll email you a link to confirm the address.
    </p>
  </form>

  <form class="auth__form" data-form="signin" hidden={guest} novalidate>
    <div class="field">
      <label for={`${id}-signin-email`}>Email</label>
      <input id={`${id}-signin-email`} class="input" type="email" name="email" autocomplete="username" required maxlength="254" />
    </div>
    <PasswordField id={`${id}-signin-pw`} label="Password" />
    <button type="submit" class="btn">Sign in</button>
    <button type="button" class="auth__link" data-show-reset>Forgot your password?</button>
    {guest && <p class="auth__fine muted">What you've done as a guest is added to that account.</p>}
  </form>

  <form class="auth__form" data-form="reset" hidden novalidate>
    <p class="muted">Enter your email and we'll send you a link to choose a new password.</p>
    <div class="field">
      <label for={`${id}-reset-email`}>Email</label>
      <input id={`${id}-reset-email`} class="input" type="email" name="email" autocomplete="email" required maxlength="254" />
    </div>
    <button type="submit" class="btn">Send reset link</button>
    <button type="button" class="auth__link" data-auth-tab="signin">Back to sign in</button>
  </form>

  <p class="auth__msg" role="status" data-msg></p>
</div>
