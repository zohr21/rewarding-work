---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TechniqueRow from '../../components/TechniqueRow.astro';
import FocusTabs from '../../components/FocusTabs.astro';
import Quiz from '../../components/Quiz.astro';
import { getTechniques } from '../../lib/techniques';
import { CATEGORIES, CATEGORY_SLUGS, PROBLEMS, PROBLEM_SLUGS } from '../../data/taxonomy';

const techniques = await getTechniques();
---

<BaseLayout title="Learn" description="Browse techniques for making work feel rewarding, filtered by category or problem.">
  <div class="container">
    <FocusTabs />
    <header class="page-header">
      <h1>Technique library</h1>
      <p>Every technique explains the idea and lets you try it on the spot.</p>
    </header>

    <!-- Works without JS (all rows shown); the script below adds filtering. -->
    <form class="filters" role="search" aria-label="Filter techniques" data-filters>
      <fieldset class="chips chips--lead">
        <legend>What's in the way?</legend>
        <label class="chip"><input type="radio" name="problem" value="" checked /> <span>All</span></label>
        {
          PROBLEM_SLUGS.map((p) => (
            <label class="chip">
              <input type="radio" name="problem" value={p} /> <span>{PROBLEMS[p].title}</span>
            </label>
          ))
        }
      </fieldset>

      <div class="filters__more">
        <fieldset class="chips">
          <legend>Type</legend>
          <label class="chip"><input type="radio" name="category" value="" checked /> <span>All</span></label>
          {
            CATEGORY_SLUGS.map((c) => (
              <label class="chip">
                <input type="radio" name="category" value={c} /> <span>{CATEGORIES[c].label}</span>
              </label>
            ))
          }
        </fieldset>

        <div class="filters__search">
          <label for="q">Search by title</label>
          <input id="q" name="q" type="search" autocomplete="off" placeholder="e.g. Pomodoro" />
        </div>
      </div>
    </form>

    <section class="card library" aria-label="Techniques">
      <div class="library__head">
        <p class="muted" aria-live="polite" data-count>Showing all {techniques.length} techniques</p>
        <a href="#quiz">Not sure? Four quick questions</a>
      </div>
      <ul class="library__list" role="list" data-grid>
        {techniques.map((t) => <TechniqueRow technique={t} />)}
      </ul>
    </section>

    <div class="empty card" data-empty hidden>
      <p>No techniques match these filters.</p>
      <button type="button" class="btn btn--ghost" data-reset>Clear filters</button>
    </div>

    <section class="quiz-section" id="quiz" aria-labelledby="quiz-heading">
      <div>
        <h2 id="quiz-heading">Not sure? Four quick questions.</h2>
        <p class="muted quiz-section__intro">Answer honestly and get 2–3 techniques to try first. Nothing is saved or sent anywhere.</p>
      </div>
      <Quiz />
    </section>
  </div>
</BaseLayout>

<script>
  import { initLibraryFilters } from '../../scripts/library-filters';
  import { onPage } from '../../lib/page';
  onPage('library-filters', initLibraryFilters);
</script>

<style>
  .filters {
    display: grid;
    gap: var(--space-4);
  }

  .filters__more {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-4) var(--space-6);
  }

  .filters__search {
    flex: 0 1 18rem;
  }

  .filters__search label,
  .chips legend {
    display: block;
    margin-bottom: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .chips--lead legend {
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
  }

  .filters__search input {
    width: 100%;
    min-height: 44px;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--well-bg);
    box-shadow: var(--well-shadow);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    border: 0;
    padding: 0;
    min-width: 0;
  }

  .chips legend {
    width: 100%;
    float: left; /* lets the chips wrap below the legend inside flex fieldsets */
  }

  .chip {
    position: relative;
  }

  .chip input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }

  .chip span {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  .chip:hover span {
    color: var(--color-text);
  }

  .chip input:checked + span {
    background: var(--color-accent-soft);
    border-color: color-mix(in srgb, var(--color-accent) 45%, transparent);
    color: var(--color-accent);
  }

  .chip input:focus-visible + span {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }

  .library {
    margin-top: var(--space-5);
    padding: 0;
    overflow: hidden;
  }

  .library__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-1) var(--space-5);
    padding: var(--space-4) var(--space-5);
    font-size: var(--text-sm);
  }

  .library__head a {
    font-weight: 600;
  }

  .library__list {
    padding: 0;
    list-style: none;
  }

  .library__list :global([data-technique][hidden]) {
    display: none;
  }

  .empty {
    margin-top: var(--space-4);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .empty[hidden] {
    display: none;
  }

  .quiz-section {
    display: grid;
    gap: var(--space-4) var(--space-6);
    margin-top: var(--space-7);
    scroll-margin-top: var(--space-5);
  }

  .quiz-section__intro {
    margin-top: var(--space-1);
  }

  @media (min-width: 56rem) {
    .quiz-section {
      grid-template-columns: 1fr 1.6fr;
      align-items: start;
    }
  }
</style>
