---
/**
 * The account page's "Data and sync" rows: export / import all data as JSON, send a
 * readable copy to Google (when a Google client is configured), and delete everything.
 * Confirmations are inline.
 */
import ExportDialog from './ExportDialog.astro';
import RowIcon from './RowIcon.astro';
import { ACCOUNTS_ENABLED } from '../config/firebase';
import { GOOGLE_EXPORT_ENABLED } from '../config/google';
import { url } from '../lib/paths';
---

<section class="group data" data-data-tools aria-labelledby="data-heading">
  <h2 id="data-heading" class="group__title">Data and sync</h2>
  <div class="rows">
    {
      ACCOUNTS_ENABLED && (
        <details class="row-more">
          <summary class="row">
            <RowIcon name="cloud" />
            <span class="row__main">
              What's kept in your account<small>Sessions, tasks, chain, settings</small>
            </span>
            <RowIcon chevron />
          </summary>
          <div class="row-more__body data__kept">
            <ul>
              <li>Kept in your account: focus sessions, done list, habit chain, tasks, timer settings, theme and background.</li>
              <li>Stays on each device: the running timer and sound settings.</li>
              <li>Without an account everything is stored in this browser only.</li>
              <li>Anything already here is added to your account when you sign in — nothing is overwritten.</li>
            </ul>
          </div>
        </details>
      )
    }
    <p class="data__warn row-note" data-data-warn hidden>
      This browser isn't saving data (private browsing or blocked storage?). It will be lost when you close the tab —
      export it if you want to keep it.
    </p>
    <button type="button" class="row" data-export>
      <RowIcon name="download" />
      <span class="row__main">Export a backup<small>A file with everything, to keep or move</small></span>
      <RowIcon chevron />
    </button>
    <label class="row data__import">
      <RowIcon name="upload" />
      <span class="row__main">Import a backup<small>Merge a file with your data, or replace it</small></span>
      <RowIcon chevron />
      <input type="file" accept="application/json,.json" class="visually-hidden" data-import />
    </label>
    {
      GOOGLE_EXPORT_ENABLED && (
        <button type="button" class="row" data-export-open>
          <RowIcon name="sheet" />
          <span class="row__main">
            Send to Google…<small>A Sheet with charts, or a Doc report, in your own Drive</small>
          </span>
          <RowIcon chevron />
        </button>
      )
    }

    <div class="data__confirm row-note" data-import-panel hidden>
      <p data-import-summary></p>
      <div class="data__actions">
        <button type="button" class="btn btn--small" data-import-merge>Merge with my data</button>
        <button type="button" class="btn btn--ghost btn--small" data-import-replace>Replace my data</button>
        <button type="button" class="btn btn--ghost btn--small" data-import-cancel>Cancel</button>
      </div>
      <p class="muted data__hint">Merge keeps everything you have and adds what's new. Replace swaps your current data for the file.</p>
    </div>

    <a class="row" href={url('/privacy')}>
      <RowIcon name="shield" />
      <span class="row__main">Privacy</span>
      <RowIcon chevron />
    </a>

    <details class="row-more">
      <summary class="row">
        <RowIcon name="trash" />
        <span class="row__main">Delete all data</span>
        <RowIcon chevron />
      </summary>
      <div class="row-more__body">
        <p class="muted">
          Removes your sessions, done list, tasks, chain and settings from this browser{ACCOUNTS_ENABLED && ' — and from your account, if you are signed in'}.
          Export first if you might want them back.
        </p>
        <div class="data__actions">
          <button type="button" class="btn btn--danger btn--small" data-clear>Delete everything</button>
        </div>
      </div>
    </details>

    <p class="data__status row-note" role="status" data-data-status></p>
  </div>
</section>

{GOOGLE_EXPORT_ENABLED && <ExportDialog />}

<script>
  import {
    applyBackup,
    clearAll,
    getAppearance,
    getTheme,
    isPersistent,
    parseBackup,
    type BackupData,
    chainsOf,
  } from '../lib/storage';
  import { applyAppearance, applyTheme } from '../lib/appearance';
  import { backupSummary, downloadBackup } from '../lib/export/backup';
  import { onPage } from '../lib/page';

  onPage('data-tools', () => {
    document.querySelectorAll<HTMLElement>('[data-data-tools]').forEach((root) => {
      const $ = <E extends Element>(s: string) => root.querySelector<E>(s)!;
      const status = $<HTMLElement>('[data-data-status]');
      const fileInput = $<HTMLInputElement>('[data-import]');
      const panel = $<HTMLElement>('[data-import-panel]');
      const summary = $<HTMLElement>('[data-import-summary]');
      const clearBtn = $<HTMLButtonElement>('[data-clear]');
      let pending: BackupData | null = null;
      let clearArmed = false;

      $<HTMLElement>('[data-data-warn]').hidden = isPersistent();

      const say = (t: string) => (status.textContent = t);

      function applyThemeNow(): void {
        applyTheme(getTheme());
        applyAppearance(getAppearance());
      }

      $<HTMLButtonElement>('[data-export]').addEventListener('click', () => {
        try {
          say(`Exported ${backupSummary(downloadBackup())}.`);
        } catch {
          say('Export failed in this browser.');
        }
      });

      fileInput.addEventListener('change', async () => {
        const file = fileInput.files?.[0];
        fileInput.value = '';
        if (!file) return;
        if (file.size > 5_000_000) {
          say('That file is too large to be an export from this site.');
          return;
        }
        const result = parseBackup(await file.text());
        if (!result.ok) {
          panel.hidden = true;
          say(result.error);
          return;
        }
        pending = result.data;
        const d = result.data;
        const chains = chainsOf(d.chain);
        const chainDays = chains.reduce((n, c) => n + c.days.length, 0);
        const chainText =
          chains.length > 1
            ? ` and ${chains.length} chains (${chainDays} days)`
            : chains.length
              ? ` and a chain for “${chains[0]!.habit}” (${chainDays} days)`
              : '';
        summary.textContent =
          `“${file.name}” contains ${d.sessions.length} focus sessions, ${d.done.filter((x) => x.deletedAt === undefined).length} done items, ` +
          `${d.tasks.items.filter((t) => t.deletedAt === undefined).length} tasks` +
          `${chainText}.` +
          `${result.skipped ? ` ${result.skipped} unreadable ${result.skipped === 1 ? 'entry' : 'entries'} will be skipped.` : ''}`;
        panel.hidden = false;
        say('');
        $<HTMLButtonElement>('[data-import-merge]').focus();
      });

      function finishImport(mode: 'merge' | 'replace'): void {
        if (!pending) return;
        applyBackup(pending, mode);
        if (mode === 'replace') applyThemeNow();
        pending = null;
        panel.hidden = true;
        say(mode === 'merge' ? 'Imported and merged with your data.' : 'Your data was replaced with the file.');
      }

      $<HTMLButtonElement>('[data-import-merge]').addEventListener('click', () => finishImport('merge'));
      $<HTMLButtonElement>('[data-import-replace]').addEventListener('click', () => finishImport('replace'));
      $<HTMLButtonElement>('[data-import-cancel]').addEventListener('click', () => {
        pending = null;
        panel.hidden = true;
        say('Import cancelled.');
      });

      // Two-step delete: the first press asks, the second press deletes.
      clearBtn.addEventListener('click', () => {
        if (!clearArmed) {
          clearArmed = true;
          clearBtn.textContent = 'Yes, delete everything';
          say('Press again to confirm. This cannot be undone.');
          window.setTimeout(() => {
            clearArmed = false;
            clearBtn.textContent = 'Delete everything';
          }, 6000);
          return;
        }
        clearArmed = false;
        clearBtn.textContent = 'Delete everything';
        clearAll();
        applyThemeNow();
        say('All data deleted from this browser.');
      });
    });
  });
</script>

<style>
  .data__kept ul {
    padding-left: var(--space-5);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .data__kept li + li {
    margin-top: var(--space-2);
  }

  .data__warn {
    background: var(--ev-some-bg);
    color: var(--ev-some);
  }

  .data__warn[hidden],
  .data__confirm[hidden] {
    display: none;
  }

  .data__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  .data__import {
    position: relative;
  }

  .data__import:focus-within {
    outline: 3px solid var(--color-focus);
    outline-offset: -3px;
  }

  .data__confirm {
    background: var(--color-surface-2);
  }

  .data__hint {
    margin-top: var(--space-3);
    font-size: var(--text-xs);
  }

  .data__status:empty {
    display: none;
  }
</style>
