---
import AppearanceMenu from './AppearanceMenu.astro';
import SoundMenu from './SoundMenu.astro';
import AccountButton from './AccountButton.astro';
import CoinMark from './CoinMark.astro';
import { NAV, SITE } from '../config/site';
import { url, isActive } from '../lib/paths';

const current = Astro.url.pathname;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href={url('/')} aria-current={isActive(current, '/') ? 'page' : undefined}>
      <CoinMark size={36} />
      <span class="brand__name">{SITE.name}</span>
    </a>

    <nav class="site-nav" aria-label="Main">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a href={url(item.href)} aria-current={isActive(current, item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__tools">
      <SoundMenu />
      <AppearanceMenu />
      <AccountButton />
    </div>
  </div>
</header>

<script>
  import { listen, onPage } from '../lib/page';

  /** Fold below this scroll position, unfold above the lower one: the gap stops flicker as the header changes height. */
  const FOLD_AT = 120;
  const UNFOLD_AT = 40;

  onPage('site-header', () => {
    const header = document.querySelector<HTMLElement>('.site-header');
    if (!header) return;
    const update = () => {
      // An open menu lives in the tools, which folding hides.
      if (header.querySelector('details[open]')) return;
      if (window.scrollY > FOLD_AT) header.classList.add('is-scrolled');
      else if (window.scrollY < UNFOLD_AT) header.classList.remove('is-scrolled');
    };
    update();
    return listen(window, 'scroll', update, { passive: true });
  });
</script>

<style>
  .site-header {
    position: relative;
    z-index: 10;
    border-bottom: 1px solid var(--color-border);
    background: var(--header-bg);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    backdrop-filter: saturate(1.4) blur(14px);
  }

  /* Mobile-first: brand + toggle on row one, nav on row two. */
  .site-header__inner {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'brand toggle'
      'nav nav';
    align-items: center;
    gap: var(--space-2) var(--space-3);
    padding-block: var(--space-3);
  }

  .brand {
    grid-area: brand;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-lg);
    letter-spacing: -0.035em;
    white-space: nowrap;
    text-decoration: none;
    min-height: 44px;
  }

  @media (max-width: 26rem) {
    .brand {
      font-size: var(--text-base);
    }
  }

  .brand:hover {
    color: var(--color-text);
  }

  .brand :global(.coin-mark) {
    filter: drop-shadow(0 6px 6px var(--accent-glow));
  }

  /*
    Small screens: the header follows you down the page. Once scrolled it folds to one
    row, the coin alone and the nav; the tools come back at the top of the page.
  */
  @media (max-width: 51.99rem) {
    .site-header {
      position: sticky;
      top: 0;
    }

    .site-header.is-scrolled .site-header__inner {
      grid-template-columns: auto minmax(0, 1fr);
      grid-template-areas: 'brand nav';
      padding-block: var(--space-1);
    }

    .site-header.is-scrolled .brand__name {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .site-header.is-scrolled .site-header__tools {
      display: none;
    }

    .site-header.is-scrolled .site-nav {
      overflow-x: auto;
      scrollbar-width: none;
    }

    .site-header.is-scrolled .site-nav ul {
      gap: 0;
    }

    .site-header.is-scrolled .site-nav a {
      padding-inline: var(--space-2);
      font-size: var(--text-sm);
    }

    .site-header.is-scrolled .site-nav li:first-child a {
      margin-left: 0;
    }
  }

  .site-nav {
    grid-area: nav;
  }

  .site-nav ul {
    display: flex;
    gap: var(--space-1);
    padding: 0;
    list-style: none;
  }

  .site-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: var(--space-3);
    border-radius: var(--radius-pill);
    color: var(--color-text-muted);
    font-weight: 500;
    text-decoration: none;
    transition: background-color var(--duration-fast) var(--ease-out);
  }

  .site-nav li:first-child a {
    margin-left: calc(-1 * var(--space-3));
  }

  .site-nav a:hover {
    color: var(--color-text);
    background: var(--color-surface-2);
  }

  .site-nav a[aria-current='page'] {
    color: var(--color-accent);
    background: var(--color-accent-soft);
    font-weight: 600;
  }

  .site-header__tools {
    grid-area: toggle;
    display: flex;
    gap: var(--space-2);
  }

  /* One row needs about 960px with the tool labels, so until there's room the tools are icons only. */
  @media (min-width: 52rem) and (max-width: 63.99rem) {
    .site-header__tools :global(.sound__text),
    .site-header__tools :global(.appearance__text),
    .site-header__tools :global(.account-btn__text) {
      display: none;
    }
  }

  /* Wider screens: everything on one row. */
  @media (min-width: 52rem) {
    .site-header__inner {
      grid-template-columns: auto 1fr auto;
      grid-template-areas: 'brand nav toggle';
      gap: var(--space-5);
    }

    .site-nav ul {
      justify-content: flex-end;
    }

    .site-nav li:first-child a {
      margin-left: 0;
    }
  }
</style>
