---
/**
 * Wellbeing spend on /health: a short summary of the Wellbeing category, which lives on
 * the Budget page (src/lib/budget.ts) along with everything else you spend.
 */
import { url } from '../lib/paths';

const budget = url('/budget');
---

<section class="card ws" aria-labelledby="ws-heading" data-ws>
  <div class="ws__head">
    <h2 id="ws-heading" class="panel-title"><i aria-hidden="true"></i>Wellbeing spend</h2>
    <span class="muted" data-ws-month></span>
  </div>
  <p class="ws__total"><strong data-ws-total></strong> <span class="muted" data-ws-of></span></p>
  <div class="ws__meter" data-ws-meter>
    <div class="ws__track well"><i data-ws-fill></i></div>
    <span class="ws__tick" data-ws-tick aria-hidden="true"></span>
  </div>
  <ul class="ws__kinds" role="list" data-ws-kinds></ul>
  <p class="muted ws__note" data-ws-note></p>
  <div class="ws__actions">
    <a class="btn btn--small" href={`${budget}?add=wellbeing`}>
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 5v14M5 12h14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"></path></svg>
      Add wellbeing expense
    </a>
    <a class="ws__link" href={`${budget}?category=wellbeing`}>
      In Budget
      <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </a>
  </div>
</section>

<script>
  import { subscribe } from '../lib/storage';
  import { catchUpRepeats, dueSoon, formatMoney, getBudget, KIND_LABELS, monthOf, paceLine, WELLBEING_KINDS } from '../lib/budget';
  import { dayKey, formatShort, fromDayKey } from '../lib/dates';
  import { cleanups, onPage } from '../lib/page';
  import { el } from '../lib/dom';

  const monthName = new Intl.DateTimeFormat(undefined, { month: 'long' });

  onPage('health-spend-summary', () => {
    const root = document.querySelector<HTMLElement>('[data-ws]');
    if (!root) return;
    const c = cleanups();
    const $ = (s: string) => root.querySelector<HTMLElement>(s)!;

    function render(): void {
      const store = getBudget();
      const today = dayKey(new Date());
      const month = monthOf(today);
      const mine = store.entries.filter((e) => e.category === 'wellbeing' && monthOf(e.day) === month);
      const total = mine.reduce((sum, e) => sum + e.amount, 0);
      const own = store.budgets.wellbeing;
      const money = (n: number) => formatMoney(Math.round(n * 100) / 100, store.currency);

      $('[data-ws-month]').textContent = monthName.format(fromDayKey(today));
      $('[data-ws-total]').textContent = money(total);
      $('[data-ws-of]').textContent = own ? (total <= own ? `of ${money(own)} · ${money(own - total)} left` : `of ${money(own)} · ${money(total - own)} over`) : 'this month';
      $('[data-ws-meter]').hidden = !own;
      if (own) {
        const fill = $('[data-ws-fill]');
        fill.style.width = `${Math.min(100, (total / own) * 100)}%`;
        fill.classList.toggle('is-over', total > own);
        const pace = paceLine(store.repeats, month, own, 'wellbeing').line[fromDayKey(today).getDate() - 1]!;
        $('[data-ws-tick]').style.left = `${Math.min(100, (pace / own) * 100)}%`;
      }

      const byKind = new Map<string, number>();
      for (const e of mine) byKind.set(e.kind ?? '', (byKind.get(e.kind ?? '') ?? 0) + e.amount);
      $('[data-ws-kinds]').replaceChildren(
        ...[...WELLBEING_KINDS, '' as const]
          .filter((k) => byKind.has(k))
          .map((k) => el('li', '', `${k ? KIND_LABELS[k] : 'Other'} ${money(byKind.get(k)!)}`)),
      );

      const next = dueSoon(store.repeats.filter((r) => r.category === 'wellbeing'), 14)[0];
      $('[data-ws-note]').textContent = next
        ? `${next.repeat.what}, ${money(next.repeat.amount)}, is due ${formatShort(fromDayKey(next.day))}.`
        : mine.length
          ? ''
          : 'Nothing logged this month. Gym, therapy, nutrition, medical: what you spend on feeling well.';
      $('[data-ws-note]').hidden = !$('[data-ws-note]').textContent;
    }

    catchUpRepeats();
    render();
    c.add(subscribe('health', render));
    return c.run;
  });
</script>

<style>
  .ws {
    display: grid;
    gap: var(--space-4);
  }

  .ws [hidden] {
    display: none !important;
  }

  .ws__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .ws__head .panel-title {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
  }

  .ws__head i {
    inline-size: 12px;
    block-size: 12px;
    border-radius: 4px;
    background: var(--cat-time);
  }

  .ws__total {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2);
  }

  .ws__total strong {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    line-height: 1;
  }

  .ws__meter {
    position: relative;
  }

  .ws__track {
    block-size: 12px;
    border-radius: var(--radius-pill);
    overflow: hidden;
  }

  .ws__track i {
    display: block;
    block-size: 100%;
    border-radius: inherit;
    background: var(--cat-time);
  }

  .ws__track i.is-over {
    background: var(--color-danger);
  }

  .ws__tick {
    position: absolute;
    top: -4px;
    inline-size: 2px;
    block-size: 20px;
    margin-inline-start: -1px;
    border-radius: 2px;
    background: var(--color-text);
  }

  .ws__kinds {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .ws__kinds :global(li) {
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    background: var(--cat-time-bg);
    color: var(--cat-time);
    font-size: var(--text-xs);
    font-weight: 600;
  }

  .ws__note {
    font-size: var(--text-sm);
  }

  .ws__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
  }

  .ws__link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    min-height: 44px;
    font-weight: 600;
  }
</style>
