---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/paths';
---

<BaseLayout title="Page not found">
  <div class="container">
    <header class="page-header">
      <h1 data-t="notFound.title">That page doesn't exist.</h1>
      <p>
        <span data-t="notFound.try">No harm done. Try the</span>{' '}<a href={url('/techniques')} data-t="notFound.library">technique library</a>{' '}<span
          data-t="notFound.or">or go</span
        >{' '}<a href={url('/')} data-t="notFound.home">home</a>.
      </p>
    </header>
  </div>
</BaseLayout>
