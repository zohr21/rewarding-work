---
/**
 * Joining the weekly board: pick a nickname, see exactly what others will see, join.
 * Opened by any button with [data-board-join-open], or a `board:join` event. Nobody signed in? Joining starts a
 * guest account first. Fires `board:changed` on the document once joined.
 */
import { NATIVE_APP } from '../config/app';
---

<dialog class="board-join" data-board-join aria-labelledby="board-join-title">
  <form class="board-join__sheet" data-board-join-form novalidate>
    <span class="board-join__grip" aria-hidden="true"></span>
    <h2 id="board-join-title" class="board-join__title">Join the weekly board</h2>
    <p class="muted board-join__lead">Pick a name for the board. It doesn't have to be your real one.</p>

    <div class="field">
      <label for="board-nick">Nickname</label>
      <input id="board-nick" class="input" type="text" name="nick" maxlength="20" autocomplete="off" autocapitalize="off" spellcheck="false" required />
    </div>
    <div class="board-join__ideas" data-board-ideas></div>

    <div class="board-join__preview">
      <span class="board-join__label">Others will see</span>
      <div class="board-row board-row--you">
        <span class="board-row__av" data-board-preview-av></span>
        <span class="board-row__name" data-board-preview-name></span>
        <span class="board-row__league" data-board-preview-league></span>
        <span class="board-row__time" data-board-preview-time></span>
      </div>
    </div>

    <ul class="board-join__promises">
      <li>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M3 12c3-5 6-7 9-7s6 2 9 7c-3 5-6 7-9 7s-6-2-9-7z"></path><path d="M3 3l18 18"></path></svg>
        <span>Never shown: your email, tasks, notes, health or budget.</span>
      </li>
      <li>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 22v-8"></path><path d="M12 14c-4 0-6-3-6-6 3 0 6 2 6 6z"></path><path d="M12 12c0-4 2-6 6-6 0 4-2 6-6 6z"></path></svg>
        <span>Up to 4 hours of focus a day counts. Resting is part of growing.</span>
      </li>
      <li>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M4 12a8 8 0 1 0 3-6.2"></path><path d="M4 4v4h4"></path></svg>
        <span>Leave any time in {NATIVE_APP ? 'You' : 'Account'}. Your row is removed.</span>
      </li>
    </ul>

    <p class="account__msg board-join__msg" role="status" data-board-join-msg></p>
    <div class="board-join__go">
      <button type="submit" class="btn" data-board-join-submit>Join</button>
      <button type="button" class="btn btn--ghost" data-board-join-close>Not now</button>
    </div>
  </form>
</dialog>

<script>
  import { getAccount } from '../lib/account/state';
  import { formatMinutes, getBoard, joinBoard, leagueName, myTier, nicknameIdeas, nicknameProblem, weekMinutes } from '../lib/board';
  import { friendlyError } from '../lib/account/errors';
  import { el } from '../lib/dom';
  import { getSessions } from '../lib/storage';
  import { cleanups, listen, onPage } from '../lib/page';

  onPage('board-join', () => {
    const dialog = document.querySelector<HTMLDialogElement>('[data-board-join]');
    if (!dialog) return;
    const c = cleanups();
    const form = dialog.querySelector<HTMLFormElement>('[data-board-join-form]')!;
    const input = form.querySelector<HTMLInputElement>('#board-nick')!;
    const ideas = form.querySelector<HTMLElement>('[data-board-ideas]')!;
    const msg = form.querySelector<HTMLElement>('[data-board-join-msg]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-board-join-submit]')!;
    const av = form.querySelector<HTMLElement>('[data-board-preview-av]')!;
    const name = form.querySelector<HTMLElement>('[data-board-preview-name]')!;

    const preview = () => {
      const nick = input.value.trim() || 'your.name';
      av.textContent = nick.charAt(0).toUpperCase();
      name.textContent = nick;
      submit.textContent = getAccount().user ? `Join as ${nick}` : `Join as a guest: ${nick}`;
    };

    const open = () => {
      const sessions = getSessions();
      form.querySelector<HTMLElement>('[data-board-preview-league]')!.textContent = leagueName(myTier(sessions)).replace(' league', '');
      form.querySelector<HTMLElement>('[data-board-preview-time]')!.textContent = formatMinutes(weekMinutes(sessions));
      const picks = nicknameIdeas();
      input.value = getBoard().name || picks[0]!;
      ideas.replaceChildren(
        ...picks.map((idea) => {
          const b = el('button', 'board-join__idea', idea);
          b.type = 'button';
          b.addEventListener('click', () => {
            input.value = idea;
            preview();
          });
          return b;
        }),
      );
      msg.textContent = '';
      submit.disabled = false;
      preview();
      dialog.showModal();
    };

    c.add(
      listen(document, 'click', (e) => {
        const t = e.target as HTMLElement;
        if (t.closest('[data-board-join-open]')) open();
        else if (t.closest('[data-board-join-close]')) dialog.close();
      }),
    );
    c.add(listen(document, 'board:join', open));
    c.add(listen(input, 'input', preview));
    // Tapping the dimmed page around the sheet closes it.
    c.add(listen(dialog, 'click', (e) => e.target === dialog && dialog.close()));

    c.add(
      listen(form, 'submit', (e) => {
        e.preventDefault();
        const nick = input.value.trim();
        const problem = nicknameProblem(nick);
        if (problem) {
          msg.textContent = problem;
          input.focus();
          return;
        }
        submit.disabled = true;
        msg.textContent = 'Joining…';
        joinBoard(nick)
          .then(() => {
            dialog.close();
            document.dispatchEvent(new CustomEvent('board:changed'));
          })
          .catch((err: unknown) => {
            msg.textContent = boardError(err);
            submit.disabled = false;
          });
      }),
    );
    return c.run;
  });

  /** Rules not published yet show up as permission-denied: say so plainly. */
  function boardError(err: unknown): string {
    const code = (err as { code?: string })?.code;
    if (code === 'permission-denied') return "The board isn't switched on for this project yet.";
    return friendlyError(err);
  }
</script>

<style>
  .board-join {
    inline-size: min(100%, 30rem);
    max-inline-size: 100%;
    margin: auto auto 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-text);
  }

  @media (min-width: 40rem) {
    .board-join {
      margin: auto;
    }
  }

  .board-join::backdrop {
    background: rgb(0 0 0 / 0.6);
  }

  .board-join__sheet {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-5) calc(var(--space-5) + env(safe-area-inset-bottom, 0px));
    border: 1px solid var(--color-border);
    border-bottom: 0;
    border-radius: 26px 26px 0 0;
    background: var(--popover-bg, var(--color-surface-solid));
    box-shadow: 0 -24px 48px -12px rgb(0 0 0 / 0.6);
  }

  @media (min-width: 40rem) {
    .board-join__sheet {
      border-bottom: 1px solid var(--color-border);
      border-radius: 26px;
    }
  }

  .board-join__grip {
    justify-self: center;
    inline-size: 40px;
    block-size: 4px;
    border-radius: 2px;
    background: var(--color-border-strong);
  }

  .board-join__title {
    margin: 0;
    font-size: var(--text-xl);
  }

  .board-join__lead {
    margin: calc(-1 * var(--space-3)) 0 0;
    font-size: var(--text-sm);
  }

  .board-join .field {
    display: grid;
    gap: var(--space-2);
  }

  .board-join label,
  .board-join__label {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .board-join__ideas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: calc(-1 * var(--space-2));
  }

  .board-join__idea {
    min-height: 36px;
    padding: 0 var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface-2);
    color: var(--color-text);
    font: inherit;
    font-size: var(--text-xs);
    cursor: pointer;
  }

  .board-join__preview {
    display: grid;
    gap: var(--space-2);
  }

  .board-join__promises {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .board-join__promises li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
  }

  .board-join__promises svg {
    flex: none;
    margin-top: 1px;
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .board-join__msg:empty {
    display: none;
  }

  .board-join__go {
    display: grid;
    gap: var(--space-1);
  }
</style>
