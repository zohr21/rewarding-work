# Optional: Firebase project for accounts and sync. Copy to .env and fill in.
# Firebase console → Project settings → General → Your apps → Web app → SDK setup and configuration.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=your-project
PUBLIC_FIREBASE_APP_ID=
# Optional: Google OAuth client id for "Send to Google" (a Sheet or Doc in the visitor's Drive).
# See README → Send to Google.
PUBLIC_GOOGLE_CLIENT_ID=
# Optional: Google sign-in inside the Android app. The "Web client ID" from
# Firebase console → Authentication → Sign-in method → Google → Web SDK configuration.
# The app itself must be added to the project too: Project settings → Add app → Android,
# package app.grovyn, with the SHA-1 of the key the APK is signed with.
PUBLIC_FIREBASE_GOOGLE_CLIENT_ID=
# Local testing against `npx firebase-tools emulators:start --only auth,firestore`:
# PUBLIC_FIREBASE_EMULATOR=true
