---
import BaseLayout from '../layouts/BaseLayout.astro';
import BudgetPlan from '../components/BudgetPlan.astro';
import BudgetView from '../components/BudgetView.astro';
import BankImport from '../components/BankImport.astro';
import BudgetLock from '../components/BudgetLock.astro';
import LifeTabs from '../components/LifeTabs.astro';
import { NATIVE_APP } from '../config/app';
---

<BaseLayout title="Budget" titleKey="nav.budget" description="What you spend, against a monthly budget: what is left, your pace, and where it goes.">
  {/* Outside the page the lock covers, so Health stays one tap away while Budget is locked. */}
  {NATIVE_APP && <div class="container"><LifeTabs /></div>}
  <div class="container budget-page">
    <BudgetLock />
    {/* In the app the bottom bar already says Budget: the money comes first. */}
    <header class={NATIVE_APP ? 'visually-hidden' : 'page-header'}>
      <h1 data-t="budget.budget">Budget</h1>
      {!NATIVE_APP && <p data-t="budget.whatIsLeftThisMonth">What is left this month, whether you are on pace, and where it goes.</p>}
    </header>

    {/* The money first: the plan with what is safe to spend and its Add button, then what the bank sent. */}
    <BudgetView>
      <BudgetPlan />
      {NATIVE_APP && <BankImport />}
    </BudgetView>
    <p data-t="budget.yourIncomeGoalsExpensesAnd" class="muted budget__note">
      Your income, goals, expenses and budgets are kept on this device, and in your account when you are signed in. They are not part of the
      backup file yet.
    </p>
  </div>
</BaseLayout>

<style>
  .budget__note {
    margin-top: var(--space-5);
    font-size: var(--text-sm);
  }

</style>
