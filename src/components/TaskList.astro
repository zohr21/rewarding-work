---
/**
 * All your tasks, in lists: Today (a short plan for the day, first up first), Next,
 * and Someday, plus an Inbox of thoughts jotted on the timer's scratchpad to sort.
 * One list shows at a time, picked from a row of tabs.
 * Add, move, break down, start a focus session on, finish, reopen or delete tasks.
 * Focus time comes from timer sessions whose label matched the task.
 */
import { NATIVE_APP } from '../config/app';
import { url } from '../lib/paths';

const timerUrl = url('/timer');
const TABS = [
  { id: 'inbox', label: 'Inbox' },
  { id: 'today', label: 'Today' },
  { id: 'next', label: 'Next' },
  { id: 'someday', label: 'Someday' },
  { id: 'finished', label: 'Done' },
];
---

<section class="card tasks" data-task-list data-timer-url={timerUrl} aria-labelledby="tasks-heading">
  <h2 id="tasks-heading" class="panel-title">Your tasks</h2>

  <div class="tasks__tabs" role="group" aria-label="Lists" data-tl-tabs>
    {
      TABS.map((tab) => (
        <button type="button" data-tl-tab={tab.id} aria-pressed={tab.id === 'today' ? 'true' : 'false'}>
          {tab.label}
          <span class="tasks__tab-count" data-tl-tab-count />
        </button>
      ))
    }
  </div>

  <form class="tasks__form" data-tl-form>
    <label for="tl-new" class="visually-hidden">New task</label>
    <input id="tl-new" class="input" type="text" maxlength="120" autocomplete="off" placeholder="Add a task…" data-tl-input />
    <label for="tl-new-list" class="visually-hidden">Add to</label>
    <select id="tl-new-list" class="input tasks__list-select" data-tl-new-list>
      <option value="today">Today</option>
      <option value="next" selected>Next</option>
      <option value="someday">Someday</option>
    </select>
    <button type="submit" class="btn">Add</button>
  </form>

  <section class="tasks__section tasks__inbox" data-list="inbox" data-tl-inbox-wrap hidden aria-labelledby="tl-inbox-head">
    <h3 class="tasks__heading tasks__heading--inbox" id="tl-inbox-head" data-tl-inbox-head>Inbox</h3>
    <p class="muted tasks__hint">Thoughts you jotted on the timer. Sort each one into a list, add it to a task's notes, or clear it.</p>
    <ul class="tasks__items" data-tl-inbox></ul>
  </section>

  <section class="tasks__section" data-list="today" aria-labelledby="tl-today-head">
    <h3 class="tasks__heading tasks__heading--today" id="tl-today-head" data-tl-today-head>Today</h3>
    <div class="tasks__carry" data-tl-carry hidden>
      <p data-tl-carry-text></p>
      <div class="tasks__carry-actions">
        <button type="button" class="btn btn--small" data-tl-carry-keep>Keep for today</button>
        <button type="button" class="btn btn--ghost btn--small" data-tl-carry-move>Move to Next</button>
      </div>
    </div>
    <ul class="tasks__items" data-tl-today></ul>
    <p class="muted tasks__hint" data-tl-today-hint></p>
  </section>

  <section class="tasks__section" data-list="next" aria-labelledby="tl-next-head">
    <h3 class="tasks__heading tasks__heading--next" id="tl-next-head" data-tl-next-head>Next</h3>
    <ul class="tasks__items" data-tl-next></ul>
    <p class="muted tasks__hint" data-tl-next-empty>Nothing here. Add a task above, or break one down below.</p>
  </section>

  <details class="disclosure tasks__section tasks__someday" data-list="someday" data-tl-someday-wrap hidden>
    <summary class="tasks__heading tasks__heading--someday" data-tl-someday-head>Someday</summary>
    <ul class="tasks__items" data-tl-someday></ul>
  </details>

  <details class="disclosure tasks__finished" data-list="finished" data-tl-finished-wrap hidden>
    <summary data-tl-finished-summary>Finished</summary>
    <ul class="tasks__items" data-tl-finished></ul>
  </details>
  <p class="muted tasks__hint" data-tl-view-empty hidden></p>
  {
    NATIVE_APP && (
      <button type="button" class="btn tasks__fab" data-tl-fab>
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
          <path d="M12 5v14M5 12h14" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" />
        </svg>
        New task
      </button>
    )
  }
  <p class="visually-hidden" aria-live="polite" data-tl-live></p>
</section>

<script>
  import { createTask, deleteTask, getCurrentTask, getSessions, getTasks, setCurrentTask, subscribe, type Task, type TaskList } from '../lib/storage';
  import {
    finishTask,
    focusByTask,
    formatFocus,
    isCarriedOver,
    jotToNotes,
    keepForToday,
    LIST_LABELS,
    listOf,
    moveTask,
    moveToTop,
    reopenTask,
    taskName,
    todayTasks,
    TODAY_SOFT_MAX,
  } from '../lib/tasks';
  import { celebrate } from '../lib/appearance';
  import { ring, segments } from '../lib/charts';
  import { offerUndo } from '../lib/undo';
  import { cleanups, onPage } from '../lib/page';

  const dayFmt = new Intl.DateTimeFormat(undefined, { day: 'numeric', month: 'short' });
  const weekdayFmt = new Intl.DateTimeFormat(undefined, { weekday: 'short' });
  const MOVABLE: TaskList[] = ['today', 'next', 'someday'];
  const X_SVG =
    '<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>';
  const CLOCK_SVG =
    '<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle cx="12" cy="13" r="8" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 9v4l3 2M9 3h6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>';
  const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? '' : 's'}`;
  /** The list the tabs are showing; kept for the visit, so coming back to Tasks lands where you were. */
  let appView = 'today';
  const VIEW_EMPTY: Record<string, string> = {
    inbox: 'Nothing to sort. Thoughts you jot on the timer land here.',
    someday: 'Nothing parked for someday.',
    finished: 'Nothing finished yet. It will show up here when it is.',
  };

  onPage('task-list', () => {
    const c = cleanups();
    document.querySelectorAll<HTMLElement>('[data-task-list]').forEach((root) => {
      const $ = <E extends Element>(s: string) => root.querySelector<E>(s)!;
      const form = $<HTMLFormElement>('[data-tl-form]');
      const input = $<HTMLInputElement>('[data-tl-input]');
      const newList = $<HTMLSelectElement>('[data-tl-new-list]');
      const inboxWrap = $<HTMLElement>('[data-tl-inbox-wrap]');
      const inboxHead = $<HTMLElement>('[data-tl-inbox-head]');
      const inboxList = $<HTMLUListElement>('[data-tl-inbox]');
      const todayHead = $<HTMLElement>('[data-tl-today-head]');
      const todayList = $<HTMLUListElement>('[data-tl-today]');
      const todayHint = $<HTMLElement>('[data-tl-today-hint]');
      const carry = $<HTMLElement>('[data-tl-carry]');
      const carryText = $<HTMLElement>('[data-tl-carry-text]');
      const nextHead = $<HTMLElement>('[data-tl-next-head]');
      const nextList = $<HTMLUListElement>('[data-tl-next]');
      const nextEmpty = $<HTMLElement>('[data-tl-next-empty]');
      const somedayWrap = $<HTMLDetailsElement>('[data-tl-someday-wrap]');
      const somedayHead = $<HTMLElement>('[data-tl-someday-head]');
      const somedayList = $<HTMLUListElement>('[data-tl-someday]');
      const finishedWrap = $<HTMLDetailsElement>('[data-tl-finished-wrap]');
      const finishedSummary = $<HTMLElement>('[data-tl-finished-summary]');
      const finishedList = $<HTMLUListElement>('[data-tl-finished]');
      const live = $<HTMLElement>('[data-tl-live]');
      const timerUrl = root.dataset.timerUrl!;
      const tabs = root.querySelector<HTMLElement>('[data-tl-tabs]');
      const viewEmpty = $<HTMLElement>('[data-tl-view-empty]');
      // Only in the Android app: the steps sheet (tasks.astro).
      const sheet = document.querySelector<HTMLDialogElement>('[data-task-sheet]');

      function showView(view: string): void {
        if (!tabs) return;
        appView = view;
        root.dataset.view = view;
        tabs.querySelectorAll<HTMLElement>('[data-tl-tab]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.tlTab === view)));
        // These two fold away without the tabs; a tab shows its list outright.
        if (view === 'someday') somedayWrap.open = true;
        if (view === 'finished') finishedWrap.open = true;
        if ((MOVABLE as string[]).includes(view)) newList.value = view;
      }

      /** Open the steps sheet on a task, with a way straight into a focus session. */
      function openSheet(task: Task): void {
        if (!sheet) return;
        setCurrentTask(task.id);
        const go = sheet.querySelector<HTMLAnchorElement>('[data-task-sheet-focus]');
        if (go) go.href = `${timerUrl}?task=${encodeURIComponent(task.id)}`;
        sheet.showModal();
      }

      /** Deleted tasks still offered for Undo (src/lib/undo.ts). */
      const removing = new Set<string>();

      const announce = (t: string) => {
        live.textContent = '';
        window.setTimeout(() => (live.textContent = t), 50);
      };

      function button(text: string, onClick: () => void, cls = 'btn btn--ghost btn--small'): HTMLButtonElement {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = cls;
        b.textContent = text;
        b.addEventListener('click', onClick);
        return b;
      }

      function iconButton(label: string, onClick: () => void): HTMLButtonElement {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'icon-btn task__remove';
        b.setAttribute('aria-label', label);
        b.title = label.replace(/ “.*”$/, '');
        b.innerHTML = X_SVG;
        b.addEventListener('click', onClick);
        return b;
      }

      /** Title and meta on the left; the list picker and remove button on the right. */
      function head(body: HTMLElement, ...side: HTMLElement[]): HTMLDivElement {
        const row = document.createElement('div');
        row.className = 'task__head';
        const tools = document.createElement('div');
        tools.className = 'task__tools';
        tools.append(...side);
        row.append(body, tools);
        return row;
      }

      function badge(text: string, cls = ''): HTMLSpanElement {
        const b = document.createElement('span');
        b.className = `badge task__badge ${cls}`;
        b.textContent = text;
        return b;
      }

      /** A list heading: its name, then how many it holds (quieter). */
      function setHead(el: HTMLElement, label: string, count: string): void {
        el.replaceChildren(label);
        if (!count) return;
        const c = document.createElement('span');
        c.className = 'tasks__count';
        c.textContent = ` · ${count}`;
        el.append(c);
      }

      /** Focus time as a bar, relative to the open task with the most. */
      function focusBar(seconds: number, max: number): HTMLDivElement {
        const row = document.createElement('div');
        row.className = 'task__focus';
        row.setAttribute('aria-hidden', 'true');
        row.innerHTML = CLOCK_SVG;
        const meter = document.createElement('span');
        meter.className = 'task__meter';
        const fill = document.createElement('span');
        fill.style.inlineSize = `${Math.max(6, Math.round((seconds / max) * 100))}%`;
        meter.append(fill);
        row.append(meter);
        return row;
      }

      /** Delete with Undo (src/lib/undo.ts): hidden now, removed for real once the offer ends. */
      function remove(task: Task, verb: string, extra = ''): void {
        const name = taskName(task);
        input.focus();
        removing.add(task.id);
        render();
        offerUndo({
          message: `${verb} “${name}”`,
          commit: () => {
            deleteTask(task.id);
            removing.delete(task.id);
          },
          undo: () => {
            removing.delete(task.id);
            render();
            announce(`Restored: ${name}`);
          },
        });
        announce(`${verb}: ${name}. Press Undo to bring it back.${extra}`);
      }

      function moveSelect(task: Task): HTMLSelectElement {
        const name = taskName(task);
        const sel = document.createElement('select');
        sel.className = 'input tasks__list-select';
        sel.setAttribute('aria-label', `List for “${name}”`);
        for (const list of MOVABLE) {
          const o = document.createElement('option');
          o.value = list;
          o.textContent = LIST_LABELS[list];
          o.selected = listOf(task) === list;
          sel.append(o);
        }
        sel.addEventListener('change', () => {
          const list = sel.value as TaskList;
          moveTask(task.id, list);
          announce(`Moved “${name}” to ${LIST_LABELS[list]}.`);
          if (list === 'someday') somedayWrap.open = true;
        });
        return sel;
      }

      /** An Inbox thought: sort it into a list, file it in the current task's notes, or clear it. */
      function renderJot(task: Task, current: Task | null): HTMLLIElement {
        const li = document.createElement('li');
        li.className = 'task task--jot';
        const body = document.createElement('div');
        body.className = 'task__body';
        const title = document.createElement('p');
        title.className = 'task__title';
        title.textContent = task.title;
        const meta = document.createElement('p');
        meta.className = 'task__meta muted';
        meta.textContent = `jotted ${dayFmt.format(task.createdAt)}`;
        body.append(title, meta);

        const actions = document.createElement('div');
        actions.className = 'task__actions';
        for (const list of MOVABLE) {
          const b = button(LIST_LABELS[list], () => {
            moveTask(task.id, list);
            announce(`“${task.title}” is now a task on ${LIST_LABELS[list]}.`);
          });
          b.setAttribute('aria-label', `Make “${task.title}” a task on ${LIST_LABELS[list]}`);
          actions.append(b);
        }
        if (current && current.status === 'active' && current.id !== task.id) {
          const b = button('To notes', () => {
            jotToNotes(task.id, current.id);
            announce(`Added to the notes of “${taskName(current)}”.`);
          });
          b.setAttribute('aria-label', `Add “${task.title}” to the notes of “${taskName(current)}”`);
          b.title = `Add to the notes of “${taskName(current)}”`;
          actions.append(b);
        }
        const clear = iconButton(`Clear “${task.title}”`, () => remove(task, 'Cleared'));
        li.append(head(body, clear), actions);
        return li;
      }

      function renderTask(task: Task, currentId: string | null, focus: Map<string, number>, maxFocus: number, firstUp = false): HTMLLIElement {
        const li = document.createElement('li');
        li.className = `task${firstUp ? ' task--first' : ''}${task.id === currentId ? ' is-current' : ''}${task.status === 'done' ? ' is-done' : ''}`;
        const name = taskName(task);

        const body = document.createElement('div');
        body.className = 'task__body';
        const title = document.createElement('p');
        title.className = 'task__title';
        title.textContent = name;
        if (firstUp) title.append(' ', badge('First up', 'task__badge--first'));
        if (task.id === currentId) title.append(' ', badge('Current'));
        if (task.status === 'active' && isCarriedOver(task)) title.append(' ', badge(`from ${weekdayFmt.format(task.todayAt)}`, 'task__badge--old'));
        const meta = document.createElement('p');
        meta.className = 'task__meta muted';
        const parts: string[] = [];
        const n = task.steps.length;
        const stepsDone = task.steps.filter((s) => s.done).length;
        const active = task.status === 'active';
        if (n) parts.push(`${stepsDone} of ${plural(n, 'step')}`);
        else if (active) parts.push('No steps yet');
        const seconds = focus.get(task.id) ?? 0;
        if (seconds >= 60) parts.push(`${formatFocus(seconds)} focused`);
        parts.push(task.status === 'done' && task.doneAt ? `finished ${dayFmt.format(task.doneAt)}` : `added ${dayFmt.format(task.createdAt)}`);
        meta.textContent = parts.join(' · ');
        body.append(title, meta);

        const actions = document.createElement('div');
        actions.className = 'task__actions';
        if (active) {
          if (sheet) {
            const steps = button('Steps', () => openSheet(task));
            steps.setAttribute('aria-label', `Steps and notes for “${name}”`);
            actions.append(steps);
          } else if (task.id !== currentId) {
            actions.append(
              button('Break down', () => {
                setCurrentTask(task.id);
                announce(`Showing “${name}” in the breakdown below.`);
                document.querySelector<HTMLInputElement>('[data-bd-step]')?.focus();
              }),
            );
          }
          if (listOf(task) === 'today' && !firstUp) {
            actions.append(
              button('Do first', () => {
                moveToTop(task.id, getTasks());
                announce(`“${name}” is first up today.`);
              }),
            );
          }
          const focusLink = document.createElement('a');
          focusLink.className = 'btn btn--ghost btn--small task__go';
          focusLink.href = `${timerUrl}?task=${encodeURIComponent(task.id)}`;
          focusLink.textContent = 'Focus';
          focusLink.setAttribute('aria-label', `Start a focus session on “${name}”`);
          actions.append(
            focusLink,
            button('Done', () => {
              finishTask(task.id);
              celebrate();
              announce(`Finished: ${name}`);
            }),
          );
        } else {
          actions.append(
            button('Reopen', () => {
              reopenTask(task.id);
              announce(`Reopened: ${name}`);
            }),
          );
        }
        const del = iconButton(`Delete “${name}”`, () => remove(task, 'Deleted', ' Its focus sessions and Done entries stay in your history.'));
        const side = active ? [moveSelect(task), del] : [del];

        // The same numbers as the meta line, drawn: a ring, a segment per step, a focus bar.
        const graphs = document.createElement('div');
        graphs.className = 'task__graphs';
        if (active && n) graphs.append(segments(task.steps));
        if (active && seconds >= 60) graphs.append(focusBar(seconds, maxFocus));

        li.append(active ? ring(stepsDone, n, listOf(task) === 'today' ? 56 : 44) : ring(1, 1, 32), head(body, ...side));
        if (graphs.childElementCount) li.append(graphs);
        li.append(actions);
        return li;
      }

      function render(): void {
        const tasks = getTasks().filter((t) => !removing.has(t.id));
        const current = getCurrentTask();
        const currentId = current?.id ?? null;
        const focus = focusByTask(getSessions());
        const open = tasks.filter((t) => t.status === 'active');
        const on = (list: TaskList) => open.filter((t) => listOf(t) === list);
        const finished = tasks.filter((t) => t.status === 'done').sort((a, b) => (b.doneAt ?? 0) - (a.doneAt ?? 0));
        const maxFocus = Math.max(1, ...open.map((t) => focus.get(t.id) ?? 0));

        const inbox = on('inbox').sort((a, b) => a.createdAt - b.createdAt);
        inboxWrap.hidden = inbox.length === 0;
        setHead(inboxHead, 'Inbox', `${inbox.length} to sort`);
        inboxList.replaceChildren(...inbox.map((t) => renderJot(t, current)));

        const today = todayTasks(open);
        setHead(todayHead, 'Today', today.length ? plural(today.length, 'task') : '');
        todayList.replaceChildren(...today.map((t, i) => renderTask(t, currentId, focus, maxFocus, i === 0)));
        todayHint.hidden = today.length > 0 && today.length <= TODAY_SOFT_MAX;
        todayHint.textContent = today.length
          ? `That's ${today.length} for today. A short list is easier to finish — consider moving some to Next.`
          : "Nothing planned yet. Pick 1–3 tasks for today, and put the one you'd most like to put off first.";
        const carried = today.filter((t) => isCarriedOver(t));
        carry.hidden = carried.length === 0;
        carryText.textContent = `${carried.length === 1 ? '1 task was' : `${carried.length} tasks were`} planned for an earlier day. Still for today?`;

        const next = on('next');
        setHead(nextHead, 'Next', next.length ? plural(next.length, 'task') : '');
        nextList.replaceChildren(...next.map((t) => renderTask(t, currentId, focus, maxFocus)));
        nextEmpty.hidden = next.length > 0;

        const someday = on('someday');
        somedayWrap.hidden = someday.length === 0;
        setHead(somedayHead, 'Someday', plural(someday.length, 'task'));
        somedayList.replaceChildren(...someday.map((t) => renderTask(t, currentId, focus, maxFocus)));

        finishedWrap.hidden = finished.length === 0;
        const finishedFocus = finished.reduce((sum, t) => sum + (focus.get(t.id) ?? 0), 0);
        setHead(finishedSummary, 'Finished', plural(finished.length, 'task') + (finishedFocus >= 60 ? `, ${formatFocus(finishedFocus)} of focus` : ''));
        finishedList.replaceChildren(...finished.map((t) => renderTask(t, currentId, focus, maxFocus)));

        if (tabs) {
          const counts: Record<string, number> = { inbox: inbox.length, today: today.length, next: next.length, someday: someday.length, finished: finished.length };
          tabs.querySelectorAll<HTMLElement>('[data-tl-tab]').forEach((b) => {
            const id = b.dataset.tlTab!;
            const n = counts[id] ?? 0;
            // The Inbox tab is only there while there is something to sort.
            if (id === 'inbox') b.hidden = n === 0;
            b.querySelector('[data-tl-tab-count]')!.textContent = n && id !== 'finished' ? String(n) : '';
          });
          if (appView === 'inbox' && !inbox.length) showView('today');
          const message = counts[appView] ? undefined : VIEW_EMPTY[appView];
          viewEmpty.hidden = !message;
          viewEmpty.textContent = message ?? '';
        }
      }

      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const text = input.value.trim();
        if (!text) return;
        // Becomes the current task only if the breakdown has nothing open to show.
        const current = getCurrentTask();
        const list = newList.value as TaskList;
        createTask(text, { makeCurrent: !current || current.status === 'done', list });
        input.value = '';
        input.focus();
        announce(`Added to ${LIST_LABELS[list]}: ${text}`);
      });

      // Carried over from an earlier day: keep them (in the same order) or move them on.
      $<HTMLButtonElement>('[data-tl-carry-keep]').addEventListener('click', () => {
        keepForToday(getTasks());
        announce('Kept on Today.');
      });
      $<HTMLButtonElement>('[data-tl-carry-move]').addEventListener('click', () => {
        const carried = todayTasks(getTasks()).filter((t) => isCarriedOver(t));
        carried.forEach((t) => moveTask(t.id, 'next'));
        announce(`Moved ${carried.length} to Next.`);
      });

      if (tabs) {
        const onTab = (e: Event) => {
          const tab = (e.target as HTMLElement).closest<HTMLElement>('[data-tl-tab]');
          if (!tab) return;
          showView(tab.dataset.tlTab!);
          render();
        };
        tabs.addEventListener('click', onTab);
        // New task: back to the form, on a list a task can be added to.
        root.querySelector<HTMLElement>('[data-tl-fab]')?.addEventListener('click', () => {
          if (!(MOVABLE as string[]).includes(appView)) {
            showView('today');
            render();
          }
          input.scrollIntoView({ block: 'center' });
          input.focus();
        });
        showView(appView);
      }
      if (sheet) {
        // Close from its button, or by tapping the dimmed page behind it.
        const onSheetClick = (e: Event) => {
          const el = e.target as HTMLElement;
          if (el === sheet || el.closest('[data-task-sheet-close], [data-task-sheet-focus]')) sheet.close();
        };
        sheet.addEventListener('click', onSheetClick);
        c.add(() => sheet.removeEventListener('click', onSheetClick));
      }

      // Rings fill once on arrival (global.css); later re-renders show the new state at once.
      root.classList.add('is-entering');
      const entered = window.setTimeout(() => root.classList.remove('is-entering'), 700);
      c.add(() => window.clearTimeout(entered));

      render();
      c.add(subscribe('tasks', render));
      c.add(subscribe('sessions', render));
    });
    return c.run;
  });
</script>

<style>
  .tasks__form {
    display: flex;
    gap: var(--space-2);
  }

  .tasks__form .input {
    flex: 1;
    min-width: 0;
  }

  .tasks__items {
    display: grid;
