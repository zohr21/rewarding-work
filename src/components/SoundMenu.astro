---
/**
 * Sound menu: background sounds generated in the browser (rain, waves, noise, calm
 * music …) or a YouTube link. Playback lives in src/lib/sound/player.ts and carries
 * on across page navigations; this is only the UI.
 */
import type { SoundId } from '../lib/storage';

const GROUPS: { title: string; items: { value: SoundId; label: string }[] }[] = [
  {
    title: 'Nature',
    items: [
      { value: 'rain', label: 'Rain' },
      { value: 'waves', label: 'Ocean waves' },
      { value: 'wind', label: 'Wind' },
      { value: 'fire', label: 'Fireplace' },
    ],
  },
  {
    title: 'Noise',
    items: [
      { value: 'brown', label: 'Brown noise' },
      { value: 'pink', label: 'Pink noise' },
    ],
  },
  {
    title: 'Calm music',
    items: [
      { value: 'pads', label: 'Soft pads' },
      { value: 'piano', label: 'Gentle piano' },
    ],
  },
];
// 24px line icons for the sound tiles (stroke = currentColor).
const ICONS: Record<SoundId, string> = {
  rain: 'M7 14a4 4 0 0 1-.5-8 5.5 5.5 0 0 1 10.6 1.2A3.5 3.5 0 0 1 17 14zM8 18l-1 2M12 18l-1 2M16 18l-1 2',
  waves: 'M2 9c2.5-2 4.5-2 7 0s4.5 2 7 0 4.5-2 6 0M2 15c2.5-2 4.5-2 7 0s4.5 2 7 0 4.5-2 6 0',
  wind: 'M3 8h10a3 3 0 1 0-3-3M3 12h15a3 3 0 1 1-3 3M3 16h7',
  fire: 'M12 3c1 4 5 5.5 5 10a5 5 0 0 1-10 0c0-2.5 1.5-4 2.5-5.5.5 1.5 1.5 2.5 2.5 3 0-3-.5-5.5 0-7.5z',
  brown: 'M3 12h2l2-5 3 10 3-12 3 9 2-4h3',
  pink: 'M3 12h3l1.5-3 3 6 3-7 3 6 1.5-2H21',
  pads: 'M9 18V6l10-2v12M9 18a3 3 0 1 1-6 0 3 3 0 0 1 6 0zM19 16a3 3 0 1 1-6 0 3 3 0 0 1 6 0z',
  piano: 'M4 5h16v14H4zM9 5v8M15 5v8M12 13v6M7.5 13h3M13.5 13h3',
};

const NAMES: Record<string, string> = Object.fromEntries(GROUPS.flatMap((g) => g.items.map((i) => [i.value, i.label])));
NAMES.youtube = 'YouTube';
---

<details class="sound" data-sound-menu data-names={JSON.stringify(NAMES)}>
  <summary class="sound__button tool-btn" aria-label="Background sound">
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
      <path
        d="M4 14v-2a8 8 0 0 1 16 0v2"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"></path>
      <rect x="3" y="13.5" width="4.5" height="7" rx="1.6" fill="none" stroke="currentColor" stroke-width="1.8"></rect>
      <rect x="16.5" y="13.5" width="4.5" height="7" rx="1.6" fill="none" stroke="currentColor" stroke-width="1.8"></rect>
    </svg>
    <span class="sound__text">Sound</span>
    <span class="sound__eq" aria-hidden="true"><i></i><i></i><i></i></span>
  </summary>

  <div class="sound__panel">
    <div class="sound__now">
      <button type="button" class="sound__play" data-sound-toggle aria-pressed="false">
        <svg class="icon-play" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" fill="currentColor"></path></svg>
        <svg class="icon-pause" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"
          ><rect x="6.5" y="5.5" width="4" height="13" rx="1" fill="currentColor"></rect><rect x="13.5" y="5.5" width="4" height="13" rx="1" fill="currentColor"
          ></rect></svg
        >
        <span class="visually-hidden" data-sound-toggle-label>Play</span>
      </button>
      <div class="sound__meta">
        <p class="sound__name" data-sound-name>Rain</p>
        <p class="sound__status" data-sound-status>Paused</p>
      </div>
    </div>

    <label class="sound__volume">
      <span>Volume</span>
      <input type="range" min="0" max="100" step="1" value="50" data-sound-volume />
    </label>

    {
      GROUPS.map((g) => (
        <fieldset>
          <legend>{g.title}</legend>
          <div class="sound__options">
            {g.items.map((i) => (
              <label class="sound__option">
                <input type="radio" name="rw-sound" value={i.value} />
                <span>
                  <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
                    <path d={ICONS[i.value]} fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  {i.label}
                </span>
              </label>
            ))}
          </div>
        </fieldset>
      ))
    }

    <fieldset>
      <legend>YouTube</legend>
      <form class="sound__yt" data-yt-form novalidate>
        <label class="visually-hidden" for="rw-yt-link">YouTube link</label>
        <input id="rw-yt-link" class="input" type="url" inputmode="url" placeholder="Paste a video or playlist link" data-yt-input />
        <button type="submit" class="btn btn--small">Play</button>
      </form>
      <p class="sound__error" data-yt-error role="alert" hidden>That doesn't look like a YouTube video or playlist link.</p>
      <p class="sound__note">Plays in a small player in the corner — YouTube requires the video to stay visible. Needs an internet connection.</p>
    </fieldset>

    <p class="sound__note">Everything above YouTube is generated in your browser and works offline. Sound keeps playing as you move between pages.</p>
    <p class="visually-hidden" aria-live="polite" data-sound-live></p>
  </div>
</details>

<script>
  import { getSoundPrefs, subscribe, type SoundId } from '../lib/storage';
  import { onPlayerChange, play, playYouTube, setVolume, toggle } from '../lib/sound/player';
  import { cleanups, listen, onPage } from '../lib/page';

  onPage('sound', () => {
    const c = cleanups();
    document.querySelectorAll<HTMLDetailsElement>('[data-sound-menu]').forEach((menu) => {
      const q = <E extends Element>(s: string) => menu.querySelector<E>(s)!;
      const names = JSON.parse(menu.dataset.names ?? '{}') as Record<string, string>;
      const toggleBtn = q<HTMLButtonElement>('[data-sound-toggle]');
      const toggleLabel = q<HTMLElement>('[data-sound-toggle-label]');
      const nameEl = q<HTMLElement>('[data-sound-name]');
      const status = q<HTMLElement>('[data-sound-status]');
      const volume = q<HTMLInputElement>('[data-sound-volume]');
      const ytForm = q<HTMLFormElement>('[data-yt-form]');
      const ytInput = q<HTMLInputElement>('[data-yt-input]');
      const ytError = q<HTMLElement>('[data-yt-error]');
      const live = q<HTMLElement>('[data-sound-live]');
      let lastAnnounced = '';

      function render(playing: boolean): void {
        const prefs = getSoundPrefs();
        const name = names[prefs.source] ?? prefs.source;
        menu.classList.toggle('is-playing', playing);
        toggleBtn.setAttribute('aria-pressed', String(playing));
        toggleLabel.textContent = playing ? `Pause ${name}` : `Play ${name}`;
        nameEl.textContent = name;
        status.textContent = playing ? 'Playing' : 'Paused';
        if (document.activeElement !== volume) volume.value = String(Math.round(prefs.volume * 100));
        if (document.activeElement !== ytInput) ytInput.value = prefs.youtube;
        menu.querySelectorAll<HTMLInputElement>('input[name="rw-sound"]').forEach((i) => (i.checked = i.value === prefs.source));
        const text = `${name}: ${playing ? 'playing' : 'paused'}`;
        if (menu.open && text !== lastAnnounced) live.textContent = text;
        lastAnnounced = text;
      }

      toggleBtn.addEventListener('click', () => {
        if (getSoundPrefs().source === 'youtube' && !getSoundPrefs().youtube) {
          ytInput.focus();
          return;
        }
        toggle();
      });

      // click, not change: picking the sound that's already selected should still start it.
      // (Arrow keys in a radio group fire click too.)
      menu.addEventListener('click', (e) => {
        const input = e.target as HTMLInputElement;
        if (input.name === 'rw-sound') play(input.value as SoundId);
      });

      volume.addEventListener('input', () => setVolume(Number(volume.value) / 100));

      ytForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const ok = playYouTube(ytInput.value);
        ytError.hidden = ok;
        if (ok) menu.open = false; // so the player in the corner isn't covered
      });
      ytInput.addEventListener('input', () => (ytError.hidden = true));

      // Close on Escape (return focus to the button) and on outside click.
      menu.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && menu.open) {
          menu.open = false;
          q<HTMLElement>('summary').focus();
        }
      });
      c.add(
        listen(document, 'click', (e) => {
          if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
        }),
      );

      let playing = false;
      c.add(
        onPlayerChange((s) => {
          playing = s.playing;
          render(playing);
        }),
      );
      c.add(subscribe('sound', () => render(playing)));
    });
    return c.run;
  });
</script>

<style>
  .sound {
    position: relative;
  }

  /* Base look: .tool-btn (global.css). While playing it glows with the accent. */
  .sound.is-playing .sound__button {
    color: var(--color-accent);
    border-color: color-mix(in srgb, var(--color-accent) 55%, transparent);
    box-shadow:
      inset 0 1px 0 var(--raised-hl),
      0 4px 0 var(--edge),
      0 0 18px -4px var(--accent-glow);
  }

  .sound.is-playing[open] .sound__button {
    box-shadow:
      inset 0 1px 0 var(--raised-hl),
      inset 0 0 0 1px color-mix(in srgb, var(--color-accent) 55%, transparent),
      0 1px 0 var(--edge);
  }

  /* Three little equaliser bars, shown while playing. */
  .sound__eq {
    display: none;
    align-items: flex-end;
    gap: 2px;
    height: 12px;
  }

  .sound.is-playing .sound__eq {
    display: inline-flex;
  }

  .sound__eq i {
    width: 3px;
    height: 100%;
    border-radius: 1px;
    background: currentColor;
    transform-origin: bottom;
    animation: eq 1.1s ease-in-out infinite alternate;
  }

  .sound__eq i:nth-child(2) {
    animation-delay: -0.4s;
  }

  .sound__eq i:nth-child(3) {
    animation-delay: -0.8s;
  }

  @keyframes eq {
    from { transform: scaleY(0.3); }
    to { transform: scaleY(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .sound__eq i {
      animation: none;
      transform: scaleY(0.7);
    }
  }

  .sound__panel {
    position: absolute;
    right: 0;
    top: calc(100% + var(--space-2));
    z-index: 50;
    width: min(23rem, calc(100vw - 2rem));
    max-height: calc(100vh - 6rem);
    overflow-y: auto;
    display: grid;
    gap: var(--space-4);
    padding: var(--space-5);
    background: var(--popover-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--popover-shadow);
    animation: panel-in var(--duration-base) var(--ease-out);
  }

  @keyframes panel-in {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: none; }
  }

  .sound__now {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .sound__play {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    border: 0;
    border-radius: 50%;
    background: var(--accent-grad);
    color: var(--color-on-accent);
    cursor: pointer;
    box-shadow:
      inset 0 2px 0 rgb(255 255 255 / 0.45),
      0 4px 0 var(--accent-edge),
      0 10px 18px -8px var(--accent-glow);
    transition: transform var(--duration-fast) var(--ease-out), box-shadow var(--duration-fast) var(--ease-out);
  }

  .sound__play:hover {
    filter: brightness(1.05);
  }

  .sound__play:active {
    transform: translateY(4px);
    box-shadow: inset 0 2px 0 rgb(255 255 255 / 0.3), 0 0 0 var(--accent-edge);
  }

  .sound__play:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }

  .sound__play .icon-pause,
  .sound.is-playing .sound__play .icon-play {
    display: none;
  }

  .sound.is-playing .sound__play .icon-pause {
    display: block;
  }

  .sound__name {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
  }

  .sound__status {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .sound__volume {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-sm);
  }

  .sound__volume input {
    width: 100%;
    min-height: 32px;
    accent-color: var(--color-accent);
  }

  fieldset {
    border: 0;
    padding: 0;
    margin: 0;
    min-width: 0;
  }

  legend {
    padding: 0;
    margin-bottom: var(--space-2);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
  }

  .sound__options {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-2);
  }

  .sound__option {
    position: relative;
    cursor: pointer;
  }

  .sound__option input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }

  /* Tactile tiles: raised when off, lit and green when chosen. */
  .sound__option span {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 72px;
    padding: var(--space-2) 2px;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    background: var(--raised-grad);
    box-shadow:
      inset 0 1px 0 var(--raised-hl),
      0 4px 0 var(--edge);
    font-size: var(--text-xs);
    line-height: 1.2;
    text-align: center;
    color: var(--color-text-muted);
    transition:
      transform var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }

  .sound__option:hover span {
    border-color: var(--color-border-strong);
    color: var(--color-text);
  }

  .sound__option:active span {
    transform: translateY(3px);
    box-shadow:
      inset 0 1px 0 var(--raised-hl),
      0 1px 0 var(--edge);
  }

  .sound__option input:checked + span {
    border-color: transparent;
    background: var(--accent-grad);
    color: var(--color-on-accent);
    font-weight: 600;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.45),
      0 4px 0 var(--accent-edge),
      0 10px 18px -8px var(--accent-glow);
  }

  .sound__option input:focus-visible + span {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }

  .sound__yt {
    display: flex;
    gap: var(--space-2);
  }

  .sound__yt .input {
    min-width: 0;
    font-size: var(--text-sm);
  }

  .sound__error {
    margin-top: var(--space-2);
    font-size: var(--text-xs);
    color: #b3261e;
  }

  :global(:root[data-theme='dark']) .sound__error {
    color: #ffb4ab;
  }

  .sound__error[hidden] {
    display: none;
  }

  .sound__note {
    margin-top: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  /* Phones: the button isn't at the screen edge, so anchor the panel to the header
     (the nearest positioned ancestor) instead, and drop the label to save room. */
  @media (max-width: 40rem) {
    .sound {
      position: static;
    }

    .sound__panel {
      right: var(--gutter);
    }
  }

  @media (max-width: 28rem) {
    .sound__text {
      display: none;
    }
  }

  /* The floating YouTube player. It is attached outside <body> at runtime, so these
     styles are global. YouTube's minimum player size is 200 × 200 px. */
  :global(.sound-dock) {
    position: fixed;
    right: var(--space-4);
    bottom: var(--space-4);
    z-index: 60;
    width: min(320px, calc(100vw - 2 * var(--space-4)));
    overflow: hidden;
    background: var(--color-surface-solid);
    color: var(--color-text);
    font-family: var(--font-sans, system-ui, sans-serif);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: 0 12px 32px rgb(0 0 0 / 0.18);
  }

  :global(.sound-dock__bar) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-1) var(--space-1) var(--space-1) var(--space-3);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  :global(.sound-dock__close) {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  :global(.sound-dock__close:hover) {
    background: var(--color-surface-2);
    color: var(--color-text);
  }

  :global(.sound-dock__close:focus-visible) {
    outline: 3px solid var(--color-focus);
    outline-offset: 1px;
  }

  :global(.sound-dock iframe) {
    display: block;
    width: 100%;
    height: 200px;
    border: 0;
  }
</style>
