---
/**
 * Header link to /account: "Sign in", or your initial with a small sync dot.
 * Also starts the account code on every page (it only downloads Firebase when
 * someone is signed in on this device). When accounts aren't configured it still
 * leads to the page, for its data tools and preferences.
 */
import { ACCOUNTS_ENABLED } from '../config/firebase';
import { url, isActive } from '../lib/paths';

const current = Astro.url.pathname;
---

<a
  class="account-btn tool-btn"
  href={url('/account')}
  data-account-btn={ACCOUNTS_ENABLED ? '' : undefined}
  data-state="signed-out"
  aria-label={ACCOUNTS_ENABLED ? undefined : 'Settings and your data'}
  aria-current={isActive(current, '/account') ? 'page' : undefined}
>
  <span class="account-btn__avatar" aria-hidden="true" data-account-avatar>
    <svg viewBox="0 0 24 24" width="20" height="20">
      <circle cx="12" cy="8.5" r="3.8" fill="none" stroke="currentColor" stroke-width="1.8"></circle>
      <path d="M4.5 20a7.5 7.5 0 0 1 15 0" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
    </svg>
  </span>
  <span class="account-btn__text" data-account-label data-t={ACCOUNTS_ENABLED ? 'you.signIn' : 'you.settings'}>
    {ACCOUNTS_ENABLED ? 'Sign in' : 'Settings'}
  </span>
  <span class="account-btn__dot" aria-hidden="true"></span>
</a>

<script>
  import { t, type Key } from '../lib/i18n';
  import { onAccountChange, startAccount, type AccountState } from '../lib/account/state';
  import { startBoard } from '../lib/board';
  import { BOARD_ENABLED } from '../config/firebase';
  import { onPage } from '../lib/page';

  const SYNC_TEXT: Record<AccountState['sync'], string> = {
    idle: '',
    saving: 'you.syncShort.saving',
    synced: 'you.syncShort.synced',
    offline: 'you.syncShort.offline',
    error: 'you.syncShort.error',
  };

  onPage('account-button', () => {
    startAccount();
    // The Play version has no board, so a `board` store synced from another device sends nothing.
    if (BOARD_ENABLED) startBoard();
    const btn = document.querySelector<HTMLAnchorElement>('[data-account-btn]');
    if (!btn) return;
    const label = btn.querySelector<HTMLElement>('[data-account-label]')!;
    const avatar = btn.querySelector<HTMLElement>('[data-account-avatar]')!;
    const icon = avatar.innerHTML;

    return onAccountChange((s) => {
      const u = s.user;
      btn.dataset.state = u ? 'signed-in' : 'signed-out';
      btn.dataset.sync = s.sync;
      if (!u) {
        label.textContent = t('you.signIn');
        avatar.innerHTML = icon;
        btn.setAttribute('aria-label', t('you.signInOrCreate'));
        return;
      }
      const who = u.isAnonymous ? t('you.guestBadge') : (u.name ?? u.email ?? t('you.account'));
      label.textContent = u.isAnonymous ? t('you.guestBadge') : t('you.account');
      if (u.isAnonymous) avatar.innerHTML = icon;
      else avatar.textContent = who.trim().charAt(0).toUpperCase();
      const sync = SYNC_TEXT[s.sync] ? t(SYNC_TEXT[s.sync] as Key) : '';
      btn.setAttribute('aria-label', t('you.accountWho', { who }) + (sync ? ` (${sync})` : ''));
    });
  });
</script>

<style>
  .account-btn {
    position: relative;
    text-decoration: none;
  }

  .account-btn:hover,
  .account-btn[aria-current='page'] {
    color: var(--color-text);
  }

  .account-btn__avatar {
    display: inline-grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    font-weight: 700;
    font-size: var(--text-xs);
  }

  .account-btn[data-state='signed-in'] .account-btn__avatar {
    background: var(--color-accent-soft);
    color: var(--color-accent);
  }

  /* Sync dot: green when synced, amber while saving/offline, red on a problem. */
  .account-btn__dot {
    display: none;
    position: absolute;
    top: 6px;
    left: 26px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    border: 2px solid var(--color-surface-solid);
    background: var(--color-accent);
  }

  .account-btn[data-state='signed-in'] .account-btn__dot {
    display: block;
  }

  .account-btn[data-sync='saving'] .account-btn__dot,
  .account-btn[data-sync='offline'] .account-btn__dot {
    background: #c28a00;
  }

  .account-btn[data-sync='error'] .account-btn__dot {
    background: #b3261e;
  }

  @media (max-width: 30rem) {
    .account-btn__text {
      display: none;
    }
  }
</style>
