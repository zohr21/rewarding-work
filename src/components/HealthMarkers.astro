---
/**
 * Body markers on /health: the four body tracks (BODY_TRACKS in src/lib/rewards.ts), each with
 * its tier, a bar to the next one and what is left, plus "What counts" in plain words.
 * The same tiers show on the Grove with their ladders; this is the glance from Health.
 * It sits in a sheet; its tile on HealthToday shows the gist (`data-hm-hint`).
 * Hidden until something has counted, so a new Health page isn't four rows of "not yet".
 */
import { url } from '../lib/paths';
---

<section class="card markers" aria-labelledby="markers-heading" data-health-markers hidden>
  <div class="markers__head">
    <h2 data-t="health.bodyMarkers" id="markers-heading" class="panel-title">Body markers</h2>
    <a data-t="health.inYourGrove" class="markers__all" href={`${url('/progress')}#tiers`}>In your grove</a>
  </div>
  <p data-t="health.daysYouLookedAfterYourself" class="muted markers__lead">Days you looked after yourself, not how hard you pushed.</p>
  <span data-hm-hint hidden></span>
  <ul class="markers__list" role="list" data-hm-list></ul>
  <details class="markers__about">
    <summary data-t="health.whatCounts">What counts</summary>
    <div class="markers__rules">
      <div>
        <h3 data-t="health.counts">Counts</h3>
        <ul>
          <li data-t="health.nightsOf7HoursSleep">Nights of 7 hours' sleep or more</li>
          <li data-t="health.daysOf7000Steps">Days of 7,000 steps or more</li>
          <li data-t="health.weeksWith150ActiveMinutes">Weeks with 150 active minutes</li>
          <li data-t="health.everyWorkoutYouLog">Every workout you log</li>
          <li data-t="health.healthConnectAndNumbersAdded">Health Connect and numbers added by hand</li>
        </ul>
      </div>
      <div>
        <h3 data-t="health.neverCounts">Never counts</h3>
        <ul>
          <li data-t="health.caloriesWeightOrBodySize">Calories, weight or body size</li>
          <li data-t="health.sleepingOrTrainingPastA">Sleeping or training past a healthy goal: a long night counts once</li>
          <li data-t="health.estimatesTheAppMade">Estimates the app made</li>
        </ul>
      </div>
    </div>
    <p data-t="health.tiersNeverGoBackEven" class="muted">Tiers never go back, even when old days drop out of Health Connect. All of this stays on this device.</p>
  </details>
</section>

<script>
  import { allProgress, closestTiers, tierLabel, type TrackProgress } from '../lib/rewards';
  import { bodyInput } from '../lib/bodytiers';
  import { tierIcon } from '../lib/tier-icons';
  import { el } from '../lib/dom';
  import { subscribe } from '../lib/storage';
  import { cleanups, onPage } from '../lib/page';
  import { locale, t, tn } from '../lib/i18n';

  function row(p: TrackProgress): HTMLLIElement {
    const li = el('li', 'marker');
    const coin = el('span', `tier-coin ${p.level ? `tier-coin--t${p.level - 1}` : 'tier-coin--blank'}`);
    coin.innerHTML = tierIcon(Math.max(0, p.level - 1), 18);
    const head = el('p', 'marker__head');
    head.append(el('span', 'marker__title', p.track.title));
    const n = closestTiers([p], 1)[0];
    const bar = el('span', 'marker__bar');
    bar.setAttribute('aria-hidden', 'true');
    bar.append(el('span'));
    let line: string;
    if (n) {
      head.append(el('span', 'marker__left', t('health.toGo', { n: n.left.toLocaleString(locale()) })));
      bar.style.setProperty('--share', `${Math.round(n.share * 100)}%`);
      bar.style.setProperty('--next', `var(--tier-${p.level})`);
      line = t('health.markerLine', { value: p.value.toLocaleString(locale()), next: n.next.toLocaleString(locale()), unit: p.track.unit(n.next), tier: tierLabel(p.level) });
    } else {
      bar.style.setProperty('--share', '100%');
      bar.style.setProperty('--next', 'var(--tier-4)');
      line = t('health.allTiers', { what: p.track.describe(p.value) });
    }
    li.append(coin, head, bar, el('p', 'marker__line muted', line));
    return li;
  }

  onPage('health-markers', () => {
    const root = document.querySelector<HTMLElement>('[data-health-markers]');
    if (!root) return;
    const c = cleanups();
    const render = () => {
      const body = bodyInput();
      const progress = body ? allProgress({ sessions: [], done: [], chainDays: [], body }).filter((p) => p.track.group === 'body') : [];
      root.hidden = !progress.some((p) => p.value > 0);
      const tiers = progress.reduce((n, p) => n + p.level, 0);
      const next = closestTiers(progress.filter((p) => p.value > 0), 1)[0];
      root.querySelector('[data-hm-hint]')!.textContent = next
        ? t('health.hintNext', { n: next.left.toLocaleString(locale()), unit: next.p.track.unit(next.left), tier: tierLabel(next.p.level) })
        : tn('health.nTiers', tiers);
      root.querySelector('[data-hm-list]')!.replaceChildren(...progress.map(row));
    };
    render();
    for (const name of ['body', 'body-manual', 'workouts', 'profile'] as const) c.add(subscribe(name, render));
    return c.run;
  });
</script>

<style>
  .markers {
    display: grid;
    gap: var(--space-2);
  }

  .markers__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .markers__all {
    font-size: var(--text-sm);
  }

  .markers__lead {
    font-size: var(--text-sm);
  }

  .markers__list {
    display: grid;
    padding: 0;
    list-style: none;
  }

  .markers__list :global(.marker) {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: var(--space-3);
    row-gap: 5px;
    align-items: center;
    padding-block: var(--space-3);
  }

  .markers__list :global(.marker + .marker) {
    border-top: 1px solid var(--color-border);
  }

  .markers__list :global(.marker .tier-coin) {
    --coin-size: 36px;
    grid-row: 1 / span 3;
    margin: 0;
  }

  .markers__list :global(.marker__head) {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    font-weight: 600;
  }

  .markers__list :global(.marker__left) {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-accent);
  }

  .markers__list :global(.marker__bar) {
    display: block;
    block-size: 7px;
    border-radius: var(--radius-pill);
    background: var(--heat-0);
    box-shadow: inset 0 1px 2px rgb(0 0 0 / 0.35);
    overflow: hidden;
  }

  .markers__list :global(.marker__bar > span) {
    display: block;
    inline-size: var(--share, 0%);
    block-size: 100%;
    border-radius: inherit;
    background: var(--next);
  }

  .markers__list :global(.marker__line) {
    font-size: var(--text-xs);
  }

  .markers__about summary {
    min-block-size: 44px;
    display: flex;
    align-items: center;
    color: var(--color-accent);
    font-size: var(--text-sm);
    cursor: pointer;
  }

  .markers__rules {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: var(--space-3);
    font-size: var(--text-sm);
  }

  .markers__rules h3 {
    font-size: var(--text-sm);
    margin-bottom: var(--space-1);
  }

  .markers__rules ul {
    margin: 0;
    padding-inline-start: 1.1rem;
    line-height: 1.5;
  }

  .markers__about > p {
    margin-top: var(--space-2);
    font-size: var(--text-xs);
  }
</style>
