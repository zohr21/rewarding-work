---
import { PROBLEMS, PROBLEM_SLUGS, type ProblemSlug } from '../data/taxonomy';
import { getTechniques } from '../lib/techniques';
import { url } from '../lib/paths';

const techniques = await getTechniques();
const counts = Object.fromEntries(
  PROBLEM_SLUGS.map((p) => [p, techniques.filter((t) => t.data.problems.includes(p)).length]),
) as Record<ProblemSlug, number>;

// Simple 24px line icons (stroke = currentColor).
// Each problem gets its own tile colour (category tokens, so both themes work).
const TILE: Record<ProblemSlug, string> = {
  'cant-start': 'var(--cat-reward)',
  'lose-focus': 'var(--cat-time)',
  'no-progress': 'var(--cat-visual)',
  'too-much': 'var(--cat-structure)',
  'burn-out': 'var(--cat-rest)',
};

const ICONS: Record<ProblemSlug, string> = {
  'cant-start': 'M5 4l14 8-14 8z',
  'lose-focus': 'M12 3v3M12 18v3M3 12h3M18 12h3M12 8a4 4 0 1 1 0 8 4 4 0 0 1 0-8z',
  'no-progress': 'M4 20V14M10 20V9M16 20V12M22 20H2M20 4l-4 4-3-3-5 5',
  'too-much': 'M4 6h16M4 10h16M4 14h16M4 18h10',
  'burn-out': 'M3 8h15a1 1 0 0 1 1 1v6a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1zM21 11v2M5 11v2',
};
---

<ul class="problems" role="list">
  {
    PROBLEM_SLUGS.map((slug) => (
      <li>
        <a class="problem" href={url(`/problems/${slug}`)}>
          <span class="problem__icon" aria-hidden="true" style={`--tile:${TILE[slug]}`}>
            <svg viewBox="0 0 24 24" width="24" height="24">
              <path d={ICONS[slug]} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
          <span class="problem__body">
            <span class="problem__title">“{PROBLEMS[slug].title}”</span>
            <span class="problem__teaser">{PROBLEMS[slug].teaser}</span>
            <span class="problem__count">{counts[slug]} techniques →</span>
          </span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .problems {
    display: grid;
    gap: var(--space-3);
    padding: 0;
    list-style: none;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
  }

  .problems li {
    max-width: none;
  }

  .problem {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    height: 100%;
    padding: var(--space-5);
    background: var(--surface-grad);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    color: var(--color-text);
    text-decoration: none;
    box-shadow: var(--shadow-card);
    transition:
      border-color var(--duration-fast) var(--ease-out),
      transform var(--duration-base) var(--ease-out),
      box-shadow var(--duration-base) var(--ease-out);
  }

  .problem:hover {
    color: var(--color-text);
    border-color: color-mix(in srgb, var(--color-accent) 45%, transparent);
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-4px);
  }

  /* A raised, coloured tile: light top, solid darker edge underneath. */
  .problem__icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 52px;
    height: 52px;
    border-radius: 15px;
    background: linear-gradient(160deg, color-mix(in srgb, var(--tile) 70%, white), var(--tile));
    color: var(--color-bg);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.5),
      0 4px 0 color-mix(in srgb, var(--tile) 55%, black),
      0 12px 20px -10px color-mix(in srgb, var(--tile) 60%, transparent);
  }

  .problem__body {
    display: grid;
    gap: var(--space-1);
    align-content: start;
  }

  .problem__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-lg);
    line-height: var(--leading-tight);
  }

  .problem__teaser {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .problem__count {
    margin-top: var(--space-1);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-accent);
  }
</style>
