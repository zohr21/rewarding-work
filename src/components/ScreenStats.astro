---
/**
 * Grove › Stats in the Android app, with the Screen time section on: focus and phone time
 * side by side for the week or month, one plain finding from them, the top apps, and how
 * many focus sessions stayed phone-free (each one a leaf).
 */
import ScreenSetup from './ScreenSetup.astro';
---

<div class="screen-stats" data-screen-stats data-module="screen" hidden>
  <section class="card screen-stats__ask" data-ss-ask aria-labelledby="ss-ask-h" hidden>
    <h2 id="ss-ask-h">Focus and phone</h2>
    <p class="muted">Turn on Usage access to see phone time next to your focus.</p>
    <button type="button" class="btn" data-screen-setup-open>Turn on</button>
  </section>

  <div class="screen-stats__body" data-ss-body hidden>
    <section class="card screen-stats__card" aria-labelledby="ss-chart-h">
      <div class="screen-stats__head">
        <h2 id="ss-chart-h">Focus and phone</h2>
        <div class="screen-stats__range" role="group" aria-label="Range">
          <button type="button" aria-pressed="true" data-ss-range="7">Week</button>
          <button type="button" aria-pressed="false" data-ss-range="30">Month</button>
        </div>
      </div>
      <div class="screen-stats__totals">
        <div>
          <span class="screen-stats__key"><span class="screen-stats__swatch screen-stats__swatch--focus"></span>Focus</span>
          <strong data-ss-focus></strong>
        </div>
        <div>
          <span class="screen-stats__key"><span class="screen-stats__swatch screen-stats__swatch--phone"></span>Phone</span>
          <strong data-ss-phone></strong>
        </div>
      </div>
      <div class="screen-stats__chart" data-ss-chart></div>
      <p class="screen-stats__finding" data-ss-finding hidden></p>
    </section>

    <section class="card screen-stats__card" aria-labelledby="ss-apps-h" data-ss-apps-card>
      <h2 id="ss-apps-h" data-ss-apps-title>Top apps this week</h2>
      <ul class="screen-stats__apps" data-ss-apps></ul>
    </section>

    <section class="card screen-stats__card" aria-labelledby="ss-focus-h">
      <h2 id="ss-focus-h">Phone during focus</h2>
      <div class="screen-stats__tiles">
        <div>
          <strong class="screen-stats__leaves" data-ss-clean></strong>
          <span class="muted" data-ss-clean-sub>sessions with no phone</span>
        </div>
        <div>
          <strong data-ss-pickups></strong>
          <span class="muted" data-ss-pickups-sub>pick-ups</span>
        </div>
      </div>
    </section>
  </div>
</div>
<ScreenSetup />

<script>
  import { getProfile } from '../lib/profile';
  import { checkRecentSessions, formatMinutes, formatPhone, getScreen, hasAccess, lastDays, refreshDays, topApps } from '../lib/screen';
  import { dailyMinutes } from '../lib/stats';
  import { getSessions, subscribe } from '../lib/storage';
  import { fromDayKey } from '../lib/dates';
  import { cleanups, listen, onPage } from '../lib/page';
  import { el } from '../lib/dom';

  const weekday = new Intl.DateTimeFormat(undefined, { weekday: 'short' });
  const dayMonth = new Intl.DateTimeFormat(undefined, { day: 'numeric', month: 'short' });
  const longDay = new Intl.DateTimeFormat(undefined, { weekday: 'long' });
  /** The chart's top: phone days run long, so it stretches to the biggest day but no less than this. */
  const MIN_SCALE = 240;

  onPage('screen-stats', () => {
    const found = document.querySelector<HTMLElement>('[data-screen-stats]');
    if (!found) return;
    const root = found;
    const c = cleanups();
    const $ = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
    let range = 7;
    let access = false;

    function render(): void {
      if (!getProfile().modules.screen) {
        root.hidden = true;
        return;
      }
      root.hidden = false;
      $('[data-ss-ask]').hidden = access;
      $('[data-ss-body]').hidden = !access;
      if (!access) return;

      const store = getScreen();
      const phone = lastDays(store, range);
      const focus = dailyMinutes(getSessions(), range);
      const days = phone.map((p, i) => ({ key: p.day, date: fromDayKey(p.day), phone: p.data?.totalMin, focus: focus[i]?.value ?? 0 }));

      $('[data-ss-focus]').textContent = formatPhone(days.reduce((a, d) => a + d.focus, 0));
      $('[data-ss-phone]').textContent = formatPhone(days.reduce((a, d) => a + (d.phone ?? 0), 0));

      // Paired bars, focus then phone, one pair a day; the dashed line marks 4 hours when it fits.
      const top = Math.max(MIN_SCALE, ...days.map((d) => Math.max(d.focus, d.phone ?? 0)));
      const chart = $('[data-ss-chart]');
      chart.classList.toggle('is-month', range > 7);
      const plot = el('div', 'screen-stats__plot');
      plot.setAttribute('role', 'img');
      plot.setAttribute(
        'aria-label',
        `Focus and phone time per day, last ${range} days. ` +
          days.map((d) => `${dayMonth.format(d.date)}: focus ${formatPhone(d.focus)}, phone ${d.phone === undefined ? 'not known' : formatPhone(d.phone)}`).join('; '),
      );
      if (top >= 240) {
        const rule = el('span', 'screen-stats__rule', '4 h');
        rule.style.insetBlockEnd = `${(240 / top) * 100}%`;
        plot.append(rule);
      }
      const labels = el('div', 'screen-stats__labels');
      labels.setAttribute('aria-hidden', 'true');
      days.forEach((d, i) => {
        const pair = el('span', 'screen-stats__pair');
        const f = el('span', 'screen-stats__bar screen-stats__bar--focus');
        f.style.blockSize = `${(d.focus / top) * 100}%`;
        const p = el('span', `screen-stats__bar screen-stats__bar--phone${d.phone === undefined ? ' is-unknown' : ''}`);
        p.style.blockSize = `${((d.phone ?? 0) / top) * 100}%`;
        pair.append(f, p);
        plot.append(pair);
        const last = i === days.length - 1;
        const text = range > 7 ? (i % 7 === days.length % 7 || last ? String(d.date.getDate()) : '') : weekday.format(d.date);
        labels.append(el('span', last ? 'is-today' : '', text));
      });
      chart.replaceChildren(plot, labels);

      // One plain finding: phone time on your biggest focus days against the rest.
      const known = days.filter((d) => d.phone !== undefined && d.phone > 0);
      const finding = $('[data-ss-finding]');
      finding.hidden = true;
      if (known.length >= 4 && known.some((d) => d.focus > 0)) {
        const byFocus = [...known].sort((a, b) => b.focus - a.focus);
        const best = byFocus.slice(0, 2).filter((d) => d.focus > 0);
        const rest = known.filter((d) => !best.includes(d));
        const avg = (xs: typeof known) => xs.reduce((a, d) => a + d.phone!, 0) / xs.length;
        const gap = Math.round(avg(rest) - avg(best));
        const names = best.map((d) => (range > 7 ? dayMonth.format(d.date) : longDay.format(d.date))).join(' and ');
        const which = best.length === 1 ? `Your biggest focus day, ${names},` : `Your two biggest focus days, ${names},`;
        finding.textContent =
          gap >= 15
            ? `${which} had ${formatMinutes(gap)} less phone time than your other days.`
            : gap <= -15
              ? `${which} had more phone time than your other days, so the phone isn't what's holding focus back.`
              : `${which} had about the same phone time as your other days.`;
        finding.hidden = false;
      }

      $('[data-ss-apps-title]').textContent = range > 7 ? 'Top apps this month' : 'Top apps this week';
      const apps = topApps(phone.map((p) => p.data), 4);
      const max = apps[0]?.min ?? 1;
      $('[data-ss-apps-card]').hidden = apps.length === 0;
      $('[data-ss-apps]').replaceChildren(
        ...apps.map((a) => {
          const li = el('li');
          const row = el('div', 'screen-stats__app');
          row.append(el('span', '', a.label), el('span', 'muted', formatPhone(a.min)));
          const bar = el('span', 'screen-stats__track');
          bar.setAttribute('aria-hidden', 'true');
          const fill = el('span');
          fill.style.inlineSize = `${Math.max(4, Math.round((a.min / max) * 100))}%`;
          bar.append(fill);
          li.append(row, bar);
          return li;
        }),
      );

      // Sessions in the range that were checked: phone-free ones are leaves.
      const since = days[0]!.date.getTime();
      const checked = getSessions().filter((s) => s.start >= since && store.sessions[s.id]).map((s) => store.sessions[s.id]!);
      const clean = checked.filter((s) => s.pickups === 0).length;
      const pickups = checked.reduce((a, s) => a + s.pickups, 0);
      const counts = new Map<string, number>();
      for (const s of checked) for (const a of s.apps) counts.set(a.label, (counts.get(a.label) ?? 0) + 1);
      const most = [...counts.entries()].sort((a, b) => b[1] - a[1])[0]?.[0];
      $('[data-ss-clean]').textContent = checked.length ? `${clean} of ${checked.length}` : '–';
      $('[data-ss-clean-sub]').textContent = checked.length ? `sessions with no phone, ${clean} ${clean === 1 ? 'leaf' : 'leaves'}` : 'no sessions checked yet';
      $('[data-ss-pickups]').textContent = String(pickups);
      $('[data-ss-pickups-sub]').textContent = pickups && most ? `pick-ups, mostly ${most}` : pickups === 1 ? 'pick-up' : 'pick-ups';
    }

    async function load(): Promise<void> {
      if (!getProfile().modules.screen) return render();
      access = Boolean(await hasAccess());
      if (access) {
        await refreshDays();
        await checkRecentSessions(getSessions());
      }
      render();
    }
    void load();

    const onClick = (e: Event) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-ss-range]');
      if (!b) return;
      range = Number(b.dataset.ssRange);
      root.querySelectorAll('[data-ss-range]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      render();
    };
    root.addEventListener('click', onClick);
    c.add(() => root.removeEventListener('click', onClick));
    const onAccess = () => void load();
    document.addEventListener('screen:access', onAccess);
    c.add(() => document.removeEventListener('screen:access', onAccess));
    c.add(listen(document, 'visibilitychange', () => document.visibilityState === 'visible' && void load()));
    c.add(subscribe('screen', render));
    c.add(subscribe('sessions', render));
    return c.run;
  });
</script>

<style>
  .screen-stats,
  .screen-stats__body {
    display: grid;
    gap: var(--space-4);
  }

  .screen-stats[hidden],
  .screen-stats [hidden] {
    display: none;
  }

  .screen-stats h2 {
    font-size: var(--text-base);
  }

  .screen-stats__ask,
  .screen-stats__card {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-4);
  }

  .screen-stats__ask .btn {
    min-height: 48px;
  }

  .screen-stats__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .screen-stats__range {
    display: flex;
    padding: 3px;
    border-radius: var(--radius-pill);
    background: var(--well-bg);
    box-shadow: var(--well-shadow);
  }

  .screen-stats__range button {
    min-height: 40px;
    padding: 0 var(--space-3);
    border: 0;
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-text-muted);
    font: inherit;
    font-size: var(--text-xs);
    font-weight: 600;
    cursor: pointer;
  }

  .screen-stats__range button[aria-pressed='true'] {
    background: var(--raised-grad);
    box-shadow: inset 0 1px 0 var(--raised-hl);
    color: var(--color-text);
  }

  .screen-stats__totals,
  .screen-stats__tiles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
  }

  .screen-stats__totals > div,
  .screen-stats__tiles > div {
    display: grid;
    gap: 2px;
  }

  .screen-stats__totals strong,
  .screen-stats__tiles strong {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: 1.1;
  }

  .screen-stats__key {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .screen-stats__swatch {
    inline-size: 10px;
    block-size: 10px;
    border-radius: 3px;
  }

  .screen-stats__swatch--focus,
  .screen-stats__chart :global(.screen-stats__bar--focus) {
    background: var(--heat-2);
  }

  .screen-stats__swatch--phone,
  .screen-stats__chart :global(.screen-stats__bar--phone) {
    background: var(--cat-visual);
  }

  .screen-stats__chart {
    display: grid;
    gap: 6px;
  }

  .screen-stats__chart :global(.screen-stats__plot) {
    position: relative;
    display: grid;
    grid-auto-columns: minmax(0, 1fr);
    grid-auto-flow: column;
    gap: 6px;
    align-items: end;
    block-size: 160px;
    border-bottom: 1px solid var(--color-border);
  }

  .screen-stats__chart.is-month :global(.screen-stats__plot),
  .screen-stats__chart.is-month :global(.screen-stats__labels) {
    gap: 2px;
  }

  .screen-stats__chart :global(.screen-stats__rule) {
    position: absolute;
    inset-inline: 0;
    border-top: 1px dashed var(--color-border);
    color: var(--color-text-muted);
    font-size: 11px;
    text-align: end;
    line-height: 1.4;
    pointer-events: none;
  }

  .screen-stats__chart :global(.screen-stats__pair) {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 3px;
    block-size: 100%;
  }

  .screen-stats__chart.is-month :global(.screen-stats__pair) {
    gap: 1px;
  }

  .screen-stats__chart :global(.screen-stats__bar) {
    flex: 0 1 12px;
    min-inline-size: 2px;
    border-radius: 4px 4px 0 0;
  }

  .screen-stats__chart.is-month :global(.screen-stats__bar) {
    border-radius: 2px 2px 0 0;
  }

  .screen-stats__chart :global(.screen-stats__bar.is-unknown) {
    display: none;
  }

  .screen-stats__chart :global(.screen-stats__labels) {
    display: grid;
    grid-auto-columns: minmax(0, 1fr);
    grid-auto-flow: column;
    gap: 6px;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    text-align: center;
  }

  .screen-stats__chart :global(.screen-stats__labels .is-today) {
    color: var(--color-text);
    font-weight: 700;
  }

  .screen-stats__finding {
    padding: var(--space-3);
    border-radius: var(--radius-md);
    background: var(--color-accent-soft);
    font-size: var(--text-sm);
  }

  .screen-stats__apps {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .screen-stats__apps :global(li) {
    display: grid;
    gap: 5px;
  }

  .screen-stats__apps :global(.screen-stats__app) {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    font-size: var(--text-sm);
  }

  .screen-stats__apps :global(.screen-stats__track) {
    display: block;
    block-size: 8px;
    border-radius: var(--radius-pill);
    background: var(--well-bg);
    box-shadow: var(--well-shadow);
    overflow: hidden;
  }

  .screen-stats__apps :global(.screen-stats__track > span) {
    display: block;
    block-size: 100%;
    border-radius: inherit;
    background: var(--cat-visual);
  }

  .screen-stats__tiles > div {
    padding: var(--space-3);
    border-radius: var(--radius-md);
    background: var(--well-bg);
    box-shadow: var(--well-shadow);
  }

  .screen-stats__tiles span {
    font-size: var(--text-xs);
  }

  .screen-stats__leaves {
    color: var(--cat-reward);
  }
</style>
