---
/**
 * Header link to /account: "Sign in", or your initial with a small sync dot.
 * Also starts the account code on every page (it only downloads Firebase when
 * someone is signed in on this device). Not rendered when accounts aren't configured.
 */
import { ACCOUNTS_ENABLED } from '../config/firebase';
import { url, isActive } from '../lib/paths';

const current = Astro.url.pathname;
---

{
  ACCOUNTS_ENABLED && (
    <a
      class="account-btn"
      href={url('/account')}
      data-account-btn
      data-state="signed-out"
      aria-current={isActive(current, '/account') ? 'page' : undefined}
    >
      <span class="account-btn__avatar" aria-hidden="true" data-account-avatar>
        <svg viewBox="0 0 24 24" width="20" height="20">
          <circle cx="12" cy="8.5" r="3.8" fill="none" stroke="currentColor" stroke-width="1.8" />
          <path d="M4.5 20a7.5 7.5 0 0 1 15 0" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
        </svg>
      </span>
      <span class="account-btn__text" data-account-label>
        Sign in
      </span>
      <span class="account-btn__dot" aria-hidden="true" />
    </a>
  )
}

<script>
  import { onAccountChange, startAccount, type AccountState } from '../lib/account/state';
  import { onPage } from '../lib/page';

  const SYNC_TEXT: Record<AccountState['sync'], string> = {
    idle: '',
    saving: 'saving',
    synced: 'synced',
    offline: 'offline, changes kept',
    error: 'sync problem',
  };

  onPage('account-button', () => {
    startAccount();
    const btn = document.querySelector<HTMLAnchorElement>('[data-account-btn]');
    if (!btn) return;
    const label = btn.querySelector<HTMLElement>('[data-account-label]')!;
    const avatar = btn.querySelector<HTMLElement>('[data-account-avatar]')!;
    const icon = avatar.innerHTML;

    return onAccountChange((s) => {
      const u = s.user;
      btn.dataset.state = u ? 'signed-in' : 'signed-out';
      btn.dataset.sync = s.sync;
      if (!u) {
        label.textContent = 'Sign in';
        avatar.innerHTML = icon;
        btn.setAttribute('aria-label', 'Sign in or create an account');
        return;
      }
      const who = u.isAnonymous ? 'Guest' : (u.name ?? u.email ?? 'Account');
      label.textContent = u.isAnonymous ? 'Guest' : 'Account';
      if (u.isAnonymous) avatar.innerHTML = icon;
      else avatar.textContent = who.trim().charAt(0).toUpperCase();
      const sync = SYNC_TEXT[s.sync];
      btn.setAttribute('aria-label', `Account: ${who}${sync ? ` (${sync})` : ''}`);
    });
  });
</script>

<style>
  .account-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    min-width: 44px;
    padding: 0 var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .account-btn:hover,
  .account-btn[aria-current='page'] {
    color: var(--color-text);
    border-color: var(--color-border-strong);
  }

  .account-btn__avatar {
    display: inline-grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    font-weight: 700;
    font-size: var(--text-xs);
  }

  .account-btn[data-state='signed-in'] .account-btn__avatar {
    background: var(--color-accent-soft);
    color: var(--color-accent);
  }

  /* Sync dot: green when synced, amber while saving/offline, red on a problem. */
  .account-btn__dot {
    display: none;
    position: absolute;
    top: 6px;
    left: 26px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    border: 2px solid var(--color-surface-solid);
    background: var(--color-accent);
  }

  .account-btn[data-state='signed-in'] .account-btn__dot {
    display: block;
  }

  .account-btn[data-sync='saving'] .account-btn__dot,
  .account-btn[data-sync='offline'] .account-btn__dot {
    background: #c28a00;
  }

  .account-btn[data-sync='error'] .account-btn__dot {
    background: #b3261e;
  }

  @media (max-width: 30rem) {
    .account-btn__text {
      display: none;
    }
  }
</style>
