---
/**
 * Home, on the site and in the Android app: what to work on now. The task that is
 * first up on Today with one button to start focusing on it, today's focus, the chain,
 * and the tier that is closest. Everything is read from stored data; nothing is kept here.
 *
 * Before the first session it is a first-day screen instead: one "plant your first seed"
 * card and a short Get started list, with the numbers left out until there are some.
 */
import { NATIVE_APP } from '../config/app';
import { url } from '../lib/paths';
import Sprig from './Sprig.astro';
import ScreenToday from './ScreenToday.astro';
import ChainToday from './ChainToday.astro';
---

<section
  class="today"
  data-app-today
  data-timer-url={url('/timer')}
  data-tasks-url={url('/tasks')}
  aria-labelledby="today-heading"
  aria-busy="true">
  <header class="today__head">
    {/* The site's home page has its own heading above this. */}
    {NATIVE_APP ? <h1 id="today-heading" data-t="today.title">Today</h1> : <h2 id="today-heading" class="visually-hidden" data-t="today.title">Today</h2>}
    <p class="muted" data-td-date></p>
  </header>

  <div class="card today__first" data-td-first></div>

  <div class="card today__start-list" data-td-steps hidden>
    <div class="today__steps-head">
      <h2 data-t="today.questsTitle">Sprig's first quests</h2>
      <span class="muted" data-td-steps-count></span>
    </div>
    <span class="today__quest-bar" aria-hidden="true"><span data-td-steps-bar></span></span>
    <ul data-td-steps-list></ul>
    <button type="button" class="today__quest-hide" data-td-steps-hide data-t="today.questsHide">Put away (it stays under You › Help)</button>
  </div>

  {/* "Did you know?": one tip a day at most, filled in by Guide.astro. */}
  <div data-help-nudge hidden></div>

  <div class="today__pair" data-td-pair hidden>
    <a class="card today__stat" href={`${url('/progress')}#stats`}>
      <span class="today__label" data-t="today.focusToday">Focus today</span>
      <strong class="today__value" data-td-focus>0 min</strong>
      <span class="today__chart" data-td-bars></span>
    </a>
    <a class="card today__stat" href={`${url('/progress')}#chains`} data-td-chain-card>
      <span class="today__label" data-td-chain-label>Chain</span>
      <strong class="today__value" data-td-chain>None yet</strong>
      <span class="today__dots" data-td-dots></span>
    </a>
  </div>

  <ChainToday />

  {NATIVE_APP && <ScreenToday />}

  <a class="today__nudge" href={`${url('/progress')}#tiers`} data-td-nudge hidden>
    <Sprig mood="auto" rest="curious" size={46} />
    <span class="today__nudge-body">
      <span class="today__nudge-text" data-td-nudge-text></span>
      <span class="today__nudge-bar" aria-hidden="true" data-td-nudge-bar><span></span></span>
    </span>
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
  </a>
</section>

<script>
  import { getChain, getChains, getDone, getSessions, getTasks, subscribe } from '../lib/storage';
  import { getProfile, getTours, setTours } from '../lib/profile';
  import { url } from '../lib/paths';
  import { allProgress, chainInput, closestTiers, tierLabel } from '../lib/rewards';
  import { bodyInput } from '../lib/bodytiers';
  import { chainStats, dailyMinutes, totals } from '../lib/stats';
  import { focusByTask, formatFocus, taskName, todayTasks } from '../lib/tasks';
  import { miniBars, ring } from '../lib/charts';
  import { sprigMood, sprigSvg } from '../lib/sprig';
  import { addDays, dayKey, startOfWeek } from '../lib/dates';
  import { cleanups, listen, onPage } from '../lib/page';
  import { el } from '../lib/dom';
  import { dateFormat, locale, t, tn } from '../lib/i18n';

  const dateFmt = dateFormat({ weekday: 'long', day: 'numeric', month: 'long' });
  /** Sprig, still a seed, waiting for the first session. */
  const SEED_SVG = sprigSvg({ stage: 0, mood: 'happy', size: 84 });
  const CHECK_SVG =
    '<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M5 12l5 5 9-10" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>';
  const PLAY_SVG =
    '<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l11-6.5a1 1 0 0 0 0-1.72l-11-6.5A1 1 0 0 0 8 5.5z" fill="currentColor"/></svg>';

  onPage('app-today', () => {
    const root = document.querySelector<HTMLElement>('[data-app-today]');
    if (!root) return;
    const c = cleanups();
    const $ = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
    const timerUrl = root.dataset.timerUrl!;
    const tasksUrl = root.dataset.tasksUrl!;

    /** No focus session yet: the first day. */
    const isFirstDay = () => getSessions().length === 0;

    function renderFirst(): void {
      const box = $('[data-td-first]');
      const today = todayTasks(getTasks());
      const task = today[0];
      if (!task && isFirstDay()) {
        const seed = el('div', 'today__seed');
        seed.innerHTML = SEED_SVG;
        const title = el('h2', 'today__title', t('today.seedTitle'));
        const text = el('p', 'muted', t('today.seedText'));
        const actions = el('div', 'today__actions');
        const go = el('a', 'btn today__start');
        go.href = timerUrl;
        go.innerHTML = PLAY_SVG;
        go.append(t('today.startFocus'));
        const add = el('a', 'btn btn--ghost', t('today.addTaskFirst'));
        add.href = tasksUrl;
        actions.append(go, add);
        box.classList.add('today__first--seed');
        box.replaceChildren(seed, title, text, actions);
        return;
      }
      box.classList.remove('today__first--seed');
      if (!task) {
        const title = el('h2', 'today__title', t('today.emptyTitle'));
        const text = el('p', 'muted', t('today.emptyText'));
        const actions = el('div', 'today__actions');
        const add = el('a', 'btn', t('today.chooseTask'));
        add.href = tasksUrl;
        const go = el('a', 'btn btn--ghost', t('today.startSession'));
        go.href = timerUrl;
        actions.append(add, go);
        box.replaceChildren(title, text, actions);
        return;
      }

      const top = el('div', 'today__top');
      top.append(el('span', 'today__eyebrow', t('today.firstUp')));
      if (today.length > 1) top.append(el('span', 'muted today__more', tn('today.moreOnToday', today.length - 1)));

      const done = task.steps.filter((s) => s.done).length;
      const row = el('div', 'today__task');
      row.append(ring(done, task.steps.length, 56, task.steps.length ? t('today.stepsDone', { done, total: task.steps.length }) : t('today.noSteps')));
      const text = el('div', 'today__task-text');
      text.append(el('h2', 'today__title', taskName(task)));
      const seconds = focusByTask(getSessions()).get(task.id) ?? 0;
      text.append(el('span', 'muted', seconds ? t('today.focusedSoFar', { time: formatFocus(seconds) }) : t('today.notStarted')));
      row.append(text);

      const parts: HTMLElement[] = [top, row];
      const next = task.steps.find((s) => !s.done);
      if (next) {
        const step = el('p', 'today__step');
        step.append(el('span', 'today__box'), t('today.nextStep', { step: next.text }));
        parts.push(step);
      }

      const start = el('a', 'btn today__start');
      start.href = `${timerUrl}?task=${encodeURIComponent(task.id)}`;
      start.innerHTML = PLAY_SVG;
      start.append(t('today.startFocusing'));
      parts.push(start);
      box.replaceChildren(...parts);
    }

    /**
     * Sprig's first quests: first things to try, each with a "Show me" that opens the page
     * and starts its tour (src/lib/tours.ts). Gone once all are done, or when put away.
     */
    function renderSteps(): void {
      const tasks = getTasks();
      const tours = getTours();
      const steps: [string, boolean, string][] = [
        [t('today.questWelcome'), getProfile().welcomed, url('/welcome')],
        [t('today.questSession'), !isFirstDay(), url('/timer?tour=timer')],
        [t('today.questTask'), tasks.length > 0, url('/tasks?tour=tasks')],
        [t('today.questSplit'), tasks.some((t) => t.steps.length > 0), url('/tasks?tour=tasks')],
        [t('today.questGrove'), tours.seen.includes('grove'), url('/progress?tour=grove')],
      ];
      const done = steps.filter(([, ok]) => ok).length;
      const box = $('[data-td-steps]');
      box.hidden = done === steps.length || !!tours.questsHidden;
      $('[data-td-steps-count]').textContent = t('today.questsCount', { done, total: steps.length });
      $('[data-td-steps-bar]').style.inlineSize = `${(done / steps.length) * 100}%`;
      $('[data-td-steps-list]').replaceChildren(
        ...steps.map(([label, ok, href]) => {
          const li = el('li', ok ? 'is-done' : '');
          const mark = el('span', 'today__check');
          if (ok) mark.innerHTML = CHECK_SVG;
          li.append(mark, el('span', 'today__quest', label));
          if (ok) li.append(el('span', 'visually-hidden', ` ${t('today.questDone')}`));
          else {
            const show = el('a', 'today__show', t('today.showMe'));
            show.href = href;
            show.setAttribute('aria-label', t('today.showMeLabel', { quest: label }));
            li.append(show);
          }
          return li;
        }),
      );
    }

    function renderFocus(): void {
      const sessions = getSessions();
      $('[data-td-focus]').textContent = formatFocus(totals(sessions).todayMin * 60);
      const week = dailyMinutes(sessions, 7);
      $('[data-td-bars]').innerHTML = miniBars(
        week.map((d) => d.value),
        6,
        t('today.focusBars'),
      );
    }

    function renderChain(): void {
      const chain = getChains()[0];
      // With a chain, Today's chains (ChainToday) shows them all; the card is only the way in.
      $('[data-td-chain-card]').hidden = !!chain;
      $('[data-td-pair]').classList.toggle('is-single', !!chain);
      const label = $('[data-td-chain-label]');
      const value = $('[data-td-chain]');
      const dots = $('[data-td-dots]');
      if (!chain) {
        label.textContent = t('today.chain');
        value.textContent = t('today.chainNone');
        dots.replaceChildren(el('span', 'muted today__hint', t('today.chainHint')));
        return;
      }
      const stats = chainStats(chain.days);
      label.textContent = t('today.chainNamed', { habit: chain.habit });
      value.textContent = tn('today.chainDays', stats.current);
      const marked = new Set(chain.days);
      const monday = startOfWeek(new Date());
      const todayKey = dayKey(new Date());
      dots.replaceChildren(
        ...Array.from({ length: 7 }, (_, i) => {
          const key = dayKey(addDays(monday, i));
          return el('span', `today__dot${marked.has(key) ? ' is-on' : key === todayKey ? ' is-today' : ''}`);
        }),
      );
      dots.setAttribute('role', 'img');
      dots.setAttribute('aria-label', t(stats.doneToday ? 'today.weekMarked' : 'today.weekOpen'));
    }

    /** The one tier that is closest, so the home screen points at a single next thing. */
    function renderNudge(): void {
      const nudge = $<HTMLAnchorElement>('[data-td-nudge]');
      const closest = closestTiers(allProgress({ sessions: getSessions(), done: getDone(), ...chainInput(getChain()), body: bodyInput() }), 1)[0];
      // Tiers mean nothing yet on the first day; the seed card says what grows them.
      nudge.hidden = !closest || isFirstDay();
      if (nudge.hidden || !closest) return;
      const { p, share, left } = closest;
      const bar = $('[data-td-nudge-bar]');
      bar.style.setProperty('--share', `${Math.round(Math.min(1, Math.max(0, share)) * 100)}%`);
      bar.style.setProperty('--next', `var(--tier-${p.level})`);
      const text = $('[data-td-nudge-text]');
      // Sprig's mood (Sprig.astro) gets a word to go with it.
      const mood = sprigMood(getSessions(), 'curious');
      const say = mood === 'cheer' ? `${t('today.cheer')} ` : mood === 'gentle' ? `${t('today.welcomeBack')} ` : '';
      // The sentence comes whole from the word list, with the amount in bold where it falls.
      const [before = '', after = ''] = t('today.toTier', { tier: tierLabel(p.level) }).split('{amount}');
      text.replaceChildren(say, before, el('strong', '', t('tier.more', { n: left.toLocaleString(locale()), unit: p.track.unit(left) })), after);
    }

    const render = () => {
      $('[data-td-date]').textContent = dateFmt.format(new Date());
      renderFirst();
      renderSteps();
      // The numbers wait until there is something to count.
      $('[data-td-pair]').hidden = isFirstDay() && getChains().length === 0;
      renderFocus();
      renderChain();
      renderNudge();
      root.removeAttribute('aria-busy');
    };
    render();
    (['tasks', 'sessions', 'chain', 'done', 'profile'] as const).forEach((name) => c.add(subscribe(name, render)));
    c.add(listen($('[data-td-steps-hide]'), 'click', () => setTours({ questsHidden: true })));
    return c.run;
  });
</script>

<style>
  .today {
    display: grid;
    gap: var(--space-3);
    padding-block: var(--space-4) var(--space-5);
  }

  .today__head h1 {
    font-size: var(--text-xl);
    letter-spacing: -0.01em;
  }

  .today__head p {
    font-size: var(--text-sm);
  }

  .today__first {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-4);
  }

  .today__first :global(.today__top) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .today__first :global(.today__eyebrow) {
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .today__first :global(.today__more) {
    font-size: var(--text-xs);
  }

  .today__first :global(.today__task) {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .today__first :global(.today__task-text) {
    display: grid;
    gap: 2px;
    min-width: 0;
    font-size: var(--text-sm);
  }

  .today__first :global(.today__title) {
    font-size: var(--text-lg);
    line-height: var(--leading-tight);
    overflow-wrap: anywhere;
  }

  .today__first :global(.today__step) {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3);
    border-radius: var(--radius-md);
    background: var(--well-bg);
    box-shadow: var(--well-shadow);
    font-size: var(--text-sm);
    overflow-wrap: anywhere;
  }

  .today__first :global(.today__box) {
    flex: none;
    inline-size: 20px;
    block-size: 20px;
    border: 2px solid var(--color-border-strong);
    border-radius: 7px;
  }

  .today__first :global(.today__start) {
    min-height: 56px;
    margin-bottom: 4px;
    border-radius: 16px;
    font-size: var(--text-base);
    font-weight: 700;
  }

  .today__first :global(.today__actions) {
    display: grid;
    gap: var(--space-3);
    margin-bottom: 4px;
  }

  .today__first :global(.today__actions .btn) {
    min-height: 52px;
  }

  /* The first day: the seed, centred. */
  .today__first--seed {
    justify-items: center;
    text-align: center;
    padding-block: var(--space-5);
  }

  .today__first--seed :global(.today__actions) {
    justify-self: stretch;
  }

  /* Until the script has read your data: a quiet block the size of the card, not "Nothing yet". */
  .today[aria-busy='true'] .today__first {
    min-block-size: 13rem;
    background: var(--color-surface-2);
    box-shadow: none;
  }

  .today__pair[hidden],
  .today__start-list[hidden] {
    display: none;
  }

  .today__start-list {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4);
  }

  .today__steps-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
  }

  .today__steps-head h2 {
    font-size: var(--text-base);
  }

  .today__steps-head span {
    font-size: var(--text-sm);
  }

  .today__start-list ul {
    display: grid;
    gap: var(--space-1);
    padding: 0;
    list-style: none;
  }

  .today__start-list :global(li) {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 36px;
  }

  .today__start-list :global(li) {
    min-height: 44px;
  }

  .today__start-list :global(.today__quest) {
    flex: 1;
  }

  .today__start-list :global(li.is-done) {
    color: var(--color-text-muted);
    text-decoration: line-through;
  }

  .today__start-list :global(.today__show) {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
  }

  .today__quest-bar {
    display: block;
    block-size: 6px;
    overflow: hidden;
    border-radius: var(--radius-pill);
    background: var(--well-bg);
    box-shadow: var(--well-shadow);
  }

  .today__quest-bar span {
    display: block;
    block-size: 100%;
    border-radius: inherit;
    background: var(--color-accent);
    transition: inline-size var(--duration-fast, 0.2s) var(--ease-out);
  }

  .today__quest-hide {
    justify-self: start;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-text-muted);
    font: inherit;
    font-size: var(--text-sm);
    cursor: pointer;
  }

  .today__start-list :global(.today__check) {
    display: grid;
    place-items: center;
    flex: none;
    inline-size: 24px;
    block-size: 24px;
    border: 2px solid var(--color-border-strong);
    border-radius: 50%;
  }

  .today__start-list :global(li.is-done .today__check) {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  .today__pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
  }

  .today__pair.is-single {
    grid-template-columns: minmax(0, 1fr);
  }

  .today__stat[hidden] {
    display: none;
  }

  .today__stat {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    padding: var(--space-4);
    color: var(--color-text);
    text-decoration: none;
  }

  .today__label {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .today__value {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: 1;
  }

  .today__chart,
  .today__dots {
    display: flex;
    align-items: center;
    gap: 5px;
    min-block-size: 34px;
  }

  .today__dots :global(.today__dot) {
    flex: 1;
    aspect-ratio: 1;
    max-inline-size: 22px;
    border-radius: 6px;
    background: var(--heat-0);
  }

  .today__dots :global(.today__dot.is-on) {
    background: var(--heat-3);
    box-shadow: 0 2px 0 var(--heat-edge-3);
  }

  .today__dots :global(.today__dot.is-today) {
    background: transparent;
    border: 2px dashed var(--color-accent);
  }

  .today__dots :global(.today__hint) {
    font-size: var(--text-xs);
  }

  /* The closest tier: Sprig points at it, with a bar that fills in the next material's colour. */
  .today__nudge {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 56px;
    padding: var(--space-2) var(--space-3) var(--space-2) var(--space-1);
    border: 1px solid var(--color-border-strong);
    border-radius: 18px;
    background: var(--raised-grad);
    box-shadow:
      inset 0 1px 0 var(--raised-hl),
      0 3px 0 var(--edge);
    color: var(--color-text);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .today__nudge[hidden] {
    display: none;
  }

  .today__nudge-body {
    display: grid;
    flex: 1;
    gap: 6px;
    min-width: 0;
  }

  .today__nudge-bar {
    block-size: 6px;
    border-radius: var(--radius-pill);
    background: var(--well-bg);
    box-shadow: var(--well-shadow);
    overflow: hidden;
  }

  .today__nudge-bar > span {
    display: block;
    inline-size: var(--share, 0%);
    block-size: 100%;
    border-radius: inherit;
    background: var(--next);
  }

  .today__nudge > svg {
    flex: none;
    color: var(--color-text-muted);
  }

  /* With room: the task on the left, the numbers stacked beside it. */
  @media (min-width: 56rem) {
    .today {
      grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
      grid-template-rows: auto auto 1fr;
      grid-template-areas:
        'head head'
        'first pair'
        'chains nudge';
      gap: var(--space-4) var(--space-5);
    }

    .today__head {
      grid-area: head;
    }

    .today__first {
      grid-area: first;
      align-content: start;
      gap: var(--space-4);
      padding: var(--space-5);
    }

    .today__first :global(.today__title) {
      font-size: var(--text-xl);
    }

    .today__first :global(.today__actions) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .today__pair {
      grid-area: pair;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-4);
    }

    .today__stat {
      padding: var(--space-5);
    }

    .today__label {
      font-size: var(--text-sm);
    }

    .today__nudge {
      grid-area: nudge;
      align-self: start;
    }

    .today > :global(.ct) {
      grid-area: chains;
      align-self: start;
    }
  }
</style>
