---
import { SITE } from '../config/site';
import { ACCOUNTS_ENABLED } from '../config/firebase';
import { url } from '../lib/paths';
---

<footer class="site-footer">
  <div class="container">
    <p>
      {SITE.name} ·{' '}
      {
        ACCOUNTS_ENABLED ? (
          <span data-t="footer.dataAccount">Your data stays in this browser unless you sign in — then it is also kept in your account.</span>
        ) : (
          <span data-t="footer.dataLocal">Your data stays in this browser — nothing is sent anywhere.</span>
        )
      }{' '}
      <a href={url('/privacy')} data-t="footer.privacy">Privacy</a>
    </p>
    <p data-t="footer.evidence">
      Techniques are labelled by how well they're supported by evidence. What works varies from person to person; treat
      everything here as an experiment.
    </p>
    <p>© {new Date().getFullYear()} {SITE.owner}. <span data-t="footer.rights">All rights reserved.</span></p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    padding-block: var(--space-5);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .site-footer p + p {
    margin-top: var(--space-2);
  }
</style>
