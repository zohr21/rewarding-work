---
/**
 * Reward tiers on the progress page: a grove with one plant per track, then one
 * ladder of five tiers per track (src/lib/rewards.ts), with how far it is to the next one.
 * Before anything has counted towards a tier it is one seed instead, with the first goal.
 */
---

<section class="card tiers" id="tiers" data-reward-tiers aria-labelledby="tiers-heading">
  <h2 id="tiers-heading" class="panel-title">Your tiers</h2>
  <p class="muted tiers__intro">
    Markers along the way — there to show how far you've come, not to keep score. Green to start, then bronze, silver
    and gold, with diamond for the hardest runs. The chain counts your best run, so a missed day never takes a tier
    away.
  </p>
  <ul class="grove" data-tiers-grove aria-label="One plant per track"></ul>
  <ul class="tiers__grid" data-tiers-list></ul>

  <div class="seed" data-tiers-seed hidden>
    <svg class="seed__art" viewBox="0 0 120 64" width="168" height="90" aria-hidden="true">
      <ellipse cx="60" cy="58" rx="54" ry="6" fill="var(--well-bg)"></ellipse>
      <g fill="var(--color-border)">
        <circle cx="22" cy="40" r="9"></circle>
        <circle cx="98" cy="34" r="12"></circle>
        <circle cx="40" cy="30" r="12"></circle>
        <circle cx="80" cy="22" r="15"></circle>
      </g>
      <circle cx="60" cy="52" r="5" fill="var(--tier-1)"></circle>
    </svg>
    <h3 class="seed__title">A seed, waiting</h3>
    <p class="muted" data-tiers-seed-text></p>
    <div class="seed__bar" aria-hidden="true"><span></span></div>
    <p class="muted seed__count" data-tiers-seed-count></p>
    <h3 class="seed__ahead">Markers ahead</h3>
    <ol class="seed__coins" data-tiers-seed-coins></ol>
  </div>
</section>

<script>
  import { getChain, getDone, getSessions, subscribe } from '../lib/storage';
  import { allProgress, chainInput, tierLabel, TIER_MATERIALS, TIER_NAMES, type TrackProgress } from '../lib/rewards';
  import { tierIcon } from '../lib/tier-icons';
  import { cleanups, onPage } from '../lib/page';

  const dateFmt = new Intl.DateTimeFormat(undefined, { day: 'numeric', month: 'short', year: 'numeric' });

  const LEAF_SVG =
    '<svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M5 19c0-8 5-13 14-14-1 9-6 14-14 14zm0 0l7-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>';

  /** Focus hours read better with one decimal below 10. */
  function amount(p: TrackProgress): string {
    if (p.track.id !== 'focus') return p.value.toLocaleString();
    const v = p.value < 10 ? Math.floor(p.value * 10) / 10 : Math.floor(p.value);
    return v.toLocaleString();
  }

  function renderTrack(p: TrackProgress): HTMLLIElement {
    const { track, level, reachedAt } = p;
    const li = document.createElement('li');
    li.className = 'tier';

    const head = document.createElement('div');
    head.className = 'tier__head';
    const title = document.createElement('h3');
    title.className = 'tier__title';
    title.textContent = track.title;
    const current = document.createElement('p');
    current.className = `tier__current${level ? '' : ' muted'}`;
    current.innerHTML = level ? LEAF_SVG : '';
    current.append(level ? tierLabel(level - 1) : 'No tier yet');
    const text = document.createElement('div');
    text.className = 'tier__text';
    text.append(title, current);

    // A 3D coin in the tier's material, a dark blank before the first one.
    const coin = document.createElement('span');
    coin.className = `tier-coin ${level ? `tier-coin--t${level - 1}` : 'tier-coin--blank'}`;
    coin.innerHTML = tierIcon(Math.max(0, level - 1), 26);
    head.append(coin, text);

    // One segment per tier; the next one fills partway with progress towards it.
    const pips = document.createElement('ol');
    pips.className = 'tier__pips';
    track.thresholds.forEach((n, i) => {
      const pip = document.createElement('li');
      const at = reachedAt[i];
      pip.className = `tier__pip${at !== null ? ' is-reached' : ''}`;
      pip.style.setProperty('--pip', `var(--tier-${i})`);
      pip.style.setProperty('--pip-edge', `var(--tier-${i}-edge)`);
      if (i === level) {
        const prev = level ? track.thresholds[level - 1]! : 0;
        const fill = document.createElement('span');
        fill.className = 'tier__fill';
        fill.style.inlineSize = `${Math.min(100, Math.max(0, ((p.value - prev) / (n - prev)) * 100))}%`;
        pip.append(fill);
      }
      const label = `${tierLabel(i)}: ${track.describe(n)}`;
      pip.title = at !== null ? `${label} — reached ${dateFmt.format(at)}` : label;
      const name = document.createElement('span');
      name.className = 'visually-hidden';
      name.textContent = at !== null ? `${pip.title}.` : `${label}, not reached yet.`;
      pip.append(name);
      pips.append(pip);
    });

    li.append(head, pips);

    const next = track.thresholds[level];
    const foot = document.createElement('p');
    foot.className = 'tier__next muted';
    if (next === undefined) {
      foot.textContent = `All five tiers reached — ${track.describe(track.thresholds.at(-1)!)}.`;
    } else {
      foot.textContent = `${amount(p)} of ${next} ${track.unit(next)} to ${tierLabel(level)}`;
    }
    li.append(foot);
    return li;
  }

  /** The track's plant, as tall as its tier, standing on the grove's ground line. */
  function renderPlant(p: TrackProgress): HTMLLIElement {
    const { track, level } = p;
    const li = document.createElement('li');
    li.className = 'grove__plant';
    const plant = document.createElement('span');
    plant.className = `grove__glyph${level ? '' : ' is-bare'}`;
    plant.innerHTML = tierIcon(Math.max(0, level - 1), 36 + level * 10);
    const name = document.createElement('span');
    name.className = 'grove__tier';
    if (level) {
      const dot = document.createElement('span');
      dot.className = 'grove__dot';
      dot.style.setProperty('--pip', `var(--tier-${level - 1})`);
      dot.style.setProperty('--pip-edge', `var(--tier-${level - 1}-edge)`);
      name.append(dot, TIER_MATERIALS[level - 1]!);
    } else {
      name.textContent = 'Not yet';
    }
    const title = document.createElement('span');
    title.className = 'grove__track';
    title.textContent = track.title;
    const say = document.createElement('span');
    say.className = 'visually-hidden';
    say.textContent = level ? `: ${TIER_NAMES[level - 1]}.` : ': no tier yet.';
    title.append(say);
    li.append(plant, name, title);
    return li;
  }

  onPage('reward-tiers', () => {
    const c = cleanups();
    document.querySelectorAll<HTMLElement>('[data-reward-tiers]').forEach((root) => {
      const list = root.querySelector<HTMLElement>('[data-tiers-list]')!;
      const grove = root.querySelector<HTMLElement>('[data-tiers-grove]')!;
      const intro = root.querySelector<HTMLElement>('.tiers__intro')!;
      const seed = root.querySelector<HTMLElement>('[data-tiers-seed]')!;
      const render = () => {
        const progress = allProgress({ sessions: getSessions(), done: getDone(), ...chainInput(getChain()) });
        // Nothing has counted yet: one seed and the first goal, not four ladders of "not yet".
        const bare = progress.every((p) => p.value === 0);
        seed.hidden = !bare;
        grove.hidden = list.hidden = intro.hidden = bare;
        if (bare) {
          const focus = progress.find((p) => p.track.id === 'focus') ?? progress[0]!;
          const goal = focus.track.thresholds[0]!;
          root.querySelector('[data-tiers-seed-text]')!.textContent =
            `Focus for ${goal} ${focus.track.unit(goal)} in total to grow your first ${TIER_NAMES[0]}.`;
          root.querySelector('[data-tiers-seed-count]')!.textContent = `0 of ${goal} ${focus.track.unit(goal)}`;
          root.querySelector('[data-tiers-seed-coins]')!.replaceChildren(
            ...TIER_NAMES.map((name, i) => {
              const li = document.createElement('li');
              const coin = document.createElement('span');
              coin.className = `tier-coin tier-coin--t${i}`;
              coin.innerHTML = tierIcon(i, 18);
              li.append(coin, name);
              return li;
            }),
          );
          return;
        }
        grove.replaceChildren(...progress.map(renderPlant));
        list.replaceChildren(...progress.map(renderTrack));
      };
      render();
      c.add(subscribe('sessions', render));
      c.add(subscribe('done', render));
      c.add(subscribe('chain', render));
    });
    return c.run;
  });
</script>

<style>
  .tiers [hidden] {
    display: none;
  }

  .seed {
    display: grid;
    justify-items: center;
    gap: var(--space-2);
    text-align: center;
  }

  .seed__title {
    font-size: var(--text-lg);
  }

  .seed__bar {
    justify-self: stretch;
    block-size: 10px;
    border-radius: 5px;
    background: var(--well-bg);
    box-shadow: var(--well-shadow);
  }

  .seed__count {
    justify-self: end;
    font-size: var(--text-xs);
  }

  .seed__ahead {
    justify-self: start;
    margin-top: var(--space-3);
    font-size: var(--text-base);
  }

  .seed__coins {
    justify-self: stretch;
    display: flex;
    justify-content: space-between;
    gap: var(--space-1);
    padding: 0;
    list-style: none;
  }

  .seed__coins :global(li) {
    display: grid;
    justify-items: center;
    gap: var(--space-1);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  /* Ahead, not reached: the coins sit back until they are earned. */
  .seed__coins :global(.tier-coin) {
    --coin-size: 36px;
    margin: 0;
    opacity: 0.45;
  }

  .tiers__intro {
    margin-top: var(--space-1);
    font-size: var(--text-sm);
  }

  .tiers__grid {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-4);
    padding: 0;
    list-style: none;
  }

  @media (min-width: 40rem) {
    .tiers__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .tiers__grid :global(.tier) {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5) var(--space-5);
    background: var(--well-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--well-shadow);
    min-width: 0;
  }

  .tiers__grid :global(.tier__head) {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .tiers__grid :global(.tier__text) {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  /* The grove: four plants on one ground line, each as tall as its tier. */
  .grove {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-1);
    margin-top: var(--space-4);
    padding: var(--space-4) var(--space-2) var(--space-3);
    list-style: none;
    background: var(--well-bg);
    border-radius: var(--radius-lg);
    box-shadow: var(--well-shadow);
  }

  .grove :global(.grove__plant) {
    display: grid;
    justify-items: center;
    align-content: start;
    gap: 2px;
    min-width: 0;
    text-align: center;
  }

  .grove :global(.grove__glyph) {
    display: grid;
    align-items: end;
    justify-items: center;
    block-size: 84px;
    inline-size: 100%;
    margin-bottom: var(--space-2);
    color: var(--color-accent);
    border-bottom: 6px solid var(--heat-edge-2);
    border-radius: 0 0 3px 3px;
  }

  .grove :global(.grove__glyph.is-bare) {
    color: var(--color-border-strong);
  }

  .grove :global(.grove__tier) {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .grove :global(.grove__dot) {
    inline-size: 10px;
    block-size: 10px;
    border-radius: 50%;
    background: var(--pip);
    box-shadow: 0 1.5px 0 var(--pip-edge);
  }

  .grove :global(.grove__track) {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    overflow-wrap: anywhere;
  }

  .tiers__grid :global(.tier__title) {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .tiers__grid :global(.tier__current) {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-accent);
  }

  .tiers__grid :global(.tier__current.muted) {
    font-weight: 500;
    color: var(--color-text-muted);
  }

  .tiers__grid :global(.tier__pips) {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--space-1);
    padding: 0;
    list-style: none;
  }

  .tiers__grid :global(.tier__pip) {
    block-size: 0.625rem;
    border-radius: var(--radius-pill);
    background: var(--heat-0);
    box-shadow: inset 0 1px 2px rgb(0 0 0 / 0.35);
    overflow: hidden;
  }

  /* Each segment is the colour of its tier's coin. */
  .tiers__grid :global(.tier__pip.is-reached) {
    background: var(--pip);
    box-shadow: 0 2px 0 var(--pip-edge);
  }

  .tiers__grid :global(.tier__fill) {
    display: block;
    block-size: 100%;
    background: var(--pip);
    border-radius: inherit;
  }

  .tiers__grid :global(.tier__next) {
    font-size: var(--text-xs);
  }
</style>
