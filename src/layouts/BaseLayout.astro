---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import AppNav from '../components/AppNav.astro';
import GroveSpark from '../components/GroveSpark.astro';
import Ambient from '../components/Ambient.astro';
import RewardNotice from '../components/RewardNotice.astro';
import UndoToast from '../components/UndoToast.astro';
import { ClientRouter } from 'astro:transitions';
import { NATIVE_APP } from '../config/app';
import { MODULES, SITE } from '../config/site';
import { SCENES } from '../lib/storage';
import { url } from '../lib/paths';

interface Props {
  title?: string;
  description?: string;
  /** A page on its own, with no header, footer or bottom bar (Welcome). */
  bare?: boolean;
}

const { title, description = SITE.description, bare = false } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.name}` : SITE.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
const swUrl = url('/sw.js');
const swScope = url('/');
const sceneIds = SCENES.join('|');
const moduleIds = MODULES.map((m) => m.id);
const homePath = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
// Only the app opens on Welcome; the site's home page explains itself.
const welcomeUrl = NATIVE_APP ? url('/welcome') : null;
---

<!doctype html>
<html lang={SITE.lang} data-theme="dark" data-bg="sunrise" data-bg-kind="glow" data-motion="on" data-app={NATIVE_APP ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="apple-touch-icon" href={url('/icons/apple-touch-icon.png')} />
    <link rel="manifest" href={url('/manifest.webmanifest')} />
    <meta name="theme-color" content="#0e1512" />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content={SITE.owner} />
    <meta name="copyright" content={`© ${new Date().getFullYear()} ${SITE.owner}`} />

    <!--
      Apply saved theme + background before first paint (no flash). Must be inline so it
      runs synchronously. Keys and defaults match src/lib/storage.ts.
      The client-side router resets <html> attributes to the new page's defaults on every
      navigation, so the same function runs again on astro:after-swap.
    -->
    <script is:inline define:vars={{ sceneIds, moduleIds, homePath, welcomeUrl }}>
      (function () {
        var root = document.documentElement;
        var scenes = new RegExp('^(' + sceneIds + ')$');
        function get(name) {
          try {
            return JSON.parse(localStorage.getItem('rw:v1:' + name) || 'null');
          } catch (e) {
            return null;
          }
        }
        function apply() {
          var t = get('theme');
          if (t === 'light' || t === 'auto') root.dataset.theme = t;
          var a = get('appearance');
          if (a && (/^(sunrise|meadow|lavender|plain)$/.test(a.bg) || scenes.test(a.bg))) {
            root.dataset.bg = a.bg;
            root.dataset.bgKind = scenes.test(a.bg) ? 'scene' : 'glow';
          }
          if (a && a.motion === false) root.dataset.motion = 'off';
          applyModules();
        }
        // Optional sections (src/lib/profile.ts): someone with data from before Welcome keeps them all.
        function holds(v) {
          if (Array.isArray(v)) return v.length > 0;
          if (v && typeof v === 'object') return Object.keys(v).some(function (k) { return holds(v[k]); });
          return false;
        }
        function hasData() {
          return ['sessions', 'tasks', 'done', 'chain', 'exam', 'health'].some(function (n) { return holds(get(n)); });
        }
        function applyModules() {
          var p = get('profile');
          var old = !p && hasData();
          moduleIds.forEach(function (id) {
            if (old || (p && p.modules && p.modules[id])) root.setAttribute('data-mod-' + id, '');
            else root.removeAttribute('data-mod-' + id);
          });
          return p || (old ? { welcomed: true } : null);
        }
        apply();
        document.addEventListener('astro:after-swap', apply);
        // A brand-new user opening Today goes to Welcome first.
        var here = location.pathname.replace(/index\.html$/, '');
        if (welcomeUrl && here === homePath && !(applyModules() || {}).welcomed) location.replace(welcomeUrl);
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <Ambient />
    <a class="skip-link" href="#main">Skip to content</a>
    {!bare && <SiteHeader />}
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {/* The Android app has a bottom bar where the site has its footer. */}
    {!bare && (NATIVE_APP ? <AppNav /> : <SiteFooter />)}
    <RewardNotice />
    <UndoToast />
    <GroveSpark />

    {
      /* Service worker only in production builds — in dev it would cache stale files.
         Not in the Android app either: its files are already on the device. */
      import.meta.env.PROD && !NATIVE_APP && (
        <script is:inline define:vars={{ swUrl, swScope }}>
          if ('serviceWorker' in navigator) {
            window.addEventListener('load', function () {
              navigator.serviceWorker.register(swUrl, { scope: swScope }).catch(function () {});
            });
          }
        </script>
      )
    }
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: var(--space-4);
    top: -100px;
    z-index: 100;
    padding: var(--space-2) var(--space-4);
    background: var(--color-accent);
    color: var(--color-on-accent);
    border-radius: var(--radius-sm);
    font-weight: 600;
  }

  .skip-link:focus {
    top: var(--space-2);
  }

  main {
    flex: 1;
    padding-bottom: var(--space-8);
  }

  main:focus {
    outline: none;
  }
</style>
