---
import BaseLayout from '../layouts/BaseLayout.astro';
import Today from '../components/Today.astro';
import InTheWay from '../components/InTheWay.astro';
import { NATIVE_APP } from '../config/app';
import { SITE } from '../config/site';
---

<BaseLayout>
  <div class="container home">
    {
      /* The site says what it is first; the Android app opens straight on Today. */
      !NATIVE_APP && (
        <header class="hero">
          <h1>
            Make the work feel <span class="hero__accent">worth doing.</span>
          </h1>
          <p class="hero__lead">{SITE.tagline}</p>
        </header>
      )
    }
    <Today />
    <InTheWay />
  </div>
</BaseLayout>

<style>
  .home {
    display: grid;
    gap: var(--space-2);
  }

  /* The row below belongs with Today's cards, so it sits as close as they do to each other. */
  .home :global(.today) {
    padding-bottom: var(--space-2);
  }

  .hero {
    padding-block: var(--space-6) var(--space-2);
  }

  .hero h1 {
    font-size: clamp(2.2rem, 1.5rem + 3vw, 3.5rem);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .hero__accent {
    color: var(--color-accent);
  }

  .hero__lead {
    margin-top: var(--space-3);
    max-width: 38rem;
    color: var(--color-text-muted);
  }
</style>
