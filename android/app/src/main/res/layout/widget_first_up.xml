<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fu_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <TextView
        android:id="@+id/fu_count"
        android:text="+"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/widget_count_bg"
        android:gravity="center"
        android:textColor="#FFEEF1EC"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_first_up_label"
            android:textAllCaps="true"
            android:textColor="#FF8FE0AE"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/fu_title"
            android:text="@string/widget_first_up_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFEEF1EC"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/fu_meta"
            android:text="@string/widget_first_up_empty_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFA7B3AB"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/fu_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="6dp"
            android:visibility="gone"
            android:progressDrawable="@drawable/widget_progress" />
    </LinearLayout>

    <ImageView
        android:id="@+id/fu_play"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/widget_play_bg"
        android:contentDescription="@string/widget_start"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="16dp"
        android:src="@drawable/ic_widget_play" />
</LinearLayout>
