---
/**
 * The Android app's bottom bar (BaseLayout shows it only in the app build): Today, Focus,
 * Grove and You, plus Health and Budget while those sections are on (src/lib/profile.ts).
 * The current one is marked with a pill behind its icon. The timer, tasks, exam prep and
 * the techniques all live under Focus, as its tabs (FocusTabs.astro).
 */
import { FOCUS, type NavItem } from '../config/site';
import { isCurrent, url } from '../lib/paths';

const current = Astro.url.pathname;

const ITEMS: (NavItem & { icon: string })[] = [
  { label: 'Today', href: '/', icon: 'M4 11l8-7 8 7v8a1 1 0 0 1-1 1h-4v-6H9v6H5a1 1 0 0 1-1-1z' },
  { ...FOCUS, icon: 'M12 5a8 8 0 1 1 0 16 8 8 0 0 1 0-16zM12 9v4l2.5 2M9 2h6' },
  { label: 'Health', href: '/health', module: 'health', icon: 'M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z' },
  { label: 'Budget', href: '/budget', module: 'budget', icon: 'M5 6h14a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2zM3 10h18M16 15h2' },
  { label: 'Grove', href: '/progress', icon: 'M12 21v-9M12 14c-4 0-6-3-6-6 4 0 6 2 6 6zM12 12c0-4 3-7 7-7 0 4-3 7-7 7z' },
  { label: 'You', href: '/account', icon: 'M12 4a4 4 0 1 1 0 8 4 4 0 0 1 0-8zM4 21c1-4 4-6 8-6s7 2 8 6' },
];
---

<nav class="app-nav" aria-label="Main">
  <ul>
    {
      ITEMS.map((item) => (
        <li data-module={item.module}>
          <a href={url(item.href)} aria-current={isCurrent(current, item) ? 'page' : undefined}>
            <span class="app-nav__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22">
                <path d={item.icon} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  import { mountDeviceSync } from '../scripts/device-sync';
  import { mountBankSync } from '../scripts/bank-sync';
  import { onPage } from '../lib/page';
  onPage('device-sync', mountDeviceSync);
  onPage('bank-sync', mountBankSync);
</script>

<style is:global>
  /* Room for the bar under the page, and for toasts above it (RewardNotice, UndoToast). */
  html[data-app] {
    --app-nav-h: calc(4.25rem + env(safe-area-inset-bottom, 0px));
  }

  html[data-app] body {
    padding-bottom: var(--app-nav-h);
  }

  /* A phone screen has less room for the page's introduction than the site does. */
  html[data-app] .page-header {
    padding-block: var(--space-4) var(--space-3);
  }

  html[data-app] .page-header h1 {
    font-size: var(--text-xl);
  }

  html[data-app] .page-header p {
    font-size: var(--text-sm);
  }
</style>

<style>
  .app-nav {
    position: fixed;
    inset-inline: 0;
    inset-block-end: 0;
    z-index: 20;
    padding-bottom: env(safe-area-inset-bottom, 0px);
    border-top: 1px solid var(--color-border);
    background: var(--header-bg);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    backdrop-filter: saturate(1.4) blur(14px);
  }

  .app-nav ul {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    max-width: 34rem;
    margin-inline: auto;
    padding: 0 var(--space-1);
    list-style: none;
  }

  .app-nav a {
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 2px;
    min-height: 4.25rem;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: 500;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }

  .app-nav__icon {
    display: grid;
    place-items: center;
    inline-size: 3.75rem;
    block-size: 2rem;
    border-radius: 1rem;
    transition: background-color var(--duration-base) var(--ease-out);
  }

  .app-nav a:active .app-nav__icon {
    background: var(--color-surface-2);
  }

  .app-nav a[aria-current='page'] {
    color: var(--color-text);
    font-weight: 700;
  }

  .app-nav a[aria-current='page'] .app-nav__icon {
    background: var(--color-accent-soft);
    color: var(--color-accent);
  }
</style>
