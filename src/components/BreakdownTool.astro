---
/**
 * Task breakdown: split a big task into small steps and tick them off.
 * Edits the *current* task (tasks in src/lib/storage.ts); /tasks lists them all.
 * Ticked steps are also logged in the Done list (unticking removes them again).
 * Also the task's notes (saved as you type) and its session log from the timer.
 */
import { url } from '../lib/paths';
import { NOTES_MAX } from '../lib/storage';

interface Props {
  heading?: string;
  intro?: string;
  /** Off on the tasks page itself. */
  linkToTasks?: boolean;
}
const {
  heading = 'Try it: break it down',
  linkToTasks = true,
  intro = 'Make each step small enough that you could start it in two minutes.',
} = Astro.props;
---

<section class="card breakdown" data-breakdown aria-labelledby="bd-heading">
  <h2 id="bd-heading" class="panel-title">{heading}</h2>
  <p class="muted bd__intro">{intro}</p>

  <label class="bd__label" for="bd-task">The big task</label>
  <input id="bd-task" class="input" type="text" maxlength="120" autocomplete="off" placeholder="e.g. Write the project report" data-bd-task />

  <form class="bd__add" data-bd-form>
    <label class="bd__label" for="bd-step">Add a step</label>
    <div class="bd__row">
      <input id="bd-step" class="input" type="text" maxlength="120" autocomplete="off" placeholder="e.g. Open the doc and write the headings" data-bd-step />
      <button type="submit" class="btn">Add</button>
    </div>
  </form>

  <p class="bd__progress" data-bd-progress hidden></p>
  <ol class="bd__steps" data-bd-steps></ol>

  <div class="bd__finish" data-bd-finish hidden>
    <button type="button" class="btn" data-bd-done>Mark the whole task done</button>
  </div>
  <div class="bd__finish" data-bd-finished hidden>
    <p class="bd__finished-text">Finished — it's in your Done list.</p>
    <button type="button" class="btn btn--ghost btn--small" data-bd-reopen>Reopen</button>
  </div>

  <div class="bd__notes" data-bd-notes-wrap hidden>
    <div class="bd__notes-head">
      <label class="bd__label" for="bd-notes">Notes</label>
      <span class="muted bd__saved" data-bd-saved></span>
    </div>
    <textarea
      id="bd-notes"
      class="input bd__notes-input"
      rows="4"
      maxlength={NOTES_MAX}
      placeholder="Links, ideas, where you left off…"
      data-bd-notes></textarea>
  </div>

  <details class="disclosure bd__log" data-bd-log-wrap hidden>
    <summary data-bd-log-summary>Session log</summary>
    <ol class="bd__log-list" data-bd-log></ol>
  </details>

  <div class="bd__footer" data-bd-footer hidden>
    <button type="button" class="btn btn--ghost btn--small" data-bd-clear>Start a new task</button>
    <span class="muted bd__note">Ticked steps also appear in your Done list. {linkToTasks && <a href={url('/tasks')}>All your tasks</a>}</span>
  </div>
  <p class="visually-hidden" aria-live="polite" data-bd-live></p>
</section>

<script>
  import { createTask, getCurrentTask, setCurrentTask, subscribe, updateTask } from '../lib/storage';
  import { addStep, ensureCurrentTask, finishTask, formatFocus, removeStep, reopenTask, setStepDone, setTaskNotes } from '../lib/tasks';
  import { celebrate } from '../lib/appearance';
  import { offerUndo } from '../lib/undo';
  import { cleanups, onPage } from '../lib/page';

  const X_SVG =
    '<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>';

  const logFmt = new Intl.DateTimeFormat(undefined, { weekday: 'short', day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit' });
  const NOTES_SAVE_MS = 500;

  onPage('breakdown', () => {
    const c = cleanups();
    document.querySelectorAll<HTMLElement>('[data-breakdown]').forEach((root) => {
      const $ = <E extends Element>(s: string) => root.querySelector<E>(s)!;
      const title = $<HTMLInputElement>('[data-bd-task]');
      const form = $<HTMLFormElement>('[data-bd-form]');
      const stepInput = $<HTMLInputElement>('[data-bd-step]');
      const progress = $<HTMLElement>('[data-bd-progress]');
      const list = $<HTMLOListElement>('[data-bd-steps]');
      const finish = $<HTMLElement>('[data-bd-finish]');
      const finished = $<HTMLElement>('[data-bd-finished]');
      const reopen = $<HTMLButtonElement>('[data-bd-reopen]');
      const footer = $<HTMLElement>('[data-bd-footer]');
      const live = $<HTMLElement>('[data-bd-live]');
      const notesWrap = $<HTMLElement>('[data-bd-notes-wrap]');
      const notes = $<HTMLTextAreaElement>('[data-bd-notes]');
      const saved = $<HTMLElement>('[data-bd-saved]');
      const logWrap = $<HTMLDetailsElement>('[data-bd-log-wrap]');
      const logSummary = $<HTMLElement>('[data-bd-log-summary]');
      const logList = $<HTMLOListElement>('[data-bd-log]');

      /** Notes save shortly after you stop typing; this is the task they belong to. */
      let notesFor: string | null = null;
      let shownTask: string | null = null;
      let notesTimer = 0;
      function saveNotes(): void {
        window.clearTimeout(notesTimer);
        if (!notesFor) return;
        const id = notesFor;
        notesFor = null;
        setTaskNotes(id, notes.value);
        saved.textContent = 'Saved';
      }

      /** Removed steps still offered for Undo (src/lib/undo.ts). */
      const removing = new Set<string>();

      const announce = (t: string) => {
        live.textContent = '';
        window.setTimeout(() => (live.textContent = t), 50);
      };

      function render(): void {
        const task = getCurrentTask();
        const steps = (task?.steps ?? []).filter((s) => !removing.has(s.id));
        if (document.activeElement !== title) title.value = task?.title ?? '';
        const done = steps.filter((s) => s.done).length;
        const isDone = task?.status === 'done';
        progress.hidden = steps.length === 0;
        progress.textContent = `${done} of ${steps.length} step${steps.length === 1 ? '' : 's'} done${done === steps.length && done > 0 ? ' — the whole thing. Well done.' : ''}`;
        // Offer to finish the task once every step is ticked.
        finish.hidden = !task || isDone || steps.length === 0 || done < steps.length;
        finished.hidden = !isDone;
        footer.hidden = !task;

        // Switching task mid-typing: save the old task's notes first.
        if (notesFor && notesFor !== task?.id) saveNotes();
        if (shownTask !== (task?.id ?? null)) saved.textContent = '';
        shownTask = task?.id ?? null;
        notesWrap.hidden = !task;
        if (document.activeElement !== notes) notes.value = task?.notes ?? '';

        const log = [...(task?.log ?? [])].reverse();
        logWrap.hidden = log.length === 0;
        logSummary.textContent = `Session log · ${log.length}`;
        logList.replaceChildren(
          ...log.map((entry) => {
            const li = document.createElement('li');
            li.className = 'bd__log-item';
            const when = document.createElement('p');
            when.className = 'bd__log-when muted';
            const time = document.createElement('time');
            time.dateTime = new Date(entry.at).toISOString();
            time.textContent = logFmt.format(entry.at);
            when.append(time, entry.focusSeconds >= 60 ? ` · ${formatFocus(entry.focusSeconds)} focus` : '');
            li.append(when);
            for (const [label, text] of [['Did', entry.did], ['Next', entry.next]] as const) {
              if (!text) continue;
              const p = document.createElement('p');
              const b = document.createElement('strong');
              b.textContent = `${label}: `;
              p.append(b, text);
              li.append(p);
            }
            return li;
          }),
        );

        list.replaceChildren(
          ...steps.map((step) => {
            const li = document.createElement('li');
            li.className = `bd__step${step.done ? ' is-done' : ''}`;
            const id = `bd-${step.id}`;

            const cb = document.createElement('input');
            cb.type = 'checkbox';
            cb.id = id;
            cb.checked = step.done;
            cb.addEventListener('change', () => {
              if (!task) return;
              setStepDone(task.id, step.id, cb.checked);
              if (cb.checked) celebrate();
              announce(`${step.text}: ${cb.checked ? 'done' : 'not done'}`);
              root.querySelector<HTMLInputElement>(`#${CSS.escape(id)}`)?.focus();
            });

            const label = document.createElement('label');
            label.htmlFor = id;
            label.textContent = step.text;

            const del = document.createElement('button');
            del.type = 'button';
            del.className = 'icon-btn';
            del.setAttribute('aria-label', `Remove step “${step.text}”`);
            del.innerHTML = X_SVG;
            del.addEventListener('click', () => {
              if (!task) return;
              stepInput.focus();
              removing.add(step.id);
              render();
              offerUndo({
                message: `Removed step “${step.text}”`,
                commit: () => {
                  removeStep(task.id, step.id);
                  removing.delete(step.id);
                },
                undo: () => {
                  removing.delete(step.id);
                  render();
                  announce(`Restored step: ${step.text}`);
                },
              });
              announce(`Removed step: ${step.text}. Press Undo to bring it back.`);
            });

            li.append(cb, label, del);
            return li;
          }),
        );
      }

      notes.addEventListener('input', () => {
        const task = getCurrentTask();
        if (!task) return;
        notesFor = task.id;
        saved.textContent = '';
        window.clearTimeout(notesTimer);
        notesTimer = window.setTimeout(saveNotes, NOTES_SAVE_MS);
      });
      notes.addEventListener('blur', saveNotes);
      c.add(saveNotes); // leaving the page mid-typing

      title.addEventListener('input', () => {
        const task = getCurrentTask();
        if (task) updateTask(task.id, () => ({ title: title.value }));
        else if (title.value.trim()) createTask(title.value);
      });

      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const text = stepInput.value.trim();
        if (!text) return;
        addStep(ensureCurrentTask().id, text);
        stepInput.value = '';
        stepInput.focus();
        announce(`Step added: ${text}`);
      });

      $<HTMLButtonElement>('[data-bd-done]').addEventListener('click', () => {
        const task = getCurrentTask();
        if (!task) return;
        finishTask(task.id);
        celebrate();
        announce('Task finished and logged in your Done list.');
        reopen.focus();
      });

      reopen.addEventListener('click', () => {
        const task = getCurrentTask();
        if (!task) return;
        reopenTask(task.id);
        announce('Task reopened.');
        stepInput.focus();
      });

      $<HTMLButtonElement>('[data-bd-clear]').addEventListener('click', () => {
        setCurrentTask(null);
        title.focus();
        announce('Ready for a new task. The last one is kept with your other tasks.');
      });

      render();
      c.add(subscribe('tasks', render));
    });
    return c.run;
  });
</script>

<style>
  .bd__intro {
    font-size: var(--text-sm);
    margin-bottom: var(--space-4);
  }

  .bd__label {
    display: block;
    margin-bottom: var(--space-1);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .bd__add {
    margin-top: var(--space-4);
  }

  .bd__row {
    display: flex;
    gap: var(--space-2);
  }

  .bd__row .input {
    flex: 1;
    min-width: 0;
  }

  .bd__progress {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-accent);
  }

  .bd__steps {
    margin-top: var(--space-2);
    padding-left: 0;
    list-style: none;
  }

  .breakdown :global(.bd__step) {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    border-bottom: 1px solid var(--color-border);
    max-width: none;
  }

  .breakdown :global(.bd__step input) {
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
    accent-color: var(--color-accent);
    cursor: pointer;
  }

  .breakdown :global(.bd__step label) {
    flex: 1;
    min-width: 0;
    padding-block: var(--space-3);
    overflow-wrap: anywhere;
    cursor: pointer;
    transition: color var(--duration-base) var(--ease-out);
  }

  .breakdown :global(.bd__step.is-done label) {
    color: var(--color-text-muted);
    text-decoration: line-through;
    text-decoration-thickness: 1.5px;
  }

  .bd__finish,
  .bd__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    margin-top: var(--space-4);
  }

  .bd__finish[hidden],
  .bd__footer[hidden] {
    display: none;
  }

  .bd__finished-text {
    font-weight: 600;
    color: var(--color-accent);
  }

  .bd__note {
    font-size: var(--text-xs);
  }

  .bd__notes {
    margin-top: var(--space-5);
  }

  .bd__notes[hidden],
  .bd__log[hidden] {
    display: none;
  }

  .bd__notes-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .bd__saved {
    font-size: var(--text-xs);
  }

  .bd__notes-input {
    display: block;
    inline-size: 100%;
    min-block-size: 6rem;
    field-sizing: content;
    max-block-size: 24rem;
    resize: vertical;
    line-height: 1.5;
  }

  .bd__log {
    margin-top: var(--space-3);
  }

  .bd__log-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .breakdown :global(.bd__log-item) {
    padding-block: var(--space-2);
    border-bottom: 1px solid var(--color-border);
    font-size: var(--text-sm);
    overflow-wrap: anywhere;
    max-width: none;
  }

  .breakdown :global(.bd__log-when) {
    font-size: var(--text-xs);
  }
</style>
