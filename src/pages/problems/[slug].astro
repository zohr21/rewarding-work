---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FocusTabs from '../../components/FocusTabs.astro';
import TechniqueCard from '../../components/TechniqueCard.astro';
import { getTechniquesForProblem } from '../../lib/techniques';
import { PROBLEMS, PROBLEM_SLUGS, type ProblemSlug } from '../../data/taxonomy';
import { url } from '../../lib/paths';
import { en } from '../../lib/i18n/en';

export function getStaticPaths() {
  return PROBLEM_SLUGS.map((slug) => ({ params: { slug } }));
}

// Build-time check: the problem texts are shown from the language lists, so en.ts must match.
const words = en as Record<string, unknown>;
for (const p of PROBLEM_SLUGS) {
  if (words[`problem.${p}`] !== PROBLEMS[p].title) throw new Error(`en.ts 'problem.${p}' must be ${JSON.stringify(PROBLEMS[p].title)}`);
  if (words[`problem.${p}.explanation`] !== PROBLEMS[p].explanation) throw new Error(`en.ts 'problem.${p}.explanation' must match src/data/taxonomy.ts`);
}

const slug = Astro.params.slug as ProblemSlug;
const problem = PROBLEMS[slug];
const techniques = await getTechniquesForProblem(slug);
const others = PROBLEM_SLUGS.filter((p) => p !== slug);
---

<BaseLayout title={problem.title} description={problem.explanation}>
  <div class="container">
    <FocusTabs />
    <header class="page-header">
      <p class="eyebrow" data-t="problem.eyebrow">Problem</p>
      <h1><q data-t={`problem.${slug}`}>{problem.title}</q></h1>
    </header>

    <div class="prose">
      <p class="lead" data-t={`problem.${slug}.explanation`}>{problem.explanation}</p>
    </div>

    <section class="matches" aria-labelledby="matches-heading">
      <h2 id="matches-heading" data-t="problem.canHelp" data-t-n={techniques.length}>Techniques that can help ({techniques.length})</h2>
      <div class="grid">
        {techniques.map((t) => <TechniqueCard technique={t} headingLevel="h3" />)}
      </div>
      <p class="more">
        <a href={url(`/techniques?problem=${slug}`)} data-t="problem.seeInLibrary">See these in the technique library</a>
      </p>
    </section>

    <nav class="others" aria-labelledby="others-heading">
      <h2 id="others-heading" data-t="problem.somethingElse">Something else?</h2>
      <ul>
        {
          others.map((p) => (
            <li>
              <a href={url(`/problems/${p}`)} data-t={`problem.${p}`}>{PROBLEMS[p].title}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</BaseLayout>

<style>
  .eyebrow {
    margin: 0 0 var(--space-2);
    font-size: var(--text-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-accent);
  }

  .lead {
    font-size: var(--text-lg);
  }

  .matches {
    margin-top: var(--space-7);
  }

  .grid {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-4);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
  }

  .more {
    margin-top: var(--space-4);
  }

  .others {
    margin-top: var(--space-7);
  }

  .others ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
    padding: 0;
    list-style: none;
  }

  .others a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--space-4);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    color: var(--color-text);
    text-decoration: none;
  }

  .others a:hover {
    background: var(--color-surface-2);
  }
</style>
