---
/**
 * An "achievement unlocked" toast when you reach a new tier (src/lib/rewards.ts), on
 * any page: slides in at the bottom corner with the tier's badge and a short sound
 * (covered by the timer's Sound setting). Several at once stack, one per tier.
 *
 * Only your own actions on this page announce a tier: data arriving from another tab
 * or from your account (e.g. signing in on a new device) updates the baseline quietly,
 * so the same tier is never celebrated twice across tabs or devices.
 */
import { url } from '../lib/paths';
---

<div class="achievements" data-reward-notice data-progress-url={url('/progress')} transition:persist="reward-notice">
  <ol class="achievements__stack" data-rn-stack></ol>
  <p class="visually-hidden" role="status" data-rn-live></p>

  <!-- Silver and above get the whole screen for a moment; the first two tiers stay a toast. -->
  <dialog class="tier-up" data-rn-dialog aria-labelledby="tier-up-name">
    <button type="button" class="tier-up__close" data-rn-close aria-label="Close">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path></svg>
    </button>
    <span class="tier-up__coin" data-rn-coin></span>
    <p class="tier-up__eyebrow" data-rn-eyebrow></p>
    <h2 id="tier-up-name" class="tier-up__name" data-rn-name></h2>
    <p class="tier-up__text" data-rn-text></p>
    <ol class="tier-up__ladder" data-rn-ladder></ol>
    <div class="tier-up__actions">
      <a class="btn" href={`${url('/progress')}#tiers`} data-rn-grove>See your grove</a>
      <button type="button" class="btn btn--ghost" data-rn-close>Keep going</button>
    </div>
  </dialog>
</div>

<script>
  import { getChain, getDone, getSessions, onWrite, subscribe, type StoreName } from '../lib/storage';
  import { chainInput, earnedTierIds, tierInfo, tierLabel, TIER_MATERIALS, TIER_NAMES, type TierInfo } from '../lib/rewards';
  import { tierIcon } from '../lib/tier-icons';
  import { armAudioUnlock, cueVolume, playAchievement } from '../lib/timer/cues';
  import { celebrate } from '../lib/appearance';
  import { cleanups, onPage } from '../lib/page';

  const WATCHED: StoreName[] = ['sessions', 'done', 'chain'];
  const SHOW_MS = 6500;
  /** Toasts after the first wait a moment each, so a burst reads as a sequence. */
  const STAGGER_MS = 700;
  const MAX_VISIBLE = 3;
  /** Tiers from this index up (Silver) are celebrated full-screen instead of with a toast. */
  const BIG_FROM = 2;

  const X_SVG =
    '<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>';

  const earnedNow = () => {
    return earnedTierIds({ sessions: getSessions(), done: getDone(), ...chainInput(getChain()) });
  };
  const capitalise = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

  // Module state outlives page swaps (the script runs once per visit).
  let known = new Set<string>();
  /** Announced during this visit — unticking and re-ticking something doesn't repeat it. */
  const announced = new Set<string>();
  const waiting: TierInfo[] = [];

  armAudioUnlock();

  onPage('reward-notice', () => {
    const c = cleanups();
    const root = document.querySelector<HTMLElement>('[data-reward-notice]');
    if (!root) return;
    const stack = root.querySelector<HTMLOListElement>('[data-rn-stack]')!;
    const live = root.querySelector<HTMLElement>('[data-rn-live]')!;
    const progressUrl = root.dataset.progressUrl!;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let paused = false;
    /** Toasts taken from `waiting` but still in their stagger delay. */
    let pending = 0;

    function dismiss(li: HTMLElement): void {
      if (li.classList.contains('is-leaving')) return;
      li.classList.add('is-leaving');
      const done = () => {
        li.remove();
        pump();
      };
      if (reduceMotion.matches) done();
      else li.addEventListener('animationend', done, { once: true });
    }

    /** Auto-dismiss, paused while the pointer or focus is on the stack. */
    function schedule(li: HTMLElement, ms: number): void {
      let left = ms;
      let started = Date.now();
      let timer = 0;
      const run = () => {
        started = Date.now();
        timer = window.setTimeout(() => dismiss(li), left);
      };
      const hold = () => {
        window.clearTimeout(timer);
        left = Math.max(1500, left - (Date.now() - started));
      };
      li.addEventListener('rn:hold', hold);
      li.addEventListener('rn:release', run);
      if (!paused) run();
    }

    function toast(tier: TierInfo): HTMLLIElement {
      const li = document.createElement('li');
      li.className = `achievement achievement--t${tier.index}`;

      const badge = document.createElement('span');
      badge.className = `tier-coin tier-coin--t${tier.index} achievement__badge`;
      badge.innerHTML = tierIcon(tier.index, 30);

      const body = document.createElement('a');
      body.className = 'achievement__body';
      body.href = progressUrl;
      const eyebrow = document.createElement('span');
      eyebrow.className = 'achievement__eyebrow';
      eyebrow.textContent = 'Achievement unlocked';
      const name = document.createElement('span');
      name.className = 'achievement__name';
      name.textContent = `${tierLabel(tier.index)} · ${tier.track.title}`;
      const text = document.createElement('span');
      text.className = 'achievement__text';
      text.textContent = `${capitalise(tier.track.describe(tier.threshold))}.`;
      const pips = document.createElement('span');
      pips.className = 'achievement__pips';
      pips.setAttribute('aria-hidden', 'true');
      TIER_NAMES.forEach((_, i) => {
        const pip = document.createElement('span');
        if (i <= tier.index) pip.className = 'is-on';
        pips.append(pip);
      });
      const tierOf = document.createElement('span');
      tierOf.className = 'achievement__of';
      tierOf.textContent = `Tier ${tier.index + 1} of ${TIER_NAMES.length}`;
      body.append(eyebrow, name, text, pips, tierOf);

      const close = document.createElement('button');
      close.type = 'button';
      close.className = 'achievement__close';
      close.setAttribute('aria-label', 'Dismiss');
      close.innerHTML = X_SVG;
      close.addEventListener('click', () => dismiss(li));

      li.append(badge, body, close);
      return li;
    }

    /** Show waiting tiers while there's room. */
    function pump(): void {
      const visible = stack.querySelectorAll('.achievement:not(.is-leaving)').length;
      const room = MAX_VISIBLE - visible - pending;
      waiting.splice(0, Math.max(0, room)).forEach((tier, i) => {
        pending++;
        window.setTimeout(() => {
          pending--;
          const li = toast(tier);
          stack.append(li);
          playAchievement(tier.index, cueVolume());
          schedule(li, SHOW_MS + i * STAGGER_MS);
        }, i * STAGGER_MS);
      });
    }

    const dialog = root.querySelector<HTMLDialogElement>('[data-rn-dialog]')!;
    const big: TierInfo[] = [];

    /** Fill the full-screen moment for one tier and open it; the next one waits for it to close. */
    function openBig(): void {
      const tier = big.shift();
      if (!tier || dialog.open) return;
      dialog.className = `tier-up tier-up--t${tier.index}`;
      const coin = dialog.querySelector<HTMLElement>('[data-rn-coin]')!;
      coin.className = `tier-coin tier-coin--t${tier.index} tier-up__coin`;
      coin.innerHTML = tierIcon(tier.index, 92);
      dialog.querySelector('[data-rn-eyebrow]')!.textContent =
        `${tier.index === TIER_NAMES.length - 1 ? 'Hardest tier' : 'New tier'} · ${tier.track.title}`;
      dialog.querySelector('[data-rn-name]')!.textContent = tierLabel(tier.index);
      dialog.querySelector('[data-rn-text]')!.textContent =
        `${capitalise(tier.track.describe(tier.threshold))}. This one stays yours, whatever tomorrow brings.`;
      const ladder = dialog.querySelector<HTMLElement>('[data-rn-ladder]')!;
      ladder.replaceChildren(
        ...TIER_NAMES.map((_, i) => {
          const li = document.createElement('li');
          if (i === tier.index) li.className = 'is-new';
          const c = document.createElement('span');
          c.className = `tier-coin ${i <= tier.index ? `tier-coin--t${i}` : 'tier-coin--blank'}`;
          c.innerHTML = tierIcon(i, 20);
          const label = document.createElement('span');
          label.textContent = TIER_MATERIALS[i]!;
          const say = document.createElement('span');
          say.className = 'visually-hidden';
          say.textContent = i <= tier.index ? ', reached.' : ', not reached yet.';
          label.append(say);
          li.append(c, label);
          return li;
        }),
      );
      dialog.showModal();
      playAchievement(tier.index, cueVolume());
    }

    const onDialogClick = (e: Event) => {
      // Buttons close it; so does the link, which then goes on to the grove.
      if ((e.target as HTMLElement).closest('[data-rn-close], [data-rn-grove]')) dialog.close();
    };
    dialog.addEventListener('click', onDialogClick);
    dialog.addEventListener('close', openBig);
    c.add(() => {
      dialog.removeEventListener('click', onDialogClick);
      dialog.removeEventListener('close', openBig);
    });

    function show(tiers: TierInfo[]): void {
      // Lowest first, so a burst builds up to the biggest one.
      const sorted = [...tiers].sort((a, b) => a.index - b.index);
      waiting.push(...sorted.filter((t) => t.index < BIG_FROM));
      big.push(...sorted.filter((t) => t.index >= BIG_FROM));
      openBig();
      const summary = sorted.map((t) => `${t.name}, ${t.track.describe(t.threshold)}`).join('. ');
      live.textContent = '';
      window.setTimeout(() => (live.textContent = `Achievement unlocked: ${summary}.`), 50);
      celebrate();
      pump();
    }

    let queued = false;
    let fromHere = false;
    /** Coalesce the writes of one action (a store change fires both listeners) into one check. */
    function queue(local: boolean): void {
      fromHere ||= local;
      if (queued) return;
      queued = true;
      queueMicrotask(() => {
        queued = false;
        const announce = fromHere;
        fromHere = false;
        const now = earnedNow();
        const fresh = announce ? [...now].filter((id) => !known.has(id) && !announced.has(id)) : [];
        known = now;
        fresh.forEach((id) => announced.add(id));
        const tiers = fresh.map(tierInfo).filter((t): t is TierInfo => t !== null);
        if (tiers.length) show(tiers);
      });
    }

    const each = (type: string) => stack.querySelectorAll('.achievement').forEach((li) => li.dispatchEvent(new Event(type)));
    const hold = () => {
      if (paused) return;
      paused = true;
      each('rn:hold');
    };
    const release = () => {
      if (!paused || stack.matches(':hover, :focus-within')) return;
      paused = false;
      each('rn:release');
    };
    const onKey = (e: KeyboardEvent) => {
      if (e.key !== 'Escape') return;
      const li = (e.target as HTMLElement).closest<HTMLElement>('.achievement');
      if (li) dismiss(li);
    };
    stack.addEventListener('pointerenter', hold);
    stack.addEventListener('pointerleave', release);
    stack.addEventListener('focusin', hold);
    const onFocusOut = () => window.setTimeout(release);
    stack.addEventListener('focusout', onFocusOut);
    stack.addEventListener('keydown', onKey);

    known = earnedNow();
    pump();
    c.add(() => {
      stack.removeEventListener('pointerenter', hold);
      stack.removeEventListener('pointerleave', release);
      stack.removeEventListener('focusin', hold);
      stack.removeEventListener('focusout', onFocusOut);
      stack.removeEventListener('keydown', onKey);
    });
    c.add(onWrite((name) => WATCHED.includes(name) && queue(true)));
    WATCHED.forEach((name) => c.add(subscribe(name, () => queue(false))));
    return c.run;
  });
</script>

<style>
  /* Deliberately dark in both themes, like a game overlay. */
  .achievements {
    --ach-bg: linear-gradient(135deg, #1e2a36 0%, #243748 60%, #2d4a60 100%);
    --ach-text: #e6edf3;
    --ach-muted: #9fb2c4;
    --ach-accent: #7ec8ff;
    position: fixed;
    inset-inline: var(--gutter) var(--gutter);
    /* Above the app's bottom bar (AppNav.astro), where there is one. */
    inset-block-end: calc(var(--space-4) + var(--app-nav-h, 0px));
    z-index: 50;
    pointer-events: none;
  }

  .achievements__stack {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .achievements :global(.achievement) {
    --tier: #8fd18a;
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    inline-size: min(100%, 22rem);
    padding: var(--space-3) var(--space-2) var(--space-3) var(--space-3);
    overflow: hidden;
    background: var(--ach-bg);
    color: var(--ach-text);
    border: 1px solid rgb(255 255 255 / 0.08);
    border-radius: 6px;
    box-shadow:
      0 10px 30px rgb(0 0 0 / 0.45),
      inset 0 1px 0 rgb(255 255 255 / 0.06);
    pointer-events: auto;
    animation: ach-in 520ms cubic-bezier(0.2, 0.9, 0.25, 1.15) both;
  }

  /* A light sweep across the card as it arrives. */
  .achievements :global(.achievement)::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, transparent 30%, rgb(255 255 255 / 0.14) 50%, transparent 70%);
    transform: translateX(-100%);
    animation: ach-sheen 1100ms 350ms ease-out both;
    pointer-events: none;
  }

  .achievements :global(.achievement.is-leaving) {
    animation: ach-out 320ms ease-in both;
  }

  /* The tier's material (tokens.css). */
  .achievements :global(.achievement--t0) { --tier: var(--tier-0); }
  .achievements :global(.achievement--t1) { --tier: var(--tier-1); }
  .achievements :global(.achievement--t2) { --tier: var(--tier-2); }
  .achievements :global(.achievement--t3) { --tier: var(--tier-3); }
  .achievements :global(.achievement--t4) { --tier: var(--tier-4); }

  /* A coin (.tier-coin in global.css), like the brand mark and the tiers on the Progress page. */
  .achievements :global(.achievement__badge) {
    --coin-size: 3.5rem;
    animation: ach-pop 600ms 180ms cubic-bezier(0.3, 1.6, 0.5, 1) both;
  }

  /* ---------- Full-screen tier moment ---------- */
  .tier-up {
    --tier: var(--tier-2);
    pointer-events: auto;
    position: fixed;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    max-inline-size: none;
    max-block-size: none;
    margin: 0;
    padding: calc(var(--space-7) + env(safe-area-inset-top, 0px)) var(--space-5) calc(var(--space-5) + env(safe-area-inset-bottom, 0px));
    border: 0;
    background: #0e1512;
    color: #eef1ec;
    text-align: center;
    overflow-y: auto;
  }

  .tier-up[open] {
    display: grid;
    justify-items: center;
    align-content: center;
    gap: var(--space-3);
  }

  .tier-up::backdrop {
    background: #0e1512;
  }

  .tier-up--t3 {
    --tier: var(--tier-3);
  }

  /* Diamond gets its own night-blue ground. */
  .tier-up--t4 {
    --tier: #a9e4fb;
    background: #0a1016;
  }

  .tier-up__close {
    position: absolute;
    inset-block-start: calc(var(--space-3) + env(safe-area-inset-top, 0px));
    inset-inline-end: var(--space-3);
    display: grid;
    place-items: center;
    inline-size: 48px;
    block-size: 48px;
    border: 0;
    border-radius: var(--radius-md);
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .tier-up :global(.tier-up__coin) {
    --coin-size: min(11rem, 46vw);
    margin-bottom: var(--space-5);
    box-shadow:
      inset 0 3px 0 rgb(255 255 255 / 0.55),
      inset 0 -12px 20px rgb(0 0 0 / 0.16),
      0 14px 0 var(--coin-edge),
      0 0 60px -6px color-mix(in srgb, var(--coin) 70%, transparent);
    animation: ach-pop 700ms 120ms cubic-bezier(0.3, 1.6, 0.5, 1) both;
  }

  .tier-up__eyebrow {
    color: var(--tier);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .tier-up__name {
    font-size: clamp(2.2rem, 1.4rem + 4vw, 3.2rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .tier-up__text {
    max-inline-size: 22rem;
    color: #a7b3ab;
  }

  .tier-up__ladder {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--space-1);
    inline-size: min(100%, 22rem);
    margin-top: var(--space-3);
    padding: var(--space-3) var(--space-2);
    list-style: none;
    border-radius: var(--radius-lg);
    background: rgb(0 0 0 / 0.35);
    box-shadow: inset 0 2px 5px rgb(0 0 0 / 0.6);
  }

  .tier-up__ladder :global(li) {
    display: grid;
    justify-items: center;
    gap: 2px;
    color: #a7b3ab;
    font-size: 0.75rem;
  }

  .tier-up__ladder :global(li.is-new) {
    color: #eef1ec;
    font-weight: 700;
  }

  .tier-up__ladder :global(.tier-coin) {
    --coin-size: 2.25rem;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.5),
      0 3px 0 var(--coin-edge);
  }

  .tier-up__ladder :global(.tier-coin--blank) {
    background: #22302a;
    color: #6f8177;
    box-shadow: 0 3px 0 #050806;
    opacity: 1;
  }

  .tier-up__actions {
    display: grid;
    gap: var(--space-3);
    inline-size: min(100%, 22rem);
    margin-top: var(--space-5);
  }

  .tier-up__actions .btn {
    min-height: 52px;
  }

  .achievements :global(.achievement__body) {
    display: grid;
    flex: 1;
    min-width: 0;
    color: inherit;
    text-decoration: none;
  }

  .achievements :global(.achievement__body:hover .achievement__name) {
    text-decoration: underline;
  }

  .achievements :global(.achievement__eyebrow) {
    color: var(--ach-accent);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .achievements :global(.achievement__name) {
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .achievements :global(.achievement__text) {
    color: var(--ach-muted);
    font-size: var(--text-sm);
  }

  .achievements :global(.achievement__pips) {
    display: flex;
    gap: 3px;
    margin-top: var(--space-1);
  }

  .achievements :global(.achievement__pips span) {
    flex: 1;
    block-size: 4px;
    border-radius: 2px;
    background: rgb(255 255 255 / 0.12);
  }

  .achievements :global(.achievement__pips .is-on) {
    background: var(--tier);
  }

  .achievements :global(.achievement__of) {
    margin-top: 2px;
    color: var(--ach-muted);
    font-size: var(--text-xs);
  }

  .achievements :global(.achievement__close) {
    display: grid;
    place-items: center;
    align-self: flex-start;
    flex: none;
    inline-size: 32px;
    block-size: 32px;
    padding: 0;
    border: 0;
    border-radius: 4px;
    background: transparent;
    color: var(--ach-muted);
    cursor: pointer;
  }

  .achievements :global(.achievement__close:hover) {
    background: rgb(255 255 255 / 0.08);
    color: var(--ach-text);
  }

  @keyframes ach-in {
    from {
      opacity: 0;
      transform: translateY(110%);
    }
  }

  @keyframes ach-out {
    to {
      opacity: 0;
      transform: translateY(40%);
    }
  }

  @keyframes ach-sheen {
    to {
      transform: translateX(100%);
    }
  }

  @keyframes ach-pop {
    from {
      transform: scale(0.4);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .achievements :global(.achievement),
    .achievements :global(.achievement__badge),
    .achievements :global(.achievement.is-leaving) {
      animation: ach-fade 200ms ease-out both;
    }

    .achievements :global(.achievement)::after {
      display: none;
    }

    @keyframes ach-fade {
      from {
        opacity: 0;
      }
    }
  }
</style>
