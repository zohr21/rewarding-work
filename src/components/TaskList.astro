---
/**
 * All your tasks, in lists: Today (a short plan for the day, first up first), Next,
 * and Someday, plus an Inbox of thoughts jotted on the timer's scratchpad to sort.
 * One list shows at a time, picked from a row of tabs.
 * Add, move, break down, start a focus session on, finish, reopen or delete tasks.
 * Focus time comes from timer sessions whose label matched the task.
 */
import { NATIVE_APP } from '../config/app';
import { url } from '../lib/paths';

const timerUrl = url('/timer');
/** Offered while you have no tasks at all, so the first one is a tap away. */
const EXAMPLES = [
  { t: 'tasks.example1', text: 'Reply to emails' },
  { t: 'tasks.example2', text: 'Read chapter 3' },
  { t: 'tasks.example3', text: 'Tidy the desk' },
];
const TABS = [
  { id: 'inbox', label: 'Inbox', t: 'list.inbox' },
  { id: 'today', label: 'Today', t: 'list.today' },
  { id: 'next', label: 'Next', t: 'list.next' },
  { id: 'someday', label: 'Someday', t: 'list.someday' },
  { id: 'finished', label: 'Done', t: 'tasks.tabDone' },
];
---

<section class="card tasks" data-task-list data-timer-url={timerUrl} aria-labelledby="tasks-heading">
  <h2 data-t="tasks.yourTasks" id="tasks-heading" class="panel-title">Your tasks</h2>

  <div data-t-aria-label="tasks.lists" class="tasks__tabs" role="group" aria-label="Lists" data-tl-tabs>
    {
      TABS.map((tab) => (
        <button type="button" data-tl-tab={tab.id} aria-pressed={tab.id === 'today' ? 'true' : 'false'}>
          <span data-t={tab.t}>{tab.label}</span>
          <span class="tasks__tab-count" data-tl-tab-count />
        </button>
      ))
    }
  </div>

  <form class="tasks__form" data-tl-form>
    <label data-t="tasks.newTask" for="tl-new" class="visually-hidden">New task</label>
    <input data-t-placeholder="tasks.addATask" id="tl-new" class="input" type="text" maxlength="120" autocomplete="off" placeholder="Add a task…" data-tl-input />
    <label data-t="tasks.addTo" for="tl-new-list" class="visually-hidden">Add to</label>
    <select id="tl-new-list" class="input tasks__list-select" data-tl-new-list>
      <option data-t="tasks.today" value="today">Today</option>
      <option data-t="tasks.next" value="next" selected>Next</option>
      <option data-t="tasks.someday" value="someday">Someday</option>
    </select>
    <button data-t="tasks.add" type="submit" class="btn">Add</button>
  </form>

  <section class="tasks__section tasks__inbox" data-list="inbox" data-tl-inbox-wrap hidden aria-labelledby="tl-inbox-head">
    <h3 data-t="tasks.inbox" class="tasks__heading tasks__heading--inbox" id="tl-inbox-head" data-tl-inbox-head>Inbox</h3>
    <p data-t="tasks.thoughtsYouJottedOnThe" class="muted tasks__hint">Thoughts you jotted on the timer. Sort each one into a list, add it to a task's notes, or clear it.</p>
    <ul class="tasks__items" data-tl-inbox></ul>
  </section>

  <section class="tasks__section" data-list="today" aria-labelledby="tl-today-head">
    <h3 data-t="tasks.today" class="tasks__heading tasks__heading--today" id="tl-today-head" data-tl-today-head>Today</h3>
    <div class="tasks__carry" data-tl-carry hidden>
      <p data-tl-carry-text></p>
      <div class="tasks__carry-actions">
        <button data-t="tasks.keepForToday" type="button" class="btn btn--small" data-tl-carry-keep>Keep for today</button>
        <button data-t="tasks.moveToNext" type="button" class="btn btn--ghost btn--small" data-tl-carry-move>Move to Next</button>
      </div>
    </div>
    <ul class="tasks__items" data-tl-today></ul>
    <p class="muted tasks__hint" data-tl-today-hint></p>
  </section>

  <section class="tasks__section" data-list="next" aria-labelledby="tl-next-head">
    <h3 data-t="tasks.next" class="tasks__heading tasks__heading--next" id="tl-next-head" data-tl-next-head>Next</h3>
    <ul class="tasks__items" data-tl-next></ul>
    <p data-t="tasks.nothingHereAddATask" class="muted tasks__hint" data-tl-next-empty>Nothing here. Add a task above, or break one down below.</p>
  </section>

  <details class="disclosure tasks__section tasks__someday" data-list="someday" data-tl-someday-wrap hidden>
    <summary data-t="tasks.someday" class="tasks__heading tasks__heading--someday" data-tl-someday-head>Someday</summary>
    <ul class="tasks__items" data-tl-someday></ul>
  </details>

  <details class="disclosure tasks__finished" data-list="finished" data-tl-finished-wrap hidden>
    <summary data-t="tasks.finished" data-tl-finished-summary>Finished</summary>
    <ul class="tasks__items" data-tl-finished></ul>
  </details>
  <p class="muted tasks__hint" data-tl-view-empty hidden></p>
  <div class="tasks__examples" data-tl-examples hidden>
    <svg class="tasks__examples-icon" viewBox="0 0 24 24" width="32" height="32" aria-hidden="true">
      <path d="M9 6h11M9 12h11M9 18h11M4 6l1 1 2-2M4 12l1 1 2-2M4 18l1 1 2-2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
    <h3 data-t="tasks.planTodayWith1To" class="tasks__examples-title">Plan today with 1 to 3 tasks</h3>
    <p data-t="tasks.putTheOneYouD" class="muted">Put the one you'd most like to avoid first. Tap one to add it:</p>
    <div class="tasks__example-list">
      {EXAMPLES.map((ex) => <button type="button" class="tasks__example" data-tl-example data-t={ex.t}>{ex.text}</button>)}
    </div>
  </div>
  <p class="visually-hidden" aria-live="polite" data-tl-live></p>
</section>

<script>
  import { createTask, deleteTask, getCurrentTask, getSessions, getTasks, setCurrentTask, subscribe, type Task, type TaskList } from '../lib/storage';
  import {
    finishTask,
    focusByTask,
    formatFocus,
    isCarriedOver,
    jotToNotes,
    keepForToday,
    listLabel,
    listOf,
    moveTask,
    moveToTop,
    reopenTask,
    taskName,
    todayTasks,
    TODAY_SOFT_MAX,
  } from '../lib/tasks';
  import { currentStep, liveTaskId, stepBar } from '../lib/parts';
  import { celebrate } from '../lib/appearance';
  import { ring } from '../lib/charts';
  import { offerUndo } from '../lib/undo';
  import { cleanups, onPage } from '../lib/page';
  import { dateFormat, t, tn } from '../lib/i18n';

  const dayFmt = dateFormat({ day: 'numeric', month: 'short' });
  const weekdayFmt = dateFormat({ weekday: 'short' });
  const MOVABLE: TaskList[] = ['today', 'next', 'someday'];
  const X_SVG =
    '<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>';
  const CLOCK_SVG =
    '<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle cx="12" cy="13" r="8" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 9v4l3 2M9 3h6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>';
  /** The list the tabs are showing; kept for the visit, so coming back to Tasks lands where you were. */
  let appView = 'today';
  const VIEW_EMPTY: Record<string, string> = {
    inbox: t('tasks.emptyInbox'),
    someday: t('tasks.emptySomeday'),
    finished: t('tasks.emptyFinished'),
  };

  onPage('task-list', () => {
    const c = cleanups();
    document.querySelectorAll<HTMLElement>('[data-task-list]').forEach((root) => {
      const $ = <E extends Element>(s: string) => root.querySelector<E>(s)!;
      const form = $<HTMLFormElement>('[data-tl-form]');
      const input = $<HTMLInputElement>('[data-tl-input]');
      const newList = $<HTMLSelectElement>('[data-tl-new-list]');
      const inboxWrap = $<HTMLElement>('[data-tl-inbox-wrap]');
      const inboxHead = $<HTMLElement>('[data-tl-inbox-head]');
      const inboxList = $<HTMLUListElement>('[data-tl-inbox]');
      const todayHead = $<HTMLElement>('[data-tl-today-head]');
      const todayList = $<HTMLUListElement>('[data-tl-today]');
      const todayHint = $<HTMLElement>('[data-tl-today-hint]');
      const carry = $<HTMLElement>('[data-tl-carry]');
      const carryText = $<HTMLElement>('[data-tl-carry-text]');
      const nextHead = $<HTMLElement>('[data-tl-next-head]');
      const nextList = $<HTMLUListElement>('[data-tl-next]');
      const nextEmpty = $<HTMLElement>('[data-tl-next-empty]');
      const somedayWrap = $<HTMLDetailsElement>('[data-tl-someday-wrap]');
      const somedayHead = $<HTMLElement>('[data-tl-someday-head]');
      const somedayList = $<HTMLUListElement>('[data-tl-someday]');
      const finishedWrap = $<HTMLDetailsElement>('[data-tl-finished-wrap]');
      const finishedSummary = $<HTMLElement>('[data-tl-finished-summary]');
      const finishedList = $<HTMLUListElement>('[data-tl-finished]');
      const live = $<HTMLElement>('[data-tl-live]');
      const timerUrl = root.dataset.timerUrl!;
      const tabs = root.querySelector<HTMLElement>('[data-tl-tabs]');
      const viewEmpty = $<HTMLElement>('[data-tl-view-empty]');
      const examples = $<HTMLElement>('[data-tl-examples]');
      // The steps sheet (tasks.astro): a bottom sheet on a phone, a side panel on a wide screen.
      const sheet = document.querySelector<HTMLDialogElement>('[data-sheet="task-steps"]');

      function showView(view: string): void {
        if (!tabs) return;
        appView = view;
        root.dataset.view = view;
        tabs.querySelectorAll<HTMLElement>('[data-tl-tab]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.tlTab === view)));
        // These two fold away without the tabs; a tab shows its list outright.
        if (view === 'someday') somedayWrap.open = true;
        if (view === 'finished') finishedWrap.open = true;
        if ((MOVABLE as string[]).includes(view)) newList.value = view;
      }

      /**
       * Get the steps sheet (tasks.astro) ready for a task: the Sheet component opens it from
       * the button's [data-sheet-open], right after this runs.
       */
      function prepareSheet(task: Task): void {
        setCurrentTask(task.id);
        const go = sheet?.querySelector<HTMLAnchorElement>('[data-task-steps-focus]');
        if (go) go.href = `${timerUrl}?task=${encodeURIComponent(task.id)}`;
      }

      /** Deleted tasks still offered for Undo (src/lib/undo.ts). */
      const removing = new Set<string>();

      const announce = (t: string) => {
        live.textContent = '';
        window.setTimeout(() => (live.textContent = t), 50);
      };

      function button(text: string, onClick: () => void, cls = 'btn btn--ghost btn--small'): HTMLButtonElement {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = cls;
        b.textContent = text;
        b.addEventListener('click', onClick);
        return b;
      }

      function iconButton(label: string, onClick: () => void): HTMLButtonElement {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'icon-btn task__remove';
        b.setAttribute('aria-label', label);
        b.title = label.replace(/ “.*”$/, '');
        b.innerHTML = X_SVG;
        b.addEventListener('click', onClick);
        return b;
      }

      /** Title and meta on the left; the list picker and remove button on the right. */
      function head(body: HTMLElement, ...side: HTMLElement[]): HTMLDivElement {
        const row = document.createElement('div');
        row.className = 'task__head';
        const tools = document.createElement('div');
        tools.className = 'task__tools';
        tools.append(...side);
        row.append(body, tools);
        return row;
      }

      function badge(text: string, cls = ''): HTMLSpanElement {
        const b = document.createElement('span');
        b.className = `badge task__badge ${cls}`;
        b.textContent = text;
        return b;
      }

      /** A list heading: its name, then how many it holds (quieter). */
      function setHead(el: HTMLElement, label: string, count: string): void {
        el.replaceChildren(label);
        if (!count) return;
        const c = document.createElement('span');
        c.className = 'tasks__count';
        c.textContent = ` · ${count}`;
        el.append(c);
      }

      /** Focus time as a bar, relative to the open task with the most. */
      function focusBar(seconds: number, max: number): HTMLDivElement {
        const row = document.createElement('div');
        row.className = 'task__focus';
        row.setAttribute('aria-hidden', 'true');
        row.innerHTML = CLOCK_SVG;
        const meter = document.createElement('span');
        meter.className = 'task__meter';
        const fill = document.createElement('span');
        fill.style.inlineSize = `${Math.max(6, Math.round((seconds / max) * 100))}%`;
        meter.append(fill);
        row.append(meter);
        return row;
      }

      /** Delete with Undo (src/lib/undo.ts): hidden now, removed for real once the offer ends. */
      /** Take a task off the list with Undo: `message` on the toast, `said` for the screen reader. */
      function remove(task: Task, message: string, said: string): void {
        const name = taskName(task);
        input.focus();
        removing.add(task.id);
        render();
        offerUndo({
          message,
          commit: () => {
            deleteTask(task.id);
            removing.delete(task.id);
          },
          undo: () => {
            removing.delete(task.id);
            render();
            announce(t('tasks.restored', { name }));
          },
        });
        announce(said);
      }

      function moveSelect(task: Task): HTMLSelectElement {
        const name = taskName(task);
        const sel = document.createElement('select');
        sel.className = 'input tasks__list-select';
        sel.setAttribute('aria-label', t('tasks.listFor', { name }));
        for (const list of MOVABLE) {
          const o = document.createElement('option');
          o.value = list;
          o.textContent = listLabel(list);
          o.selected = listOf(task) === list;
          sel.append(o);
        }
        sel.addEventListener('change', () => {
          const list = sel.value as TaskList;
          moveTask(task.id, list);
          announce(t('tasks.movedTo', { name, list: listLabel(list) }));
          if (list === 'someday') somedayWrap.open = true;
        });
        return sel;
      }

      /** An Inbox thought: sort it into a list, file it in the current task's notes, or clear it. */
      function renderJot(task: Task, current: Task | null): HTMLLIElement {
        const li = document.createElement('li');
        li.className = 'task task--jot';
        const body = document.createElement('div');
        body.className = 'task__body';
        const title = document.createElement('p');
        title.className = 'task__title';
        title.textContent = task.title;
        const meta = document.createElement('p');
        meta.className = 'task__meta muted';
        meta.textContent = t('tasks.jotted', { date: dayFmt.format(task.createdAt) });
        body.append(title, meta);

        const actions = document.createElement('div');
        actions.className = 'task__actions';
        for (const list of MOVABLE) {
          const b = button(listLabel(list), () => {
            moveTask(task.id, list);
            announce(t('tasks.nowATask', { name: task.title, list: listLabel(list) }));
          });
          b.setAttribute('aria-label', t('tasks.makeTask', { name: task.title, list: listLabel(list) }));
          actions.append(b);
        }
        if (current && current.status === 'active' && current.id !== task.id) {
          const b = button(t('tasks.toNotes'), () => {
            jotToNotes(task.id, current.id);
            announce(t('tasks.addedToNotes', { task: taskName(current) }));
          });
          b.setAttribute('aria-label', t('tasks.addToNotesOf', { name: task.title, task: taskName(current) }));
          b.title = t('tasks.addToNotesTitle', { task: taskName(current) });
          actions.append(b);
        }
        const clear = iconButton(t('tasks.clear', { name: task.title }), () =>
          remove(task, t('tasks.clearedMsg', { name: task.title }), t('tasks.clearedSaid', { name: task.title })),
        );
        li.append(head(body, clear), actions);
        return li;
      }

      function renderTask(task: Task, currentId: string | null, focus: Map<string, number>, maxFocus: number, liveId: string | null, firstUp = false): HTMLLIElement {
        const live = task.id === liveId && task.status === 'active';
        const li = document.createElement('li');
        li.className = `task${firstUp ? ' task--first' : ''}${task.id === currentId ? ' is-current' : ''}${task.status === 'done' ? ' is-done' : ''}${live ? ' is-live' : ''}`;
        const name = taskName(task);

        const body = document.createElement('div');
        body.className = 'task__body';
        const title = document.createElement('p');
        title.className = 'task__title';
        title.textContent = name;
        if (firstUp) title.append(' ', badge(t('tasks.firstUp'), 'task__badge--first'));
        if (task.id === currentId) title.append(' ', badge(t('tasks.current')));
        if (task.status === 'active' && isCarriedOver(task)) title.append(' ', badge(t('tasks.fromDay', { day: weekdayFmt.format(task.todayAt!) }), 'task__badge--old'));
        const meta = document.createElement('p');
        meta.className = 'task__meta muted';
        const parts: string[] = [];
        const n = task.steps.length;
        const stepsDone = task.steps.filter((s) => s.done).length;
        const active = task.status === 'active';
        if (n) parts.push(tn('tasks.stepsOf', n, { done: stepsDone }));
        else if (active) parts.push(t('tasks.noSteps'));
        const seconds = focus.get(task.id) ?? 0;
        if (seconds >= 60) parts.push(t('tasks.focused', { time: formatFocus(seconds) }));
        parts.push(task.status === 'done' && task.doneAt ? t('tasks.finishedOn', { date: dayFmt.format(task.doneAt) }) : t('tasks.addedOn', { date: dayFmt.format(task.createdAt) }));
        meta.textContent = parts.join(' · ');
        body.append(title, meta);
        // The step you're on, under the title: green and turning while a session runs on it.
        const nowStep = active ? currentStep(task.steps) : undefined;
        if (nowStep) {
          const now = document.createElement('p');
          now.className = `task__now${live ? ' is-live' : ''}`;
          now.textContent = t(live ? 'tasks.now' : 'tasks.nextStep', { step: nowStep.text });
          body.append(now);
        }

        const actions = document.createElement('div');
        actions.className = 'task__actions';
        if (active && sheet) {
          // One small button; the steps open in the sheet over the list, which keeps its room.
          const steps = button(n ? t('tasks.stepsButton', { done: stepsDone, n }) : t('tasks.addSteps'), () => {
            prepareSheet(task);
            // A task with no steps yet goes straight to typing the first one.
            if (!n) window.setTimeout(() => sheet.querySelector<HTMLInputElement>('[data-bd-step]')?.focus(), 60);
          });
          steps.dataset.sheetOpen = 'task-steps';
          steps.setAttribute('aria-haspopup', 'dialog');
          steps.setAttribute('aria-label', n ? t('tasks.stepsLabel', { name, done: stepsDone, n }) : t('tasks.addStepsTo', { name }));
          actions.append(steps);
        }
        if (active) {
          if (listOf(task) === 'today' && !firstUp) {
            actions.append(
              button(t('tasks.doFirst'), () => {
                moveToTop(task.id, getTasks());
                announce(t('tasks.isFirstUp', { name }));
              }),
            );
          }
          const focusLink = document.createElement('a');
          focusLink.className = 'btn btn--ghost btn--small task__go';
          focusLink.href = `${timerUrl}?task=${encodeURIComponent(task.id)}${nowStep ? `&step=${encodeURIComponent(nowStep.id)}` : ''}`;
          focusLink.textContent = t('tasks.focus');
          focusLink.setAttribute('aria-label', t('tasks.focusOn', { name }));
          const done = button(t('tasks.done'), () => {
            celebrate(done); // before finishing: the list re-renders and the button goes away
            finishTask(task.id);
            announce(t('tasks.finishedSaid', { name }));
          });
          actions.append(focusLink, done);
        } else {
          actions.append(
            button(t('tasks.reopen'), () => {
              reopenTask(task.id);
              announce(t('tasks.reopenedSaid', { name }));
            }),
          );
        }
        const del = iconButton(t('tasks.delete', { name }), () => {
          const time = formatFocus(seconds);
          const withFocus = active && seconds > 0;
          remove(
            task,
            withFocus ? t('tasks.deletedMsgFocus', { name, time }) : t('tasks.deletedMsg', { name }),
            withFocus ? t('tasks.deletedSaidFocus', { name, time }) : t('tasks.deletedSaid', { name }),
          );
        });
        const side = active ? [moveSelect(task), del] : [del];

        // The same numbers as the meta line, drawn: a ring, a segment per step, a focus bar.
        const graphs = document.createElement('div');
        graphs.className = 'task__graphs';
        if (active && n) graphs.append(stepBar(task, live));
        if (active && seconds >= 60) graphs.append(focusBar(seconds, maxFocus));

        li.append(active ? ring(stepsDone, n, listOf(task) === 'today' ? 56 : 44) : ring(1, 1, 32), head(body, ...side));
        if (graphs.childElementCount) li.append(graphs);
        li.append(actions);
        return li;
      }

      function render(): void {
        const tasks = getTasks().filter((t) => !removing.has(t.id));
        const current = getCurrentTask();
        const currentId = current?.id ?? null;
        const focus = focusByTask(getSessions());
        const open = tasks.filter((t) => t.status === 'active');
        const on = (list: TaskList) => open.filter((t) => listOf(t) === list);
        const finished = tasks.filter((t) => t.status === 'done').sort((a, b) => (b.doneAt ?? 0) - (a.doneAt ?? 0));
        const maxFocus = Math.max(1, ...open.map((t) => focus.get(t.id) ?? 0));
        const liveId = liveTaskId();
        const row = (t: Task, firstUp = false) => renderTask(t, currentId, focus, maxFocus, liveId, firstUp);

        const inbox = on('inbox').sort((a, b) => a.createdAt - b.createdAt);
        inboxWrap.hidden = inbox.length === 0;
        setHead(inboxHead, listLabel('inbox'), t('tasks.toSort', { n: inbox.length }));
        inboxList.replaceChildren(...inbox.map((t) => renderJot(t, current)));

        const today = todayTasks(open);
        setHead(todayHead, listLabel('today'), today.length ? tn('tasks.count', today.length) : '');
        todayList.replaceChildren(...today.map((t, i) => row(t, i === 0)));
        todayHint.hidden = today.length > 0 && today.length <= TODAY_SOFT_MAX;
        todayHint.textContent = today.length
          ? t('tasks.tooMany', { n: today.length })
          : t('tasks.planHint');
        // Someone with no tasks at all gets a few to start from, in place of the hint.
        examples.hidden = tasks.length > 0;
        if (!examples.hidden) todayHint.hidden = true;
        const carried = today.filter((t) => isCarriedOver(t));
        carry.hidden = carried.length === 0;
        carryText.textContent = tn('tasks.carried', carried.length);

        const next = on('next');
        setHead(nextHead, listLabel('next'), next.length ? tn('tasks.count', next.length) : '');
        nextList.replaceChildren(...next.map((t) => row(t)));
        nextEmpty.hidden = next.length > 0;

        const someday = on('someday');
        somedayWrap.hidden = someday.length === 0;
        setHead(somedayHead, listLabel('someday'), tn('tasks.count', someday.length));
        somedayList.replaceChildren(...someday.map((t) => row(t)));

        finishedWrap.hidden = finished.length === 0;
        const finishedFocus = finished.reduce((sum, t) => sum + (focus.get(t.id) ?? 0), 0);
        const finishedCount = tn('tasks.count', finished.length);
        setHead(
          finishedSummary,
          t('tasks.finished'),
          finishedFocus >= 60 ? t('tasks.finishedFocus', { count: finishedCount, time: formatFocus(finishedFocus) }) : finishedCount,
        );
        finishedList.replaceChildren(...finished.map((t) => row(t)));

        if (tabs) {
          const counts: Record<string, number> = { inbox: inbox.length, today: today.length, next: next.length, someday: someday.length, finished: finished.length };
          tabs.querySelectorAll<HTMLElement>('[data-tl-tab]').forEach((b) => {
            const id = b.dataset.tlTab!;
            const n = counts[id] ?? 0;
            // The Inbox tab is only there while there is something to sort.
            if (id === 'inbox') b.hidden = n === 0;
            b.querySelector('[data-tl-tab-count]')!.textContent = n && id !== 'finished' ? String(n) : '';
          });
          if (appView === 'inbox' && !inbox.length) showView('today');
          const message = counts[appView] ? undefined : VIEW_EMPTY[appView];
          viewEmpty.hidden = !message;
          viewEmpty.textContent = message ?? '';
        }
      }

      root.querySelectorAll<HTMLButtonElement>('[data-tl-example]').forEach((b) =>
        b.addEventListener('click', () => {
          const text = b.textContent!.trim();
          createTask(text, { makeCurrent: !getCurrentTask(), list: 'today' });
          announce(t('tasks.addedToday', { text }));
        }),
      );

      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const text = input.value.trim();
        if (!text) return;
        // Becomes the current task only if the breakdown has nothing open to show.
        const current = getCurrentTask();
        const list = newList.value as TaskList;
        createTask(text, { makeCurrent: !current || current.status === 'done', list });
        input.value = '';
        input.focus();
        announce(t('tasks.addedTo', { list: listLabel(list), text }));
      });

      // Carried over from an earlier day: keep them (in the same order) or move them on.
      $<HTMLButtonElement>('[data-tl-carry-keep]').addEventListener('click', () => {
        keepForToday(getTasks());
        announce(t('tasks.kept'));
      });
      $<HTMLButtonElement>('[data-tl-carry-move]').addEventListener('click', () => {
        const carried = todayTasks(getTasks()).filter((t) => isCarriedOver(t));
        carried.forEach((t) => moveTask(t.id, 'next'));
        announce(t('tasks.movedNext', { n: carried.length }));
      });

      if (tabs) {
        const onTab = (e: Event) => {
          const tab = (e.target as HTMLElement).closest<HTMLElement>('[data-tl-tab]');
          if (!tab) return;
          showView(tab.dataset.tlTab!);
          render();
        };
        tabs.addEventListener('click', onTab);
        showView(appView);
      }

      // Rings fill once on arrival (global.css); later re-renders show the new state at once.
      root.classList.add('is-entering');
      const entered = window.setTimeout(() => root.classList.remove('is-entering'), 700);
      c.add(() => window.clearTimeout(entered));

      render();
      c.add(subscribe('tasks', render));
      c.add(subscribe('sessions', render));
      c.add(subscribe('timer', render)); // the step you're on turns while a session runs on its task
    });
    return c.run;
  });
</script>

