---
/**
 * Focus timer. Used standalone on /timer and embedded on technique pages.
 * Use at most one per page (element ids are fixed).
 *
 * There is one shared timer across the whole site: a session started on a technique
 * page keeps running on /timer, after a reload, or in another tab.
 */
import { TIMER_MODES, TIMER_MODE_LABELS, type TimerMode } from '../data/taxonomy';
import CoinMark from './CoinMark.astro';
import { NATIVE_APP } from '../config/app';
import { url } from '../lib/paths';
import { TONES, TONE_LABELS } from '../lib/timer/cues';

interface Props {
  /** Mode shown when no session is in progress. Standalone uses the user's last mode. */
  defaultMode?: TimerMode;
  /** Standalone page: enables Space / R shortcuts and a larger layout. */
  standalone?: boolean;
}

const { defaultMode, standalone = false } = Astro.props;
const RADIUS = 92;
const CIRCUMFERENCE = 2 * Math.PI * RADIUS;
---

<section
  class:list={['timer', { 'timer--standalone': standalone }]}
  data-timer
  data-default-mode={defaultMode}
  data-shortcuts={standalone ? '' : undefined}
  data-icon={url('/favicon.svg')}
  data-tasks-url={url('/tasks')}
  data-phase="work"
  data-status="idle"
  aria-labelledby="timer-heading">
  <div class="timer__head">
    <h2 id="timer-heading" class:list={{ 'visually-hidden': standalone }}>Try it: focus timer</h2>
    <fieldset class="timer__modes" data-modes>
      <legend class="visually-hidden">Timer mode</legend>
      {
        TIMER_MODES.map((m) => (
          <label class="seg">
            <input type="radio" name="timer-mode" value={m} checked={m === (defaultMode ?? 'pomodoro')} />
            <span>{TIMER_MODE_LABELS[m]}</span>
          </label>
        ))
      }
    </fieldset>
    <p class="timer__mode-hint muted" data-mode-hint hidden>Reset to change mode.</p>
  </div>

  <div class="timer__custom" data-custom hidden>
    <label>
      <span>Focus (min)</span>
      <input type="number" inputmode="numeric" min="1" max="240" step="1" value="15" data-custom-work />
    </label>
    <label>
      <span>Break (min)</span>
      <input type="number" inputmode="numeric" min="0" max="60" step="1" value="5" data-custom-break />
    </label>
  </div>

  <div class="timer__dial" data-dial>
    <svg class="timer__ring" viewBox="0 0 200 200" aria-hidden="true">
      <circle class="timer__track" cx="100" cy="100" r={RADIUS}></circle>
      <circle
        class="timer__progress"
        cx="100"
        cy="100"
        r={RADIUS}
        stroke-dasharray={CIRCUMFERENCE}
        stroke-dashoffset="0"
        data-ring
        data-circumference={CIRCUMFERENCE}></circle>
    </svg>
    <div class="timer__readout">
      <p class="timer__phase" data-phase-label>Focus</p>
      <p class="timer__time" role="timer" aria-atomic="true" data-time>25:00</p>
      <p class="timer__dots" data-dots hidden>
        <span></span><span></span><span></span><span></span>
      </p>
    </div>
  </div>

  <p class="timer__message" data-message></p>

  <form class="timer__log" data-log hidden>
    <p class="timer__log-title">Before you move on <span class="muted">(optional)</span></p>
    <label class="timer__log-field">
      <span>What did you get done?</span>
      <input class="input" type="text" maxlength="200" autocomplete="off" data-log-did />
    </label>
    <label class="timer__log-field">
      <span>What's next?</span>
      <input class="input" type="text" maxlength="200" autocomplete="off" data-log-next />
    </label>
    <p class="timer__log-hint muted" data-log-hint></p>
    <div class="timer__log-actions">
      <button type="submit" class="btn btn--small">Save</button>
      <button type="button" class="btn btn--ghost btn--small" data-log-skip>Skip</button>
    </div>
  </form>

  <div class="timer__controls">
    <button type="button" class="btn timer__main" data-action="toggle">Start</button>
    <button type="button" class="btn btn--ghost" data-action="stop" hidden>Stop &amp; take a break</button>
    <button type="button" class="btn btn--ghost" data-action="skip" hidden>Skip break</button>
    <button type="button" class="btn btn--ghost" data-action="reset">Reset</button>
  </div>

  <label class="timer__label">
    <span>What are you working on? <span class="muted">(optional)</span></span>
    <input type="text" maxlength="80" autocomplete="off" placeholder="e.g. Chapter 3 notes" data-label />
    <datalist data-task-options></datalist>
  </label>
  {/* The Android app's web view doesn't open the suggestions above, so there your tasks are buttons (timer-ui.ts). */}
  {NATIVE_APP && <div class="timer__picks" role="group" aria-label="Your tasks" data-task-picks hidden />}
  <p class="timer__task muted" data-task-link hidden></p>

  <div class="timer__jot">
    <button type="button" class="btn btn--ghost btn--small" aria-expanded="false" aria-controls="timer-jot-form" data-jot-open>
      Jot a thought
    </button>
    <form id="timer-jot-form" class="timer__jot-form" data-jot-form hidden>
      <label for="timer-jot" class="visually-hidden">A thought to deal with later</label>
      <input id="timer-jot" class="input" type="text" maxlength="120" autocomplete="off" placeholder="Something to deal with later…" data-jot-input />
      <button type="submit" class="btn btn--small">Save</button>
    </form>
    <p class="timer__jot-status muted" data-jot-status hidden></p>
  </div>

  <div class="timer__footer">
    <label class="timer__sound">
      <input type="checkbox" data-sound checked />
      <span>Sound</span>
    </label>
    <span class="timer__sound-options" data-sound-options>
      <label class="visually-hidden" for="timer-tone">End sound</label>
      <select id="timer-tone" class="input timer__tone" data-tone>
        {TONES.map((t) => <option value={t}>{TONE_LABELS[t]}</option>)}
      </select>
      <label class="visually-hidden" for="timer-volume">Volume</label>
      <input id="timer-volume" class="timer__volume" type="range" min="5" max="100" step="5" value="70" data-volume />
    </span>
    <span class="muted" data-notify-status></span>
    <a href={url('/progress')} class="timer__today" data-today></a>
  </div>

  {
    standalone && (
      <p class="timer__keys muted">
        Keyboard: <kbd>Space</kbd> start / pause · <kbd>R</kbd> reset · <kbd>J</kbd> jot a thought
      </p>
    )
  }

  {
    /*
      The Android app gives the end of a focus session the whole screen: what you did,
      how far it moved your focus tier, and the note form above (timer-ui.ts moves it in).
    */
    NATIVE_APP && (
      <dialog class="done" data-done aria-labelledby="done-title">
        <button type="button" class="done__close" data-done-close aria-label="Close">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
          </svg>
        </button>
        <CoinMark size={120} class="done__coin" />
        <h2 id="done-title" class="done__title">Session complete</h2>
        <p class="done__text" data-done-text />
        <div class="done__tier" data-done-tier />
        <div class="done__form" data-done-slot />
      </dialog>
    )
  }

  <p class="visually-hidden" aria-live="polite" aria-atomic="true" data-live></p>
  <noscript><p class="timer__message">The timer needs JavaScript enabled.</p></noscript>
</section>

<script>
  import { mountTimers } from '../scripts/timer-ui';
  import { onPage } from '../lib/page';
  onPage('timer', mountTimers);
</script>

<style>
  .timer {
    --phase-color: var(--color-accent);
    display: grid;
    gap: var(--space-4);
    padding: var(--space-6) var(--space-4);
    background: var(--surface-grad);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    justify-items: center;
    text-align: center;
  }

  .timer[data-phase='short-break'],
  .timer[data-phase='long-break'] {
    --phase-color: var(--cat-visual);
  }

  .timer__head {
    display: grid;
    gap: var(--space-3);
    justify-items: center;
    width: 100%;
  }

  .timer__head h2 {
    font-size: var(--text-lg);
  }

  /* Segmented mode control */
  .timer__modes {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px;
    padding: 5px;
    border: 0;
    border-radius: 16px;
    background: var(--well-bg);
    box-shadow: var(--well-shadow);
    min-width: 0;
  }

  .seg {
    position: relative;
  }

  .seg input {
    position: absolute;
    inset: 0;
    opacity: 0;
    margin: 0;
    cursor: pointer;
  }

  .seg input:disabled {
    cursor: not-allowed;
  }

  .seg span {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 var(--space-4);
    border-radius: 11px;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-muted);
    transition: background-color var(--duration-fast) var(--ease-out);
  }

  @media (max-width: 26rem) {
    .timer {
      padding-inline: var(--space-3);
    }

    .seg span {
      padding: 0 0.55rem;
      font-size: var(--text-xs);
    }
  }

  .seg input:checked + span {
    background: var(--accent-grad);
    color: var(--color-on-accent);
    font-weight: 600;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.45),
      0 3px 0 var(--accent-edge);
  }

  .seg input:focus-visible + span {
    outline: 3px solid var(--color-focus);
    outline-offset: 1px;
  }

  .seg input:disabled:not(:checked) + span {
    opacity: 0.5;
  }

  .timer__mode-hint {
    font-size: var(--text-xs);
  }

  .timer__custom {
    display: flex;
    gap: var(--space-4);
    justify-content: center;
  }

  .timer__custom[hidden] {
    display: none;
  }

  .timer__custom label {
    display: grid;
    gap: var(--space-1);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .timer__custom input {
    width: 6rem;
    min-height: 44px;
    padding: var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--well-bg);
    box-shadow: var(--well-shadow);
    text-align: center;
  }

  /* Dial */
  .timer__dial {
    position: relative;
    width: min(100%, 280px);
    aspect-ratio: 1;
    padding: 12px;
    border-radius: 50%;
    background: var(--raised-grad);
    box-shadow:
      inset 0 2px 0 var(--raised-hl),
      0 16px 0 -4px var(--edge),
      0 40px 60px -28px rgb(0 0 0 / 0.6);
    margin-bottom: 12px;
  }

  .timer__dial::after {
    content: '';
    position: absolute;
    inset: 13%;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 30%, var(--color-surface-solid), var(--well-bg) 75%);
    box-shadow: inset 0 3px 8px rgb(0 0 0 / 0.35);
    pointer-events: none;
  }

  .timer--standalone .timer__dial {
    width: min(100%, 360px);
  }

  .timer__ring {
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
  }

  .timer__track {
    fill: none;
    stroke: var(--well-bg);
    stroke-width: 12;
  }

  .timer__progress {
    fill: none;
    stroke: var(--phase-color);
    stroke-width: 12;
    stroke-linecap: round;
    filter: drop-shadow(0 0 5px color-mix(in srgb, var(--phase-color) 55%, transparent));
    transition:
      stroke-dashoffset 300ms linear,
      stroke var(--duration-base) var(--ease-out);
  }

  /* Flowtime focus counts up: show a calm dashed ring instead of progress. */
  .timer[data-countup] .timer__progress {
    stroke-dasharray: 4 10 !important;
    stroke-dashoffset: 0 !important;
    opacity: 0.6;
  }

  .timer__readout {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: grid;
    place-content: center;
    gap: var(--space-1);
  }

  .timer__phase {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--phase-color);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .timer__time {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 12vw, 3.5rem);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .timer--standalone .timer__time {
    font-size: clamp(3rem, 14vw, 4.5rem);
  }

  .timer__dots {
    display: flex;
    justify-content: center;
    gap: 6px;
  }

  .timer__dots[hidden] {
    display: none;
  }

  .timer__dots span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 1.5px solid var(--color-border-strong);
  }

  .timer__dots span.is-done {
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  /* Completion: a soft glow + gentle pop. Disabled by prefers-reduced-motion (global.css). */
  .timer__dial.is-complete .timer__ring {
    animation: dial-complete 900ms var(--ease-out);
  }

  @keyframes dial-complete {
    0% { filter: drop-shadow(0 0 0 transparent); scale: 1; }
    35% { filter: drop-shadow(0 0 12px var(--phase-color)); scale: 1.04; }
    100% { filter: drop-shadow(0 0 0 transparent); scale: 1; }
  }

  .timer__message {
    min-height: 1.6em;
    max-width: 32rem;
    color: var(--color-text-muted);
  }

  .timer__controls {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
  }

  .timer__main {
    min-width: 9rem;
    min-height: 52px;
    font-size: var(--text-base);
  }

  .timer__controls {
    align-items: center;
  }

  .timer__controls [hidden] {
    display: none;
  }

  .timer__label {
    display: grid;
    gap: var(--space-1);
    width: min(100%, 26rem);
    text-align: left;
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .timer__label input {
    min-height: 44px;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--well-bg);
    box-shadow: var(--well-shadow);
    font-weight: 400;
  }

  .timer__task {
    width: min(100%, 26rem);
    margin-top: calc(-1 * var(--space-2));
    text-align: left;
    font-size: var(--text-xs);
  }

  .timer__task[hidden],
  .timer__log[hidden] {
    display: none;
  }

  .timer__log {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface-2);
    text-align: start;
    animation: log-in var(--duration-slow) var(--ease-out);
  }

  .timer__log-title {
    font-weight: 700;
  }

  .timer__log-field {
    display: grid;
    gap: var(--space-1);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .timer__log-field .input {
    font-weight: 400;
  }

  .timer__log-hint {
    font-size: var(--text-xs);
  }

  .timer__log-actions {
    display: flex;
    gap: var(--space-2);
  }

  @keyframes log-in {
    from {
      opacity: 0;
      transform: translateY(0.5rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .timer__log {
      animation: none;
    }
  }

  .timer__footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    font-size: var(--text-sm);
  }

  .timer__sound {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    cursor: pointer;
  }

  .timer__sound input {
    width: 1.1rem;
    height: 1.1rem;
    accent-color: var(--color-accent);
  }

  .timer__sound-options {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .timer__sound-options[hidden] {
    display: none;
  }

  .timer__tone {
    inline-size: auto;
    min-height: 36px;
    padding-block: 0;
    font-size: var(--text-sm);
  }

  .timer__volume {
    inline-size: 5.5rem;
    accent-color: var(--color-accent);
  }

  .timer__today:empty {
    display: none;
  }

  .timer__jot {
    display: grid;
    justify-items: center;
    gap: var(--space-2);
  }

  .timer__jot-form {
    display: flex;
    gap: var(--space-2);
    inline-size: min(100%, 26rem);
  }

  .timer__jot-form[hidden],
  .timer__jot-status[hidden] {
    display: none;
  }

  .timer__jot-form .input {
    flex: 1;
    min-width: 0;
  }

  .timer__jot-status {
    font-size: var(--text-sm);
  }

  .timer__keys {
    font-size: var(--text-xs);
  }

  /*
    The Android app: the timer is the screen, not a card on it. The dial leads, what
    you're working on sits right under it, and the main button spans the screen where
    a thumb reaches. Only the look and the order change; the markup and script don't.
  */
  :global(html[data-app]) .timer {
    gap: var(--space-4);
    padding: 0;
    background: none;
    border: 0;
    box-shadow: none;
  }

  :global(html[data-app]) .timer__head {
    order: 1;
  }

  :global(html[data-app]) .timer__custom {
    order: 2;
  }

  /* Small enough that the main button is on screen without scrolling. */
  :global(html[data-app]) .timer .timer__dial {
    order: 3;
    width: min(100%, 256px);
  }

  :global(html[data-app]) .timer .timer__time {
    font-size: 3.25rem;
  }

  :global(html[data-app]) .timer__message {
    order: 4;
  }

  :global(html[data-app]) .timer__message:empty {
    display: none;
  }

  :global(html[data-app]) .timer__log {
    order: 5;
    inline-size: 100%;
  }

  :global(html[data-app]) .timer__label {
    order: 6;
  }

  :global(html[data-app]) .timer__task {
    order: 7;
  }

  :global(html[data-app]) .timer__controls {
    order: 8;
  }

  :global(html[data-app]) .timer__jot {
    order: 9;
  }

  :global(html[data-app]) .timer__footer {
    order: 10;
  }

  /* Four equal segments; the chosen one is raised, so green stays the colour of the main button. */
  :global(html[data-app]) .timer__modes {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    inline-size: 100%;
  }

  :global(html[data-app]) .seg span {
    justify-content: center;
    inline-size: 100%;
    min-height: 44px;
    padding: 0;
    font-size: var(--text-xs);
  }

  :global(html[data-app]) .seg input:checked + span {
    background: var(--raised-grad);
    color: var(--color-text);
    font-weight: 700;
    box-shadow:
      inset 0 1px 0 var(--raised-hl),
      0 2px 0 var(--edge);
  }

  /* "What are you working on?" as one raised row. */
  :global(html[data-app]) .timer__label {
    inline-size: 100%;
    padding: var(--space-2) var(--space-4) var(--space-1);
    border: 1px solid var(--color-border);
    border-radius: 18px;
    background: var(--surface-grad);
    box-shadow:
      inset 0 1px 0 var(--hl),
      0 3px 0 var(--edge);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: 500;
  }

  :global(html[data-app]) .timer__label input {
    padding-inline: 0;
    border: 0;
    background: none;
    box-shadow: none;
    color: var(--color-text);
    font-size: var(--text-base);
    font-weight: 600;
  }

  :global(html[data-app]) .timer__label input:focus-visible {
    outline: none;
  }

  :global(html[data-app]) .timer__label:focus-within {
    border-color: var(--color-accent);
  }

  :global(html[data-app]) .timer__task {
    inline-size: 100%;
    padding-inline: var(--space-4);
  }

  /* Your tasks, one tap each: a row that scrolls sideways under the field. */
  .timer__picks {
    order: 6;
    display: flex;
    gap: var(--space-2);
    inline-size: 100%;
    margin-top: calc(-1 * var(--space-2));
    padding-bottom: 4px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .timer__picks[hidden] {
    display: none;
  }

  .timer__picks :global(.timer__pick) {
    flex: none;
    max-inline-size: 15rem;
    min-height: 44px;
    padding: 0 var(--space-4);
    border: 1px solid var(--color-border-strong);
    border-radius: 12px;
    background: none;
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    cursor: pointer;
  }

  .timer__picks :global(.timer__pick[aria-pressed='true']) {
    border-color: var(--accent-edge);
    background: var(--color-accent-soft);
    font-weight: 700;
  }

  /* The main button on its own row; the quieter ones share the row under it. */
  :global(html[data-app]) .timer__controls {
    inline-size: 100%;
    gap: var(--space-3);
  }

  :global(html[data-app]) .timer__main {
    flex: 1 0 100%;
    min-height: 60px;
    border-radius: 18px;
    font-size: var(--text-lg);
    font-weight: 700;
  }

  :global(html[data-app]) .timer__controls .btn--ghost {
    flex: 1 1 0;
    min-height: 52px;
    padding-inline: var(--space-3);
    border-radius: 16px;
  }

  :global(html[data-app]) .timer__jot,
  :global(html[data-app]) .timer__jot-form {
    inline-size: 100%;
  }

  :global(html[data-app]) .timer__jot [data-jot-open] {
    --btn-depth: 0px;
    inline-size: 100%;
    min-height: 48px;
    border: 1px dashed var(--color-border-strong);
    background: none;
    box-shadow: none;
    color: var(--color-text-muted);
