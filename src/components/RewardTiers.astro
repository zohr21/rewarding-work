---
/**
 * Reward tiers on the grove's first tab: one compact row per track, each a ladder of five
 * tiers (src/lib/rewards.ts) with how far it is to the next one.
 * Before anything has counted towards a tier it is one seed instead, with the first goal.
 * Sprig stands at the top, grown as far as the focus-time tier.
 */
import Sprig from './Sprig.astro';
---

<section class="card tiers" id="tiers" data-reward-tiers aria-labelledby="tiers-heading">
  <h2 id="tiers-heading" class="visually-hidden">Your tiers</h2>
  <div class="tiers__sprig" data-tiers-sprig>
    <div class="tiers__sprig-art" data-tiers-sprig-art>
      <Sprig mood="auto" size={96} bob />
      <canvas aria-hidden="true"></canvas>
    </div>
    <div class="tiers__sprig-text">
      <p class="tiers__sprig-name" data-tiers-sprig-name></p>
      <p class="tiers__sprig-tree" data-tiers-sprig-tree></p>
      <p class="muted" data-tiers-sprig-next></p>
      <div class="tiers__sprig-bar" role="progressbar" aria-label="Sprig's growth to the next stage" aria-valuemin="0" aria-valuemax="100" data-tiers-sprig-bar>
        <span></span>
      </div>
    </div>
  </div>
  <div class="tiers__head" data-tiers-head>
    <h3 class="tiers__markers">Markers</h3>
    <details class="tiers__about">
      <summary>What are these?</summary>
      <p class="muted">
        Markers along the way — there to show how far you've come, not to keep score. Green to start, then bronze, silver
        and gold, with diamond for the hardest runs. The chain counts your best run, so a missed day never takes a tier
        away.
      </p>
    </details>
  </div>
  <ul class="tiers__grid" data-tiers-list></ul>

  <div class="seed" data-tiers-seed hidden>
    <Sprig stage={0} size={100} bob />
    <h3 class="seed__title">Sprig is a seed, waiting</h3>
    <p class="muted" data-tiers-seed-text></p>
    <div class="seed__bar" aria-hidden="true"><span></span></div>
    <p class="muted seed__count" data-tiers-seed-count></p>
    <h3 class="seed__ahead">Markers ahead</h3>
    <ol class="seed__coins" data-tiers-seed-coins></ol>
  </div>
</section>

<script>
  import { getChain, getDone, getSessions, subscribe } from '../lib/storage';
  import { allProgress, chainInput, tierLabel, TIER_NAMES, type TrackProgress } from '../lib/rewards';
  import { tierIcon } from '../lib/tier-icons';
  import { SPRIG_TREES, sprigGrowth, sprigStageName } from '../lib/sprig';
  import { cleanups, onPage } from '../lib/page';
  import { url } from '../lib/paths';
  import { webglAvailable } from '../lib/scene';
  import type { Sprig3D } from '../lib/scene/sprig3d';

  /**
   * Swap the drawn Sprig for the 3D one at `stage` (three.js loads only now). The drawing stays
   * until the model is ready, and is what shows without WebGL. Returns a cleanup.
   */
  function show3D(art: HTMLElement, stage: number): () => void {
    const canvas = art.querySelector('canvas');
    if (!canvas || !webglAvailable()) return () => {};
    const root = document.documentElement;
    const motion = root.dataset.motion !== 'off' && !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let sprig: Sprig3D | null = null;
    let gone = false;
    art.dataset.stage = String(stage);
    void import('../lib/scene/sprig3d')
      .then(({ createSprig3D }) => createSprig3D(canvas, url(`/sprig/sprig-${stage}.glb`), motion))
      .then((s) => {
        if (gone) return s?.destroy();
        sprig = s;
        art.classList.toggle('is-3d', !!s);
      });
    return () => {
      gone = true;
      sprig?.destroy();
      art.classList.remove('is-3d');
    };
  }

  const dateFmt = new Intl.DateTimeFormat(undefined, { day: 'numeric', month: 'short', year: 'numeric' });

  const LEAF_SVG =
    '<svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M5 19c0-8 5-13 14-14-1 9-6 14-14 14zm0 0l7-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>';

  /** Focus hours read better with one decimal below 10. */
  function amount(p: TrackProgress): string {
    if (p.track.id !== 'focus') return p.value.toLocaleString();
    const v = p.value < 10 ? Math.floor(p.value * 10) / 10 : Math.floor(p.value);
    return v.toLocaleString();
  }

  function renderTrack(p: TrackProgress): HTMLLIElement {
    const { track, level, reachedAt } = p;
    const li = document.createElement('li');
    li.className = 'tier';

    const head = document.createElement('div');
    head.className = 'tier__head';
    const title = document.createElement('h3');
    title.className = 'tier__title';
    title.textContent = track.title;
    const current = document.createElement('p');
    current.className = `tier__current${level ? '' : ' muted'}`;
    current.innerHTML = level ? LEAF_SVG : '';
    current.append(level ? tierLabel(level - 1) : 'No tier yet');
    const text = document.createElement('div');
    text.className = 'tier__text';
    text.append(title, current);

    // A 3D coin in the tier's material, a dark blank before the first one.
    const coin = document.createElement('span');
    coin.className = `tier-coin ${level ? `tier-coin--t${level - 1}` : 'tier-coin--blank'}`;
    coin.innerHTML = tierIcon(Math.max(0, level - 1), 20);
    head.append(coin, text);

    // One segment per tier; the next one fills partway with progress towards it.
    const pips = document.createElement('ol');
    pips.className = 'tier__pips';
    track.thresholds.forEach((n, i) => {
      const pip = document.createElement('li');
      const at = reachedAt[i];
      pip.className = `tier__pip${at !== null ? ' is-reached' : ''}`;
      pip.style.setProperty('--pip', `var(--tier-${i})`);
      pip.style.setProperty('--pip-edge', `var(--tier-${i}-edge)`);
      if (i === level) {
        const prev = level ? track.thresholds[level - 1]! : 0;
        const fill = document.createElement('span');
        fill.className = 'tier__fill';
        fill.style.inlineSize = `${Math.min(100, Math.max(0, ((p.value - prev) / (n - prev)) * 100))}%`;
        pip.append(fill);
      }
      const label = `${tierLabel(i)}: ${track.describe(n)}`;
      pip.title = at !== null ? `${label} — reached ${dateFmt.format(at)}` : label;
      const name = document.createElement('span');
      name.className = 'visually-hidden';
      name.textContent = at !== null ? `${pip.title}.` : `${label}, not reached yet.`;
      pip.append(name);
      pips.append(pip);
    });

    li.append(head, pips);

    const next = track.thresholds[level];
    const foot = document.createElement('p');
    foot.className = 'tier__next muted';
    if (next === undefined) {
      foot.textContent = `All five tiers reached — ${track.describe(track.thresholds.at(-1)!)}.`;
    } else {
      foot.textContent = `${amount(p)} of ${next} ${track.unit(next)} to ${tierLabel(level)}`;
    }
    li.append(foot);
    return li;
  }


  onPage('reward-tiers', () => {
    const c = cleanups();
    document.querySelectorAll<HTMLElement>('[data-reward-tiers]').forEach((root) => {
      const list = root.querySelector<HTMLElement>('[data-tiers-list]')!;
      const head = root.querySelector<HTMLElement>('[data-tiers-head]')!;
      const seed = root.querySelector<HTMLElement>('[data-tiers-seed]')!;
      const sprig = root.querySelector<HTMLElement>('[data-tiers-sprig]')!;
      const art = root.querySelector<HTMLElement>('[data-tiers-sprig-art]')!;
      let stage3D = -1;
      let stop3D = () => {};
      c.add(() => stop3D());
      const render = () => {
        const progress = allProgress({ sessions: getSessions(), done: getDone(), ...chainInput(getChain()) });
        // Nothing has counted yet: one seed and the first goal, not four ladders of "not yet".
        const bare = progress.every((p) => p.value === 0);
        seed.hidden = !bare;
        head.hidden = list.hidden = sprig.hidden = bare;
        if (bare) {
          const focus = progress.find((p) => p.track.id === 'focus') ?? progress[0]!;
          const goal = focus.track.thresholds[0]!;
          root.querySelector('[data-tiers-seed-text]')!.textContent =
            `Focus for ${goal} ${focus.track.unit(goal)} in total to grow your first ${TIER_NAMES[0]}.`;
          root.querySelector('[data-tiers-seed-count]')!.textContent = `0 of ${goal} ${focus.track.unit(goal)}`;
          root.querySelector('[data-tiers-seed-coins]')!.replaceChildren(
            ...TIER_NAMES.map((name, i) => {
              const li = document.createElement('li');
              const coin = document.createElement('span');
              coin.className = `tier-coin tier-coin--t${i}`;
              coin.innerHTML = tierIcon(i, 18);
              li.append(coin, name);
              return li;
            }),
          );
          return;
        }
        // Sprig grows with focus time only, so its size always means real focus.
        const focus = progress.find((p) => p.track.id === 'focus')!;
        const goal = focus.track.thresholds[focus.level];
        root.querySelector('[data-tiers-sprig-name]')!.textContent = focus.level
          ? `Sprig is a ${tierLabel(focus.level - 1)}`
          : 'Sprig is still a seed';
        root.querySelector('[data-tiers-sprig-tree]')!.textContent = SPRIG_TREES[Math.min(5, focus.level)]!;
        // A new canvas for each model: a WebGL context can't be handed on cleanly.
        if (focus.level !== stage3D) {
          stage3D = focus.level;
          stop3D();
          art.querySelector('canvas')!.replaceWith(Object.assign(document.createElement('canvas'), { ariaHidden: 'true' }));
          stop3D = show3D(art, focus.level);
        }
        root.querySelector('[data-tiers-sprig-next]')!.textContent =
          goal === undefined
            ? 'A whole grove. Sprig has grown as far as it can.'
            : `${(Math.ceil((goal - focus.value) * 10) / 10).toLocaleString()} more ${focus.track.unit(goal - focus.value)} of focus to grow into ${sprigStageName(focus.level + 1)}.`;
        // The bar fills in the next stage's colour, a bud for each quarter of it.
        const bar = root.querySelector<HTMLElement>('[data-tiers-sprig-bar]')!;
        const { share } = sprigGrowth(getSessions());
        bar.hidden = goal === undefined;
        bar.setAttribute('aria-valuenow', String(Math.round(share * 100)));
        bar.style.setProperty('--share', `${share * 100}%`);
        bar.style.setProperty('--next', `var(--tier-${Math.min(4, focus.level)})`);
        list.replaceChildren(...progress.map(renderTrack));
      };
      render();
      c.add(subscribe('sessions', render));
      c.add(subscribe('done', render));
      c.add(subscribe('chain', render));
    });
    return c.run;
  });
</script>

<style>
  .tiers [hidden] {
    display: none;
  }

  /* Sprig, on its own patch of ground, with what it is and how far to the next stage. */
  .tiers__sprig {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--space-4);
    margin-top: var(--space-3);
    padding: var(--space-3) var(--space-4) 0 var(--space-2);
    background: var(--well-bg);
    border-radius: var(--radius-lg);
    box-shadow: var(--well-shadow);
  }

  /* The drawing until the 3D model is ready (and without WebGL); then the model, a bit bigger,
     with room for the Grove's wide crown. Drag to turn it. */
  .tiers__sprig-art {
    position: relative;
    display: grid;
    flex: none;
    /* Centred on its own row when the text has wrapped below it (narrow phones, wide Grove). */
    margin-inline: auto;
    align-items: end;
  }

  .tiers__sprig-art :global(canvas) {
    display: none;
    inline-size: 128px;
    block-size: 152px;
    touch-action: pan-y;
    cursor: grab;
  }

  .tiers__sprig-art[data-stage='5'] :global(canvas) {
    inline-size: 210px;
    block-size: 168px;
  }

  .tiers__sprig-art.is-3d :global(canvas) {
    display: block;
  }

  .tiers__sprig-art.is-3d :global(.sprig) {
    display: none;
  }

  .tiers__sprig-tree {
    color: var(--color-text-muted);
    font-style: italic;
  }

  .tiers__sprig-text {
    display: grid;
    flex: 1;
    gap: 2px;
    align-self: center;
    min-width: 11rem;
    padding-block-end: var(--space-3);
    font-size: var(--text-sm);
  }

  .tiers__sprig-bar {
    margin-top: var(--space-2);
    block-size: 8px;
    border-radius: var(--radius-pill);
    background: var(--color-surface-2);
    box-shadow: inset 0 1px 2px rgb(0 0 0 / 0.35);
    overflow: hidden;
  }

  .tiers__sprig-bar > span {
    display: block;
    inline-size: var(--share, 0%);
    block-size: 100%;
    border-radius: inherit;
    background: var(--next);
    transition: inline-size var(--duration-base) var(--ease-out);
  }

  .tiers__sprig-name {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    line-height: 1.15;
  }

  .seed {
    display: grid;
    justify-items: center;
    gap: var(--space-2);
    text-align: center;
  }

  .seed__title {
    font-size: var(--text-lg);
  }

  .seed__bar {
    justify-self: stretch;
    block-size: 10px;
    border-radius: 5px;
    background: var(--well-bg);
    box-shadow: var(--well-shadow);
  }

  .seed__count {
    justify-self: end;
    font-size: var(--text-xs);
  }

  .seed__ahead {
    justify-self: start;
    margin-top: var(--space-3);
    font-size: var(--text-base);
  }

  .seed__coins {
    justify-self: stretch;
    display: flex;
    justify-content: space-between;
    gap: var(--space-1);
    padding: 0;
    list-style: none;
  }

  .seed__coins :global(li) {
    display: grid;
    justify-items: center;
    gap: var(--space-1);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  /* Ahead, not reached: the coins sit back until they are earned. */
  .seed__coins :global(.tier-coin) {
    --coin-size: 36px;
    margin: 0;
    opacity: 0.45;
  }

  /* "Markers" and its fold-out explanation, on one line. */
  .tiers__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-1) var(--space-3);
    margin-top: var(--space-5);
  }

  .tiers__markers {
    font-size: var(--text-base);
  }

  .tiers__about summary {
    color: var(--color-accent);
    font-size: var(--text-sm);
    cursor: pointer;
  }

  .tiers__about[open] {
    flex-basis: 100%;
  }

  .tiers__about p {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
  }

  /* One row per track: the coin on the left, then its tier, ladder and what is next. */
  .tiers__grid {
    display: grid;
    margin-top: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .tiers__grid :global(.tier) {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: var(--space-4);
    row-gap: var(--space-2);
    align-items: center;
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--color-border);
    min-width: 0;
  }

  .tiers__grid :global(.tier:last-child) {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .tiers__grid :global(.tier__head) {
    display: contents;
  }

  .tiers__grid :global(.tier .tier-coin) {
    --coin-size: 44px;
    grid-row: 1 / span 3;
    margin-bottom: 5px;
  }

  .tiers__grid :global(.tier__text) {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0 var(--space-3);
    min-width: 0;
  }

  .tiers__grid :global(.tier__title) {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .tiers__grid :global(.tier__current) {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-accent);
  }

  .tiers__grid :global(.tier__current.muted) {
    font-weight: 500;
    color: var(--color-text-muted);
  }

  .tiers__grid :global(.tier__pips) {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--space-1);
    padding: 0;
    list-style: none;
  }

  .tiers__grid :global(.tier__pip) {
    block-size: 0.625rem;
    border-radius: var(--radius-pill);
    background: var(--heat-0);
    box-shadow: inset 0 1px 2px rgb(0 0 0 / 0.35);
    overflow: hidden;
  }

  /* Each segment is the colour of its tier's coin. */
  .tiers__grid :global(.tier__pip.is-reached) {
    background: var(--pip);
    box-shadow: 0 2px 0 var(--pip-edge);
  }

  .tiers__grid :global(.tier__fill) {
    display: block;
    block-size: 100%;
    background: var(--pip);
    border-radius: inherit;
  }

  .tiers__grid :global(.tier__next) {
    font-size: var(--text-xs);
  }
</style>
