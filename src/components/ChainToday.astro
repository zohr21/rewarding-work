---
/**
 * Today's chains, on Today: one slim row per chain with the one thing to do for today. A
 * tick chain ticks, a parts chain (the five prayers) has a button per slot, and an amount
 * or linked chain shows how far today is and opens the day in ChainDay's sheet. The
 * history stays on Grove › Chains. Hidden until there is a chain.
 */
import ChainDay from './ChainDay.astro';
import { url } from '../lib/paths';
---

<section class="card ct" data-ct aria-labelledby="ct-heading" hidden>
  <div class="ct__head">
    <h2 data-t="grove.todaySChains" id="ct-heading" class="ct__title">Today’s chains</h2>
    <a data-t="grove.allChains" class="ct__all" href={`${url('/progress')}#chains`}>All chains</a>
  </div>
  <ul class="ct__list" data-ct-list></ul>
  <p class="visually-hidden" aria-live="polite" data-ct-live></p>
</section>

<ChainDay />

<script>
  import { CHAIN_COLORS, getChains, subscribe, toggleChainDay, type ChainEntry } from '../lib/storage';
  import { chainDay, getEntry, getSetup, linkData, syncLinked, togglePart } from '../lib/chainkinds';
  import { chainStats } from '../lib/stats';
  import { dayKey } from '../lib/dates';
  import { el } from '../lib/dom';
  import { celebrate } from '../lib/appearance';
  import { cleanups, onPage } from '../lib/page';
  import { t, tn } from '../lib/i18n';

  const TICK_SVG =
    '<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M6 12.5l4 4L18 8" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"/></svg>';

  /** Short slot labels: first letters, or two when two slots share one. */
  function initials(names: string[]): string[] {
    const first = names.map((n) => n.slice(0, 1).toUpperCase());
    return names.map((n, i) => (first.filter((f) => f === first[i]).length > 1 ? n.slice(0, 2) : first[i]!));
  }

  onPage('chain-today', () => {
    const found = document.querySelector<HTMLElement>('[data-ct]');
    if (!found) return;
    const root: HTMLElement = found;
    const list = root.querySelector<HTMLElement>('[data-ct-list]')!;
    const live = root.querySelector<HTMLElement>('[data-ct-live]')!;
    const c = cleanups();
    const announce = (t: string) => {
      live.textContent = '';
      window.setTimeout(() => (live.textContent = t), 50);
    };

    /** Keeps focus on the control just used across redraws. */
    function focusKey(): string | undefined {
      return list.contains(document.activeElement) ? (document.activeElement as HTMLElement).dataset.ctKey : undefined;
    }

    function row(ch: ChainEntry, data: ReturnType<typeof linkData>): HTMLElement {
      const key = dayKey(new Date());
      const setup = getSetup(ch.id);
      const today = chainDay(ch, key, data);
      const li = el('li', 'ct__row');
      li.style.setProperty('--chain-color', CHAIN_COLORS[ch.color % CHAIN_COLORS.length]!);
      const dot = el('span', 'ct__dot');
      dot.setAttribute('aria-hidden', 'true');

      const name = el('span', 'ct__name', ch.habit);
      const s = chainStats(ch.days);
      const sub = el('span', 'ct__sub', setup.kind === 'tick' ? (s.current ? `${t('chain.running', { days: tn('chain.days', s.current) })} · ${t('chain.best', { n: s.best })}` : t('chain.best', { n: s.best })) : today.long);
      let label: HTMLElement;
      if (setup.kind === 'tick') {
        label = el('span', 'ct__label');
      } else {
        // The name opens today in the sheet.
        label = el('button', 'ct__label ct__label--open');
        (label as HTMLButtonElement).type = 'button';
        label.dataset.sheetOpen = 'chain-day';
        label.dataset.chainId = ch.id;
        label.dataset.chainDay = key;
        label.dataset.ctKey = `${ch.id}:open`;
        label.setAttribute('aria-label', t('chain.fillToday', { habit: ch.habit, value: today.long }));
      }
      label.append(name, ' ', sub);
      li.append(dot, label);

      if (setup.kind === 'tick') {
        const tick = el('button', 'ct__tick');
        tick.type = 'button';
        tick.innerHTML = TICK_SVG;
        tick.dataset.ctKey = `${ch.id}:tick`;
        tick.setAttribute('aria-pressed', String(today.counted));
        tick.setAttribute('aria-label', t('chain.doneToday', { habit: ch.habit }));
        tick.addEventListener('click', () => {
          const marking = !ch.days.includes(key);
          toggleChainDay(key, ch.id);
          if (marking) celebrate(tick);
          announce(t(marking ? 'chain.todayMarked' : 'chain.todayUnmarked', { habit: ch.habit }));
        });
        li.append(tick);
      } else if (setup.kind === 'parts') {
        const names = setup.parts ?? [];
        const done = getEntry(ch.id, key).parts ?? [];
        const group = el('span', 'ct__parts');
        group.setAttribute('role', 'group');
        group.setAttribute('aria-label', t('chain.habitToday', { habit: ch.habit }));
        initials(names).forEach((short, i) => {
          const b = el('button', 'ct__part', short);
          b.type = 'button';
          b.dataset.ctKey = `${ch.id}:${i}`;
          b.setAttribute('aria-label', names[i]!);
          b.setAttribute('aria-pressed', String(!!done[i]));
          b.addEventListener('click', () => {
            const before = ch.days.includes(key);
            const counted = togglePart(ch.id, key, i);
            if (counted && !before) celebrate(b);
            announce(t(done[i] ? 'chain.slotNotYet' : 'chain.slotDone', { slot: names[i] ?? '' }));
          });
          group.append(b);
        });
        li.append(group);
      } else {
        const state = el('span', `ct__state${today.counted ? ' is-done' : ''}`);
        if (today.counted) state.innerHTML = TICK_SVG;
        else state.textContent = today.short || '0';
        state.setAttribute('aria-hidden', 'true');
        li.append(state);
      }
      return li;
    }

    function render(): void {
      const chains = getChains();
      root.hidden = chains.length === 0;
      if (root.hidden) return;
      const data = linkData();
      const keep = focusKey();
      list.replaceChildren(...chains.map((ch) => row(ch, data)));
      if (keep) list.querySelector<HTMLElement>(`[data-ct-key="${keep}"]`)?.focus();
    }

    const follow = () => {
      syncLinked();
      render();
    };
    follow();
    c.add(subscribe('chain', render));
    c.add(subscribe('chain-detail', render));
    c.add(subscribe('sessions', follow));
    c.add(subscribe('workouts', follow));
    return c.run;
  });
</script>

<style>
  .ct {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-4);
  }

  .ct[hidden] {
    display: none;
  }

  .ct__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .ct__title {
    font-size: var(--text-base);
  }

  .ct__all {
    display: flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--text-sm);
  }

  .ct__list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ct :global(.ct__row) {
    --chain-color: var(--color-accent);
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 56px;
    max-width: none;
    border-top: 1px solid var(--color-border);
  }

  .ct :global(.ct__dot) {
    width: 10px;
    height: 10px;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--chain-color);
  }

  .ct :global(.ct__label) {
    display: grid;
    flex: 1;
    min-width: 0;
    min-height: 44px;
    align-content: center;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-text);
    font: inherit;
    text-align: left;
  }

  .ct :global(.ct__label--open) {
    cursor: pointer;
  }

  .ct :global(.ct__name) {
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .ct :global(.ct__sub) {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .ct :global(.ct__tick),
  .ct :global(.ct__state) {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    border: 2px solid var(--chain-color);
    border-radius: 50%;
    background: var(--well-bg);
    color: transparent;
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .ct :global(.ct__tick) {
    cursor: pointer;
  }

  .ct :global(.ct__state) {
    color: var(--color-text);
  }

  .ct :global(.ct__tick[aria-pressed='true']),
  .ct :global(.ct__state.is-done) {
    background: var(--chain-color);
    color: var(--color-on-accent);
  }

  .ct :global(.ct__parts) {
    display: flex;
    flex-shrink: 0;
    gap: 4px;
  }

  .ct :global(.ct__part) {
    width: 34px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    background: var(--well-bg);
    color: var(--color-text-muted);
    font: inherit;
    font-size: var(--text-xs);
    font-weight: 700;
    cursor: pointer;
  }

  .ct :global(.ct__part[aria-pressed='true']) {
    border-color: var(--chain-color);
    background: var(--chain-color);
    color: var(--color-on-accent);
  }
</style>
