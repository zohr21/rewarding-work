---
/** Two stat tiles: focus this week and sessions completed, each with a small graphic. Today has its own tab. */
---

<section class="stats" data-progress-stats aria-label="Focus totals">
  <div class="stat">
    <p class="stat__label">This week</p>
    <p class="stat__value"><span data-stat="week">0</span> <span class="stat__unit">min</span></p>
    <p class="stat__sub muted" data-stat="week-sub">Mon–Sun</p>
    <div class="stat__chart" data-stat-week></div>
  </div>
  <div class="stat">
    <p class="stat__label">Sessions completed</p>
    <p class="stat__value"><span data-stat="sessions">0</span></p>
    <p class="stat__sub muted">all time</p>
    <div class="stat__chart" data-stat-trend></div>
  </div>
</section>

<script>
  import { getSessions, subscribe } from '../lib/storage';
  import { dailyMinutes, totals, weeklySums } from '../lib/stats';
  import { miniBars, sparkline } from '../lib/charts';
  import { cleanups, onPage } from '../lib/page';

  const TREND_WEEKS = 8;

  onPage('progress-stats', () => {
    const c = cleanups();
    document.querySelectorAll<HTMLElement>('[data-progress-stats]').forEach((root) => {
      const set = (name: string, text: string) => {
        const el = root.querySelector(`[data-stat="${name}"]`);
        if (el) el.textContent = text;
      };
      const week = root.querySelector<HTMLElement>('[data-stat-week]')!;
      const trend = root.querySelector<HTMLElement>('[data-stat-trend]')!;
      const render = () => {
        const sessions = getSessions();
        const now = new Date();
        const t = totals(sessions, now);
        set('week', t.weekMin.toLocaleString());
        set('sessions', t.completedSessions.toLocaleString());
        set('week-sub', `${t.weekSessions} session${t.weekSessions === 1 ? '' : 's'} this week`);

        // Monday to Sunday; days still to come are stubs.
        const days = dailyMinutes(sessions, ((now.getDay() + 6) % 7) + 1, now).map((d) => d.value);
        const padded = [...days, ...Array<number>(7 - days.length).fill(0)];
        week.innerHTML = miniBars(padded, days.length - 1, `Focus minutes Monday to today: ${days.join(', ')}`);

        const perWeek = weeklySums(sessions.filter((s) => s.completed), (s) => s.start, () => 1, TREND_WEEKS, now).map((w) => w.value);
        trend.innerHTML = sparkline(perWeek, `Sessions completed per week, last ${TREND_WEEKS} weeks: ${perWeek.join(', ')}`);
      };
      render();
      c.add(subscribe('sessions', render));
    });
    return c.run;
  });
</script>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
  }

  .stat {
    padding: var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    min-width: 0;
  }

  .stat__label {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .stat__value {
    margin-top: var(--space-1);
    font-size: clamp(1.5rem, 1.1rem + 2vw, 2.25rem);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
  }

  .stat__unit {
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--color-text-muted);
  }

  .stat__sub {
    margin-top: var(--space-1);
    font-size: var(--text-xs);
  }

  .stat__chart {
    margin-top: var(--space-3);
  }
</style>
