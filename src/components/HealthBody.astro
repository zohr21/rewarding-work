---
/**
 * Body data on /health: sleep, steps, exercise, resting heart rate, calories and distance, read from Health
 * Connect by the Android app (src/lib/device.ts) and set next to focus time. Numbers typed in
 * by hand (BodyEntry.astro, src/lib/body.ts) are shown over the synced ones, and a tile with a
 * typed number shows even when that kind isn't allowed. The site has nothing to read from, so
 * it says where the numbers come from instead.
 */
import { NATIVE_APP } from '../config/app';
import { HEALTH_KINDS } from '../lib/device';
import { url } from '../lib/paths';

const ASK = {
  sleep: 'Sleep',
  steps: 'Steps',
  exercise: 'Exercise',
  heart: 'Resting heart rate',
  calories: 'Total calories burned',
  activeCalories: 'Active calories',
  distance: 'Distance',
};
const TILES = [
  { kind: 'sleep', label: 'Sleep', icon: 'M20 14A8 8 0 0 1 10 4a8 8 0 1 0 10 10z' },
  { kind: 'steps', label: 'Steps', icon: 'M3 12h4l3-7 4 14 3-7h4' },
  { kind: 'exercise', label: 'Active', icon: 'M4 9v6M7 7v10M17 7v10M20 9v6M7 12h10' },
  { kind: 'heart', label: 'Resting heart', icon: 'M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z' },
  // Total and active calories share one tile.
  { kind: 'calories', label: 'Calories', icon: 'M12 21c-4 0-7-3-7-7 0-3 2-5 3-7 1 2 2 3 3 3 0-3 1-5 3-7 2 3 5 6 5 11 0 4-3 7-7 7z' },
  { kind: 'distance', label: 'Distance', icon: 'M12 21s-6-5.3-6-11a6 6 0 0 1 12 0c0 5.7-6 11-6 11zM12 12a2 2 0 1 0 0-4 2 2 0 0 0 0 4z' },
];
const RANGES = [
  { id: 'today', label: 'Today' },
  { id: 'week', label: 'Week' },
  { id: 'month', label: 'Month' },
];
const CHECK = 'M5 12l5 5 9-10';
---

{
  NATIVE_APP ? (
    <div class="body" data-body>
      <section class="card body__connect" data-hb-connect hidden aria-labelledby="hb-connect-heading">
        <h2 data-t="health.seeHowRestAndMovement" id="hb-connect-heading">See how rest and movement shape your focus</h2>
        <p data-t="health.chooseWhatToReadFrom" class="muted">Choose what to read from Health Connect. You can change this at any time.</p>
        <div class="body__asks well">
          {HEALTH_KINDS.map((kind) => (
            <label>
              <span data-t={`health.ask.${kind}`}>{ASK[kind]}</span>
              <input type="checkbox" value={kind} checked={kind !== 'heart'} data-hb-ask />
            </label>
          ))}
        </div>
        <button data-t="health.connectHealthConnect" type="button" class="btn body__go" data-hb-go>Connect Health Connect</button>
        <p class="body__refused" data-hb-refused hidden>
          <span data-t="health.nothingAllowed">Nothing was allowed. If Android no longer asks, allow it in Health Connect:</span>{' '}
          <button data-t="health.openItsSettings" type="button" class="body__link" data-hb-manage>open its settings</button>.
        </p>
        <p class="muted body__sub">
          <span data-t="health.noWatch">No watch or app sharing with Health Connect?</span>{' '}
          <button data-t="health.addNumbersByHand" type="button" class="body__link" data-sheet-open="body-entry">Add numbers by hand</button>
        </p>
        <ul class="body__promises muted" role="list">
          {[['health.promise.read', 'Read only. The app never writes to your health record.'], ['health.promise.stays', 'Stays on this phone. It is not part of account sync.'], ['health.promise.ads', 'Never used for ads or shared with anyone.']].map(([key, text]) => (
            <li>
              <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d={CHECK} fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
              <span data-t={key}>{text}</span>
            </li>
          ))}
        </ul>
      </section>

      <div class="body__data" data-hb-data hidden>
        <div data-t-aria-label="health.range" class="body__ranges well" role="group" aria-label="Range" data-hb-ranges>
          {RANGES.map((r) => (
            <button type="button" data-hb-range={r.id} aria-pressed={r.id === 'today' ? 'true' : 'false'} data-t={`health.range.${r.id}`}>{r.label}</button>
          ))}
        </div>

        <section data-t-aria-label="health.bodyData" class="body__tiles" aria-label="Body data">
          {TILES.map((t) => (
            <div class={`card body__tile body__tile--${t.kind}`} data-hb-tile={t.kind}>
              <span class="body__kind">
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d={t.icon} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                <span data-t={`health.tile.${t.kind}`}>{t.label}</span>
              </span>
              <strong class="body__value" data-hb-value />
              <div class="body__bar well" data-hb-bar hidden><i /></div>
              <span class="muted body__sub" data-hb-sub />
              <button data-t="health.allow" type="button" class="body__link body__allow" data-hb-allow hidden>Allow</button>
            </div>
          ))}
        </section>

        <p class="body__hint" data-hb-hint hidden>
          <span data-hb-hint-text />{' '}
          <span data-t="health.onlyWhatOthers"
            >Health Connect only has what other apps put into it. In the app for your watch or band (Samsung Health, Mi Fitness and
            the like), turn on sharing with Health Connect, then come back here.</span
          >
        </p>

        <section class="card body__chart" data-hb-chart hidden aria-labelledby="hb-chart-heading">
          <div>
            <h2 data-t="health.sleepAndFocus" id="hb-chart-heading" class="panel-title">Sleep and focus</h2>
            <p data-t="health.last7Days" class="muted body__sub">Last 7 days</p>
          </div>
          <div class="body__bars well" role="img" data-hb-bars />
          <p class="body__legend">
            <span><i class="body__dot body__dot--sleep" /><span data-t="health.hoursSlept">Hours slept</span></span>
            <span><i class="body__dot body__dot--focus" /><span data-t="health.focusTime">Focus time</span></span>
          </p>
        </section>

        <p class="muted body__note">
          <span data-t="health.bodyDataStays">Body data comes from Health Connect and stays on this phone.</span>{' '}
          <button data-t="health.manage" type="button" class="body__link" data-hb-manage>Manage</button> ·{" "}
          <button data-t="health.addByHand" type="button" class="body__link" data-sheet-open="body-entry" data-hb-entry>Add by hand</button>
        </p>
      </div>

      <p data-t="health.sleepStepsCaloriesAndActivity" class="muted body__note" data-hb-none hidden>Sleep, steps, calories and activity need Health Connect, which is part of Android 14 and later.</p>
    </div>
  ) : (
    <p class="muted body__note">
      <span data-t="health.siteNote"
        >Sleep, steps, exercise, resting heart rate, calories burned and distance are read from Health Connect by the Android app, and stay on the phone. See the</span
      >{' '}
      <a data-t="health.privacyPage" href={url('/privacy')}>privacy page</a>.
    </p>
  )
}

<script>
  import { getSessions, read, subscribe, write } from '../lib/storage';
  import { HEALTH_KINDS, healthConnect, healthRead, healthState, openHealthSettings, type BodyDay, type BodyField, type HealthKind, type HealthState } from '../lib/device';
  import { minutesByDay } from '../lib/stats';
  import { formatFocus } from '../lib/tasks';
  import { addDays, dayKey, fromDayKey } from '../lib/dates';
  import { getManual, withManual } from '../lib/body';
  import { cleanups, listen, onPage } from '../lib/page';
  import { el } from '../lib/dom';
  import { usesMiles } from '../lib/workouts';
  import { dateFormat, locale, t, tn, type Key } from '../lib/i18n';

  type Range = 'today' | 'week' | 'month';
  const SPAN: Record<Range, number> = { today: 1, week: 7, month: 30 };
  const READ_DAYS = 30;
  /** Older days stay in the store for your finding (src/lib/findings.ts), up to this many. */
  const KEEP_DAYS = 90;
  /** What a full bar means on Today. */
  const GOALS = { sleepMin: 8 * 60, steps: 10_000, activeMin: 30 };
  const weekdayFmt = dateFormat({ weekday: 'narrow' });
  const dayNameFmt = dateFormat({ weekday: 'long' });

  const hm = (min: number) => t('unit.hmShort', { h: Math.floor(min / 60), m: String(Math.round(min % 60)).padStart(2, '0') });
  const num = (n: number) => n.toLocaleString(locale());
  const avg = (xs: number[]) => xs.reduce((a, b) => a + b, 0) / xs.length;
  const sum = (xs: number[]) => xs.reduce((a, b) => a + b, 0);
  // Miles where people walk in miles, kilometres everywhere else.
  const distance = (m: number) =>
    usesMiles()
      ? t('health.u.mi', { n: (m / 1609.344).toFixed(m < 16_093 ? 1 : 0) })
      : m < 1000
        ? t('health.u.m', { n: Math.round(m) })
        : t('health.u.km', { n: (m / 1000).toFixed(m < 10_000 ? 1 : 0) });
  const kcal = (n: number) => t('health.u.kcal', { n: num(Math.round(n)) });
  /** Which kind each field belongs to, for the tiles. */
  const KIND_OF: Record<BodyField, HealthKind> = {
    sleepMin: 'sleep',
    steps: 'steps',
    activeMin: 'exercise',
    restingHr: 'heart',
    totalKcal: 'calories',
    activeKcal: 'activeCalories',
    distanceM: 'distance',
  };
  const TILE_OF: Partial<Record<HealthKind, HealthKind>> = { activeCalories: 'calories' };
  const numbers = (days: BodyDay[], key: BodyField) => days.flatMap((d) => (typeof d[key] === 'number' ? [d[key] as number] : []));

  onPage('health-body', () => {
    const root = document.querySelector<HTMLElement>('[data-body]');
    if (!root) return;
    const c = cleanups();
    const $ = <E extends Element>(s: string) => root.querySelector<E>(s)!;
    const connect = $<HTMLElement>('[data-hb-connect]');
    const data = $<HTMLElement>('[data-hb-data]');
    const none = $<HTMLElement>('[data-hb-none]');
    const refused = $<HTMLElement>('[data-hb-refused]');

    let state: HealthState | null = null;
    let range: Range = 'today';
    // The last read is kept so the page has numbers before Health Connect answers.
    const stored = () => read<BodyDay[]>('body', []).filter((d) => d && typeof d.day === 'string');
    let days = stored().slice(-READ_DAYS);
    /** `days` with the typed numbers over them: what the page shows. `days` itself stays as synced. */
    let view: BodyDay[] = days;
    /** Kinds with a number typed in for some day. */
    let typed = new Set<HealthKind>();
    const dayBack = (n: number) => dayKey(addDays(new Date(), -n));

    /** `ask`: the kinds to ask for when the tile's Allow is tapped; without it there is no Allow. */
    function tile(kind: HealthKind, value: string, sub: string, share?: number, ask?: HealthKind[]): void {
      const box = $<HTMLElement>(`[data-hb-tile="${kind}"]`);
      const allow = box.querySelector<HTMLElement>('[data-hb-allow]')!;
      allow.hidden = !ask;
      allow.dataset.kinds = ask?.join(' ') ?? '';
      box.querySelector('[data-hb-value]')!.textContent = value;
      box.querySelector('[data-hb-sub]')!.textContent = sub;
      const bar = box.querySelector<HTMLElement>('[data-hb-bar]')!;
      bar.hidden = share === undefined;
      bar.querySelector('i')!.style.width = `${Math.round(Math.min(1, share ?? 0) * 100)}%`;
    }

    function renderTiles(): void {
      const today = range === 'today';
      const since = dayBack(SPAN[range] - 1);
      const shown = view.filter((d) => d.day >= since);
      // Today is only part of a day, so daily averages leave it out (unless it is all there is).
      const todayKey = dayKey(new Date());
      const finished = shown.filter((d) => d.day !== todayKey);
      const whole = today || !finished.length ? shown : finished;
      const span = range === 'week' ? 'week' : 'month';
      const nothing = t(`health.nothing.${span}` as Key);
      const min = (n: number) => t('unit.min', { n });
      const allowed = (kind: HealthKind) => !!state?.[kind] || typed.has(kind);
      // Without Health Connect on the phone there is nothing to allow: only typing it in.
      const off = (kind: HealthKind, ask: HealthKind[] = [kind]) =>
        state?.available ? tile(kind, t('health.off'), t('health.notAllowed'), undefined, ask) : tile(kind, '–', t('health.notRecorded'));

      const sleep = numbers(shown, 'sleepMin');
      const before = view.find((d) => d.day === dayBack(1));
      if (!allowed('sleep')) off('sleep');
      else if (!sleep.length && today && before?.sleepMin) {
        // Not slept yet since the evening: the night before is the latest there is.
        tile('sleep', hm(before.sleepMin), t('health.nightTo', { day: dayNameFmt.format(fromDayKey(before.day)) }), before.sleepMin / GOALS.sleepMin);
      } else if (!sleep.length) tile('sleep', t('health.noData'), today ? t('health.nothingLastNight') : nothing);
      else if (today) tile('sleep', hm(sleep[0]!), t('health.lastNight'), sleep[0]! / GOALS.sleepMin);
      else tile('sleep', hm(avg(sleep)), tn('health.nightlyAvg', sleep.length));

      const steps = numbers(whole, 'steps');
      if (!allowed('steps')) off('steps');
      else if (!steps.length && today) tile('steps', '0', t('health.goal', { n: num(GOALS.steps) }), 0);
      else if (!steps.length) tile('steps', t('health.noData'), nothing);
      else if (today) tile('steps', num(steps[0]!), t('health.goal', { n: num(GOALS.steps) }), steps[0]! / GOALS.steps);
      else tile('steps', num(Math.round(avg(steps))), t('health.dailyAvgTotal', { total: num(sum(numbers(shown, 'steps'))) }));

      const active = numbers(shown, 'activeMin');
      const total = active.reduce((a, b) => a + b, 0);
      if (!allowed('exercise')) off('exercise');
      else if (!active.length) tile('exercise', today ? min(0) : t('health.noData'), today ? t('health.goal', { n: min(GOALS.activeMin) }) : nothing, today ? 0 : undefined);
      else if (today) tile('exercise', min(total), t('health.goal', { n: min(GOALS.activeMin) }) + (total >= GOALS.activeMin ? t('health.reached') : ''), total / GOALS.activeMin);
      else tile('exercise', formatFocus(total * 60), t(`health.daysOf.${span}` as Key, { n: active.length, total: shown.length }));

      const heart = numbers(shown, 'restingHr');
      const month = numbers(view, 'restingHr');
      if (!allowed('heart')) off('heart');
      else if (!heart.length) tile('heart', t('health.noData'), today ? t('health.nothingToday') : nothing);
      else tile('heart', t('health.u.bpm', { n: Math.round(avg(heart)) }), month.length > 2 ? t('health.last30', { lo: Math.min(...month), hi: Math.max(...month) }) : today ? t('health.range.today') : t('health.average'));

      // Total burned leads, active is the part from moving; either one alone still fills the tile.
      // Health Connect fills a day nothing was recorded for with the resting rate alone (the same
      // ~1,500 kcal whether you walked 16,000 steps or none), so once a watch or app records active
      // calories, only the days it covered count, and both numbers come from the same days.
      const recorded = whole.filter((d) => typeof d.activeKcal === 'number');
      const counted = recorded.length ? recorded : whole;
      const burned = numbers(counted, 'totalKcal');
      const moving = numbers(counted, 'activeKcal');
      const dayCount = today || counted.length === shown.length ? '' : tn('health.dayCount', counted.length);
      const askCalories = (['calories', 'activeCalories'] as const).filter((k) => !allowed(k));
      if (askCalories.length === 2) off('calories', [...askCalories]);
      else if (!burned.length && !moving.length) tile('calories', today ? kcal(0) : t('health.noData'), today ? t('health.nothingToday') : nothing);
      else if (burned.length) {
        const activePart = moving.length
          ? t('health.activeKcal', { kcal: kcal(today ? moving[0]! : avg(moving)) })
          : allowed('activeCalories')
            ? t('health.noActiveKcal')
            : t('health.activeNotAllowed');
        tile('calories', kcal(today ? burned[0]! : avg(burned)), today ? t('health.soFarToday', { part: activePart }) : t('health.dailyAvgPart', { part: activePart, days: dayCount }));
      } else tile('calories', kcal(today ? moving[0]! : avg(moving)), today ? t('health.activeSoFar') : t('health.activeDailyAvg', { days: dayCount }));

      const walked = numbers(whole, 'distanceM');
      if (!allowed('distance')) off('distance');
      else if (!walked.length) tile('distance', today ? distance(0) : t('health.noData'), today ? t('health.nothingToday') : nothing);
      else if (today) tile('distance', distance(walked[0]!), t('health.walkedToday'));
      else tile('distance', distance(avg(walked)), t('health.dailyAvgTotal', { total: distance(sum(numbers(shown, 'distanceM'))) }));
    }

    /** Allowed, yet nothing in a month: no app on the phone is handing that kind to Health Connect. */
    function renderHint(): void {
      const kinds: [HealthKind, BodyField, Key][] = [
        ['sleep', 'sleepMin', 'health.miss.sleep'],
        ['exercise', 'activeMin', 'health.miss.exercise'],
        ['heart', 'restingHr', 'health.miss.heart'],
        ['activeCalories', 'activeKcal', 'health.miss.activeCalories'],
        ['distance', 'distanceM', 'health.miss.distance'],
      ];
      const missing = kinds.filter(([kind, field]) => state?.[kind] && !numbers(view, field).length).map(([, , name]) => t(name));
      const hint = $<HTMLElement>('[data-hb-hint]');
      hint.hidden = !missing.length || !days.length;
      $('[data-hb-hint-text]').textContent = tn('health.missingIn', days.length, { list: missing.join(` ${t('health.or')} `) });
    }

    function renderChart(): void {
      const chart = $<HTMLElement>('[data-hb-chart]');
      const week = Array.from({ length: 7 }, (_, i) => dayBack(6 - i)).map((k) => view.find((d) => d.day === k) ?? { day: k });
      const sleep = week.map((d) => d.sleepMin ?? 0);
      chart.hidden = !(state?.sleep || typed.has('sleep')) || !sleep.some(Boolean);
      if (chart.hidden) return;
      const focusByDay = minutesByDay(getSessions());
      const focus = week.map((d) => Math.round(focusByDay.get(d.day) ?? 0));
      const maxSleep = Math.max(GOALS.sleepMin, ...sleep);
      const maxFocus = Math.max(60, ...focus);
      const todayKey = dayKey(new Date());
      const bars = $<HTMLElement>('[data-hb-bars]');
      bars.replaceChildren(
        ...week.map((d, i) => {
          const col = el('div', 'body__col');
          const pair = el('div', 'body__pair');
          const a = el('i', 'body__dot--sleep');
          a.style.height = `${(sleep[i]! / maxSleep) * 100}%`;
          const b = el('i', 'body__dot--focus');
          b.style.height = `${(focus[i]! / maxFocus) * 100}%`;
          pair.append(a, b);
          col.append(pair, el('span', d.day === todayKey ? 'body__day is-today' : 'body__day muted', weekdayFmt.format(fromDayKey(d.day))));
          return col;
        }),
      );
      bars.setAttribute(
        'aria-label',
        week
          .map((d, i) =>
            t(sleep[i] ? 'health.chartDay' : 'health.chartDayNoSleep', { day: weekdayFmt.format(fromDayKey(d.day)), sleep: sleep[i] ? hm(sleep[i]!) : '', focus: focus[i]! }),
          )
          .join('; '),
      );
    }

    function render(): void {
      const manual = getManual();
      view = withManual(days, manual);
      typed = new Set(Object.values(manual).flatMap((v) => (Object.keys(v) as BodyField[]).map((f) => KIND_OF[f])));
      const any = !!state && HEALTH_KINDS.some((k) => state![k]);
      none.hidden = !!state?.available;
      connect.hidden = !state?.available || any;
      data.hidden = !any && !typed.size;
      if (data.hidden) return;
      data.querySelectorAll<HTMLElement>('[data-hb-range]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.hbRange === range)));
      renderTiles();
      // Today's numbers you typed say so, so a typo is easy to find again.
      const todayTyped = range === 'today' ? manual[dayKey(new Date())] : undefined;
      const marked = new Set(Object.keys(todayTyped ?? {}).map((f) => KIND_OF[f as BodyField]).map((k) => TILE_OF[k] ?? k));
      for (const kind of marked) {
        const sub = root!.querySelector(`[data-hb-tile="${kind}"] [data-hb-sub]`);
        if (sub) sub.textContent = sub.textContent + t('health.addedByYou');
      }
      $<HTMLElement>('[data-hb-entry]').dataset.day = dayKey(new Date());
      renderHint();
      renderChart();
    }

    /** Ask what is allowed now and read it again: permissions change outside the app, in Health Connect. */
    async function refresh(): Promise<void> {
      state = await healthState();
      render();
      if (!state || !HEALTH_KINDS.some((k) => state![k])) return;
      const fresh = await healthRead(READ_DAYS);
      if (!fresh?.days.length) return;
      // A field Health Connect would not answer for this time keeps the numbers from the last read.
      const lost = Object.keys(fresh.failed) as BodyField[];
      const kept = new Map(days.map((d) => [d.day, d]));
      days = fresh.days.map((d) => {
        const old = kept.get(d.day);
        const merged = { ...d };
        for (const field of lost) if (old?.[field] !== undefined) merged[field] = old[field];
        return merged;
      });
      const justRead = new Set(days.map((d) => d.day));
      const older = stored().filter((d) => !justRead.has(d.day));
      write('body', [...older, ...days].sort((a, b) => (a.day < b.day ? -1 : 1)).slice(-KEEP_DAYS));
      render();
    }

    $('[data-hb-go]').addEventListener('click', async () => {
      const kinds = Array.from(root.querySelectorAll<HTMLInputElement>('[data-hb-ask]:checked'), (i) => i.value as HealthKind);
      if (!kinds.length) return;
      const after = await healthConnect(kinds);
      refused.hidden = !after || HEALTH_KINDS.some((k) => after[k]);
      await refresh();
    });
    // Kinds added after the first connect are asked for from their own tile. Android stops asking
    // after two refusals, so a tile refused once already opens Health Connect's own screen instead.
    const refusedOnce = new Set<string>();
    root.querySelectorAll<HTMLElement>('[data-hb-allow]').forEach((b) =>
      b.addEventListener('click', async () => {
        const kinds = (b.dataset.kinds ?? '').split(' ').filter(Boolean) as HealthKind[];
        if (!kinds.length) return;
        if (refusedOnce.has(b.dataset.kinds!)) return openHealthSettings();
        const after = await healthConnect(kinds);
        if (after && !kinds.some((k) => after[k])) refusedOnce.add(b.dataset.kinds!);
        await refresh();
      }),
    );
    root.querySelectorAll('[data-hb-manage]').forEach((b) => b.addEventListener('click', openHealthSettings));
    $('[data-hb-ranges]').addEventListener('click', (e) => {
      const button = (e.target as HTMLElement).closest<HTMLElement>('[data-hb-range]');
      if (!button) return;
      range = button.dataset.hbRange as Range;
      render();
    });

    void refresh();
    c.add(subscribe('sessions', render));
    c.add(subscribe('body-manual', render));
    c.add(
      listen(document, 'visibilitychange', () => {
        if (!document.hidden) void refresh();
      }),
    );
    return c.run;
  });
</script>

<style>
  .body,
  .body__data {
    display: grid;
    gap: var(--space-4);
  }

  .body__data[hidden],
  .body__connect[hidden],
  .body__chart[hidden],
  .body__hint[hidden],
  .body__refused[hidden],
  .body__bar[hidden] {
    display: none;
  }

  .body__connect {
    display: grid;
    gap: var(--space-4);
  }

  .body__connect h2 {
    font-size: var(--text-xl);
  }

  .body__asks {
    padding: 2px var(--space-4);
    border-radius: var(--radius-md);
  }

  .body__asks label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 52px;
