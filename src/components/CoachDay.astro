---
/**
 * Focus › Coach, the day rhythm: Plan in the morning, Now in the day, Close in the evening and
 * the Week on Sunday. It opens on the part that fits the time (phaseFor in src/lib/coachday.ts)
 * and the tabs switch by hand. The Top 3 are the tasks on Today; "Park a thought" is the
 * timer's scratchpad (the Inbox). Canvas: https://claude.ai/artifact/3Yx7NAc7SwuQNnQrESRx27
 */
import Sheet from './Sheet.astro';
import { url } from '../lib/paths';

const PHASES = [
  { id: 'plan', label: 'Plan', t: 'cday.tabPlan' },
  { id: 'now', label: 'Now', t: 'cday.tabNow' },
  { id: 'close', label: 'Close', t: 'cday.tabClose' },
  { id: 'week', label: 'Week', t: 'cday.tabWeek' },
];
const ENERGY = [
  { id: 'low', label: 'Low', t: 'cday.energyLow', bars: 1 },
  { id: 'ok', label: 'OK', t: 'cday.energyOk', bars: 2 },
  { id: 'good', label: 'Good', t: 'cday.energyGood', bars: 3 },
];
const json = JSON.stringify({ timer: url('/timer'), tasks: url('/tasks') }).replace(/</g, '\\u003c');
---

<section class="cday" data-cday aria-label="Your day" data-t-aria-label="cday.yourDay">
  <script type="application/json" data-cday-info set:html={json} />
  <div class="cday-tabs" role="group" aria-label="Part of the day" data-t-aria-label="cday.partOfDay">
    {PHASES.map((p) => <button type="button" data-phase={p.id} aria-pressed="false" data-t={p.t}>{p.label}</button>)}
  </div>

  {/* ---------- Plan ---------- */}
  <div class="cday-view" data-view="plan" hidden>
    <div class="card cday-card">
      <h2 class="cday-q" data-t="cday.energyQ">How's your energy?</h2>
      <div class="cday-energy" data-energy>
        {
          ENERGY.map((e) => (
            <button type="button" data-energy-id={e.id} aria-pressed="false">
              <span class="cday-bars" aria-hidden="true">
                {[1, 2, 3].map((i) => <i class={i <= e.bars ? 'on' : ''} style={`height:${3 + i * 4}px`} />)}
              </span>
              <span data-t={e.t}>{e.label}</span>
            </button>
          ))
        }
      </div>
      <p class="cday-why" data-energy-why></p>
    </div>

    <p class="cday-woop" data-woop hidden></p>

    <div class="card cday-card cday-card--live">
      <div class="cday-head">
        <h2 class="cday-q" data-t="cday.top3">Today's Top 3</h2>
        <span class="cday-sum" data-top-sum></span>
      </div>
      <ol class="cday-top" role="list" data-top></ol>
      <p class="cday-why" data-top-empty data-t="cday.topEmpty" hidden>Pick up to three tasks. Fewer is fine.</p>
      <p class="cday-why" data-top-more hidden></p>
      <p class="cday-why" data-top-pad hidden></p>
      <button type="button" class="btn btn--ghost btn--small cday-pick-open" data-sheet-open="coach-pick" data-t="cday.pickFromTasks">Pick from Tasks</button>
    </div>

    <div class="card cday-card" data-fit hidden>
      <h2 class="cday-q" data-t="cday.whereItFits">Where it fits</h2>
      <div class="cday-dayline" aria-hidden="true">
        <span class="cday-peak" data-fit-peak></span>
        <span class="cday-nowline" data-fit-now></span>
      </div>
      <div class="cday-hours" aria-hidden="true"><span>6</span><span>10</span><span>14</span><span>18</span><span>22</span></div>
      <p class="cday-why" data-fit-text></p>
    </div>

    <a class="btn cday-go" href="#" data-plan-start hidden></a>
    <button type="button" class="cday-link" data-plan-skip data-t="cday.skipPlan">Skip planning today</button>
  </div>

  {/* ---------- Now ---------- */}
  <div class="cday-view" data-view="now" hidden>
    <div class="card cday-card" data-progress>
      <div class="cday-head">
        <h2 class="cday-q" data-t="cday.top3Short">Top 3</h2>
        <span class="cday-sum" data-progress-count></span>
      </div>
      <div class="cday-meter" aria-hidden="true"><i data-progress-bar></i></div>
      <ol class="cday-top" role="list" data-progress-list></ol>
      <p class="cday-why" data-progress-empty hidden>
        <span data-t="cday.noTop">No Top 3 today.</span>
        <button type="button" class="cday-link cday-link--inline" data-go-plan data-t="cday.planNow">Plan it</button>
      </p>
    </div>

    <div class="card cday-card cday-card--live" data-sig hidden>
      <p class="cday-eyebrow" data-t="cday.coachSays">Coach</p>
      <p class="cday-big" data-sig-text></p>
      <p class="cday-why" data-sig-why></p>
      <a class="btn cday-go" href="#" data-sig-go></a>
      <div class="cday-links">
        <button type="button" class="cday-link" data-sig-snooze data-t="cday.notNow">Not now</button>
        <button type="button" class="cday-link" data-sig-mute data-t="cday.notTrue">This isn't true</button>
      </div>
    </div>

    <form class="card cday-card" data-park>
      <h2 class="cday-q"><label for="cday-park" data-t="cday.parkQ">Park a thought</label></h2>
      <p class="cday-why" data-t="cday.parkWhy">Something pulling you away? Write it down and get back to it when you close the day.</p>
      <div class="cday-row">
        <input id="cday-park" class="input" name="thought" maxlength="120" autocomplete="off" placeholder="e.g. book the dentist" data-t-placeholder="cday.parkPlaceholder" />
        <button type="submit" class="btn btn--small" data-t="cday.park">Park</button>
      </div>
      <p class="cday-why" data-park-count hidden></p>
    </form>
  </div>

  {/* ---------- Close ---------- */}
  <div class="cday-view" data-view="close" hidden>
    <div class="card cday-card">
      <p class="cday-big" data-close-head></p>
      <p class="cday-why" data-close-sub></p>
      <dl class="cday-kv" data-close-rows></dl>
      <p class="cday-why" data-close-bias hidden></p>
    </div>

    <div class="card cday-card" data-close-left-card hidden>
      <h2 class="cday-q" data-t="cday.firstStepQ">What's the first step tomorrow?</h2>
      <div class="cday-list" data-close-left></div>
    </div>

    <div class="card cday-card" data-close-parked hidden>
      <h2 class="cday-q" data-close-parked-title></h2>
      <ul class="cday-parked" role="list" data-close-parked-list></ul>
    </div>

    <button type="button" class="btn cday-go" data-close-day data-t="cday.closeDay">Close the day</button>
    <div class="card cday-card cday-closed" data-closed hidden>
      <p class="cday-big" data-t="cday.closedHead">Day closed.</p>
      <p class="cday-why" data-t="cday.closedSub">What's left has its first step. The rest of the evening is yours.</p>
      <button type="button" class="cday-link" data-reopen data-t="cday.reopen">Open it again</button>
    </div>
  </div>

  {/* ---------- Week ---------- */}
  <div class="cday-view" data-view="week" hidden>
    <div class="card cday-card">
      <p class="cday-eyebrow" data-t="cday.weekSoFar">This week so far</p>
      <dl class="cday-kv" data-week-rows></dl>
    </div>
    <div class="card cday-card">
      <p class="cday-q" data-week-kind-head></p>
      <p class="cday-why" data-week-kind></p>
    </div>
    <form class="card cday-card cday-card--live cday-woop-form" data-woop-form>
      <p class="cday-eyebrow" data-woop-title></p>
      <p class="cday-why" data-t="cday.woopWhy">Four short lines. Naming the obstacle and a plan for it works better than only picturing the goal.</p>
      <label class="cday-field"><span data-t="cday.woopWish">Wish</span><input class="input" name="wish" maxlength="120" required placeholder="e.g. Finish chapter 2" data-t-placeholder="cday.woopWishPh" /></label>
      <label class="cday-field"><span data-t="cday.woopOutcome">Best result</span><input class="input" name="outcome" maxlength="120" placeholder="e.g. Send it on Friday" data-t-placeholder="cday.woopOutcomePh" /></label>
      <label class="cday-field"><span data-t="cday.woopObstacle">What gets in the way</span><input class="input" name="obstacle" maxlength="120" required placeholder="e.g. I pick up my phone when it gets hard" data-t-placeholder="cday.woopObstaclePh" /></label>
      <label class="cday-field"><span data-t="cday.woopPlan">If that happens, I will…</span><input class="input" name="plan" maxlength="120" required placeholder="e.g. park the thought and write one sentence" data-t-placeholder="cday.woopPlanPh" /></label>
      <button type="submit" class="btn" data-t="cday.woopSave">Save next week's plan</button>
      <p class="cday-why" data-woop-saved hidden data-t="cday.woopSaved">Saved. It shows in Plan each morning.</p>
    </form>
  </div>
</section>

<Sheet id="coach-pick" title="Pick up to 3" titleKey="cday.pickTitle">
  <p class="muted cday-pick-intro" data-t="cday.pickIntro">From Today, what's due and what's next. Tap again to take one off Today.</p>
  <ul class="cday-pick" role="list" data-pick-list></ul>
  <p class="muted" data-pick-empty hidden data-t="cday.pickEmpty">No open tasks yet. Add some in Tasks.</p>
  <button type="button" class="btn cday-go" data-sheet-close data-t="cday.done">Done</button>
</Sheet>

<script>
  import { t, tn, type Key } from '../lib/i18n';
  import { getCoach, setCoach, setDay, type CoachDay, type Energy } from '../lib/coach';
  import { ESTIMATES, energyFromSleep, estimateRatio, focusOn, lastNight, padded, phaseFor, signal, topIds, totalOn, weekSummary, woopWeek, type Phase, type Signal } from '../lib/coachday';
  import { focusHours, atHour } from '../lib/findings';
  import { getSessions, getTasks, subscribe, deleteTask, type Task } from '../lib/storage';
  import { addStep, doStepNext, jot, listOf, moveTask, todayTasks } from '../lib/tasks';
  import { isDue, whenLabel } from '../lib/when';
  import { getProfile } from '../lib/profile';
  import { bodyDays } from '../lib/body';
  import { getScreen } from '../lib/screen';
  import { hoursMinutes } from '../lib/i18n/units';
  import { dayKey } from '../lib/dates';
  import { el } from '../lib/dom';
  import { celebrate } from '../lib/appearance';
  import { offerUndo } from '../lib/undo';
  import { onPage, cleanups } from '../lib/page';

  onPage('coach-day', () => {
    const root = document.querySelector<HTMLElement>('[data-cday]');
    const pickSheet = document.querySelector<HTMLDialogElement>('[data-sheet="coach-pick"]');
    if (!root || !pickSheet) return;
    const { timer } = JSON.parse(root.querySelector('[data-cday-info]')!.textContent!) as { timer: string; tasks: string };
    const $ = <T extends HTMLElement = HTMLElement>(sel: string, from: ParentNode = root) => from.querySelector<T>(sel)!;
    const c = cleanups();

    const key = () => dayKey(Date.now());
    const today = () => getCoach().days[key()];
    const open = (): Task[] => getTasks().filter((x) => x.status === 'active' && !x.deletedAt);
    const quoted = (s: string) => t('coach.quoted', { text: s });
    const mins = (m: number) => hoursMinutes(m);
    let phase: Phase = phaseFor(today(), getSessions());
    let chosenByHand = false;

    function startHref(taskId: string | undefined, mode = 'pomodoro', min?: number): string {
      const q = new URLSearchParams({ mode });
      if (taskId) q.set('task', taskId);
      if (min) q.set('min', String(min));
      return `${timer}?${q}`;
    }

    /** The Top 3 as tasks, in order; picked ones that are gone are left out. */
    function topTasks(day: CoachDay | undefined): Task[] {
      const all = getTasks();
      return topIds(day, todayTasks(open()))
        .map((id) => all.find((x) => x.id === id && !x.deletedAt))
        .filter((x): x is Task => !!x);
    }

    const doneToday = (task: Task) => task.status === 'done' && task.doneAt !== undefined && dayKey(task.doneAt) === key();

    // ---------- Tabs ----------
    function showPhase(p: Phase): void {
      phase = p;
      for (const b of root!.querySelectorAll<HTMLButtonElement>('[data-phase]')) b.setAttribute('aria-pressed', String(b.dataset.phase === p));
      for (const v of root!.querySelectorAll<HTMLElement>('[data-view]')) v.hidden = v.dataset.view !== p;
      render();
    }
    root.querySelector('.cday-tabs')!.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-phase]');
      if (!b) return;
      chosenByHand = true;
      showPhase(b.dataset.phase as Phase);
    });

    // ---------- Plan ----------
    const energyWhy: Record<Energy, Key> = { low: 'cday.energyLowWhy', ok: 'cday.energyOkWhy', good: 'cday.energyGoodWhy' };

    function renderPlan(): void {
      const day = today();
      const sleep = getProfile().modules.health ? lastNight(bodyDays()) : undefined;
      const energy = day?.energy;
      for (const b of root!.querySelectorAll<HTMLButtonElement>('[data-energy-id]')) b.setAttribute('aria-pressed', String(b.dataset.energyId === energy));
      const why = $('[data-energy-why]');
      const slept = sleep ? t('cday.slept', { time: mins(sleep) }) : '';
      const hint = energy ? t(energyWhy[energy]) : sleep ? t('cday.sleepHint', { energy: t(`cday.energy${cap(energyFromSleep(sleep)!)}` as Key) }) : t('cday.energyAsk');
      why.textContent = [slept, hint].filter(Boolean).join(' ');

      const woop = getCoach().woop;
      const woopEl = $('[data-woop]');
      const thisWeek = woop && woop.week === woopWeek(new Date()) && new Date().getDay() !== 0;
      woopEl.hidden = !thisWeek;
      if (thisWeek) woopEl.textContent = t('cday.woopLine', { wish: woop!.wish, plan: woop!.plan });

      const top = topTasks(day).filter((x) => x.status === 'active');
      const est = day?.est ?? {};
      const ratio = estimateRatio(getCoach(), getSessions());
      const list = $('[data-top]');
      list.replaceChildren(
        ...top.map((task, i) => {
          const li = el('li', 'cday-top__row');
          const text = el('div', 'cday-top__text');
          text.append(el('strong', '', task.title || t('tasks.untitled')));
          if (i === 0 && top.length > 1) text.append(el('small', '', t('cday.firstUp')));
          const chips = el('div', 'cday-est');
          chips.setAttribute('role', 'group');
          chips.setAttribute('aria-label', t('cday.estimateFor', { task: task.title }));
          for (const m of ESTIMATES) {
            const b = el('button', '', String(m));
            b.type = 'button';
            b.dataset.est = String(m);
            b.dataset.task = task.id;
            b.setAttribute('aria-pressed', String(est[task.id] === m));
            b.setAttribute('aria-label', t('cday.minutes', { n: m }));
            chips.append(b);
          }
          li.append(el('span', 'cday-num', String(i + 1)), text, chips);
          return li;
        }),
      );
      $('[data-top-empty]').hidden = top.length > 0;
      const onToday = todayTasks(open()).length;
      const more = $('[data-top-more]');
      more.hidden = onToday <= 3;
      if (!more.hidden) more.textContent = tn('cday.moreOnToday', onToday - 3);
      const total = top.reduce((n, x) => n + (est[x.id] ?? 0), 0);
      const sum = $('[data-top-sum]');
      sum.textContent = total ? t('cday.aboutFocus', { time: mins(padded(total, ratio)) }) : '';
      const pad = $('[data-top-pad]');
      pad.hidden = !total || padded(total, ratio) === total;
      if (!pad.hidden) pad.textContent = t('cday.padded', { pct: Math.round((ratio! - 1) * 100) });

      // Where it fits: your best two hours, from your own sessions.
      const peak = focusHours(getSessions());
      const fit = $('[data-fit]');
      fit.hidden = !peak;
      if (peak) {
        const pos = (h: number) => `${Math.max(0, Math.min(100, ((h - 6) / 16) * 100))}%`;
        const bar = $('[data-fit-peak]');
        bar.style.left = pos(peak.first);
        bar.style.width = `${(2 / 16) * 100}%`;
        const now = new Date();
        $('[data-fit-now]').style.left = pos(now.getHours() + now.getMinutes() / 60);
        const first = top[0];
        $('[data-fit-text]').textContent = [
          t('cday.peakLine', { from: atHour(peak.first), to: atHour(peak.first + 2) }),
          first && energy !== 'low' ? t('cday.hardestThere', { task: quoted(first.title) }) : '',
        ]
          .filter(Boolean)
          .join(' ');
      }

      const go = $<HTMLAnchorElement>('[data-plan-start]');
      go.hidden = !top.length;
      if (top[0]) {
        go.href = startHref(top[0].id, energy === 'low' ? 'custom' : 'pomodoro', energy === 'low' ? 15 : undefined);
        go.textContent = t('cday.startTask', { task: quoted(top[0].title) });
      }
    }

    const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

    $('[data-energy]').addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-energy-id]');
      if (!b) return;
      const id = b.dataset.energyId as Energy;
      setDay(key(), (d) => ({ ...d, energy: d.energy === id ? undefined : id }));
    });

    $('[data-top]').addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-est]');
      if (!b) return;
      const id = b.dataset.task!;
      const m = Number(b.dataset.est);
      setDay(key(), (d) => {
        const est = { ...(d.est ?? {}) };
        if (est[id] === m) delete est[id];
        else est[id] = m;
        return { ...d, est };
      });
    });

    function planned(): void {
      setDay(key(), (d) => ({ ...d, plannedAt: d.plannedAt ?? Date.now(), top: d.top ?? topTasks(d).map((x) => x.id) }));
    }
    $('[data-plan-start]').addEventListener('click', planned);
    $('[data-plan-skip]').addEventListener('click', () => {
      planned();
      showPhase('now');
    });

    // ---------- Pick sheet ----------
    /** The sheet's order, set when it opens so rows don't jump while you tap them. */
    let pickOrder: string[] = [];

    function sortPick(): void {
      // Today, then what's due and Next; the Inbox and Someday stay out.
      const all = open().filter((x) => listOf(x) === 'today' || listOf(x) === 'next');
      const onToday = todayTasks(all);
      const rest = all
        .filter((x) => !onToday.includes(x))
        .sort((a, b) => Number(isDue(b)) - Number(isDue(a)) || (a.due ?? '9').localeCompare(b.due ?? '9') || b.updatedAt - a.updatedAt);
      pickOrder = [...onToday, ...rest].slice(0, 14).map((x) => x.id);
    }

    function renderPick(): void {
      const all = open();
      const picked = topIds(today(), todayTasks(all));
      const rows = pickOrder.map((id) => all.find((x) => x.id === id)).filter((x): x is Task => !!x);
      $('[data-pick-empty]', pickSheet!).hidden = rows.length > 0;
      $('[data-pick-list]', pickSheet!).replaceChildren(
        ...rows.map((task) => {
          const li = el('li');
          const b = el('button', 'cday-pick__row');
          b.type = 'button';
          b.dataset.pick = task.id;
          const n = picked.indexOf(task.id);
          b.setAttribute('aria-pressed', String(n !== -1));
          const sub = n !== -1 ? '' : listOf(task) === 'today' ? t('cday.onToday') : task.due || task.repeat ? whenLabel(task) : '';
          const text = el('span', 'cday-pick__text');
          text.append(el('strong', '', task.title || t('tasks.untitled')));
          if (sub) text.append(el('small', '', sub));
          b.append(el('span', 'cday-num', n !== -1 ? String(n + 1) : ''), text);
          li.append(b);
          return li;
        }),
      );
    }

    pickSheet.addEventListener('sheet:open', () => {
      sortPick();
      renderPick();
    });
    pickSheet.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-pick]');
      if (!b) return;
      const id = b.dataset.pick!;
      const day = today();
      const current = topIds(day, todayTasks(open()));
      if (current.includes(id)) {
        setDay(key(), (d) => ({ ...d, top: current.filter((x) => x !== id) }));
        moveTask(id, 'next');
      } else {
        if (current.length >= 3) return;
        setDay(key(), (d) => ({ ...d, top: [...current, id] }));
        moveTask(id, 'today');
      }
      renderPick();
    });

    // ---------- Now ----------
    let current: Signal | undefined;

    function renderNow(): void {
      const day = today();
      const sessions = getSessions();
      const top = topTasks(day);
      const focus = focusOn(sessions, key());
      const done = top.filter(doneToday).length;
      $('[data-progress-count]').textContent = top.length ? t('cday.doneOf', { done, n: top.length }) : '';
      $<HTMLElement>('[data-progress-bar]').style.width = top.length ? `${(done / top.length) * 100}%` : '0';
      $('[data-progress-empty]').hidden = top.length > 0;
      $('[data-progress-list]').replaceChildren(
        ...top.map((task) => {
          const li = el('li', `cday-top__row${doneToday(task) ? ' cday-top__row--done' : ''}`);
          const text = el('div', 'cday-top__text');
          text.append(el('strong', '', task.title || t('tasks.untitled')));
          const est = day?.est?.[task.id];
          const took = Math.round((focus.get(task.id) ?? 0) / 60);
          const bits = [est ? t('cday.est', { n: est }) : '', took ? t('cday.took', { time: mins(took) }) : ''].filter(Boolean);
          if (bits.length) text.append(el('small', '', bits.join(' · ')));
          const dot = el('span', `cday-dot${doneToday(task) ? ' cday-dot--done' : ''}`);
          dot.setAttribute('aria-hidden', 'true');
          li.append(dot, text);
          if (doneToday(task)) li.append(el('span', 'visually-hidden', t('cday.isDone')));
          return li;
        }),
      );

      const profile = getProfile();
      current = signal({
        now: new Date(),
        day,
        muted: getCoach().muted,
        today: todayTasks(open()),
        sessions,
        peak: focusHours(sessions)?.first,
        phone: profile.modules.screen ? getScreen().sessions : undefined,
      });
      const card = $('[data-sig]');
      card.hidden = !current;
      if (current) {
        const v: Record<string, string | number> = { ...current.vars, task: quoted(String(current.vars.task ?? '')) };
        if (current.vars.part) v.part = t(`cday.part.${current.vars.part}` as Key);
        $('[data-sig-text]').textContent = t(`cday.sig.${current.id}` as Key, v);
        $('[data-sig-why]').textContent = current.id === 'stuck' ? tn('cday.sigWhy.stuck', Number(current.vars.days)) : current.id === 'phone' ? tn('cday.sigWhy.phone', Number(current.vars.n), v) : t(`cday.sigWhy.${current.id}` as Key, v);
        const go = $<HTMLAnchorElement>('[data-sig-go]');
        go.href = startHref(current.taskId, current.mode, current.min);
        go.textContent = current.min ? t('cday.startMin', { n: current.min }) : current.mode === 'flowtime' ? t('coach.startTwo') : t('coach.start');
        $('[data-sig-mute]').hidden = current.id === 'next';
      }

      const parked = parkedToday();
      const count = $('[data-park-count]');
      count.hidden = !parked.length;
      if (parked.length) count.textContent = tn('cday.parkedToday', parked.length);
    }

    $('[data-sig-snooze]').addEventListener('click', () => {
      const id = current?.id;
      if (id) setDay(key(), (d) => ({ ...d, snoozed: [...(d.snoozed ?? []), id] }));
    });
    $('[data-sig-mute]').addEventListener('click', () => {
      const id = current?.id;
      if (id) setCoach({ muted: [...getCoach().muted, id] });
    });
    $('[data-go-plan]').addEventListener('click', () => showPhase('plan'));

    /** Thoughts parked today: Inbox tasks made today. */
    const parkedToday = () => open().filter((x) => listOf(x) === 'inbox' && dayKey(x.createdAt) === key());

    $<HTMLFormElement>('[data-park]').addEventListener('submit', (e) => {
      e.preventDefault();
      const input = $<HTMLInputElement>('#cday-park');
      if (jot(input.value)) input.value = '';
    });

    // ---------- Close ----------
    function renderClose(): void {
      const day = today();
      const sessions = getSessions();
      const top = topTasks(day);
      const focusSec = totalOn(sessions, key());
      const done = top.filter(doneToday).length;
      const closed = !!day?.closedAt;
      const time = mins(Math.round(focusSec / 60));
      $('[data-close-head]').textContent = top.length && (focusSec || done)
        ? t('cday.closeHead', { done, n: top.length, time })
        : focusSec
          ? t('cday.closeHeadNoPlan', { time })
          : t('cday.closeQuiet');
      $('[data-close-sub]').textContent = focusSec || done ? t('cday.closeSub') : t('cday.closeQuietSub');

      const focus = focusOn(sessions, key());
      $('[data-close-rows]').replaceChildren(
        ...top.flatMap((task) => {
          const est = day?.est?.[task.id];
          const took = Math.round((focus.get(task.id) ?? 0) / 60);
          const over = est && took > est * 1.15;
          const value = el('dd', over ? 'cday-over' : '');
          value.textContent = doneToday(task)
            ? [est ? t('cday.est', { n: est }) : '', took ? t('cday.took', { time: mins(took) }) : t('cday.isDone')].filter(Boolean).join(' · ')
            : took
              ? t('cday.took', { time: mins(took) })
              : t('cday.tomorrow');
          return [el('dt', doneToday(task) ? 'cday-done' : '', task.title || t('tasks.untitled')), value];
        }),
      );
      const ratio = estimateRatio(getCoach(), sessions);
      const bias = $('[data-close-bias]');
      bias.hidden = !ratio || ratio < 1.15;
      if (!bias.hidden) bias.textContent = t('cday.bias', { pct: Math.round((ratio! - 1) * 100) });

      // What's left: write tomorrow's first step. It stays on Today.
      const left = top.filter((x) => x.status === 'active');
      $('[data-close-left-card]').hidden = closed || !left.length;
      $('[data-close-left]').replaceChildren(
        ...(closed
          ? []
          : left.map((task) => {
              const form = el('form', 'cday-left');
              form.dataset.left = task.id;
              const id = `cday-step-${task.id}`;
              const label = el('label', 'cday-left__task', task.title || t('tasks.untitled'));
              label.setAttribute('for', id);
              const next = task.steps.find((s) => !s.done);
              const hint = el('p', 'cday-why', next ? t('cday.nextIs', { step: next.text }) : '');
              hint.hidden = !next;
              const row = el('div', 'cday-row');
              const input = el('input', 'input');
              input.id = id;
              input.name = 'step';
              input.maxLength = 120;
              input.autocomplete = 'off';
              input.placeholder = t('cday.firstStepPh');
              const save = el('button', 'btn btn--small btn--ghost', t('cday.forTomorrow'));
              save.type = 'submit';
              row.append(input, save);
              form.append(label, hint, row);
              return form;
            })),
      );

      const parked = parkedToday();
      const box = $('[data-close-parked]');
      box.hidden = !parked.length || closed;
      $('[data-close-parked-title]').textContent = tn('cday.parkedTitle', parked.length);
      $('[data-close-parked-list]').replaceChildren(
        ...parked.map((x) => {
          const li = el('li', 'cday-parked__row');
          const keep = el('button', 'btn btn--small btn--ghost', t('cday.keepTask'));
          keep.type = 'button';
          keep.dataset.keep = x.id;
          const drop = el('button', 'cday-link', t('cday.letGo'));
          drop.type = 'button';
          drop.dataset.drop = x.id;
          li.append(el('span', 'cday-parked__text', x.title), keep, drop);
          return li;
        }),
      );

      $('[data-close-day]').hidden = closed;
      $('[data-closed]').hidden = !closed;
    }

    $('[data-close-left]').addEventListener('submit', (e) => {
      e.preventDefault();
      const form = e.target as HTMLFormElement;
      const id = form.dataset.left!;
      const input = form.elements.namedItem('step') as HTMLInputElement;
      const text = input.value.trim();
      if (!text) return;
      addStep(id, text);
      const step = getTasks().find((x) => x.id === id)?.steps.filter((s) => s.text === text.slice(0, 120)).pop();
      if (step) doStepNext(id, step.id);
      moveTask(id, 'today');
    });

    $('[data-close-parked-list]').addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-keep], [data-drop]');
      if (!b) return;
      if (b.dataset.keep) return moveTask(b.dataset.keep, 'next');
      const id = b.dataset.drop!;
      const task = getTasks().find((x) => x.id === id);
      const row = b.closest('li') as HTMLElement;
      row.hidden = true;
      offerUndo({
        message: t('cday.letGoDone', { task: task?.title ?? '' }),
        commit: () => deleteTask(id),
        undo: () => (row.hidden = false),
      });
    });

    $('[data-close-day]').addEventListener('click', (e) => {
      setDay(key(), (d) => ({ ...d, closedAt: Date.now() }));
      celebrate(e.currentTarget as Element);
    });
    $('[data-reopen]').addEventListener('click', () => setDay(key(), (d) => ({ ...d, closedAt: undefined })));

    // ---------- Week ----------
    function renderWeek(): void {
      const coach = getCoach();
      const sessions = getSessions();
      const w = weekSummary(coach, sessions, getTasks());
      const peak = focusHours(sessions);
      const best = Object.entries(coach.worked)
        .filter(([, x]) => x.tries >= 2)
        .sort((a, b) => b[1].helped / b[1].tries - a[1].helped / a[1].tries)[0];
      const rows: [string, string][] = [
        [t('cday.weekFocus'), mins(Math.round(w.focusSeconds / 60))],
        [t('cday.weekTop'), w.planned ? t('cday.doneOf', { done: w.done, n: w.planned }) : '–'],
        [t('cday.weekClosed'), t('cday.doneOf', { done: w.closed, n: w.daysSoFar })],
      ];
      if (peak) rows.push([t('cday.weekPeak'), `${atHour(peak.first)}–${atHour(peak.first + 2)}`]);
      if (best && best[1].helped / best[1].tries >= 0.5) rows.push([t('cday.weekHelped'), t(`tech.${best[0]}.title` as Key)]);
      $('[data-week-rows]').replaceChildren(...rows.flatMap(([k, v]) => [el('dt', '', k), el('dd', '', v)]));

      const quiet = w.quietDays > 0 && w.daysSoFar > 1;
      $('[data-week-kind-head]').textContent = quiet ? t('cday.kindQuietHead') : t('cday.kindHead');
      $('[data-week-kind]').textContent = quiet ? tn('cday.kindQuiet', w.quietDays) : t('cday.kind');

      const form = $<HTMLFormElement>('[data-woop-form]');
      const week = woopWeek(new Date());
      $('[data-woop-title]').textContent = new Date().getDay() === 0 ? t('cday.woopNextWeek') : t('cday.woopThisWeek');
      const saved = coach.woop?.week === week ? coach.woop : null;
      if (!form.contains(document.activeElement)) {
        for (const k of ['wish', 'outcome', 'obstacle', 'plan'] as const) (form.elements.namedItem(k) as HTMLInputElement).value = saved?.[k] ?? '';
      }
      $('[data-woop-saved]').hidden = !saved;
    }

    $<HTMLFormElement>('[data-woop-form]').addEventListener('submit', (e) => {
      e.preventDefault();
      const f = new FormData(e.currentTarget as HTMLFormElement);
      const v = (k: string) => String(f.get(k) ?? '').trim().slice(0, 120);
      if (!v('wish') || !v('obstacle') || !v('plan')) return;
      (document.activeElement as HTMLElement | null)?.blur();
      setCoach({ woop: { week: woopWeek(new Date()), wish: v('wish'), outcome: v('outcome'), obstacle: v('obstacle'), plan: v('plan') } });
    });

    // ---------- All ----------
    function render(): void {
      if (phase === 'plan') renderPlan();
      else if (phase === 'now') renderNow();
      else if (phase === 'close') renderClose();
      else renderWeek();
    }

    function refresh(): void {
      // Follow the time of day until you pick a tab yourself.
      if (!chosenByHand) {
        const p = phaseFor(today(), getSessions());
        if (p !== phase) return showPhase(p);
      }
      render();
      if (pickSheet!.open) renderPick();
    }

    c.add(subscribe('coach', refresh));
    c.add(subscribe('tasks', refresh));
    c.add(subscribe('sessions', refresh));
    const tick = window.setInterval(refresh, 5 * 60_000);
    c.add(() => window.clearInterval(tick));
    showPhase(phase);
    return c.run;
  });
</script>

