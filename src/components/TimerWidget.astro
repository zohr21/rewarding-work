---
/**
 * Focus timer. Used standalone on /timer and embedded on technique pages.
 * Use at most one per page (element ids are fixed).
 *
 * There is one shared timer across the whole site: a session started on a technique
 * page keeps running on /timer, after a reload, or in another tab.
 */
import { TIMER_MODES, type TimerMode } from '../data/taxonomy';
import { modeKey, modeLabel, toneLabel } from '../lib/i18n/labels';
import Sprig from './Sprig.astro';
import { NATIVE_APP } from '../config/app';
import { url } from '../lib/paths';
import { TONES } from '../lib/timer/cues';
import Sheet from './Sheet.astro';

/** What each rhythm does, shown under the picked one in the rhythm sheet (keys in src/lib/i18n). */
const RUN_KEYS = { pomodoro: 'timer.runsPomodoro', '52-17': 'timer.runsFiftyTwo', flowtime: 'timer.runsFlowtime', custom: 'timer.runsCustom' } as const;
const RUNS: Record<TimerMode, string> = {
  pomodoro: '25 minutes focus, 5 minute break, a 15 minute break after every 4. Good default, especially for getting started.',
  '52-17': 'Longer focus blocks with a proper break. Suits work that takes a while to get into.',
  flowtime: 'Counts up. Press “Stop & take a break” when your focus fades; the break is a fifth of your focus time.',
  custom: 'Your own lengths, handy for timeboxing a task. Set the break to 0 for no break.',
};

interface Props {
  /** Mode shown when no session is in progress. Standalone uses the user's last mode. */
  defaultMode?: TimerMode;
  /** Standalone page: enables Space / R shortcuts and a larger layout. */
  standalone?: boolean;
  /** Standalone: each rhythm with the page of the technique it comes from, for "Why it works". */
  rhythms?: { mode: TimerMode; href: string }[];
}

const { defaultMode, standalone = false, rhythms = [] } = Astro.props;
const RADIUS = 92;
const CIRCUMFERENCE = 2 * Math.PI * RADIUS;
---

<section
  class:list={['timer', { 'timer--standalone': standalone }]}
  data-timer
  data-default-mode={defaultMode}
  data-shortcuts={standalone ? '' : undefined}
  data-icon={url('/favicon.svg')}
  data-tasks-url={url('/tasks')}
  data-phase="work"
  data-status="idle"
  aria-labelledby="timer-heading">
  {standalone && <h2 data-t="timer.tryItFocusTimer" id="timer-heading" class="visually-hidden">Try it: focus timer</h2>}

  {
    /* On /timer what you are focusing on sits at the top, one row that opens the task sheet. */
    standalone && (
      <button type="button" class="timer__taskrow" data-task-row data-sheet-open="timer-task" aria-haspopup="dialog">
        <span class="timer__taskrow-text">
          <span class="timer__taskrow-name" data-task-row-name></span>
          <span class="timer__taskrow-meta muted" data-task-row-meta></span>
        </span>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </button>
    )
  }

  {
    !standalone && (
      <div class="timer__head">
        <h2 data-t="timer.tryItFocusTimer" id="timer-heading">Try it: focus timer</h2>
        {/* In the app the rhythm is a chip that opens the four choices; the site shows them all, always open. */}
        <details class="timer__rhythm" data-rhythm-menu open={!NATIVE_APP}>
          <summary class="timer__rhythm-chip">
            <span data-rhythm-label data-t={modeKey(defaultMode ?? 'pomodoro')}>{modeLabel(defaultMode ?? 'pomodoro')}</span>
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          </summary>
          <fieldset class="timer__modes" data-modes>
            <legend data-t="timer.timerMode" class="visually-hidden">Timer mode</legend>
            {
              TIMER_MODES.map((m) => (
                <label class="seg">
                  <input type="radio" name="timer-mode" value={m} checked={m === (defaultMode ?? 'pomodoro')} />
                  <span data-t={modeKey(m)}>{modeLabel(m)}</span>
                </label>
              ))
            }
          </fieldset>
        </details>
        <p data-t="timer.resetToChangeMode" class="timer__mode-hint muted" data-mode-hint hidden>Reset to change mode.</p>
      </div>
    )
  }

  {
    !standalone && (
      <div class="timer__custom" data-custom hidden>
        <label>
          <span data-t="timer.focusMin">Focus (min)</span>
          <input type="number" inputmode="numeric" min="1" max="240" step="1" value="15" data-custom-work />
        </label>
        <label>
          <span data-t="timer.breakMin">Break (min)</span>
          <input type="number" inputmode="numeric" min="0" max="60" step="1" value="5" data-custom-break />
        </label>
      </div>
    )
  }

  {/* On /timer a 3D tree grows out of the top of the dial as the session runs (focus-tree.ts). */}
  {
    standalone && (
      <div class="timer__tree" data-focus-tree aria-hidden="true">
        <canvas></canvas>
      </div>
    )
  }

  <div class="timer__dial" data-dial>
    <svg class="timer__ring" viewBox="0 0 200 200" aria-hidden="true">
      <circle class="timer__track" cx="100" cy="100" r={RADIUS}></circle>
      <circle
        class="timer__progress"
        cx="100"
        cy="100"
        r={RADIUS}
        stroke-dasharray={CIRCUMFERENCE}
        stroke-dashoffset="0"
        data-ring
        data-circumference={CIRCUMFERENCE}></circle>
    </svg>
    <div class:list={['timer__readout', { 'timer__readout--sprig': standalone }]}>
      {/* On /timer Sprig keeps you company: eyes closed while you focus, cheering when a session ends (timer-ui.ts). */}
      {
        standalone && (
          <span class="timer__sprig" data-timer-sprig>
            <Sprig size={42} />
          </span>
        )
      }
      <p data-t="timer.focus" class="timer__phase" data-phase-label>Focus</p>
      <p class="timer__time" role="timer" aria-atomic="true" data-time>25:00</p>
      <p class="timer__dots" data-dots hidden>
        <span></span><span></span><span></span><span></span>
      </p>
    </div>
  </div>

  <p class="timer__message" data-message></p>

  <form class="timer__log" data-log hidden>
    <p class="timer__log-title"><span data-t="timer.beforeYouMoveOn">Before you move on</span> <span data-t="timer.optional" class="muted">(optional)</span></p>
    <label class="timer__log-field">
      <span data-t="timer.whatDidYouGetDone">What did you get done?</span>
      <input class="input" type="text" maxlength="200" autocomplete="off" data-log-did />
    </label>
    <label class="timer__log-field">
      <span data-t="timer.whatSNext">What's next?</span>
      <input class="input" type="text" maxlength="200" autocomplete="off" data-log-next />
    </label>
    <p class="timer__log-hint muted" data-log-hint></p>
    <div class="timer__log-actions">
      <button data-t="timer.save" type="submit" class="btn btn--small">Save</button>
      <button data-t="timer.skip" type="button" class="btn btn--ghost btn--small" data-log-skip>Skip</button>
    </div>
  </form>

  <div class="timer__controls">
    <button data-t="timer.start" type="button" class="btn timer__main" data-action="toggle">Start</button>
    <button data-t="timer.stopTakeABreak" type="button" class="btn btn--ghost" data-action="stop" hidden>Stop &amp; take a break</button>
    <button data-t="timer.skipBreak" type="button" class="btn btn--ghost" data-action="skip" hidden>Skip break</button>
    {
      standalone ? (
        <button data-t-aria-label="timer.reset" data-t-title="timer.reset" type="button" class="btn btn--ghost timer__reset-icon" data-action="reset" aria-label="Reset" title="Reset">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <path d="M4 12a8 8 0 1 0 2.4-5.7M4 4v4h4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      ) : (
        <button data-t="timer.reset" type="button" class="btn btn--ghost" data-action="reset">Reset</button>
      )
    }
  </div>

  {
    /* On /timer: the rhythm and the sound behind one chip, and today's total under it. */
    standalone && (
      <div class="timer__bar">
        <button type="button" class="timer__rhythm-chip timer__rhythm-chip--sheet" data-rhythm-menu data-sheet-open="timer-rhythm" aria-haspopup="dialog">
          <span data-rhythm-label data-t={modeKey(defaultMode ?? 'pomodoro')}>{modeLabel(defaultMode ?? 'pomodoro')}</span>
          <svg class="timer__bell" data-bell viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
            <path d="M6 16V11a6 6 0 0 1 12 0v5l1.5 2h-15zM10 20a2 2 0 0 0 4 0" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
            <path class="timer__bell-off" d="M4 4l16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </button>
        <a href={url('/progress')} class="timer__today" data-today></a>
      </div>
    )
  }

  {
    !standalone && (
      <label class="timer__label">
        <span><span data-t="timer.whatAreYouWorkingOn">What are you working on?</span> <span data-t="timer.optional" class="muted">(optional)</span></span>
        <input data-t-placeholder="timer.eGChapter3Notes" type="text" maxlength="80" autocomplete="off" placeholder="e.g. Chapter 3 notes" data-label />
        <datalist data-task-options></datalist>
      </label>
    )
  }
  {/* The Android app's web view doesn't open the suggestions above, so there your tasks are buttons (timer-ui.ts). */}
  {!standalone && NATIVE_APP && <div data-t-aria-label="timer.yourTasks" class="timer__picks" role="group" aria-label="Your tasks" data-task-picks hidden />}
  {!standalone && <p class="timer__task muted" data-task-link hidden></p>}

  <div class="timer__jot">
    <button data-t="timer.jotAThought" type="button" class="btn btn--ghost btn--small" aria-expanded="false" aria-controls="timer-jot-form" data-jot-open>
      Jot a thought
    </button>
    <form id="timer-jot-form" class="timer__jot-form" data-jot-form hidden>
      <label data-t="timer.aThoughtToDealWith" for="timer-jot" class="visually-hidden">A thought to deal with later</label>
      <input data-t-placeholder="timer.somethingToDealWithLater" id="timer-jot" class="input" type="text" maxlength="120" autocomplete="off" placeholder="Something to deal with later…" data-jot-input />
      <button data-t="timer.save" type="submit" class="btn btn--small">Save</button>
    </form>
    <p class="timer__jot-status muted" data-jot-status hidden></p>
  </div>

  {
    !standalone && (
      <div class="timer__footer">
        <label class="timer__sound">
          <input type="checkbox" data-sound checked />
          <span data-t="timer.sound">Sound</span>
        </label>
        <span class="timer__sound-options" data-sound-options>
          <label data-t="timer.endSound" class="visually-hidden" for="timer-tone">End sound</label>
          <select id="timer-tone" class="input timer__tone" data-tone>
            {TONES.map((tone) => <option value={tone} data-t={`tone.${tone}`}>{toneLabel(tone)}</option>)}
          </select>
          <label data-t="timer.volume" class="visually-hidden" for="timer-volume">Volume</label>
          <input id="timer-volume" class="timer__volume" type="range" min="5" max="100" step="5" value="70" data-volume />
        </span>
        <span class="muted" data-notify-status></span>
        <a href={url('/progress')} class="timer__today" data-today></a>
      </div>
    )
  }

  {
    standalone && (
      <p class="timer__keys muted">
        <span data-t="timer.keys">Keyboard:</span> <kbd data-t="timer.space">Space</kbd> <span data-t="timer.keysStartPause">start / pause</span> ·
        <kbd>R</kbd> <span data-t="timer.keysReset">reset</span> · <kbd>J</kbd> <span data-t="timer.keysJot">jot a thought</span>
      </p>
    )
  }

  {
    /* The rhythm sheet: the four rhythms, what the picked one does and why, and the end sound. */
    standalone && (
      <Sheet id="timer-rhythm" title="Rhythm and sound" titleKey="timer.rhythmAndSound">
        <div class="timer__sheet">
          <fieldset class="timer__modes" data-modes>
            <legend data-t="timer.timerMode" class="visually-hidden">Timer mode</legend>
            {
              TIMER_MODES.map((m) => (
                <label class="seg">
                  <input type="radio" name="timer-mode" value={m} checked={m === (defaultMode ?? 'pomodoro')} />
                  <span data-t={modeKey(m)}>{modeLabel(m)}</span>
                </label>
              ))
            }
          </fieldset>
          <p data-t="timer.resetToChangeMode" class="timer__mode-hint muted" data-mode-hint hidden>Reset to change mode.</p>
          <div class="timer__custom" data-custom hidden>
            <label>
              <span data-t="timer.focusMin">Focus (min)</span>
              <input type="number" inputmode="numeric" min="1" max="240" step="1" value="15" data-custom-work />
            </label>
            <label>
              <span data-t="timer.breakMin">Break (min)</span>
              <input type="number" inputmode="numeric" min="0" max="60" step="1" value="5" data-custom-break />
            </label>
          </div>
          {
            rhythms.map((r) => (
              <div class="timer__about" data-rhythm-about={r.mode} hidden={r.mode !== (defaultMode ?? 'pomodoro')}>
                <p class="muted" data-t={RUN_KEYS[r.mode]}>{RUNS[r.mode]}</p>
                <a href={r.href}>
                  <span data-t="timer.whyItWorksAndWhen">Why it works, and when it does not</span>
                </a>
              </div>
            ))
          }
          <div class="timer__sheet-sound">
            <label class="timer__sound">
              <input type="checkbox" data-sound checked />
              <span data-t="timer.sound">Sound</span>
            </label>
            <span class="timer__sound-options" data-sound-options>
              <label data-t="timer.endSound" class="visually-hidden" for="timer-tone">End sound</label>
              <select id="timer-tone" class="input timer__tone" data-tone>
                {TONES.map((tone) => <option value={tone} data-t={`tone.${tone}`}>{toneLabel(tone)}</option>)}
              </select>
              <label data-t="timer.volume" class="visually-hidden" for="timer-volume">Volume</label>
              <input id="timer-volume" class="timer__volume" type="range" min="5" max="100" step="5" value="70" data-volume />
            </span>
          </div>
          <span class="muted timer__notify" data-notify-status></span>
          <p class="muted timer__note">
            {
              NATIVE_APP ? (
                <span data-t="timer.noteApp">
                  Breaks start automatically when a focus session ends; the next focus session waits for you. Sessions of a minute or more are saved on this phone and grow
                </span>
              ) : (
                <span data-t="timer.noteSite">
                  Breaks start automatically when a focus session ends; the next focus session waits for you. Sessions of a minute or more are saved in this browser and grow
                </span>
              )
            }{' '}
            <a data-t="timer.yourGrove" href={url('/progress')}>your grove</a><span data-t="timer.noteEnd">.</span>
          </p>
        </div>
      </Sheet>
    )
  }

  {
    /* The task sheet: Coach's Top 3 and Today first, then your other tasks and exam chapters, or your own words. */
    standalone && (
      <Sheet id="timer-task" title="Focus on" titleKey="timer.focusOn">
        <div class="timer__sheet">
          <ul class="timer__picklist" role="list" data-t-aria-label="timer.yourTasks" aria-label="Your tasks" data-task-picks data-rich></ul>
          <label class="timer__own">
            <span data-t="timer.orTypeYourOwn">Or type your own</span>
            <input data-t-placeholder="timer.eGChapter3Notes" class="input" type="text" maxlength="80" autocomplete="off" placeholder="e.g. Chapter 3 notes" data-label />
            <datalist data-task-options></datalist>
          </label>
          <p class="timer__task muted" data-task-link hidden></p>
          <div class="timer__sheet-actions">
            <button data-t="timer.noTask" type="button" class="btn btn--ghost btn--small" data-pick-clear hidden>No task</button>
            <a data-t="timer.allTasks" class="btn btn--ghost btn--small" href={url('/tasks')}>All tasks</a>
          </div>
        </div>
      </Sheet>
    )
  }

  {
    /*
      The Android app gives the end of a focus session the whole screen: what you did,
      how far it moved your focus tier, and the note form above (timer-ui.ts moves it in).
    */
    NATIVE_APP && (
      <dialog class="done" data-done aria-labelledby="done-title">
        <button data-t-aria-label="timer.close" type="button" class="done__close" data-done-close aria-label="Close">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
          </svg>
        </button>
        <Sprig mood="cheer" size={132} class="done__coin" />
        <h2 data-t="timer.sessionComplete" id="done-title" class="done__title" data-done-title>Session complete</h2>
        <p class="done__text" data-done-text />
        <div class="done__tier" data-done-tier />
        <section data-t-aria-label="timer.phoneDuringFocus" class="done__phone" data-done-phone data-module="screen" aria-label="Phone during focus" hidden />
        {/* "Did you know?": filled in by Guide.astro when this opens. */}
        <div class="done__tip" data-done-tip hidden />
        <div class="done__form" data-done-slot />
      </dialog>
    )
  }

  <p class="visually-hidden" aria-live="polite" aria-atomic="true" data-live></p>
  <noscript><p data-t="timer.theTimerNeedsJavascriptEnabled" class="timer__message">The timer needs JavaScript enabled.</p></noscript>
</section>

<script>
  import { mountTimers } from '../scripts/timer-ui';
  import { onPage } from '../lib/page';
  import { mountFocusTree } from '../scripts/focus-tree';
  onPage('timer', mountTimers);
  onPage('focus-tree', mountFocusTree);
</script>

<style>
  .timer {
    --phase-color: var(--color-accent);
    display: grid;
    gap: var(--space-4);
    padding: var(--space-6) var(--space-4);
    background: var(--surface-grad);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    justify-items: center;
    text-align: center;
  }

  .timer[data-phase='short-break'],
  .timer[data-phase='long-break'] {
    --phase-color: var(--cat-visual);
  }

  .timer__head {
    display: grid;
    gap: var(--space-3);
    justify-items: center;
    width: 100%;
  }

  .timer__head h2 {
    font-size: var(--text-lg);
  }

  /* Segmented mode control */
  .timer__modes {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px;
    padding: 5px;
    border: 0;
    border-radius: 16px;
    background: var(--well-bg);
    box-shadow: var(--well-shadow);
    min-width: 0;
  }

  .seg {
    position: relative;
  }

  .seg input {
    position: absolute;
    inset: 0;
    opacity: 0;
    margin: 0;
    cursor: pointer;
  }

  .seg input:disabled {
    cursor: not-allowed;
  }

  .seg span {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 var(--space-4);
    border-radius: 11px;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-muted);
    transition: background-color var(--duration-fast) var(--ease-out);
  }

  @media (max-width: 26rem) {
    .timer {
      padding-inline: var(--space-3);
    }

    .seg span {
      padding: 0 0.55rem;
      font-size: var(--text-xs);
    }
  }

  .seg input:checked + span {
    background: var(--accent-grad);
    color: var(--color-on-accent);
    font-weight: 600;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.45),
      0 3px 0 var(--accent-edge);
  }

  .seg input:focus-visible + span {
    outline: 3px solid var(--color-focus);
    outline-offset: 1px;
  }

  .seg input:disabled:not(:checked) + span {
    opacity: 0.5;
  }

  .timer__mode-hint {
    font-size: var(--text-xs);
  }

  .timer__custom {
    display: flex;
    gap: var(--space-4);
    justify-content: center;
  }

  .timer__custom[hidden] {
    display: none;
  }

  .timer__custom label {
    display: grid;
    gap: var(--space-1);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .timer__custom input {
    width: 6rem;
    min-height: 44px;
    padding: var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--well-bg);
    box-shadow: var(--well-shadow);
    text-align: center;
  }

  /* Dial */
  .timer__dial {
    position: relative;
    width: min(100%, 280px);
    aspect-ratio: 1;
    padding: 12px;
    border-radius: 50%;
    background: var(--raised-grad);
    box-shadow:
      inset 0 2px 0 var(--raised-hl),
      0 16px 0 -4px var(--edge),
      0 40px 60px -28px rgb(0 0 0 / 0.6);
    margin-bottom: 12px;
  }

  .timer__dial::after {
    content: '';
    position: absolute;
    inset: 13%;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 30%, var(--color-surface-solid), var(--well-bg) 75%);
    box-shadow: inset 0 3px 8px rgb(0 0 0 / 0.35);
    pointer-events: none;
  }

  .timer--standalone .timer__dial {
    width: min(100%, 360px);
  }

  .timer__ring {
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
  }

  .timer__track {
    fill: none;
    stroke: var(--well-bg);
    stroke-width: 12;
  }

  .timer__progress {
    fill: none;
    stroke: var(--phase-color);
    stroke-width: 12;
    stroke-linecap: round;
    transition:
      stroke-dashoffset 300ms linear,
      stroke var(--duration-base) var(--ease-out),
      filter var(--duration-slow) var(--ease-out);
  }

  /* Glow only while time is running; a paused or idle ring goes flat. */
  .timer[data-status='running'] .timer__progress {
    filter: drop-shadow(0 0 calc(7px * var(--glow-strength)) color-mix(in srgb, var(--phase-color) 60%, transparent));
  }

  /* The tree stands behind the top of the dial, so its trunk disappears into it like a pot. */
  .timer__tree {
    /* Fraction of the height, from the bottom, where the trunk meets the dial; the camera frames the tree above it. */
    --tree-base: 0.35;
    position: relative;
    z-index: 0;
    width: min(100%, 360px);
    height: 230px;
    margin-bottom: -96px;
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--duration-slow) var(--ease-out);
  }

  .timer__tree.is-ready {
    opacity: 1;
  }

  .timer__tree canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  .timer__tree + .timer__dial {
    z-index: 1;
  }

  /* Flowtime focus counts up: show a calm dashed ring instead of progress. */
  .timer[data-countup] .timer__progress {
    stroke-dasharray: 4 10 !important;
    stroke-dashoffset: 0 !important;
    opacity: 0.6;
  }

  .timer__readout {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: grid;
    place-content: center;
    gap: var(--space-1);
  }

  .timer__sprig {
    justify-self: center;
  }

  /* With Sprig above them, the phase and time are a size smaller so the time clears the ring. */
  .timer__readout--sprig {
    gap: 2px;
  }

  .timer__readout--sprig .timer__phase {
    font-size: var(--text-xs);
  }

  .timer--standalone .timer__readout--sprig .timer__time {
    font-size: clamp(2.25rem, 11vw, 3.5rem);
  }

  .timer__phase {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--phase-color);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .timer__time {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 12vw, 3.5rem);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .timer--standalone .timer__time {
    font-size: clamp(3rem, 14vw, 4.5rem);
  }

  .timer__dots {
    display: flex;
    justify-content: center;
    gap: 6px;
  }

  .timer__dots[hidden] {
    display: none;
  }

  .timer__dots span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 1.5px solid var(--color-border-strong);
  }

  .timer__dots span.is-done {
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  /* Completion: a soft glow + gentle pop. Disabled by prefers-reduced-motion (global.css). */
  .timer__dial.is-complete .timer__ring {
    animation: dial-complete 900ms var(--ease-out);
  }

  @keyframes dial-complete {
    0% { filter: drop-shadow(0 0 0 transparent); scale: 1; }
    35% { filter: drop-shadow(0 0 12px var(--phase-color)); scale: 1.04; }
    100% { filter: drop-shadow(0 0 0 transparent); scale: 1; }
  }

  .timer__message {
    min-height: 1.6em;
    max-width: 32rem;
    color: var(--color-text-muted);
  }

  .timer__controls {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
  }

  .timer__main {
    min-width: 9rem;
    min-height: 52px;
    font-size: var(--text-base);
  }

  .timer__controls {
    align-items: center;
  }

  .timer__controls [hidden] {
    display: none;
  }

  .timer__label {
    display: grid;
    gap: var(--space-1);
    width: min(100%, 26rem);
    text-align: left;
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .timer__label input {
    min-height: 44px;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--well-bg);
    box-shadow: var(--well-shadow);
    font-weight: 400;
  }

  .timer__task {
    width: min(100%, 26rem);
    margin-top: calc(-1 * var(--space-2));
    text-align: left;
    font-size: var(--text-xs);
  }

  .timer__task[hidden],
  .timer__log[hidden] {
    display: none;
  }

  .timer__log {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface-2);
    text-align: start;
    animation: log-in var(--duration-slow) var(--ease-out);
  }

  .timer__log-title {
    font-weight: 700;
  }

  .timer__log-field {
    display: grid;
    gap: var(--space-1);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .timer__log-field .input {
    font-weight: 400;
  }

  .timer__log-hint {
    font-size: var(--text-xs);
  }

  .timer__log-actions {
    display: flex;
    gap: var(--space-2);
  }

  @keyframes log-in {
    from {
      opacity: 0;
      transform: translateY(0.5rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .timer__log {
      animation: none;
    }
  }

  .timer__footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    font-size: var(--text-sm);
  }

  .timer__sound {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    cursor: pointer;
  }

  .timer__sound input {
    width: 1.5rem;
    height: 1.5rem;
    accent-color: var(--color-accent);
  }

  .timer__sound-options {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .timer__sound-options[hidden] {
    display: none;
  }

  .timer__tone {
    inline-size: auto;
    min-height: 44px;
    padding-block: 0;
    font-size: var(--text-sm);
  }

  /* A taller box than the track, so a thumb is easy to land on. */
  .timer__volume {
    inline-size: 6.5rem;
    block-size: 44px;
    accent-color: var(--color-accent);
  }

  .timer__today:empty {
    display: none;
  }

  .timer__jot {
    display: grid;
    justify-items: center;
    gap: var(--space-2);
  }

  .timer__jot-form {
    display: flex;
    gap: var(--space-2);
    inline-size: min(100%, 26rem);
  }

  .timer__jot-form[hidden],
  .timer__jot-status[hidden] {
    display: none;
  }

  .timer__jot-form .input {
    flex: 1;
    min-width: 0;
  }

  .timer__jot-status {
    font-size: var(--text-sm);
  }

  .timer__keys {
    font-size: var(--text-xs);
  }

  /*
    The Android app: the timer is the screen, not a card on it. The dial leads and the
    main button sits right under it, so Start is on screen without scrolling; the rhythm
    and what you're working on follow. Only the look and the order change; the markup
    and script don't.
  */
  :global(html[data-app]) .timer {
    gap: var(--space-4);
    padding: 0;
    background: none;
    border: 0;
    box-shadow: none;
  }

  /* The rhythm sits under the main button, as a chip. */
  :global(html[data-app]) .timer__head {
    order: 6;
    display: grid;
    justify-items: center;
    inline-size: 100%;
  }

  :global(html:not([data-app])) .timer__rhythm-chip {
    display: none;
  }

  .timer__rhythm-chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding-inline: var(--space-4) var(--space-3);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: 600;
    list-style: none;
    cursor: pointer;
  }

  .timer__rhythm-chip::-webkit-details-marker {
    display: none;
  }

  .timer__rhythm[open] .timer__rhythm-chip svg {
    transform: rotate(180deg);
  }

  :global(html[data-app]) .timer__rhythm {
    display: grid;
    justify-items: center;
    gap: var(--space-3);
    inline-size: 100%;
  }

  :global(html[data-app]) .timer__custom {
    order: 2;
  }

  /* Small enough that the main button is on screen without scrolling. */
  :global(html[data-app]) .timer .timer__dial {
    order: 3;
    width: min(100%, 256px);
  }

  :global(html[data-app]) .timer .timer__tree {
    order: 3;
    /* Reaches up into the empty space under the tabs, so it adds only ~80px above the dial. */
    --tree-base: 0.42;
    width: min(100%, 300px);
    height: 180px;
    margin-top: -36px;
    margin-bottom: -80px;
  }

  /* With the tree above it, the dial gives back some height so Start and Pause stay above the bottom bar. */
  :global(html[data-app]) .timer .timer__tree + .timer__dial {
    width: min(100%, 232px);
  }

  /* Short phone screens keep the plain dial, so Start stays above the fold. */
  @media (max-height: 740px) {
    :global(html[data-app]) .timer .timer__tree {
      display: none;
    }
  }

  :global(html[data-app]) .timer .timer__time {
    font-size: 3.25rem;
  }

  /* Sprig takes the top of the dial, so the time steps down to stay inside the ring. */
  :global(html[data-app]) .timer .timer__readout--sprig .timer__time {
    font-size: 2.5rem;
  }

  :global(html[data-app]) .timer__message {
    order: 4;
  }

  :global(html[data-app]) .timer__message:empty {
    display: none;
  }

  :global(html[data-app]) .timer__log {
    order: 7;
    inline-size: 100%;
  }

  :global(html[data-app]) .timer__label {
    order: 8;
  }

  :global(html[data-app]) .timer__task {
    order: 9;
  }

  :global(html[data-app]) .timer__controls {
    order: 5;
  }

  :global(html[data-app]) .timer__jot {
    order: 10;
  }

  :global(html[data-app]) .timer__footer {
    order: 11;
  }

  /* Four equal segments; the chosen one is raised, so green stays the colour of the main button. */
  :global(html[data-app]) .timer__modes {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    inline-size: 100%;
  }

  :global(html[data-app]) .seg span {
    justify-content: center;
    inline-size: 100%;
    min-height: 44px;
    padding: 0;
    font-size: var(--text-xs);
  }

  :global(html[data-app]) .seg input:checked + span {
    background: var(--raised-grad);
    color: var(--color-text);
    font-weight: 700;
    box-shadow:
      inset 0 1px 0 var(--raised-hl),
      0 2px 0 var(--edge);
  }

  /* "What are you working on?" as one raised row. */
  :global(html[data-app]) .timer__label {
    inline-size: 100%;
    padding: var(--space-2) var(--space-4) var(--space-1);
    border: 1px solid var(--color-border);
    border-radius: 18px;
    background: var(--surface-grad);
    box-shadow:
      inset 0 1px 0 var(--hl),
      0 3px 0 var(--edge);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: 500;
  }

  :global(html[data-app]) .timer__label input {
    padding-inline: 0;
    border: 0;
    background: none;
    box-shadow: none;
    color: var(--color-text);
    font-size: var(--text-base);
    font-weight: 600;
  }

  :global(html[data-app]) .timer__label input:focus-visible {
    outline: none;
  }

  :global(html[data-app]) .timer__label:focus-within {
    border-color: var(--color-accent);
  }

  :global(html[data-app]) .timer__task {
    inline-size: 100%;
    padding-inline: var(--space-4);
  }

  /* Your tasks, one tap each: a row that scrolls sideways under the field. */
  .timer__picks {
    order: 8;
    display: flex;
    gap: var(--space-2);
    inline-size: 100%;
    margin-top: calc(-1 * var(--space-2));
    padding-bottom: 4px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .timer__picks[hidden] {
    display: none;
  }

  .timer__picks :global(.timer__pick) {
    flex: none;
    max-inline-size: 15rem;
    min-height: 44px;
    padding: 0 var(--space-4);
    border: 1px solid var(--color-border-strong);
    border-radius: 12px;
    background: none;
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    cursor: pointer;
  }

  .timer__picks :global(.timer__pick[aria-pressed='true']) {
    border-color: var(--accent-edge);
    background: var(--color-accent-soft);
    font-weight: 700;
  }

  /* The main button on its own row; the quieter ones share the row under it. */
  :global(html[data-app]) .timer__controls {
    inline-size: 100%;
    gap: var(--space-3);
  }

  :global(html[data-app]) .timer__main {
    flex: 1 0 100%;
    min-height: 60px;
    border-radius: 18px;
    font-size: var(--text-lg);
    font-weight: 700;
  }

  :global(html[data-app]) .timer__controls .btn--ghost {
    flex: 1 1 0;
    min-height: 52px;
    padding-inline: var(--space-3);
    border-radius: 16px;
  }

  :global(html[data-app]) .timer__jot,
  :global(html[data-app]) .timer__jot-form {
    inline-size: 100%;
  }

  :global(html[data-app]) .timer__jot [data-jot-open] {
    --btn-depth: 0px;
    inline-size: 100%;
    min-height: 48px;
    border: 1px dashed var(--color-border-strong);
    background: none;
    box-shadow: none;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: 500;
  }

  :global(html[data-app]) .timer__footer {
    inline-size: 100%;
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
  }

  /* ---------- The app's full-screen "Session complete" ---------- */
  .done {
    position: fixed;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    max-inline-size: none;
    max-block-size: none;
    margin: 0;
    padding: calc(var(--space-7) + env(safe-area-inset-top, 0px)) var(--space-5) calc(var(--space-5) + env(safe-area-inset-bottom, 0px));
    border: 0;
    background: var(--color-bg);
    color: var(--color-text);
    text-align: center;
    overflow-y: auto;
  }

  .done[open] {
    display: grid;
    justify-items: center;
    align-content: start;
    gap: var(--space-3);
  }

  .done::backdrop {
    background: var(--color-bg);
  }

  .done__close {
    position: absolute;
    inset-block-start: calc(var(--space-3) + env(safe-area-inset-top, 0px));
    inset-inline-end: var(--space-3);
    display: grid;
    place-items: center;
    inline-size: 48px;
    block-size: 48px;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }

  .done :global(.done__coin) {
    margin-bottom: var(--space-2);
    filter: drop-shadow(0 14px 18px var(--accent-glow));
  }

  .done[open] :global(.done__coin) {
    animation: done-pop 600ms cubic-bezier(0.3, 1.6, 0.5, 1) both;
  }

  .done__title {
    font-size: var(--text-2xl);
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  .done__text {
    max-inline-size: 22rem;
    color: var(--color-text-muted);
  }

  /* How far this session moved the focus tier: its coin, the ladder, what is left. */
  .done__tier {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    inline-size: min(100%, 26rem);
    margin-top: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: 20px;
    background: var(--surface-grad);
    box-shadow:
      inset 0 1px 0 var(--hl),
      0 3px 0 var(--edge);
    text-align: start;
  }

  .done__tier:empty {
    display: none;
  }

  .done__tier :global(.tier-coin) {
    --coin-size: 44px;
    margin: 0;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.5),
      0 3px 0 var(--coin-edge);
  }

  .done__tier :global(.done__tier-body) {
    display: grid;
    flex: 1;
    gap: 6px;
    min-width: 0;
    font-size: var(--text-sm);
  }

  .done__tier :global(.done__tier-head) {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    font-weight: 600;
  }

  .done__tier :global(.done__tier-gain) {
    color: var(--tier-3);
    font-weight: 700;
    white-space: nowrap;
  }

  .done__tier :global(.done__pips) {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 5px;
  }

  .done__tier :global(.done__pips > span) {
    block-size: 9px;
    border-radius: 5px;
    background: var(--well-bg);
    overflow: hidden;
  }

  .done__tier :global(.done__pips > .is-on) {
    background: var(--pip);
    box-shadow: 0 2px 0 var(--pip-edge);
  }

  .done__tier :global(.done__pips > span > span) {
    display: block;
    block-size: 100%;
    background: var(--pip);
  }

  .done__tier :global(.done__tier-foot) {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .done__form {
    inline-size: min(100%, 26rem);
    margin-top: var(--space-2);
  }

  /* Screen time: what the phone did during this session (timer-ui.ts renderPhone). */
  .done__phone {
    display: grid;
    gap: var(--space-2);
    inline-size: min(100%, 26rem);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: 20px;
    background: var(--surface-grad);
    box-shadow:
      inset 0 1px 0 var(--hl),
      0 3px 0 var(--edge);
    text-align: start;
    font-size: var(--text-sm);
  }

  .done__phone[hidden] {
    display: none;
  }

  .done__phone--clean {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .done__phone :global(.done__leaf) {
    display: grid;
    place-items: center;
    flex: none;
    inline-size: 44px;
    block-size: 44px;
    border-radius: 14px;
    background: var(--cat-reward-bg);
    color: var(--tier-3);
  }

  .done__phone :global(.done__phone-text) {
    display: grid;
    gap: 2px;
  }

  .done__phone :global(.done__phone-leaf) {
    color: var(--cat-reward);
    font-weight: 600;
  }

  .done__phone :global(.done__phone-head),
  .done__phone :global(.done__phone-ends),
  .done__phone :global(.done__phone-apps li) {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .done__phone :global(.done__phone-line) {
    position: relative;
    block-size: 12px;
    border-radius: var(--radius-pill);
    background: var(--heat-1);
    overflow: hidden;
  }

  .done__phone :global(.done__phone-line > span) {
    position: absolute;
    inset-block: 0;
    background: var(--cat-visual);
  }

  .done__phone :global(.done__phone-ends) {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .done__phone :global(.done__phone-apps) {
    display: grid;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .done__form .timer__log {
    padding: 0;
    border: 0;
    background: none;
    animation: none;
  }

  .done__form .timer__log-actions {
    margin-top: var(--space-2);
  }

  .done__form .timer__log-actions .btn {
    flex: 1;
    min-height: 52px;
    border-radius: 16px;
    font-size: var(--text-base);
  }

  @keyframes done-pop {
    from {
      transform: scale(0.6);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .done[open] :global(.done__coin) {
      animation: none;
    }
  }

  /* No keyboard on a phone. */
  :global(html[data-app]) .timer__keys {
    display: none;
  }

  kbd {
    padding: 0 0.35em;
    border: 1px solid var(--color-border-strong);
    border-bottom-width: 2px;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.9em;
  }

  /* ---- /timer (option B, 26 Nov 2026): the task on top, rhythm and sound in a sheet, quiet while focusing ---- */

  .timer__taskrow {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    inline-size: 100%;
    min-height: 56px;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--raised-grad);
    box-shadow:
      inset 0 1px 0 var(--raised-hl),
      0 2px 0 var(--edge);
    color: var(--color-text);
    font: inherit;
    text-align: start;
    cursor: pointer;
  }

  .timer__taskrow:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }

  .timer__taskrow svg {
    flex: none;
    color: var(--color-text-muted);
  }

  .timer__taskrow-text {
    display: grid;
    flex: 1;
    min-width: 0;
    gap: 2px;
  }

  .timer__taskrow-name {
    overflow: hidden;
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .timer__taskrow-name.is-empty {
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .timer__taskrow-meta {
    font-size: var(--text-xs);
  }

  .timer__taskrow-meta:empty {
    display: none;
  }

  .timer__bar {
    display: grid;
    justify-items: center;
    gap: var(--space-1);
    font-size: var(--text-sm);
    transition:
      opacity var(--duration-slow, 0.4s) var(--ease-out),
      visibility 0s linear;
  }

  .timer__rhythm-chip--sheet {
    background: none;
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 600;
  }

  /* The site hides the <details> chip (its choices are always open), but not this one. */
  :global(html:not([data-app])) .timer__rhythm-chip--sheet {
    display: inline-flex;
  }

  .timer__rhythm-chip--sheet:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }

  .timer__bell {
    color: var(--color-text-muted);
  }

  .timer__bell-off {
