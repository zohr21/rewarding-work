    font-size: var(--text-sm);
  }

  .bp__actions {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: var(--space-2);
  }

  .bp__tiles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-2);
  }

  .bp__tile {
    display: grid;
    gap: 2px;
    align-content: center;
    min-height: 64px;
    padding: var(--space-2) var(--space-3);
    border: 0;
    border-radius: var(--radius-md);
    background: var(--raised-grad);
    box-shadow:
      inset 0 1px 0 var(--raised-hl),
      0 2px 0 var(--edge);
    font: inherit;
    color: inherit;
    text-align: start;
    cursor: pointer;
  }

  .bp__tile span {
    font-size: var(--text-xs);
  }

  .bp__tile strong {
    font-size: var(--text-sm);
    overflow-wrap: anywhere;
  }

  /* ---- Sheets ---- */
  .bp-form {
    display: grid;
    gap: var(--space-3);
  }

  .bp-amount {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0 var(--space-3);
    border-radius: var(--radius-md);
    background: var(--color-surface-2);
    box-shadow: inset 0 0 0 1px var(--edge);
  }

  .bp-amount__sign {
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--color-text-muted);
  }

  .bp-amount input {
    flex: 1;
    min-width: 0;
    min-height: 60px;
    border: 0;
    background: none;
    font: inherit;
    font-size: 1.8rem;
    font-weight: 750;
    color: inherit;
    outline: none;
  }

  .bp-amount:focus-within {
    box-shadow: inset 0 0 0 2px var(--color-focus);
