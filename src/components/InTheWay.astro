---
/**
 * Home's one way into the techniques: name what is in the way and get the techniques
 * for it. The site lists the five problems as chips; the Android app keeps them in a
 * sheet behind a single row, so Today stays one screen.
 */
import { NATIVE_APP } from '../config/app';
import { PROBLEMS, PROBLEM_SLUGS } from '../data/taxonomy';
import { url } from '../lib/paths';

const quizUrl = url('/techniques#quiz');
const CHEVRON = 'M9 6l6 6-6 6';
---

{
  NATIVE_APP ? (
    <>
      <button type="button" class="way-row" data-way-open aria-haspopup="dialog">
        <span class="way-row__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="20" height="20">
            <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2" />
            <path d="M9.5 9.5a2.5 2.5 0 1 1 3.6 2.2c-.7.4-1.1 1-1.1 1.8M12 17h.01" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
        </span>
        <span class="way-row__text">
          <strong>Something in the way?</strong>
          <span class="muted">Get a technique to try now</span>
        </span>
        <svg class="way-chevron" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path d={CHEVRON} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>

      <dialog class="way-sheet" data-way-sheet aria-labelledby="way-heading">
        <span class="way-sheet__handle" aria-hidden="true" />
        <h2 id="way-heading">What's in the way?</h2>
        <p class="muted way-sheet__intro">Pick the one that fits best. Each leads to techniques you can try in minutes.</p>
        <ul class="way-sheet__list" role="list">
          {PROBLEM_SLUGS.map((slug) => (
            <li>
              <a href={url(`/problems/${slug}`)}>
                <span>{PROBLEMS[slug].title}</span>
                <svg class="way-chevron" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                  <path d={CHEVRON} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            </li>
          ))}
        </ul>
        <a class="btn btn--ghost way-sheet__quiz" href={quizUrl}>Not sure? Four quick questions</a>
      </dialog>
    </>
  ) : (
    <section class="card way" aria-labelledby="way-heading">
      <div class="way__head">
        <div>
          <h2 id="way-heading">Something in the way?</h2>
          <p class="muted">Pick what fits and get techniques to try in the next few minutes.</p>
        </div>
        <a class="way__quiz" href={quizUrl}>Not sure? Four quick questions</a>
      </div>
      <ul class="way__chips" role="list">
        {PROBLEM_SLUGS.map((slug) => (
          <li>
            <a href={url(`/problems/${slug}`)}>{PROBLEMS[slug].title}</a>
          </li>
        ))}
      </ul>
    </section>
  )
}

<script>
  import { onPage } from '../lib/page';

  onPage('in-the-way', () => {
    const sheet = document.querySelector<HTMLDialogElement>('[data-way-sheet]');
    const open = document.querySelector<HTMLButtonElement>('[data-way-open]');
    if (!sheet || !open) return;
    open.addEventListener('click', () => sheet.showModal());
    // A tap on the dimmed page behind the sheet lands on the dialog itself.
    sheet.addEventListener('click', (e) => {
      if (e.target === sheet) sheet.close();
    });
  });
</script>

<style>
  .way {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-5);
  }

  .way__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
  }

  .way h2 {
    font-size: var(--text-lg);
  }

  .way__head p,
  .way__quiz {
    font-size: var(--text-sm);
  }

  .way__quiz {
    font-weight: 600;
  }

  .way__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    padding: 0;
    list-style: none;
  }

  .way__chips li {
    max-width: none;
  }

  .way__chips a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--raised-grad);
    box-shadow:
      inset 0 1px 0 var(--raised-hl),
      0 3px 0 var(--edge);
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    transition:
      border-color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }

  .way__chips a:hover {
    border-color: color-mix(in srgb, var(--color-accent) 45%, transparent);
  }

  .way__chips a:active {
    transform: translateY(3px);
    box-shadow: inset 0 1px 0 var(--raised-hl);
  }

  /* The app's row, shaped like the cards above it on Today. */
  .way-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    inline-size: 100%;
    min-height: 64px;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--surface-grad);
    box-shadow: var(--shadow-card);
    color: var(--color-text);
    font: inherit;
    text-align: start;
    cursor: pointer;
  }

  .way-row__icon {
    flex: none;
    display: grid;
    place-items: center;
    inline-size: 38px;
    block-size: 38px;
    border-radius: 11px;
    background: var(--color-accent-soft);
    color: var(--color-accent);
  }

  .way-row__text {
    flex: 1;
    display: grid;
    min-width: 0;
    font-size: var(--text-sm);
  }

  .way-row__text .muted {
    font-size: var(--text-xs);
  }

  .way-chevron {
    flex: none;
    color: var(--color-text-muted);
  }

  .way-sheet {
    position: fixed;
    inset: auto 0 0;
    inline-size: 100%;
    max-inline-size: none;
    max-block-size: 88dvh;
    margin: 0;
    padding: var(--space-3) var(--space-5) calc(var(--space-5) + env(safe-area-inset-bottom, 0px));
    border: 0;
    border-top: 1px solid var(--color-border-strong);
    border-radius: 28px 28px 0 0;
    background: var(--popover-bg);
    color: var(--color-text);
    box-shadow: var(--popover-shadow);
    overflow-y: auto;
  }

  .way-sheet[open] {
    animation: way-in 260ms var(--ease-out);
  }

  .way-sheet::backdrop {
    background: rgb(0 0 0 / 0.6);
  }

  .way-sheet__handle {
    display: block;
    inline-size: 36px;
    block-size: 4px;
    margin: 0 auto var(--space-4);
    border-radius: 2px;
    background: var(--color-border-strong);
  }

  .way-sheet h2 {
    font-size: var(--text-xl);
  }

  .way-sheet__intro {
    margin-top: var(--space-1);
    font-size: var(--text-sm);
  }

  .way-sheet__list {
    margin-block: var(--space-4);
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--color-border);
  }

  .way-sheet__list a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 56px;
    border-top: 1px solid var(--color-border);
    color: var(--color-text);
    font-weight: 600;
    text-decoration: none;
  }

  .way-sheet__quiz {
    inline-size: 100%;
    min-height: 52px;
  }

  @keyframes way-in {
    from {
      transform: translateY(40%);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .way-sheet[open] {
      animation: none;
    }
  }
</style>
