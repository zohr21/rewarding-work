rules_version = '2';

// Security rules for Grovyn accounts. Paste into
// Firebase console → Firestore Database → Rules, then Publish.
//
// Each signed-in person (including guests) can read and write only their own
// documents: users/{uid}/stores/{store}. The weekly board (src/lib/board.ts) adds
// boards/{week}/entries/{uid}, codes/{code}, reports, follows and links. Everything else is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/stores/{store} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;

      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && store in ['sessions', 'done', 'chain', 'chain-detail', 'tasks', 'exam', 'health', 'breakdown', 'timer-prefs', 'theme', 'appearance', 'board', 'coach']
        && request.resource.data.keys().hasOnly(['data', 'updatedAt'])
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 800000
        && request.resource.data.updatedAt is number;
    }

    // One row per person per week ({week} is its Monday, YYYY-MM-DD). Rows that show to
    // everyone can be read by anyone, so the board can be seen before joining; a
    // "Friends only" row by its owner and the friends it lists. Minutes are capped at
    // 4 hours a day, as the app counts them.
    //
    // `reports` counts the different people who reported the nickname: only someone else
    // can add one (once, with a report of their own in the same write), and the owner can
    // only put it back to 0 by changing the nickname. 3 or more, or `hidden`, and the app
    // shows "hidden name".
    match /boards/{week}/entries/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid)
        || resource.data.visibility == 'all'
        || (request.auth != null && request.auth.uid in resource.data.friends);

      allow delete: if request.auth != null && request.auth.uid == uid;

      allow create: if isOwner() && validRow()
        && request.resource.data.get('reports', 0) == 0;

      allow update: if isOwner() && validRow()
        && (request.resource.data.get('reports', 0) == resource.data.get('reports', 0)
          || (request.resource.data.name != resource.data.name && request.resource.data.get('reports', 0) == 0));

      // Someone reporting this row.
      allow update: if request.auth != null
        && request.auth.uid != uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reports'])
        && request.resource.data.reports == resource.data.get('reports', 0) + 1
        && !exists(/databases/$(database)/documents/reports/$(request.auth.uid + '_' + uid + '_' + week))
        && existsAfter(/databases/$(database)/documents/reports/$(request.auth.uid + '_' + uid + '_' + week));

      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      function validRow() {
        return week.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['name', 'minutes', 'tier', 'guest', 'visibility', 'friends', 'updatedAt', 'reports', 'hidden'])
        && request.resource.data.get('reports', 0) is int
        && request.resource.data.get('hidden', false) is bool
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 20
        && request.resource.data.minutes is int
        && request.resource.data.minutes >= 0
        && request.resource.data.minutes <= 1680
        && request.resource.data.tier is int
        && request.resource.data.tier >= 0
        && request.resource.data.tier <= 5
        && request.resource.data.guest is bool
        && request.resource.data.visibility in ['all', 'friends']
        && request.resource.data.friends is list
        && request.resource.data.friends.size() <= 30
        && request.resource.data.updatedAt is number;
      }
    }

    // Reports of a nickname, for the owner to review in the Firebase console. Anyone signed
    // in (guests too) can send one per row per week; nobody can read, change or delete them
    // from the app. The id is reporter_target_week, so a second report is refused.
    match /reports/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['reporter', 'target', 'week', 'name', 'reason', 'at'])
        && request.resource.data.reporter == request.auth.uid
        && request.resource.data.target is string
        && request.resource.data.target != request.auth.uid
        && request.resource.data.week is string
        && request.resource.data.week.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && id == request.auth.uid + '_' + request.resource.data.target + '_' + request.resource.data.week
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 20
        && request.resource.data.reason in ['hate', 'sexual', 'bullying', 'impersonation', 'personal', 'spam', 'other']
        && request.resource.data.at == request.time;
    }

    // Following someone: one way, no asking. The id is follower_target. Both people can read
    // it (the target sees "X followed you") and either can delete it (unfollow, or remove a
    // follower). Only the follower writes it, under the nickname they have on the board.
    match /follows/{id} {
      allow read, delete: if request.auth != null
        && (resource.data.follower == request.auth.uid || resource.data.target == request.auth.uid);

      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['follower', 'target', 'name', 'at'])
        && request.resource.data.follower == request.auth.uid
        && request.resource.data.target is string
        && request.resource.data.target != request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.target
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 20
        && request.resource.data.at == request.time;
    }

    // Friends go both ways. The id is from_to. `from` asks ('ask') or ends the friendship
    // ('end'); `to` can only turn an 'ask' into 'yes'. Each side then keeps the other in its
    // own friends list. Both can read and delete it.
    match /links/{id} {
      allow read, delete: if request.auth != null
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);

      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['from', 'to', 'name', 'state', 'at'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.to
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 20
        && request.resource.data.state in ['ask', 'end']
        && request.resource.data.at == request.time;

      allow update: if request.auth != null
        && resource.data.to == request.auth.uid
        && resource.data.state == 'ask'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state'])
        && request.resource.data.state == 'yes';
    }

    // Friend codes: anyone signed in can look one up; you can only claim a free code for
    // yourself, and only release your own.
    match /codes/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && code.matches('^[A-Z2-9]{3}-[A-Z2-9]{4}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
  }
}
