rules_version = '2';

// Security rules for Rewarding Work accounts. Paste into
// Firebase console → Firestore Database → Rules, then Publish.
//
// Each signed-in person (including guests) can read and write only their own
// documents: users/{uid}/stores/{store}. Everything else is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/stores/{store} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;

      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && store in ['sessions', 'done', 'chain', 'breakdown', 'timer-prefs', 'theme', 'appearance']
        && request.resource.data.keys().hasOnly(['data', 'updatedAt'])
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 800000
        && request.resource.data.updatedAt is number;
    }
  }
}
