---
/**
 * Task breakdown: split a big task into small steps and tick them off.
 * Edits the *current* task (tasks in src/lib/storage.ts); /tasks lists them all.
 * Ticked steps are also logged in the Done list (unticking removes them again).
 */
import { url } from '../lib/paths';

interface Props {
  heading?: string;
  intro?: string;
  /** Off on the tasks page itself. */
  linkToTasks?: boolean;
}
const {
  heading = 'Try it: break it down',
  linkToTasks = true,
  intro = 'Make each step small enough that you could start it in two minutes.',
} = Astro.props;
---

<section class="card breakdown" data-breakdown aria-labelledby="bd-heading">
  <h2 id="bd-heading" class="panel-title">{heading}</h2>
  <p class="muted bd__intro">{intro}</p>

  <label class="bd__label" for="bd-task">The big task</label>
  <input id="bd-task" class="input" type="text" maxlength="120" autocomplete="off" placeholder="e.g. Write the project report" data-bd-task />

  <form class="bd__add" data-bd-form>
    <label class="bd__label" for="bd-step">Add a step</label>
    <div class="bd__row">
      <input id="bd-step" class="input" type="text" maxlength="120" autocomplete="off" placeholder="e.g. Open the doc and write the headings" data-bd-step />
      <button type="submit" class="btn">Add</button>
    </div>
  </form>

  <p class="bd__progress" data-bd-progress hidden></p>
  <ol class="bd__steps" data-bd-steps></ol>

  <div class="bd__finish" data-bd-finish hidden>
    <button type="button" class="btn" data-bd-done>Mark the whole task done</button>
  </div>
  <div class="bd__finish" data-bd-finished hidden>
    <p class="bd__finished-text">Finished — it's in your Done list.</p>
    <button type="button" class="btn btn--ghost btn--small" data-bd-reopen>Reopen</button>
  </div>

  <div class="bd__footer" data-bd-footer hidden>
    <button type="button" class="btn btn--ghost btn--small" data-bd-clear>Start a new task</button>
    <span class="muted bd__note">Ticked steps also appear in your Done list. {linkToTasks && <a href={url('/tasks')}>All your tasks</a>}</span>
  </div>
  <p class="visually-hidden" aria-live="polite" data-bd-live></p>
</section>

<script>
  import { createTask, getCurrentTask, setCurrentTask, subscribe, updateTask } from '../lib/storage';
  import { addStep, ensureCurrentTask, finishTask, removeStep, reopenTask, setStepDone } from '../lib/tasks';
  import { celebrate } from '../lib/appearance';
  import { cleanups, onPage } from '../lib/page';

  const X_SVG =
    '<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>';

  onPage('breakdown', () => {
    const c = cleanups();
    document.querySelectorAll<HTMLElement>('[data-breakdown]').forEach((root) => {
      const $ = <E extends Element>(s: string) => root.querySelector<E>(s)!;
      const title = $<HTMLInputElement>('[data-bd-task]');
      const form = $<HTMLFormElement>('[data-bd-form]');
      const stepInput = $<HTMLInputElement>('[data-bd-step]');
      const progress = $<HTMLElement>('[data-bd-progress]');
      const list = $<HTMLOListElement>('[data-bd-steps]');
      const finish = $<HTMLElement>('[data-bd-finish]');
      const finished = $<HTMLElement>('[data-bd-finished]');
      const reopen = $<HTMLButtonElement>('[data-bd-reopen]');
      const footer = $<HTMLElement>('[data-bd-footer]');
      const live = $<HTMLElement>('[data-bd-live]');

      const announce = (t: string) => {
        live.textContent = '';
        window.setTimeout(() => (live.textContent = t), 50);
      };

      function render(): void {
        const task = getCurrentTask();
        const steps = task?.steps ?? [];
        if (document.activeElement !== title) title.value = task?.title ?? '';
        const done = steps.filter((s) => s.done).length;
        const isDone = task?.status === 'done';
        progress.hidden = steps.length === 0;
        progress.textContent = `${done} of ${steps.length} step${steps.length === 1 ? '' : 's'} done${done === steps.length && done > 0 ? ' — the whole thing. Well done.' : ''}`;
        // Offer to finish the task once every step is ticked.
        finish.hidden = !task || isDone || steps.length === 0 || done < steps.length;
        finished.hidden = !isDone;
        footer.hidden = !task;

        list.replaceChildren(
          ...steps.map((step) => {
            const li = document.createElement('li');
            li.className = `bd__step${step.done ? ' is-done' : ''}`;
            const id = `bd-${step.id}`;

            const cb = document.createElement('input');
            cb.type = 'checkbox';
            cb.id = id;
            cb.checked = step.done;
            cb.addEventListener('change', () => {
              if (!task) return;
              setStepDone(task.id, step.id, cb.checked);
              if (cb.checked) celebrate();
              announce(`${step.text}: ${cb.checked ? 'done' : 'not done'}`);
              root.querySelector<HTMLInputElement>(`#${CSS.escape(id)}`)?.focus();
            });

            const label = document.createElement('label');
            label.htmlFor = id;
            label.textContent = step.text;

            const del = document.createElement('button');
            del.type = 'button';
            del.className = 'icon-btn';
            del.setAttribute('aria-label', `Remove step “${step.text}”`);
            del.innerHTML = X_SVG;
            del.addEventListener('click', () => {
              if (task) removeStep(task.id, step.id);
              announce(`Removed step: ${step.text}`);
              stepInput.focus();
            });

            li.append(cb, label, del);
            return li;
          }),
        );
      }

      title.addEventListener('input', () => {
        const task = getCurrentTask();
        if (task) updateTask(task.id, () => ({ title: title.value }));
        else if (title.value.trim()) createTask(title.value);
      });

      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const text = stepInput.value.trim();
        if (!text) return;
        addStep(ensureCurrentTask().id, text);
        stepInput.value = '';
        stepInput.focus();
        announce(`Step added: ${text}`);
      });

      $<HTMLButtonElement>('[data-bd-done]').addEventListener('click', () => {
        const task = getCurrentTask();
        if (!task) return;
        finishTask(task.id);
        celebrate();
        announce('Task finished and logged in your Done list.');
        reopen.focus();
      });

      reopen.addEventListener('click', () => {
        const task = getCurrentTask();
        if (!task) return;
        reopenTask(task.id);
        announce('Task reopened.');
        stepInput.focus();
      });

      $<HTMLButtonElement>('[data-bd-clear]').addEventListener('click', () => {
        setCurrentTask(null);
        title.focus();
        announce('Ready for a new task. The last one is kept with your other tasks.');
      });

      render();
      c.add(subscribe('tasks', render));
    });
    return c.run;
  });
</script>

<style>
  .bd__intro {
    font-size: var(--text-sm);
    margin-bottom: var(--space-4);
  }

  .bd__label {
    display: block;
    margin-bottom: var(--space-1);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .bd__add {
    margin-top: var(--space-4);
  }

  .bd__row {
    display: flex;
    gap: var(--space-2);
  }

  .bd__row .input {
    flex: 1;
    min-width: 0;
  }

  .bd__progress {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-accent);
  }

  .bd__steps {
    margin-top: var(--space-2);
    padding-left: 0;
    list-style: none;
  }

  .breakdown :global(.bd__step) {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    border-bottom: 1px solid var(--color-border);
    max-width: none;
  }

  .breakdown :global(.bd__step input) {
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
    accent-color: var(--color-accent);
    cursor: pointer;
  }

  .breakdown :global(.bd__step label) {
    flex: 1;
    min-width: 0;
    padding-block: var(--space-3);
    overflow-wrap: anywhere;
    cursor: pointer;
    transition: color var(--duration-base) var(--ease-out);
  }

  .breakdown :global(.bd__step.is-done label) {
    color: var(--color-text-muted);
    text-decoration: line-through;
    text-decoration-thickness: 1.5px;
  }

  .bd__finish,
  .bd__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    margin-top: var(--space-4);
  }

  .bd__finish[hidden],
  .bd__footer[hidden] {
    display: none;
  }

  .bd__finished-text {
    font-weight: 600;
    color: var(--color-accent);
  }

  .bd__note {
    font-size: var(--text-xs);
  }
</style>
