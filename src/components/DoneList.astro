---
/**
 * "Done" list: log finished tasks. One tap to add from today's timer labels,
 * or type and press Enter. Each new item gets a small check-off animation.
 * Groups fold away (older ones start closed) and the list scrolls inside a fixed-height
 * box. Long groups show their newest few with "Show more"; removing offers Undo.
 */
---

<section class="card done" data-done-list aria-labelledby="done-heading">
  <h2 id="done-heading" class="panel-title">Done</h2>
  <p class="muted done__intro">Finished something? Log it — seeing what you've done is its own reward.</p>

  <form class="done__form" data-done-form>
    <label for="done-input" class="visually-hidden">Something you finished</label>
    <input id="done-input" class="input" type="text" maxlength="200" autocomplete="off" placeholder="I finished…" data-done-input />
    <button type="submit" class="btn">Add</button>
  </form>

  <div class="done__quick" data-done-quick hidden>
    <p class="done__quick-label muted">From today's timer:</p>
    <div class="done__chips" data-done-chips></div>
  </div>

  <div class="done__bar" data-done-bar hidden>
    <p class="muted" data-done-total></p>
    <button type="button" class="btn btn--ghost btn--small" data-done-all></button>
  </div>
  <!-- Fixed height: a long list scrolls in here instead of stretching the page. -->
  <div class="done__well" data-done-groups hidden></div>
  <p class="muted done__empty" data-done-empty>Nothing logged yet. Small things count.</p>
  <p class="visually-hidden" aria-live="polite" data-done-live></p>
</section>

<script>
  import { addDone, getDone, getSessions, removeDone, subscribe, type DoneItem } from '../lib/storage';
  import { startOfDay, startOfWeek } from '../lib/dates';
  import { celebrate } from '../lib/appearance';
  import { offerUndo } from '../lib/undo';
  import { cleanups, onPage } from '../lib/page';

  /** Items a group shows before "Show more", and how many more each click reveals. */
  const PREVIEW = 10;
  const PAGE = 20;

  const CHEVRON_SVG =
    '<svg class="done__chevron" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>';

  const CHECK_SVG =
    '<svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><circle cx="12" cy="12" r="11"></circle><path d="M7 12.5l3.2 3.2L17 9"></path></svg>';
  const X_SVG =
    '<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>';

  const timeFmt = new Intl.DateTimeFormat(undefined, { hour: 'numeric', minute: '2-digit' });
  const dayFmt = new Intl.DateTimeFormat(undefined, { weekday: 'short', day: 'numeric', month: 'short' });

  onPage('done-list', () => {
    const c = cleanups();
    document.querySelectorAll<HTMLElement>('[data-done-list]').forEach((root) => {
      const form = root.querySelector<HTMLFormElement>('[data-done-form]')!;
      const input = root.querySelector<HTMLInputElement>('[data-done-input]')!;
      const quick = root.querySelector<HTMLElement>('[data-done-quick]')!;
      const chips = root.querySelector<HTMLElement>('[data-done-chips]')!;
      const groups = root.querySelector<HTMLElement>('[data-done-groups]')!;
      const empty = root.querySelector<HTMLElement>('[data-done-empty]')!;
      const live = root.querySelector<HTMLElement>('[data-done-live]')!;
      let justAdded: string | null = null;
      /** Removed, but still undoable (src/lib/undo.ts): hidden until the removal is final. */
      const removing = new Set<string>();
      /** How many items each group shows, by group title; groups not listed show PREVIEW. */
      const shown = new Map<string, number>();
      const bar = root.querySelector<HTMLElement>('[data-done-bar]')!;
      const totalEl = root.querySelector<HTMLElement>('[data-done-total]')!;
      const allBtn = root.querySelector<HTMLButtonElement>('[data-done-all]')!;
      /** Groups opened or closed by hand, by group title; otherwise only the newest group is open. */
      const open = new Map<string, boolean>();
      /** Titles of the groups on show and whether any is open, for "Collapse all". */
      let titles: string[] = [];
      let anyOpen = false;

      function announce(text: string): void {
        live.textContent = '';
        window.setTimeout(() => (live.textContent = text), 50);
      }

      function add(text: string, taskId?: string): void {
        const item = addDone(text, { taskId });
        if (!item) return;
        justAdded = item.id;
        celebrate();
        announce(`Logged: ${item.text}`);
        // Render happens via the storage subscription.
      }

      function renderItem(item: DoneItem, showDay: boolean): HTMLLIElement {
        const li = document.createElement('li');
        li.className = `done__item${item.id === justAdded ? ' is-new' : ''}`;

        const check = document.createElement('span');
        check.className = 'done__check';
        check.innerHTML = CHECK_SVG;

        const body = document.createElement('span');
        body.className = 'done__text';
        body.textContent = item.text;

        const when = document.createElement('time');
        when.className = 'done__time muted';
        when.dateTime = new Date(item.doneAt).toISOString();
        when.textContent = showDay ? dayFmt.format(item.doneAt) : timeFmt.format(item.doneAt);

        const del = document.createElement('button');
        del.type = 'button';
        del.className = 'icon-btn done__remove';
        del.setAttribute('aria-label', `Remove “${item.text}”`);
        del.innerHTML = X_SVG;
        del.addEventListener('click', () => {
          // Move focus to a neighbour first, so keyboard users don't lose their place.
          const next = li.nextElementSibling ?? li.previousElementSibling;
          (next?.querySelector<HTMLElement>('.done__remove') ?? input).focus();
          removing.add(item.id);
          render();
          offerUndo({
            message: `Removed “${item.text}”`,
            commit: () => {
              removeDone(item.id);
              removing.delete(item.id);
            },
            undo: () => {
              removing.delete(item.id);
              justAdded = item.id;
              render();
              announce(`Restored: ${item.text}`);
            },
          });
          announce(`Removed: ${item.text}. Press Undo to bring it back.`);
        });

        li.append(check, body, when, del);
        return li;
      }

      function render(): void {
        const items = getDone().filter((i) => !removing.has(i.id));
        const today = startOfDay(new Date()).getTime();
        const week = startOfWeek(new Date()).getTime();
        const buckets: [string, DoneItem[], boolean][] = [
          ['Today', items.filter((i) => i.doneAt >= today), false],
          ['Earlier this week', items.filter((i) => i.doneAt < today && i.doneAt >= week), true],
          ['Before that', items.filter((i) => i.doneAt < week), true],
        ];

        titles = buckets.filter(([, list]) => list.length).map(([title]) => title);
        const isOpen = (title: string) => open.get(title) ?? title === titles[0];
        anyOpen = titles.some(isOpen);
        bar.hidden = groups.hidden = items.length === 0;
        totalEl.textContent = `${items.length} logged`;
        allBtn.textContent = anyOpen ? 'Collapse all' : 'Expand all';

        const frag = document.createDocumentFragment();
        for (const [title, list, showDay] of buckets) {
          if (!list.length) continue;
          const expanded = isOpen(title);
          const h = document.createElement('h3');
          h.className = 'done__group';
          const toggle = document.createElement('button');
          toggle.type = 'button';
          toggle.className = 'done__toggle';
          toggle.dataset.toggle = title;
          toggle.setAttribute('aria-expanded', String(expanded));
          toggle.innerHTML = CHEVRON_SVG;
          const name = document.createElement('span');
          name.className = 'done__group-name';
          name.textContent = title;
          const n = document.createElement('span');
          n.className = 'done__count';
          n.textContent = String(list.length);
          toggle.append(name, n);
          toggle.addEventListener('click', () => {
            open.set(title, !expanded);
            render();
            groups.querySelector<HTMLElement>(`[data-toggle="${title}"]`)?.focus();
          });
          h.append(toggle);
          frag.append(h);
          if (!expanded) continue;
          const ul = document.createElement('ul');
          ul.className = 'done__items';
          ul.dataset.group = title;
          const limit = shown.get(title) ?? PREVIEW;
          ul.append(...list.slice(0, limit).map((i) => renderItem(i, showDay)));
          frag.append(ul);

          const more = list.length - limit;
          if (more > 0 || limit > PREVIEW) {
            const b = document.createElement('button');
            b.type = 'button';
            b.className = 'btn btn--ghost btn--small done__more';
            if (more > 0) {
              const n = Math.min(more, PAGE);
              b.textContent = `Show ${n === more ? `all ${list.length}` : `${n} more`}`;
              b.addEventListener('click', () => {
                shown.set(title, limit + n);
                render();
                // Focus the first newly shown item, so keyboard users carry on from there.
                groups
                  .querySelector(`[data-group="${title}"]`)
                  ?.children[limit]?.querySelector<HTMLElement>('.done__remove')
                  ?.focus();
              });
            } else {
              b.textContent = 'Show fewer';
              b.addEventListener('click', () => {
                shown.delete(title);
                render();
                const ul = groups.querySelector<HTMLElement>(`[data-group="${title}"]`);
                ul?.scrollIntoView({ block: 'nearest' });
                ul?.nextElementSibling instanceof HTMLButtonElement && ul.nextElementSibling.focus();
              });
            }
            frag.append(b);
          }
        }
        groups.replaceChildren(frag);
        empty.hidden = items.length > 0;
        justAdded = null;

        // Quick-add chips: today's timer labels not already logged today (with the task they were for).
        const loggedToday = new Set(buckets[0]![1].map((i) => i.text.toLowerCase()));
        const taskOf = new Map<string, string | undefined>();
        getSessions()
          .filter((s) => s.start >= today && s.label)
          .forEach((s) => taskOf.set(s.label, s.taskId ?? taskOf.get(s.label)));
        const labels = [...taskOf.keys()].filter((l) => !loggedToday.has(l.toLowerCase()));
        quick.hidden = labels.length === 0;
        chips.replaceChildren(
          ...labels.slice(-6).map((label) => {
            const b = document.createElement('button');
            b.type = 'button';
            b.className = 'done__chip';
            b.textContent = `+ ${label}`;
            b.setAttribute('aria-label', `Log “${label}” as done`);
            b.addEventListener('click', () => add(label, taskOf.get(label)));
            return b;
          }),
        );
      }

      allBtn.addEventListener('click', () => {
        const next = !anyOpen;
        titles.forEach((t) => open.set(t, next));
        render();
      });

      form.addEventListener('submit', (e) => {
        e.preventDefault();
        add(input.value);
        input.value = '';
        input.focus();
      });

      render();
      c.add(subscribe('done', render));
      c.add(subscribe('sessions', render));
    });
    return c.run;
  });
</script>

<style>
  .done__intro {
    font-size: var(--text-sm);
    margin-bottom: var(--space-4);
  }

  .done__form {
    display: flex;
    gap: var(--space-2);
  }

  .done__form .input {
    flex: 1;
    min-width: 0;
  }

  .done__quick {
    margin-top: var(--space-3);
  }

  .done__quick[hidden] {
    display: none;
  }

  .done__quick-label {
    font-size: var(--text-xs);
    margin-bottom: var(--space-2);
  }

  .done__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .done :global(.done__chip) {
    min-height: 36px;
    padding: 0 var(--space-3);
    border: 1px dashed var(--color-accent);
    border-radius: var(--radius-pill);
    background: var(--color-accent-soft);
    color: var(--color-text);
    font-size: var(--text-sm);
    cursor: pointer;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .done :global(.done__chip:hover) {
    border-style: solid;
  }

  .done__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-4);
    font-size: var(--text-sm);
  }

  .done__bar[hidden],
  .done__well[hidden] {
    display: none;
  }

  .done__well {
    max-height: min(30rem, 70vh);
    margin-top: var(--space-2);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--color-border-strong) transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  /* Group headers stay in view while their items scroll under them. */
  .done :global(.done__group) {
    position: sticky;
    top: 0;
    z-index: 1;
    max-width: none;
    font-size: var(--text-sm);
    background: var(--color-surface-solid);
    border-bottom: 1px solid var(--color-border);
  }

  .done :global(.done__group:last-child) {
    border-bottom: 0;
  }

  .done :global(.done__toggle) {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    width: 100%;
    min-height: 44px;
    padding: 0 var(--space-3);
    border: 0;
    background: transparent;
    color: var(--color-text);
    font-weight: 600;
    text-align: left;
    cursor: pointer;
  }

  .done :global(.done__toggle:hover) {
    background: var(--color-surface-2);
  }

  .done :global(.done__chevron) {
    flex-shrink: 0;
    color: var(--color-text-muted);
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .done :global(.done__toggle[aria-expanded='true'] .done__chevron) {
    transform: rotate(90deg);
  }

  .done :global(.done__group-name) {
    flex: 1;
  }

  .done :global(.done__count) {
    min-width: 1.75rem;
    padding: 0 var(--space-2);
    border-radius: var(--radius-pill);
    background: var(--color-accent-soft);
    color: var(--color-accent);
    font-size: var(--text-xs);
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  .done :global(.done__items) {
    list-style: none;
    padding: 0 var(--space-1) 0 var(--space-3);
  }

  .done :global(.done__item:last-child) {
    border-bottom: 0;
  }

  .done :global(.done__item) {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-left: var(--space-1);
    border-bottom: 1px solid var(--color-border);
    max-width: none;
  }

  .done :global(.done__text) {
    flex: 1;
    min-width: 0;
    overflow-wrap: anywhere;
    padding-block: var(--space-2);
  }

  .done :global(.done__time) {
    font-size: var(--text-xs);
    white-space: nowrap;
  }

  /* Check mark */
  .done :global(.done__check svg) {
    display: block;
    flex-shrink: 0;
  }

  .done :global(.done__check circle) {
    fill: var(--color-accent);
  }

  .done :global(.done__check path) {
    fill: none;
    stroke: var(--color-on-accent);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* New item: circle pops, tick draws itself, row softly highlights. */
  .done :global(.is-new) {
    animation: done-row 1.2s var(--ease-out);
  }

  .done :global(.is-new .done__check svg) {
    animation: done-pop 450ms var(--ease-out);
  }

  .done :global(.is-new .done__check path) {
    stroke-dasharray: 16;
    stroke-dashoffset: 16;
    animation: done-draw 350ms 150ms var(--ease-out) forwards;
  }

  @keyframes done-pop {
    0% { transform: scale(0.4); opacity: 0; }
    60% { transform: scale(1.15); opacity: 1; }
    100% { transform: scale(1); }
  }

  @keyframes done-draw {
    to { stroke-dashoffset: 0; }
  }

  @keyframes done-row {
    0% { background: var(--color-accent-soft); }
    100% { background: transparent; }
  }

  .done :global(.done__more) {
    margin: var(--space-2) var(--space-3) var(--space-3);
  }

  .done__empty {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
  }

  .done__empty[hidden] {
    display: none;
  }
</style>
