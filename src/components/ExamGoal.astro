---
/**
 * The exam goal: a short form to set it (name, date, target hours, chapters), then a
 * summary of where you stand: the days left, a button that resumes the chapter you were
 * last on and one that starts a practice round, then one line of numbers (time studied,
 * chapters, this week, last round) and, with a target, the pace that gets you there.
 */
import { url } from '../lib/paths';

const timerUrl = url('/timer');
---

<div class="exam-goal" data-exam-goal data-timer-url={timerUrl}>
  <form class="card goal-form" data-eg-form hidden aria-labelledby="eg-form-title">
    <h2 data-t="exam.setYourGoal" id="eg-form-title" class="panel-title" data-eg-form-title>Set your goal</h2>
    <div class="goal-form__grid">
      <label class="goal-form__field goal-form__field--wide">
        <span data-t="exam.examOrCertification">Exam or certification</span>
        <input data-t-placeholder="exam.eGAwsSolutionsArchitect" class="input" type="text" maxlength="120" autocomplete="off" required placeholder="e.g. AWS Solutions Architect – Associate" data-eg-title />
      </label>
      <label class="goal-form__field">
        <span><span data-t="exam.examDate">Exam date</span> <span data-t="exam.optional" class="muted">(optional)</span></span>
        <input class="input" type="date" data-eg-date />
      </label>
      <label class="goal-form__field">
        <span><span data-t="exam.studyHours">Study hours you're aiming for</span> <span data-t="exam.optional" class="muted">(optional)</span></span>
        <input data-t-placeholder="exam.aRoughGuessIsFine" class="input" type="number" min="1" max="10000" step="1" inputmode="numeric" placeholder="A rough guess is fine" data-eg-hours />
      </label>
      <label class="goal-form__field goal-form__field--wide" data-eg-chapters-field>
        <span><span data-t="exam.chaptersOrParts">Chapters or parts</span> <span data-t="exam.onePerLineYouCan" class="muted">(one per line; you can add more later)</span></span>
        <textarea data-t-placeholder="exam.chaptersPlaceholder" class="input" rows="6" placeholder="Networking, 14&#10;Storage, 10&#10;Databases" data-eg-chapters></textarea>
        <span data-t="exam.plannedHoursCanFollowA" class="muted goal-form__hint">Planned hours can follow a comma, as in “Networking, 14”.</span>
      </label>
    </div>
    <p class="goal-form__plan" data-eg-plan aria-live="polite"></p>
    <div class="goal-form__actions">
      <button data-t="exam.createExamPlan" type="submit" class="btn" data-eg-submit>Create exam plan</button>
      <button data-t="exam.cancel" type="button" class="btn btn--ghost" data-eg-cancel hidden>Cancel</button>
      <button data-t="exam.iTookTheExam" type="button" class="btn btn--ghost" data-eg-took hidden>I took the exam</button>
      <button data-t="exam.deleteThisExamPlan" type="button" class="btn btn--ghost goal-form__delete" data-eg-delete hidden>Delete this exam plan</button>
    </div>
  </form>

  <section class="card goal-finish" data-eg-finish hidden aria-labelledby="eg-finish-title">
    <h2 data-t="exam.howDidItGo" id="eg-finish-title" class="panel-title" tabindex="-1" data-eg-finish-title>How did it go?</h2>
    <p class="muted" data-eg-finish-text></p>
    <div class="goal-finish__choices">
      <button data-t="exam.iPassed" type="button" class="btn" data-eg-result="passed">I passed</button>
      <button data-t="exam.iDidnTPass" type="button" class="btn btn--ghost" data-eg-result="failed">I didn't pass</button>
      <button data-t="exam.justMarkItFinished" type="button" class="btn btn--ghost" data-eg-result="finished">Just mark it finished</button>
    </div>
    <button data-t="exam.notYet" type="button" class="btn btn--ghost btn--small" data-eg-finish-cancel>Not yet</button>
  </section>

  <section class="card goal" data-eg-hero hidden aria-labelledby="eg-name">
    <div class="goal__top">
      <div class="goal__main">
        <p data-t="exam.yourExam" class="goal__eyebrow">Your exam</p>
        <h2 id="eg-name" class="goal__title" data-eg-name></h2>
        <p class="goal__chips" data-eg-chips></p>
      </div>
      <p class="goal__countdown" data-eg-days hidden></p>
    </div>
    <div class="goal__actions">
      <a class="btn goal__continue" data-eg-continue hidden></a>
      <button data-t="exam.iTookTheExam" type="button" class="btn goal__continue" data-eg-took-now hidden>I took the exam</button>
      <button type="button" class="btn btn--ghost goal__continue" data-eg-practice hidden></button>
    </div>
    <div class="goal__target" data-eg-target hidden>
      <p class="goal__time-head muted"><span data-eg-time></span><span data-eg-pct></span></p>
      <div class="goal__bar" aria-hidden="true"><span data-eg-bar></span></div>
      <p class="goal__pace muted" data-eg-pace></p>
    </div>
    <p class="goal__facts muted" data-eg-facts></p>
    <button data-t="exam.editGoal" type="button" class="btn btn--ghost btn--small goal__edit" data-eg-edit>Edit goal</button>
  </section>
  <p class="visually-hidden" aria-live="polite" data-eg-live></p>
</div>

<script>
  import { getExam, getSessions, subscribe, type ExamResult } from '../lib/storage';
  import {
    cleanHours,
    createExam,
    daysLeft,
    deleteExam,
    examTime,
    finishExam,
    formatHM,
    nextChapter,
    pacePerDay,
    parseChapterLines,
    ROUND_SIZE,
    saveGoal,
    weekMinutes,
  } from '../lib/exam';
  import { celebrate } from '../lib/appearance';
  import { fromDayKey } from '../lib/dates';
  import { el } from '../lib/dom';
  import { cleanups, onPage } from '../lib/page';
  import { dateFormat, t, tn } from '../lib/i18n';

  const dateFmt = dateFormat({ day: 'numeric', month: 'short', year: 'numeric' });

  onPage('exam-goal', () => {
    const root = document.querySelector<HTMLElement>('[data-exam-goal]');
    if (!root) return;
    const c = cleanups();
    const $ = <E extends Element>(s: string) => root.querySelector<E>(s)!;
    const form = $<HTMLFormElement>('[data-eg-form]');
    const formTitle = $<HTMLElement>('[data-eg-form-title]');
    const title = $<HTMLInputElement>('[data-eg-title]');
    const date = $<HTMLInputElement>('[data-eg-date]');
    const hours = $<HTMLInputElement>('[data-eg-hours]');
    const chaptersField = $<HTMLElement>('[data-eg-chapters-field]');
    const chapters = $<HTMLTextAreaElement>('[data-eg-chapters]');
    const plan = $<HTMLElement>('[data-eg-plan]');
    const submit = $<HTMLButtonElement>('[data-eg-submit]');
    const cancel = $<HTMLButtonElement>('[data-eg-cancel]');
    const del = $<HTMLButtonElement>('[data-eg-delete]');
    const took = $<HTMLButtonElement>('[data-eg-took]');
    const tookNow = $<HTMLButtonElement>('[data-eg-took-now]');
    const finish = $<HTMLElement>('[data-eg-finish]');
    const hero = $<HTMLElement>('[data-eg-hero]');
    const live = $<HTMLElement>('[data-eg-live]');
    const timerUrl = root.dataset.timerUrl!;
    let editing = false;
    /** Asking how the exam went. */
    let finishing = false;
    let deleteArmed = false;

    const announce = (text: string) => {
      live.textContent = '';
      window.setTimeout(() => (live.textContent = text), 50);
    };

    const draft = () => ({
      title: title.value,
      date: date.value || undefined,
      targetHours: hours.value ? cleanHours(Number(hours.value)) : undefined,
    });

    /** What the numbers in the form add up to, before saving. */
    function renderPlan(): void {
      const d = draft();
      const parts: string[] = [];
      const days = daysLeft(d);
      if (days !== null) parts.push(days > 0 ? tn('exam.daysUntil', days) : days === 0 ? t('exam.theExamIsToday') : t('exam.datePassed'));
      if (days !== null && days > 0 && d.targetHours) parts.push(t('exam.aDayToReach', { time: formatHM((d.targetHours * 3600) / days), target: t('unit.h', { n: d.targetHours }) }));
      if (!editing) {
        const list = parseChapterLines(chapters.value);
        const planned = list.reduce((sum, ch) => sum + (ch.plannedHours ?? 0), 0);
        if (list.length) parts.push(planned ? tn('exam.chaptersPlanned', list.length, { planned: t('unit.h', { n: planned }) }) : tn('exam.chaptersN', list.length));
      }
      plan.textContent = parts.join(' · ');
    }

    function chip(text: string, cls = ''): HTMLSpanElement {
      return el('span', `badge goal__chip ${cls}`, text);
    }

    function render(): void {
      const exam = getExam();
      if (!exam) editing = finishing = false;
      const showForm = (!exam || editing) && !finishing;
      form.hidden = !showForm;
      finish.hidden = !finishing;
      hero.hidden = showForm || finishing;
      formTitle.textContent = exam ? t('exam.editYourGoal') : t('exam.setYourGoal');
      submit.textContent = exam ? t('exam.save') : t('exam.createExamPlan');
      chaptersField.hidden = Boolean(exam);
      cancel.hidden = del.hidden = took.hidden = !exam;
      if (!exam) {
        renderPlan();
        return;
      }
      if (finishing) {
        $<HTMLElement>('[data-eg-finish-text]').textContent =
          t('exam.finishText', { title: exam.title });
        return;
      }
      if (showForm) return;

      const sessions = getSessions();
      const time = examTime(exam, sessions);
      $<HTMLElement>('[data-eg-name]').textContent = exam.title;

      const chips = $<HTMLElement>('[data-eg-chips]');
      chips.replaceChildren();
      const days = daysLeft(exam);
      if (exam.date) chips.append(chip(t('exam.examOn', { date: dateFmt.format(fromDayKey(exam.date)) })));
      if (exam.targetHours) chips.append(chip(t('exam.targetChip', { target: t('unit.h', { n: exam.targetHours }) })));
      // The days left are the headline: what the rest of the page is planned against.
      const countdown = $<HTMLElement>('[data-eg-days]');
      countdown.hidden = days === null;
      if (days !== null) {
        countdown.replaceChildren();
        if (days > 0) countdown.append(el('strong', '', String(days)), el('span', '', tn('exam.daysLeft', days)));
        else countdown.append(el('span', '', days === 0 ? t('exam.examIsToday') : t('exam.examDatePassed')));
      }

      // From exam day on, the main button asks how it went; Continue stays available as a plain one.
      const examDay = days !== null && days <= 0;
      tookNow.hidden = !examDay;
      const next = nextChapter(exam, time);
      const go = $<HTMLAnchorElement>('[data-eg-continue]');
      go.hidden = !next;
      go.classList.toggle('btn--ghost', examDay);
      if (next) {
        go.href = `${timerUrl}?chapter=${encodeURIComponent(next.id)}`;
        go.textContent = t(time.byChapter.has(next.id) ? 'exam.continueOn' : 'exam.startOn', { name: next.name });
      }
      // Practice sits beside Continue; it starts the question bank's round (ExamBank.astro).
      const practice = $<HTMLButtonElement>('[data-eg-practice]');
      const n = Math.min(ROUND_SIZE, exam.questions.length);
      practice.hidden = n === 0;
      practice.textContent = tn('exam.practiceN', n);
      // With nothing left to study, practice is the main thing to do.
      practice.classList.toggle('btn--ghost', Boolean(next) || examDay);

      const target = exam.targetHours ? exam.targetHours * 3600 : 0;
      const pct = target ? Math.min(100, Math.round((time.total / target) * 100)) : 0;
      $<HTMLElement>('[data-eg-target]').hidden = !target;
      if (target) {
        $<HTMLElement>('[data-eg-time]').textContent = t('exam.timeOfTarget', { time: formatHM(time.total), target: t('unit.h', { n: exam.targetHours! }) });
        $<HTMLElement>('[data-eg-pct]').textContent = `${pct}%`;
        $<HTMLElement>('[data-eg-bar]').style.inlineSize = `${pct}%`;
        const pace = pacePerDay(exam, time.total);
        $<HTMLElement>('[data-eg-pace]').textContent =
          pace === null ? '' : pace === 0 ? t('exam.reachedTarget', { target: t('unit.h', { n: exam.targetHours! }) }) : t('exam.paceLine', { time: formatHM(pace) });
      }

      // The rest in one line: studied (when there is no target bar), chapters, this week, last round.
      const done = exam.chapters.filter((ch) => ch.done).length;
      const week = weekMinutes(exam, sessions);
      const round = exam.rounds.at(-1);
      const facts = [
        target ? '' : time.total >= 60 ? t('exam.studied', { time: formatHM(time.total) }) : t('exam.timeAddsUp'),
        exam.chapters.length ? tn('exam.chaptersDone', exam.chapters.length, { done }) : '',
        week.total >= 60 ? t('exam.thisWeek', { time: formatHM(week.total) }) : '',
        round ? t('exam.lastRound', { correct: round.correct, total: round.total }) : '',
      ];
      // Times like "4 h 40 m" stay on one line.
      $<HTMLElement>('[data-eg-facts]').textContent = facts
        .filter(Boolean)
        .map((f) => f.replace(/(\d) (?=\S)/g, '$1\u00a0'))
        .join(' · ');
    }

    function disarmDelete(): void {
      deleteArmed = false;
      del.textContent = t('exam.deleteThisExamPlan');
    }

    $<HTMLButtonElement>('[data-eg-edit]').addEventListener('click', () => {
      const exam = getExam();
      if (!exam) return;
      editing = true;
      title.value = exam.title;
      date.value = exam.date ?? '';
      hours.value = exam.targetHours ? String(exam.targetHours) : '';
      render();
      renderPlan();
      title.focus();
    });

    cancel.addEventListener('click', () => {
      editing = false;
      disarmDelete();
      render();
    });

    function askResult(): void {
      editing = false;
      finishing = true;
      disarmDelete();
      render();
      $<HTMLElement>('[data-eg-finish-title]').focus();
    }
    took.addEventListener('click', askResult);
    $<HTMLButtonElement>('[data-eg-practice]').addEventListener('click', () => {
      document.querySelector<HTMLButtonElement>('[data-eb-start]')?.click();
    });
    tookNow.addEventListener('click', askResult);

    $<HTMLButtonElement>('[data-eg-finish-cancel]').addEventListener('click', () => {
      finishing = false;
      render();
      $<HTMLButtonElement>('[data-eg-edit]').focus();
    });

    root.querySelectorAll<HTMLButtonElement>('[data-eg-result]').forEach((b) =>
      b.addEventListener('click', () => {
        const exam = getExam();
        if (!exam) return;
        const result = b.dataset.egResult as ExamResult;
        finishing = false;
        form.reset();
        finishExam(result, examTime(exam, getSessions()).total);
        if (result === 'passed') celebrate();
        announce(
          result === 'passed'
            ? t('exam.saidPassed', { title: exam.title })
            : result === 'failed'
              ? t('exam.saidFailed', { title: exam.title })
              : t('exam.saidFinished', { title: exam.title }),
        );
        title.focus();
      }),
    );

    // Press twice to delete: the first press says what will happen.
    del.addEventListener('click', () => {
      if (!deleteArmed) {
        deleteArmed = true;
        del.textContent = t('exam.pressAgainToDelete');
        announce(t('exam.pressAgainToDeleteSaid'));
        window.setTimeout(disarmDelete, 6000);
        return;
      }
      disarmDelete();
      editing = false;
      deleteExam();
      form.reset();
      announce(t('exam.deleted'));
      title.focus();
    });

    form.addEventListener('input', renderPlan);
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!title.value.trim()) return;
      const wasEditing = Boolean(getExam());
      if (wasEditing) saveGoal(draft());
      else createExam(draft(), parseChapterLines(chapters.value));
      editing = false;
      form.reset();
      render();
      announce(wasEditing ? t('exam.goalSaved') : t('exam.created'));
    });

    render();
    c.add(subscribe('exam', render));
    c.add(subscribe('sessions', render));
    return c.run;
  });
</script>

<style>
  .exam-goal {
    display: grid;
    gap: var(--space-5);
  }

  /* Also beats .btn's own display, for the buttons that come and go. */
  .exam-goal [hidden] {
    display: none;
  }

  .goal-finish {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }

  .goal-finish .panel-title {
    margin-bottom: 0;
    font-size: var(--text-xl);
  }

  .goal-finish__choices {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .goal-form__grid {
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 40rem) {
    .goal-form__grid {
      grid-template-columns: 1fr 1fr;
    }

    .goal-form__field--wide {
      grid-column: 1 / -1;
    }
  }

  .goal-form__field {
    display: grid;
    gap: var(--space-1);
    align-content: start;
    font-weight: 600;
  }

  .goal-form__field .input {
    font-weight: 400;
  }

  .goal-form__field textarea {
    resize: vertical;
  }

  .goal-form__hint {
    font-size: var(--text-xs);
    font-weight: 400;
  }

  .goal-form__plan {
    min-height: 1.6em;
    margin-top: var(--space-4);
    color: var(--cat-reward);
    font-weight: 600;
  }

  .goal-form__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }

  .goal-form__delete {
    margin-inline-start: auto;
    color: var(--cat-rest);
  }

  .goal {
    display: grid;
    gap: var(--space-4);
  }

  .goal__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .goal__main {
    min-width: 0;
    display: grid;
    gap: var(--space-2);
    align-content: start;
  }

  .goal__eyebrow {
    color: var(--cat-reward);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .goal__title {
    font-size: var(--text-xl);
    line-height: 1.15;
    overflow-wrap: anywhere;
  }

  /* The countdown: a big number in the reward colour, "days left" under it. */
  .goal__countdown {
    flex: none;
    display: grid;
    justify-items: center;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    background: var(--cat-reward-bg);
    color: var(--cat-reward);
    font-size: var(--text-xs);
    font-weight: 600;
    text-align: center;
  }

  .goal :global(.goal__countdown strong) {
    font-family: var(--font-display);
    font-size: 2.25rem;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .goal__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .goal__chips:empty {
    display: none;
  }

  .goal :global(.goal__chip) {
    padding-block: var(--space-1);
    background: var(--well-bg);
    box-shadow: var(--well-shadow);
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .goal__actions {
    display: grid;
    gap: var(--space-2);
  }

  @media (min-width: 40rem) {
    .goal__actions {
      grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    }
  }

  .goal__continue {
    min-height: 52px;
    font-size: var(--text-base);
    overflow-wrap: anywhere;
  }

  .goal__target {
    display: grid;
    gap: var(--space-2);
  }

  .goal__time-head {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
  }

  .goal__bar {
    height: 10px;
    border-radius: var(--radius-pill);
    background: var(--heat-0);
  }

  .goal__bar > span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--accent-grad);
  }

  .goal__pace,
  .goal__facts {
    font-size: var(--text-sm);
  }

  .goal__pace:empty,
  .goal__facts:empty {
    display: none;
  }

  .goal__edit {
    justify-self: start;
    min-height: 44px;
  }
</style>
