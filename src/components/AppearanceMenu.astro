---
/**
 * Appearance menu: theme, ambient background (soft glows or live scenes), motion.
 * A <details> disclosure — no modal, closes on Escape / outside click.
 */
import { SCENES } from '../lib/storage';
import { SCENE_INFO } from '../lib/scene';

const THEMES = [
  { value: 'light', label: 'Light' },
  { value: 'dark', label: 'Dark' },
  { value: 'auto', label: 'Auto' },
];
const BACKGROUNDS = [
  { value: 'sunrise', label: 'Sunrise', swatch: 'linear-gradient(135deg, #ffc9b0, #ffe49a 45%, #ffc2d9)' },
  { value: 'meadow', label: 'Meadow', swatch: 'linear-gradient(135deg, #bdecc9, #e4f5a3 45%, #b5e2ff)' },
  { value: 'lavender', label: 'Lavender', swatch: 'linear-gradient(135deg, #dccfff, #c4dcff 45%, #ffd3ea)' },
  { value: 'plain', label: 'Plain', swatch: 'var(--color-bg)' },
];
const SCENE_OPTIONS = SCENES.map((id) => ({ value: id, label: SCENE_INFO[id].label, preview: SCENE_INFO[id].preview }));
---

<details class="appearance" data-appearance>
  <summary class="appearance__button" aria-label="Appearance: theme and background">
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
      <path
        d="M12 3a9 9 0 1 0 0 18c1.1 0 1.8-.8 1.8-1.7 0-.5-.2-.9-.5-1.2-.3-.3-.5-.7-.5-1.2 0-1 .8-1.7 1.8-1.7H17a4 4 0 0 0 4-4c0-4.5-4-8.2-9-8.2z"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linejoin="round"></path>
      <circle cx="7.5" cy="11" r="1.3" fill="currentColor"></circle>
      <circle cx="10" cy="7.3" r="1.3" fill="currentColor"></circle>
      <circle cx="14.5" cy="7.3" r="1.3" fill="currentColor"></circle>
    </svg>
    <span class="appearance__text">Look</span>
  </summary>

  <div class="appearance__panel">
    <fieldset>
      <legend>Theme</legend>
      <div class="appearance__seg">
        {
          THEMES.map((t) => (
            <label>
              <input type="radio" name="rw-theme" value={t.value} />
              <span>{t.label}</span>
            </label>
          ))
        }
      </div>
    </fieldset>

    <fieldset>
      <legend>Background · soft glow</legend>
      <div class="appearance__swatches">
        {
          BACKGROUNDS.map((b) => (
            <label class="swatch">
              <input type="radio" name="rw-bg" value={b.value} />
              <span class="swatch__chip" style={`background:${b.swatch}`} />
              <span class="swatch__label">{b.label}</span>
            </label>
          ))
        }
      </div>
    </fieldset>

    <fieldset>
      <legend>Background · live scene</legend>
      <div class="appearance__scenes">
        {
          SCENE_OPTIONS.map((sc) => (
            <label class="scene">
              <input type="radio" name="rw-bg" value={sc.value} />
              <span class="scene__preview" style={`background:${sc.preview}`} />
              <span class="scene__label">{sc.label}</span>
            </label>
          ))
        }
      </div>
      <p class="appearance__note" data-scene-note>Drawn live in 3D. Scenes slow down and fade back while a focus session runs.</p>
      <p class="appearance__note" data-no-webgl hidden>This browser can't draw scenes, so a soft glow is shown instead.</p>
    </fieldset>

    <label class="appearance__switch">
      <input type="checkbox" name="rw-motion" role="switch" />
      <span>Gentle background motion</span>
    </label>
    <p class="appearance__note" data-reduced-note hidden>Your system asks for reduced motion, so the background stays still.</p>
  </div>
</details>

<script>
  import { getAppearance, getTheme, setAppearance, setTheme, subscribe, type Backdrop, type ThemeChoice } from '../lib/storage';
  import { applyAppearance, applyTheme } from '../lib/appearance';
  import { webglAvailable } from '../lib/scene';
  import { cleanups, listen, onPage } from '../lib/page';

  let canWebGL: boolean | null = null;

  onPage('appearance', () => {
    const c = cleanups();
    document.querySelectorAll<HTMLDetailsElement>('[data-appearance]').forEach((menu) => {
      const q = <E extends Element>(s: string) => menu.querySelector<E>(s)!;

      function sync(): void {
        const theme = getTheme();
        const a = getAppearance();
        applyTheme(theme);
        applyAppearance(a);
        menu.querySelectorAll<HTMLInputElement>('input[name="rw-theme"]').forEach((i) => (i.checked = i.value === theme));
        menu.querySelectorAll<HTMLInputElement>('input[name="rw-bg"]').forEach((i) => (i.checked = i.value === a.bg));
        const motion = q<HTMLInputElement>('input[name="rw-motion"]');
        motion.checked = a.motion;
        motion.disabled = a.bg === 'plain';
        q<HTMLElement>('[data-reduced-note]').hidden = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      }

      // Checking for WebGL creates a throwaway context, so only do it once the menu is opened.
      menu.addEventListener('toggle', () => {
        if (!menu.open) return;
        canWebGL ??= webglAvailable();
        q<HTMLElement>('[data-no-webgl]').hidden = canWebGL;
        q<HTMLElement>('[data-scene-note]').hidden = !canWebGL;
      });

      menu.addEventListener('change', (e) => {
        const input = e.target as HTMLInputElement;
        if (input.name === 'rw-theme') setTheme(input.value as ThemeChoice);
        if (input.name === 'rw-bg') setAppearance({ ...getAppearance(), bg: input.value as Backdrop });
        if (input.name === 'rw-motion') setAppearance({ ...getAppearance(), motion: input.checked });
        sync();
      });

      // Close on Escape (return focus to the button) and on outside click.
      menu.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && menu.open) {
          menu.open = false;
          q<HTMLElement>('summary').focus();
        }
      });
      c.add(
        listen(document, 'click', (e) => {
          if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
        }),
      );

      c.add(subscribe('theme', sync)); // also changes arriving from your account
      c.add(subscribe('appearance', sync));
      sync();
    });
    return c.run;
  });
</script>

<style>
  .appearance {
    position: relative;
  }

  .appearance__button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    min-width: 44px;
    padding: 0 var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    cursor: pointer;
    list-style: none;
  }

  .appearance__button::-webkit-details-marker {
    display: none;
  }

  .appearance__button:hover,
  .appearance[open] .appearance__button {
    color: var(--color-text);
    border-color: var(--color-border-strong);
  }

  .appearance__panel {
    position: absolute;
    right: 0;
    top: calc(100% + var(--space-2));
    z-index: 50;
    width: min(20rem, calc(100vw - 2rem));
    max-height: calc(100vh - 6rem);
    overflow-y: auto;
    display: grid;
    gap: var(--space-4);
    padding: var(--space-4);
    background: var(--color-surface-solid);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: 0 12px 32px rgb(0 0 0 / 0.14);
    animation: panel-in var(--duration-base) var(--ease-out);
  }

  @keyframes panel-in {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: none; }
  }

  fieldset {
    border: 0;
    padding: 0;
    margin: 0;
    min-width: 0;
  }

  legend {
    padding: 0;
    margin-bottom: var(--space-2);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
  }

  .appearance__seg {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    padding: 3px;
    border-radius: var(--radius-pill);
    background: var(--color-surface-2);
  }

  .appearance__seg label,
  .swatch {
    position: relative;
    cursor: pointer;
  }

  .appearance__seg input,
  .swatch input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }

  .appearance__seg span {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 36px;
    border-radius: var(--radius-pill);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .appearance__seg input:checked + span {
    background: var(--color-surface-solid);
    color: var(--color-text);
    font-weight: 600;
    box-shadow: var(--shadow-sm);
  }

  .appearance__seg input:focus-visible + span,
  .swatch input:focus-visible + .swatch__chip {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }

  .appearance__swatches {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-2);
  }

  .swatch {
    display: grid;
    justify-items: center;
    gap: var(--space-1);
  }

  .swatch__chip {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .swatch:hover .swatch__chip {
    transform: scale(1.06);
  }

  .swatch input:checked + .swatch__chip {
    box-shadow: 0 0 0 2px var(--color-surface-solid), 0 0 0 4px var(--color-accent);
  }

  .swatch__label {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .swatch input:checked ~ .swatch__label {
    color: var(--color-text);
    font-weight: 600;
  }

  .appearance__scenes {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-2);
  }

  .scene {
    position: relative;
    display: grid;
    gap: var(--space-1);
    cursor: pointer;
  }

  .scene input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }

  .scene__preview {
    height: 56px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .scene:hover .scene__preview {
    transform: scale(1.03);
  }

  .scene input:checked + .scene__preview {
    box-shadow: 0 0 0 2px var(--color-surface-solid), 0 0 0 4px var(--color-accent);
  }

  .scene input:focus-visible + .scene__preview {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }

  .scene__label {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .scene input:checked ~ .scene__label {
    color: var(--color-text);
    font-weight: 600;
  }

  fieldset .appearance__note {
    margin-top: var(--space-2);
  }

  .appearance__switch {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    font-size: var(--text-sm);
    cursor: pointer;
  }

  .appearance__switch input {
    width: 1.1rem;
    height: 1.1rem;
    accent-color: var(--color-accent);
  }

  .appearance__switch:has(input:disabled) {
    opacity: 0.5;
    cursor: default;
  }

  .appearance__note {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .appearance__note[hidden] {
    display: none;
  }

  @media (max-width: 24rem) {
    .appearance__text {
      display: none;
    }
  }
</style>
