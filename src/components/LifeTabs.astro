---
/**
 * The tabs between Health and Budget in the Android app. With both sections on, the bottom
 * bar has one "Life" tab for them (AppNav.astro) and these tabs switch between the two;
 * with one section on, the bar names it and these stay hidden.
 */
import { LIFE, LIFE_TABS } from '../config/site';
import { isCurrent, url } from '../lib/paths';

const current = Astro.url.pathname;
---

<nav class="life-tabs" aria-label={LIFE.label} data-t-aria-label={LIFE.t} data-life-tabs>
  {
    LIFE_TABS.map((tab) => (
      <a href={url(tab.href)} aria-current={isCurrent(current, tab) ? 'page' : undefined} data-t={tab.t}>
        {tab.label}
      </a>
    ))
  }
</nav>

<style>
  /* The same well-and-raised-tab look as the Focus and Grove tabs. */
  .life-tabs {
    display: none;
    gap: var(--space-1);
    margin-top: var(--space-3);
    padding: 5px;
    border-radius: 17px;
    background: var(--well-bg);
    box-shadow: var(--well-shadow);
  }

  :global(html[data-app][data-mod-health][data-mod-budget]) .life-tabs {
    display: flex;
  }

  .life-tabs a {
    flex: 1 1 0;
    display: grid;
    place-items: center;
    min-height: 44px;
    padding-inline: var(--space-3);
    border-radius: 12px;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: 600;
    white-space: nowrap;
    text-decoration: none;
  }

  .life-tabs a[aria-current='page'] {
    background: var(--raised-grad);
    color: var(--color-text);
    box-shadow:
      inset 0 1px 0 var(--raised-hl),
      0 3px 0 var(--edge);
  }
</style>
