---
/**
 * Password input with a show/hide toggle. With `isNew`, adds a strength meter and
 * the rules (wired up by src/scripts/account-ui.ts).
 */
import { PASSWORD_MAX, PASSWORD_MIN } from '../lib/account/password';

interface Props {
  id: string;
  label: string;
  name?: string;
  isNew?: boolean;
}

const { id, label, name = 'password', isNew = false } = Astro.props;
const hintId = `${id}-hint`;
/** Each label's key in the word lists. */
const LABEL_KEYS: Record<string, string> = {
  'Choose a password': 'you.pw.choose',
  Password: 'you.password',
  'Current password': 'you.pw.current',
  'New password': 'you.pw.new',
  'Confirm with your password': 'you.pw.confirm',
};
---

<div class="field" data-password-field>
  <label for={id} data-t={LABEL_KEYS[label]}>{label}</label>
  <div class="pw">
    <input
      id={id}
      class="input pw__input"
      type="password"
      name={name}
      autocomplete={isNew ? 'new-password' : 'current-password'}
      required
      minlength={isNew ? PASSWORD_MIN : undefined}
      maxlength={PASSWORD_MAX}
      spellcheck="false"
      aria-describedby={isNew ? hintId : undefined}
      data-new={isNew ? '' : undefined}
    />
    <button data-t="you.show" type="button" class="pw__toggle" data-pw-toggle aria-pressed="false">Show</button>
  </div>
  {
    isNew && (
      <>
        <div class="pw__meter" data-strength="0" aria-hidden="true">
          <span />
          <span />
          <span />
        </div>
        <p class="pw__hint" id={hintId} data-pw-hint data-t="you.pw.hint" data-t-n={PASSWORD_MIN}>
          At least {PASSWORD_MIN} characters. A few random words make a strong, memorable password.
        </p>
      </>
    )
  }
</div>
