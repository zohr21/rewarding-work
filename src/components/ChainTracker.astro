---
/**
 * Don't-break-the-chain tracker. Each habit is a row: one tap marks today, its last
 * seven days show as dots, and opening the row shows its best chain and month calendar.
 * Best chain is the headline number; a gap is never framed as failure.
 * A chain can also count an amount, parts of the day (the five prayers) or fill itself in
 * from Focus or Health (src/lib/chainkinds.ts); its days then open in ChainDay's sheet.
 * Used on /progress and the technique page.
 */
import ChainDay from './ChainDay.astro';
import { KINDS, PRAYERS, TEMPLATES, WORKOUT_TYPES } from '../lib/chainkinds';

interface Props {
  headingLevel?: 'h2' | 'h3';
}
const { headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
---

<section class="card chain" data-chain aria-labelledby="chain-heading">
  <div class="chain__head">
    <div>
      <Heading id="chain-heading" class="panel-title" data-t="grove.chains">Chains</Heading>
      <p class="muted chain__count" data-chain-count hidden></p>
    </div>
    <button type="button" class="btn btn--ghost btn--small chain__new" data-chain-new hidden>
      <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"
        ><path d="M12 5v14M5 12h14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path></svg
      >
      <span data-t="grove.newChain">New chain</span>
    </button>
  </div>

  <!-- One row per habit; the open row holds the tracker below (or the form, while renaming). -->
  <ul class="chain__list" data-chain-list></ul>

  <!-- Setup / new chain / rename -->
  <div data-chain-form-home>
    <form class="chain__setup" data-chain-form hidden>
      <label data-t="grove.whatSmallThingWillYou" for="chain-habit" data-chain-label>What small thing will you do every day?</label>
      <div class="chain__row">
        <input data-t-placeholder="grove.eGWrite50Words" id="chain-habit" class="input" type="text" maxlength="80" autocomplete="off" placeholder="e.g. Write 50 words" data-chain-input />
      </div>

      <div class="chain__templates" data-chain-templates>
        <p data-t="grove.orStartFromOne" class="chain__small">Or start from one</p>
        <div class="chain__chips">
          {TEMPLATES.map((t, i) => <button type="button" class="chain__chip" data-chain-template={i} data-t={`chain.tpl.${i}`}>{t.label}</button>)}
        </div>
      </div>

      <fieldset class="chain__kinds">
        <legend data-t="grove.howDoYouMarkA" class="chain__small">How do you mark a day?</legend>
        {
          KINDS.map((k) => (
            <label class="chain__kind">
              <input type="radio" name="chain-kind" value={k.id} data-chain-kind />
              <span class="chain__kind-text">
                <strong data-t={`chain.kind.${k.id}`}>{k.title}</strong>
                <span data-t={`chain.kind.${k.id}Sub`}>{k.sub}</span>
              </span>
            </label>
          ))
        }
      </fieldset>

      <div class="chain__opts" data-chain-opt="amount" hidden>
        <label class="chain__opt"><span data-t="grove.goalPerDay">Goal per day</span><input class="input" type="text" inputmode="decimal" placeholder="20" data-chain-goal /></label>
        <label class="chain__opt"><span data-t="grove.countedIn">Counted in</span><input data-t-placeholder="grove.pages" class="input" type="text" maxlength="20" placeholder="pages" data-chain-unit /></label>
      </div>
      <div class="chain__opts" data-chain-opt="parts" hidden>
        <label class="chain__opt chain__opt--wide"
          ><span data-t="grove.slotsComma">Slots, separated by commas</span><input class="input" type="text" maxlength="200" value={PRAYERS.join(', ')} data-chain-parts /></label
        >
        <label class="chain__opt"><span data-t="grove.dayCountsAt">The day counts at</span><select class="input" data-chain-count-at></select></label>
      </div>
      <div class="chain__opts" data-chain-opt="linked" hidden>
        <label class="chain__opt"
          ><span data-t="grove.fillsFrom">Fills from</span><select class="input" data-chain-source>
            <option data-t="grove.focusTime" value="focus">Focus time</option>
            {WORKOUT_TYPES.map((t) => <option value={t.id} data-t={`chain.from.${t.id}`}>{t.label} on Health</option>)}
          </select></label
        >
        <label class="chain__opt"
          ><span data-t="grove.goalMinutes" data-chain-link-unit>Goal (minutes)</span><input data-t-placeholder="grove.n0Any" class="input" type="text" inputmode="decimal" placeholder="0 = any" data-chain-link-goal /></label
        >
      </div>

      <div class="chain__form-actions">
        <div class="chain__edit-actions" data-chain-edit-actions hidden>
          <button data-t="grove.cancel" type="button" class="btn btn--ghost btn--small" data-chain-cancel>Cancel</button>
          <button data-t="grove.deleteChain" type="button" class="btn btn--ghost btn--small" data-chain-delete>Delete chain</button>
        </div>
        <button data-t="grove.save" type="submit" class="btn">Save</button>
      </div>
      <p class="chain__small muted" data-chain-form-error hidden></p>
    </form>
  </div>

  <!-- Tracker for the open chain -->
  <div class="chain__body" data-chain-body hidden>
    <div class="chain__stats">
      <div class="chain__best">
        <p data-t="grove.bestChain" class="chain__label">Best chain</p>
        <p class="chain__big"><span data-chain-best>0</span> <span data-t="grove.days" class="chain__unit" data-chain-best-unit>days</span></p>
      </div>
      <div class="chain__side">
        <p><span data-t="grove.current" class="chain__label">Current</span> <strong data-chain-current>0</strong></p>
        <p><span data-t="grove.totalDays" class="chain__label">Total days</span> <strong data-chain-total>0</strong></p>
      </div>
    </div>

    <div class="chain__habit">
      <p class="chain__message" data-chain-message></p>
      <button data-t="grove.edit" type="button" class="btn btn--ghost btn--small" data-chain-edit>Edit</button>
    </div>

    <div class="chain__cal-wrap">
      <div class="chain__month">
        <button data-t-aria-label="grove.previousMonth" type="button" class="icon-btn chain__nav" aria-label="Previous month" data-chain-prev>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
            ><path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg
          >
        </button>
        <p class="chain__month-name" id="chain-cal-label" aria-live="polite" data-chain-month></p>
        <button data-t-aria-label="grove.nextMonth" type="button" class="icon-btn chain__nav" aria-label="Next month" data-chain-next>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
            ><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg
          >
        </button>
        <button data-t="grove.today" type="button" class="btn btn--ghost btn--small chain__this-month" data-chain-this-month hidden>Today</button>
      </div>
      <div class="chain__weekdays" aria-hidden="true">
        {['M', 'T', 'W', 'T', 'F', 'S', 'S'].map((d, i) => <span data-t={`chain.wd.${i}`}>{d}</span>)}
      </div>
      <div class="chain__cal" role="group" aria-labelledby="chain-cal-label" data-chain-cal></div>
      <p class="chain__cal-hint muted" data-chain-hint></p>
    </div>
  </div>

  <p class="visually-hidden" aria-live="polite" data-chain-live></p>
</section>

<ChainDay />

<script>
  import {
    addChain,
    CHAIN_COLORS,
    deleteChain,
    getChains,
    MAX_CHAINS,
    renameChain,
    subscribe,
    toggleChainDay,
    type ChainEntry,
  } from '../lib/storage';
  import {
    EDIT_DAYS,
    PRAYERS,
    WORKOUT_TYPES,
    prayers,
    template,
    chainDay,
    getEntry,
    getSetup,
    linkData,
    removeDetail,
    saveSetup,
    syncLinked,
    togglePart,
    type ChainKind,
    type ChainSetup,
    type LinkSource,
  } from '../lib/chainkinds';
  import { offerUndo } from '../lib/undo';
  import { streakRecords } from '../lib/rewards';
  import { chainStats } from '../lib/stats';
  import { addDays, dayKey, formatDay, fromDayKey, startOfDay, startOfWeek } from '../lib/dates';
  import { celebrate } from '../lib/appearance';
  import { cleanups, onPage } from '../lib/page';
  import { dateFormat, t, tn } from '../lib/i18n';

  const monthFmt = dateFormat({ month: 'long', year: 'numeric' });
  const shortMonthFmt = dateFormat({ month: 'short' });

  const TICK_SVG =
    '<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M6 12.5l4 4L18 8" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"/></svg>';
  const CHEVRON_SVG =
    '<svg class="chain__chevron" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>';

  const monthStart = (d: Date) => new Date(d.getFullYear(), d.getMonth(), 1);
  const addMonths = (d: Date, n: number) => new Date(d.getFullYear(), d.getMonth() + n, 1);
  const sameMonth = (a: Date, b: Date) => a.getFullYear() === b.getFullYear() && a.getMonth() === b.getMonth();

  interface Row {
    el: HTMLLIElement;
    tick: HTMLButtonElement;
    open: HTMLButtonElement;
    name: HTMLElement;
    sub: HTMLElement;
    dots: HTMLElement;
    /** Today's slots, for a parts-of-the-day chain. */
    parts: HTMLElement;
    slot: HTMLElement;
  }

  /** Buttons that open a day in ChainDay's sheet carry these. */
  function opensDay(b: HTMLElement, id: string, key: string | null): void {
    if (key) {
      b.dataset.sheetOpen = 'chain-day';
      b.dataset.chainId = id;
      b.dataset.chainDay = key;
    } else {
      delete b.dataset.sheetOpen;
      delete b.dataset.chainId;
      delete b.dataset.chainDay;
    }
  }

  onPage('chain', () => {
    const c = cleanups();
    document.querySelectorAll<HTMLElement>('[data-chain]').forEach((root) => {
      const $ = <E extends Element>(s: string) => root.querySelector<E>(s)!;
      const count = $<HTMLElement>('[data-chain-count]');
      const newBtn = $<HTMLButtonElement>('[data-chain-new]');
      const listEl = $<HTMLElement>('[data-chain-list]');
      const formHome = $<HTMLElement>('[data-chain-form-home]');
      const form = $<HTMLFormElement>('[data-chain-form]');
      const label = $<HTMLElement>('[data-chain-label]');
      const input = $<HTMLInputElement>('[data-chain-input]');
      const cancel = $<HTMLButtonElement>('[data-chain-cancel]');
      const editActions = $<HTMLElement>('[data-chain-edit-actions]');
      const del = $<HTMLButtonElement>('[data-chain-delete]');
      const body = $<HTMLElement>('[data-chain-body]');
      const edit = $<HTMLButtonElement>('[data-chain-edit]');
      const best = $<HTMLElement>('[data-chain-best]');
      const bestUnit = $<HTMLElement>('[data-chain-best-unit]');
      const current = $<HTMLElement>('[data-chain-current]');
      const total = $<HTMLElement>('[data-chain-total]');
      const message = $<HTMLElement>('[data-chain-message]');
      const cal = $<HTMLElement>('[data-chain-cal]');
      const monthName = $<HTMLElement>('[data-chain-month]');
      const prev = $<HTMLButtonElement>('[data-chain-prev]');
      const next = $<HTMLButtonElement>('[data-chain-next]');
      const thisMonth = $<HTMLButtonElement>('[data-chain-this-month]');
      const hint = $<HTMLElement>('[data-chain-hint]');
      const live = $<HTMLElement>('[data-chain-live]');
      const templates = $<HTMLElement>('[data-chain-templates]');
      const kindInputs = [...root.querySelectorAll<HTMLInputElement>('[data-chain-kind]')];
      const opts = [...root.querySelectorAll<HTMLElement>('[data-chain-opt]')];
      const goalIn = $<HTMLInputElement>('[data-chain-goal]');
      const unitIn = $<HTMLInputElement>('[data-chain-unit]');
      const partsIn = $<HTMLInputElement>('[data-chain-parts]');
      const countAtIn = $<HTMLSelectElement>('[data-chain-count-at]');
      const sourceIn = $<HTMLSelectElement>('[data-chain-source]');
      const linkGoalIn = $<HTMLInputElement>('[data-chain-link-goal]');
      const linkUnit = $<HTMLElement>('[data-chain-link-unit]');
      const formError = $<HTMLElement>('[data-chain-form-error]');

      const rows = new Map<string, Row>();
      /** The chain whose tracker is showing; undefined until the first render picks one. */
      let openId: string | null | undefined;
      /** What the form is for: a further chain, or renaming the open one. */
      let mode: 'new' | 'edit' | null = null;
      /** First day of the month on show. */
      let viewMonth = monthStart(new Date());
      let pulseKey: string | null = null;
      /** Deleted, but still offered for Undo (src/lib/undo.ts): hidden until then. */
      const removing = new Set<string>();
      const shown = () => getChains().filter((ch) => !removing.has(ch.id));

      const announce = (text: string) => {
        live.textContent = '';
        window.setTimeout(() => (live.textContent = text), 50);
      };
      const days = (n: number) => tn('chain.days', n);
      // The slots a new parts chain starts with, in this language.
      if (partsIn.value === PRAYERS.join(', ')) partsIn.value = prayers().join(', ');

      function encouragement(s: ReturnType<typeof chainStats>): string {
        if (s.total === 0) return t('chain.say.first');
        if (s.current === 0) return t('chain.say.restart', { best: days(s.best) });
        if (!s.doneToday) return t('chain.say.soFar', { days: days(s.current) });
        if (s.current >= s.best && s.best > 1) return t('chain.say.best', { days: days(s.current) });
        return t('chain.say.counting', { days: days(s.current) });
      }

      // ---------- The kind fields of the form ----------

      const pickedKind = (): ChainKind => (kindInputs.find((i) => i.checked)?.value as ChainKind) ?? 'tick';
      const slotNames = () =>
        partsIn.value
          .split(',')
          .map((p) => p.trim())
          .filter(Boolean)
          .slice(0, 8);
      const distanceSource = () => WORKOUT_TYPES.find((w) => w.id === sourceIn.value)?.distance ?? false;

      function showKind(): void {
        const kind = pickedKind();
        opts.forEach((o) => (o.hidden = o.dataset.chainOpt !== kind));
        const n = Math.max(1, slotNames().length);
        const keep = Number(countAtIn.value) || n;
        countAtIn.replaceChildren(
          ...Array.from({ length: n }, (_, i) => {
            const o = document.createElement('option');
            o.value = String(i + 1);
            o.textContent = t('chain.nOf', { n: i + 1, total: n });
            return o;
          }),
        );
        countAtIn.value = String(Math.min(keep, n));
        linkUnit.textContent = sourceIn.value !== 'focus' && distanceSource() ? t('chain.goalKm') : t('grove.goalMinutes');
        formError.hidden = true;
      }
      kindInputs.forEach((i) => i.addEventListener('change', showKind));
      partsIn.addEventListener('input', showKind);
      sourceIn.addEventListener('change', showKind);

      function fillKind(s: ChainSetup): void {
        kindInputs.forEach((i) => (i.checked = i.value === s.kind));
        goalIn.value = s.kind === 'amount' ? String(s.goal ?? '') : '';
        unitIn.value = s.kind === 'amount' ? (s.unit ?? '') : '';
        if (s.kind === 'parts') partsIn.value = (s.parts ?? []).join(', ');
        sourceIn.value = s.kind === 'linked' ? (s.source ?? 'focus') : 'focus';
        linkGoalIn.value = s.kind === 'linked' && s.goal ? String(s.goal) : '';
        countAtIn.value = '';
        showKind();
        if (s.kind === 'parts') countAtIn.value = String(s.countAt ?? (s.parts ?? []).length);
      }

      /** The setup the form describes, or a sentence saying what is missing. */
      function readKind(): ChainSetup | string {
        const kind = pickedKind();
        const n = (v: string) => Number(v.replace(',', '.'));
        if (kind === 'amount') {
          const goal = n(goalIn.value);
          if (!(goal > 0)) return t('chain.err.goal');
          return { kind, goal, unit: unitIn.value.trim() || undefined };
        }
        if (kind === 'parts') {
          const parts = slotNames();
          if (parts.length < 2) return t('chain.err.slots');
          return { kind, parts, countAt: Number(countAtIn.value) || parts.length };
        }
        if (kind === 'linked') {
          const goal = linkGoalIn.value.trim() ? n(linkGoalIn.value) : 0;
          if (!(goal >= 0)) return t('chain.err.linkGoal');
          return { kind, source: sourceIn.value as LinkSource, goal };
        }
        return { kind: 'tick' };
      }

      templates.addEventListener('click', (e) => {
        const b = (e.target as HTMLElement).closest<HTMLElement>('[data-chain-template]');
        const tpl = b && template(Number(b.dataset.chainTemplate));
        if (!tpl) return;
        input.value = tpl.habit;
        fillKind(tpl.setup);
      });

      function makeRow(id: string): Row {
        const el = document.createElement('li');
        el.className = 'chain__item';
        const head = document.createElement('div');
        head.className = 'chain__item-head';

        const tick = document.createElement('button');
        tick.type = 'button';
        tick.className = 'chain__tick';
        tick.innerHTML = TICK_SVG;
        // Other kinds open today in the sheet instead (opensDay).
        tick.addEventListener('click', () => {
          if (getSetup(id).kind === 'tick') toggle(id, dayKey(new Date()), new Date());
        });

        const open = document.createElement('button');
        open.type = 'button';
        open.className = 'chain__open';
        const names = document.createElement('span');
        names.className = 'chain__names';
        const name = document.createElement('span');
        name.className = 'chain__name';
        const sub = document.createElement('span');
        sub.className = 'chain__sub';
        names.append(name, sub);
        const dots = document.createElement('span');
        dots.className = 'chain__dots';
        dots.setAttribute('aria-hidden', 'true');
        dots.append(...Array.from({ length: EDIT_DAYS }, () => document.createElement('span')));
        open.append(names, dots);
        open.insertAdjacentHTML('beforeend', CHEVRON_SVG);
        open.addEventListener('click', () => {
          openId = openId === id ? null : id;
          mode = null;
          viewMonth = monthStart(new Date());
          render();
        });

        const parts = document.createElement('div');
        parts.className = 'chain__parts';
        parts.setAttribute('role', 'group');
        parts.addEventListener('click', (e) => {
          const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-part]');
          if (!b) return;
          const ch = shown().find((x) => x.id === id);
          const key = dayKey(new Date());
          const before = ch?.days.includes(key) ?? false;
          const counted = togglePart(id, key, Number(b.dataset.part));
          if (counted && !before) celebrate();
          // The write has redrawn the row already, so the button shows the new state.
          announce(t(b.getAttribute('aria-pressed') === 'true' ? 'chain.slotDone' : 'chain.slotNotYet', { slot: b.textContent ?? '' }));
        });

        const slot = document.createElement('div');
        slot.className = 'chain__slot';
        head.append(tick, open);
        el.append(head, parts, slot);
        return { el, tick, open, name, sub, dots, parts, slot };
      }

      function fillRow(r: Row, ch: ChainEntry, s: ReturnType<typeof chainStats>, data: ReturnType<typeof linkData>): void {
        const isOpen = ch.id === openId;
        const now = startOfDay(new Date());
        const todayKey = dayKey(now);
        const setup = getSetup(ch.id);
        const today = chainDay(ch, todayKey, data);
        r.el.style.setProperty('--chain-color', CHAIN_COLORS[ch.color % CHAIN_COLORS.length]!);
        r.el.classList.toggle('is-open', isOpen);
        r.name.textContent = ch.habit;
        const run = s.total === 0 ? t('chain.notStarted') : `${s.current ? t('chain.running', { days: days(s.current) }) : t('chain.noChainNow')} · ${t('chain.best', { n: s.best })}`;
        r.sub.textContent = setup.kind === 'tick' ? run : `${t('chain.today', { value: today.long })} · ${t('chain.best', { n: s.best })}`;
        r.tick.setAttribute('aria-label', setup.kind === 'tick' ? t('chain.doneToday', { habit: ch.habit }) : t('chain.fillToday', { habit: ch.habit, value: today.long }));
        r.tick.setAttribute('aria-pressed', String(today.counted));
        // A chain with a number shows it until the day counts, then the tick.
        const text = setup.kind !== 'tick' && !today.counted ? today.short : '';
        r.tick.classList.toggle('has-text', !!text);
        if (text) r.tick.textContent = text;
        else if (!r.tick.querySelector('svg')) r.tick.innerHTML = TICK_SVG;
        opensDay(r.tick, ch.id, setup.kind === 'tick' ? null : todayKey);
        r.open.setAttribute('aria-expanded', String(isOpen));
        [...r.dots.children].forEach((dot, i) => {
          const view = chainDay(ch, dayKey(addDays(now, i - (EDIT_DAYS - 1))), data);
          dot.classList.toggle('is-marked', view.counted);
          dot.classList.toggle('is-part', view.partial);
          dot.classList.toggle('is-today', i === EDIT_DAYS - 1);
        });

        // Parts of the day: one tap per slot, today.
        const names = setup.kind === 'parts' ? (setup.parts ?? []) : [];
        r.parts.hidden = !names.length;
        r.parts.setAttribute('aria-label', t('chain.habitToday', { habit: ch.habit }));
        const entry = names.length ? (getEntry(ch.id, todayKey).parts ?? []) : [];
        // Kept and updated in place, so focus stays on the slot just tapped.
        if (r.parts.children.length !== names.length)
          r.parts.replaceChildren(
            ...names.map((_, i) => {
              const b = document.createElement('button');
              b.type = 'button';
              b.className = 'chain__part';
              b.dataset.part = String(i);
              return b;
            }),
          );
        [...r.parts.children].forEach((b, i) => {
          b.textContent = names[i]!;
          b.setAttribute('aria-pressed', String(!!entry[i]));
          b.classList.toggle('is-later', entry[i] === 2);
        });
      }

      function render(): void {
        const list = shown();
        const none = list.length === 0;
        if (openId === undefined && !none) openId = list[0]!.id;
        if (openId && !list.some((ch) => ch.id === openId)) openId = null;
        const openChain = list.find((ch) => ch.id === openId);
        if (mode === 'edit' && !openChain) mode = null;
        const stats = new Map(list.map((ch) => [ch.id, chainStats(ch.days)]));
        const data = linkData();

        const doneToday = list.filter((ch) => stats.get(ch.id)!.doneToday).length;
        count.hidden = none;
        count.textContent = t('chain.doneTodayCount', { n: doneToday, total: list.length });
        newBtn.hidden = none || mode !== null || list.length >= MAX_CHAINS;

        // Rows are kept and updated in place, so focus stays put while days are marked.
        for (const [id, r] of rows) {
          if (list.some((ch) => ch.id === id)) continue;
          if (r.el.contains(body)) root.append(body);
          if (r.el.contains(form)) formHome.append(form);
          r.el.remove();
          rows.delete(id);
        }
        list.forEach((ch, i) => {
          let r = rows.get(ch.id);
          if (!r) rows.set(ch.id, (r = makeRow(ch.id)));
          if (listEl.children[i] !== r.el) listEl.insertBefore(r.el, listEl.children[i] ?? null);
          fillRow(r, ch, stats.get(ch.id)!, data);
        });

        const openRow = openChain && rows.get(openChain.id);
        const renaming = mode === 'edit' && openRow;
        const formAt = renaming ? openRow.slot : formHome;
        if (form.parentElement !== formAt) formAt.append(form);
        form.hidden = !(none || mode !== null);
        label.textContent = renaming ? t('chain.rename') : none ? t('grove.whatSmallThingWillYou') : t('chain.whatElse');
        editActions.hidden = none;
        del.hidden = !renaming;
        templates.hidden = !!renaming;
        if (!kindInputs.some((i) => i.checked)) fillKind({ kind: 'tick' });

        const tracking = openChain && openRow && !renaming;
        if (tracking) {
          if (body.parentElement !== openRow.slot) openRow.slot.append(body);
          const s = stats.get(openChain.id)!;
          best.textContent = String(s.best);
          bestUnit.textContent = tn('chain.dayWord', s.best);
          current.textContent = days(s.current);
          total.textContent = String(s.total);
          message.textContent = encouragement(s);
          renderCalendar(openChain, data);
        }
        body.hidden = !tracking;
        pulseKey = null;
      }

      /** Month grid, Monday first, with the neighbouring months' days dimmed. */
      function renderCalendar(chain: ChainEntry, data: ReturnType<typeof linkData>): void {
        const plain = getSetup(chain.id).kind === 'tick';
        const marked = chain.days;
        const set = new Set(marked);
        const now = startOfDay(new Date());
        const todayKey = dayKey(now);
        const editFrom = addDays(now, -(EDIT_DAYS - 1));
        // Browse back as far as the first marked day (or just this month when there are none).
        const earliest = monthStart(marked.length ? fromDayKey(marked[0]!) : now);
        const current = monthStart(now);
        if (viewMonth > current) viewMonth = current;
        if (viewMonth < earliest) viewMonth = earliest;

        monthName.textContent = monthFmt.format(viewMonth);
        prev.disabled = viewMonth <= earliest;
        next.disabled = viewMonth >= current;
        thisMonth.hidden = sameMonth(viewMonth, now);

        const first = startOfWeek(viewMonth);
        const last = addDays(startOfWeek(addDays(addMonths(viewMonth, 1), -1)), 6);
        const focusedKey = cal.contains(document.activeElement) ? (document.activeElement as HTMLElement).dataset.key : undefined;
        const buttons: HTMLElement[] = [];
        for (let date = first, i = 0; date <= last; date = addDays(date, 1), i++) {
          const key = dayKey(date);
          const isMarked = set.has(key);
          const future = date > now;
          const editable = !future && date >= editFrom;
          const outside = !sameMonth(date, viewMonth);
          const b = document.createElement('button');
          b.type = 'button';
          b.className = 'chain__day';
          b.dataset.key = key;
          // The 1st of a neighbouring month carries its name, so the change of month is visible.
          b.textContent = outside && date.getDate() === 1 ? `${shortMonthFmt.format(date)} 1` : String(date.getDate());
          b.disabled = future;
          // Read-only past days stay focusable, so their state can still be read out.
          if (!future && !editable) b.setAttribute('aria-disabled', 'true');
          const view = plain || future ? undefined : chainDay(chain, key, data);
          // Other kinds open the day in the sheet, so the button is not a toggle there.
          if (plain) b.setAttribute('aria-pressed', String(isMarked));
          if (!plain && editable) opensDay(b, chain.id, key);
          b.classList.toggle('is-part', !!view?.partial);
          b.setAttribute(
            'aria-label',
            `${formatDay(date)}${key === todayKey ? ` (${t('chain.todayLower')})` : ''}${view ? `, ${view.long}` : ''}${!future && !editable ? `, ${t('chain.readOnly')}` : ''}`,
          );
          b.classList.toggle('is-outside', outside);
          b.classList.toggle('is-locked', !future && !editable);
          if (isMarked) {
            b.classList.add('is-marked');
            // Visually link consecutive days within a week row.
            if (i % 7 !== 6 && set.has(dayKey(addDays(date, 1)))) b.classList.add('link-right');
          }
          if (key === todayKey) b.classList.add('is-today');
          if (key === pulseKey) b.classList.add('is-pulse');
          const day = date;
          b.addEventListener('click', () => {
            if (!editable) {
              announce(t('chain.onlyLast', { n: EDIT_DAYS }));
              hint.classList.remove('is-nudged');
              void hint.offsetWidth; // restart the nudge animation
              hint.classList.add('is-nudged');
              return;
            }
            if (plain) toggle(chain.id, key, day);
          });
          buttons.push(b);
        }
        cal.replaceChildren(...buttons);
        if (focusedKey) cal.querySelector<HTMLElement>(`[data-key="${focusedKey}"]`)?.focus();
        hint.textContent = plain
          ? t('chain.hintTick', { n: EDIT_DAYS })
          : t('chain.hintFill', { n: EDIT_DAYS });
      }

      function show(month: Date): void {
        viewMonth = month;
        render();
      }
      prev.addEventListener('click', () => show(addMonths(viewMonth, -1)));
      next.addEventListener('click', () => show(addMonths(viewMonth, 1)));
      thisMonth.addEventListener('click', () => {
        show(monthStart(new Date()));
        (next.disabled ? prev : next).focus();
      });

      function toggle(id: string, key: string, date: Date): void {
        const before = shown().find((ch) => ch.id === id);
        if (!before) return;
        // Set before the write: the storage subscription redraws straight away.
        const marking = !before.days.includes(key);
        if (marking && id === openId) pulseKey = key;
        toggleChainDay(key, id);
        if (marking) celebrate();
        const s = chainStats(getChains().find((ch) => ch.id === id)?.days ?? []);
        announce(
          t(marking ? 'chain.saidMarked' : 'chain.saidUnmarked', { habit: before.habit, day: formatDay(date), current: days(s.current), best: days(s.best) }),
        );
      }

      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const habit = input.value.trim();
        if (!habit) {
          input.focus();
          return;
        }
        const setup = readKind();
        if (typeof setup === 'string') {
          formError.textContent = setup;
          formError.hidden = false;
          announce(setup);
          return;
        }
        if (mode === 'edit' && openId) {
          mode = null;
          renameChain(openId, habit);
          saveSetup(openId, setup);
          render();
          announce(t('chain.saved', { habit }));
          edit.focus();
          return;
        }
        const id = addChain(habit);
        if (!id) return;
        saveSetup(id, setup);
        mode = null;
        openId = id;
        viewMonth = monthStart(new Date());
        input.value = '';
        render();
        announce(t('chain.started', { habit }));
        rows.get(id)?.tick.focus();
      });

      newBtn.addEventListener('click', () => {
        mode = 'new';
        input.value = '';
        fillKind({ kind: 'tick' });
        render();
        input.focus();
      });

      edit.addEventListener('click', () => {
        const chain = shown().find((ch) => ch.id === openId);
        if (!chain) return;
        mode = 'edit';
        input.value = chain.habit;
        fillKind(getSetup(chain.id));
        render();
        input.focus();
        input.select();
      });

      cancel.addEventListener('click', () => {
        const wasEdit = mode === 'edit';
        mode = null;
        input.value = '';
        render();
        (wasEdit ? edit : newBtn).focus();
      });

      del.addEventListener('click', () => {
        const old = shown().find((ch) => ch.id === openId);
        if (!old) return;
        const n = old.days.length;
        removing.add(old.id);
        mode = null;
        openId = undefined; // open the first of those left
        input.value = '';
        render();
        (newBtn.hidden ? input : newBtn).focus();
        offerUndo({
          message: n ? t('chain.deletedDays', { habit: old.habit, days: days(n) }) : t('chain.deleted', { habit: old.habit }),
          commit: () => {
            if (!removing.delete(old.id)) return;
            deleteChain(old.id, streakRecords(getChains().find((ch) => ch.id === old.id)?.days ?? []));
            removeDetail(old.id);
          },
          undo: () => {
            if (!removing.delete(old.id)) return;
            mode = null;
            openId = old.id;
            render();
            announce(t('chain.restored', { habit: old.habit }));
            edit.focus();
          },
        });
        announce(t('chain.deletedSaid', { habit: old.habit }));
      });

      // Linked chains follow Focus and Health; syncing writes `chain`, which redraws.
      const follow = () => {
        syncLinked();
        render();
      };
      follow();
      c.add(subscribe('chain', render));
      c.add(subscribe('chain-detail', render));
      c.add(subscribe('sessions', follow));
      c.add(subscribe('workouts', follow));
    });
    return c.run;
  });
</script>

