---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Ambient from '../components/Ambient.astro';
import { ClientRouter } from 'astro:transitions';
import { SITE } from '../config/site';
import { SCENES } from '../lib/storage';
import { url } from '../lib/paths';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = SITE.description } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.name}` : SITE.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
const swUrl = url('/sw.js');
const swScope = url('/');
const sceneIds = SCENES.join('|');
---

<!doctype html>
<html lang={SITE.lang} data-theme="light" data-bg="sunrise" data-bg-kind="glow" data-motion="on">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="apple-touch-icon" href={url('/icons/apple-touch-icon.png')} />
    <link rel="manifest" href={url('/manifest.webmanifest')} />
    <meta name="theme-color" content="#fbf8f3" />
    <meta name="generator" content={Astro.generator} />

    <!--
      Apply saved theme + background before first paint (no flash). Must be inline so it
      runs synchronously. Keys and defaults match src/lib/storage.ts.
      The client-side router resets <html> attributes to the new page's defaults on every
      navigation, so the same function runs again on astro:after-swap.
    -->
    <script is:inline define:vars={{ sceneIds }}>
      (function () {
        var root = document.documentElement;
        var scenes = new RegExp('^(' + sceneIds + ')$');
        function get(name) {
          try {
            return JSON.parse(localStorage.getItem('rw:v1:' + name) || 'null');
          } catch (e) {
            return null;
          }
        }
        function apply() {
          var t = get('theme');
          if (t === 'dark' || t === 'auto') root.dataset.theme = t;
          var a = get('appearance');
          if (a && (/^(sunrise|meadow|lavender|plain)$/.test(a.bg) || scenes.test(a.bg))) {
            root.dataset.bg = a.bg;
            root.dataset.bgKind = scenes.test(a.bg) ? 'scene' : 'glow';
          }
          if (a && a.motion === false) root.dataset.motion = 'off';
        }
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <Ambient />
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />

    {
      /* Service worker only in production builds — in dev it would cache stale files. */
      import.meta.env.PROD && (
        <script is:inline define:vars={{ swUrl, swScope }}>
          if ('serviceWorker' in navigator) {
            window.addEventListener('load', function () {
              navigator.serviceWorker.register(swUrl, { scope: swScope }).catch(function () {});
            });
          }
        </script>
      )
    }
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: var(--space-4);
    top: -100px;
    z-index: 100;
    padding: var(--space-2) var(--space-4);
    background: var(--color-accent);
    color: var(--color-on-accent);
    border-radius: var(--radius-sm);
    font-weight: 600;
  }

  .skip-link:focus {
    top: var(--space-2);
  }

  main {
    flex: 1;
    padding-bottom: var(--space-8);
  }

  main:focus {
    outline: none;
  }
</style>
