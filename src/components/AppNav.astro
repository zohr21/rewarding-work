---
/**
 * The Android app's bottom bar (BaseLayout shows it only in the app build): five
 * destinations, the current one marked with a pill behind its icon. Exam prep and
 * the problem pages live under Learn, next to the techniques.
 */
import { isActive, url } from '../lib/paths';

const current = Astro.url.pathname;

const ITEMS = [
  { label: 'Today', href: '/', under: ['/'], icon: 'M4 11l8-7 8 7v8a1 1 0 0 1-1 1h-4v-6H9v6H5a1 1 0 0 1-1-1z' },
  { label: 'Timer', href: '/timer', under: ['/timer'], icon: 'M12 5a8 8 0 1 1 0 16 8 8 0 0 1 0-16zM12 9v4l2.5 2M9 2h6' },
  { label: 'Tasks', href: '/tasks', under: ['/tasks'], icon: 'M10 6h10M10 12h10M10 18h10M4 6l1 1 2-2M4 12l1 1 2-2M4 18l1 1 2-2' },
  { label: 'Progress', href: '/progress', under: ['/progress'], icon: 'M5 20V11M12 20V5M19 20v-6' },
  { label: 'Learn', href: '/techniques', under: ['/techniques', '/exam', '/problems'], icon: 'M5 4h11a3 3 0 0 1 3 3v13H8a3 3 0 0 1-3-3zM5 17a3 3 0 0 1 3-3h11' },
];
---

<nav class="app-nav" aria-label="Main">
  <ul>
    {
      ITEMS.map((item) => (
        <li>
          <a href={url(item.href)} aria-current={item.under.some((p) => isActive(current, p)) ? 'page' : undefined}>
            <span class="app-nav__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22">
                <path d={item.icon} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style is:global>
  /* Room for the bar under the page, and for toasts above it (RewardNotice, UndoToast). */
  html[data-app] {
    --app-nav-h: calc(4.25rem + env(safe-area-inset-bottom, 0px));
  }

  html[data-app] body {
    padding-bottom: var(--app-nav-h);
  }

  /* A phone screen has less room for the page's introduction than the site does. */
  html[data-app] .page-header {
    padding-block: var(--space-4) var(--space-3);
  }

  html[data-app] .page-header h1 {
    font-size: var(--text-xl);
  }

  html[data-app] .page-header p {
    font-size: var(--text-sm);
  }
</style>

<style>
  .app-nav {
    position: fixed;
    inset-inline: 0;
    inset-block-end: 0;
    z-index: 20;
    padding-bottom: env(safe-area-inset-bottom, 0px);
    border-top: 1px solid var(--color-border);
    background: var(--header-bg);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    backdrop-filter: saturate(1.4) blur(14px);
  }

  .app-nav ul {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    max-width: 34rem;
    margin-inline: auto;
    padding: 0 var(--space-1);
    list-style: none;
  }

  .app-nav a {
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 2px;
    min-height: 4.25rem;
    color: var(--color-text-muted);
    font-size: 0.75rem;
    font-weight: 500;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }

  .app-nav__icon {
    display: grid;
    place-items: center;
    inline-size: 3.75rem;
    block-size: 2rem;
    border-radius: 1rem;
    transition: background-color var(--duration-base) var(--ease-out);
  }

  .app-nav a:active .app-nav__icon {
    background: var(--color-surface-2);
  }

  .app-nav a[aria-current='page'] {
    color: var(--color-text);
    font-weight: 700;
  }

  .app-nav a[aria-current='page'] .app-nav__icon {
    background: var(--color-accent-soft);
    color: var(--color-accent);
  }
</style>
