---
/**
 * The plan above the expenses: income split into needs, wants and savings (50/30/20 by
 * default), savings paid first, and one number from it all, what is safe to spend today.
 * Income, goals, the plan and a calendar of the month open in sheets (Sheet.astro) instead of
 * pages. It follows the month shown in BudgetView (the `budget:month` event); the data is in
 * src/lib/budget.ts.
 */
import Sheet from './Sheet.astro';
import { AMOUNT_MAX, CATEGORIES, CATEGORY_COLORS, CATEGORY_LABELS, INCOME_SOURCES, SOURCE_LABELS, SPLITS, WHAT_MAX } from '../lib/budget';

const TAGS = [
  ['need', 'Need'],
  ['want', 'Want'],
  ['mixed', 'Mixed'],
] as const;
---

<section class="card bp" data-bplan aria-labelledby="bp-label">
  <div class="bp__empty" data-bp-empty>
    <h2 data-t="budget.planTheMonth" class="panel-title" id="bp-label-empty">Plan the month</h2>
    <p data-t="budget.addWhatComesInIt" class="muted">
      Add what comes in. It is split into needs, wants and savings, and the savings are put aside first. Then you get one number: what is safe to
      spend today.
    </p>
    <button data-t="budget.addIncome" type="button" class="btn" data-sheet-open="income">Add income</button>
  </div>

  <div class="bp__main" data-bp-main hidden>
    <div class="bp__hero">
      <p class="bp__label" id="bp-label" data-bp-label></p>
      <p class="bp__big" data-bp-big></p>
      <p class="muted bp__line" data-bp-line></p>
      <p class="bp__saved" data-bp-saved></p>
    </div>
    <ul class="bp__bars" role="list" data-bp-bars></ul>
    <p class="bp__unsorted" data-bp-unsorted hidden></p>
    <div class="bp__actions">
      <button data-t="budget.addExpense" type="button" class="btn" data-bp-expense>Add expense</button>
      <button data-t="budget.income" type="button" class="btn btn--ghost" data-sheet-open="income">Income</button>
    </div>
    <div class="bp__tiles">
      <button type="button" class="bp__tile" data-sheet-open="goals"><span data-t="budget.goals" class="muted">Goals</span><strong data-bp-goals></strong></button>
      <button type="button" class="bp__tile" data-sheet-open="plan"><span data-t="budget.plan" class="muted">Plan</span><strong data-bp-split></strong></button>
      <button type="button" class="bp__tile" data-sheet-open="budget-cal"><span data-t="budget.noSpendDays" class="muted">No-spend days</span><strong data-bp-nospend></strong></button>
    </div>
  </div>
</section>

<Sheet id="income" title="Income" titleKey="budget.income">
  <form class="bp-form" data-bp-i-form>
    <label class="bp-amount">
      <span data-t="budget.amount" class="visually-hidden">Amount</span>
      <span class="bp-amount__sign" data-bp-sign aria-hidden="true"></span>
      <input data-t-aria-label="budget.amount" type="number" inputmode="decimal" min="0.01" max={AMOUNT_MAX} step="0.01" required placeholder="0" aria-label="Amount" data-bp-i-amount />
    </label>
    <fieldset class="bp-seg">
      <legend data-t="budget.source" class="visually-hidden">Source</legend>
      {
        INCOME_SOURCES.map((s, i) => (
          <label class="bp-seg__opt">
            <input type="radio" name="bp-i-source" value={s} class="visually-hidden" checked={i === 0} />
            <span data-t={`budget.src.${s}`}>{SOURCE_LABELS[s]}</span>
          </label>
        ))
      }
    </fieldset>
    <div class="bp-pair">
      <label class="bp-field">
        <span><span data-t="budget.what">What</span> <span data-t="budget.optional" class="muted">(optional)</span></span>
        <input data-t-placeholder="budget.eGOctoberSalary" class="input" type="text" maxlength={WHAT_MAX} autocomplete="off" placeholder="e.g. October salary" data-bp-i-what />
      </label>
      <label class="bp-field">
        <span data-t="budget.date">Date</span>
        <input class="input" type="date" required data-bp-i-day />
      </label>
    </div>
    <label class="bp-check"><input type="checkbox" data-bp-i-repeat /><span data-t="budget.comesEveryMonthOnThis">Comes every month on this day</span></label>
    <label class="bp-check"><input type="checkbox" checked data-bp-i-save /><span data-bp-i-save-label></span></label>
    <button data-t="budget.saveIncome" type="submit" class="btn bp-form__save">Save income</button>
  </form>
  <h3 class="bp-sub" data-bp-i-list-title></h3>
  <ul class="bp-list" role="list" data-bp-i-list></ul>
  <h3 data-t="budget.everyMonth" class="bp-sub" data-bp-ir-title hidden>Every month</h3>
  <ul class="bp-list" role="list" data-bp-ir-list></ul>
</Sheet>

<Sheet id="goals" title="Savings goals" titleKey="budget.savingsGoals">
  <p class="muted bp-intro" data-bp-g-intro></p>
  <ul class="bp-goals" role="list" data-bp-g-list></ul>
  <button type="button" class="btn btn--ghost bp-suggest" data-bp-g-suggest hidden></button>
  <form class="bp-form bp-goal-form" data-bp-g-form hidden>
    <h3 data-t="budget.newGoal" class="bp-sub" data-bp-g-form-title>New goal</h3>
    <label class="bp-field">
      <span data-t="budget.name">Name</span>
      <input data-t-placeholder="budget.eGLaptop" class="input" type="text" maxlength={WHAT_MAX} required autocomplete="off" placeholder="e.g. Laptop" data-bp-g-name />
    </label>
    <div class="bp-pair">
      <label class="bp-field">
        <span data-t="budget.target">Target</span>
        <input class="input" type="number" inputmode="decimal" min="0.01" max={AMOUNT_MAX} step="0.01" required data-bp-g-target />
      </label>
      <label class="bp-field">
        <span data-t="budget.eachMonth">Each month</span>
        <input class="input" type="number" inputmode="decimal" min="0" max={AMOUNT_MAX} step="0.01" data-bp-g-monthly />
      </label>
    </div>
    <label class="bp-field">
      <span><span data-t="budget.by">By</span> <span data-t="budget.optional" class="muted">(optional)</span></span>
      <input class="input" type="month" data-bp-g-by />
    </label>
    <div class="bp-row">
      <button data-t="budget.delete" type="button" class="btn btn--ghost" data-bp-g-delete hidden>Delete</button>
      <button data-t="budget.cancel" type="button" class="btn btn--ghost" data-bp-g-cancel>Cancel</button>
      <button data-t="budget.saveGoal" type="submit" class="btn">Save goal</button>
    </div>
  </form>
  <button data-t="budget.newGoal" type="button" class="btn bp-form__save" data-bp-g-new>New goal</button>
  <form class="bp-form bp-put" data-bp-s-form>
    <h3 data-t="budget.putMoneyAside" class="bp-sub">Put money aside</h3>
    <div class="bp-pair">
      <label class="bp-field">
        <span data-t="budget.for">For</span>
        <select class="input" data-bp-s-goal></select>
      </label>
      <label class="bp-field">
        <span data-t="budget.amount">Amount</span>
        <input class="input" type="number" inputmode="decimal" min="0.01" max={AMOUNT_MAX} step="0.01" required data-bp-s-amount />
      </label>
    </div>
    <button data-t="budget.putAside" type="submit" class="btn btn--ghost">Put aside</button>
  </form>
</Sheet>

<Sheet id="plan" title="Your plan" titleKey="budget.yourPlan">
  <p data-t="budget.howIncomeIsSplitSavings" class="muted bp-intro">How income is split. Savings come off first, when the income comes in.</p>
  <fieldset class="bp-splits">
    <legend data-t="budget.needsWantsSavings" class="bp-sub">Needs · wants · savings</legend>
    {
      SPLITS.map((s) => (
        <label class="bp-seg__opt bp-split">
          <input type="radio" name="bp-split" value={s.join('/')} class="visually-hidden" />
          <strong>{s.join('/')}</strong>
          <span class="muted" data-bp-split-amounts={s.join('/')} />
        </label>
      ))
    }
  </fieldset>
  <h3 data-t="budget.eachCategoryCountsAs" class="bp-sub">Each category counts as</h3>
  <p data-t="budget.mixedAsksEachTimeLike" class="muted bp-intro">Mixed asks each time, like food: groceries are a need, eating out is a want. One expense can always differ.</p>
  <ul class="bp-tags" role="list">
    {
      CATEGORIES.map((c) => (
        <li class="bp-tags__row">
          <span class="bp-tags__name">
            <i style={`background: ${CATEGORY_COLORS[c]}`} aria-hidden="true" />
            <span data-t={`budget.cat.${c}`}>{CATEGORY_LABELS[c]}</span>
          </span>
          <fieldset class="bp-seg bp-seg--small">
            <legend class="visually-hidden" data-t={`budget.cat.${c}`}>{CATEGORY_LABELS[c]} counts as</legend>
            {TAGS.map(([value, label]) => (
              <label class="bp-seg__opt">
                <input type="radio" name={`bp-tag-${c}`} value={value} class="visually-hidden" data-bp-tag={c} />
                <span data-t={`budget.tag.${value}`}>{label}</span>
              </label>
            ))}
          </fieldset>
        </li>
      ))
    }
  </ul>
</Sheet>

<Sheet id="budget-cal" labelledby="bp-cal-title">
  <h2 class="sheet__title bp-cal__title" id="bp-cal-title" data-bp-cal-title></h2>
  <div class="bp-cal__week" aria-hidden="true" data-bp-cal-week></div>
  <div class="bp-cal__grid" data-bp-cal-grid></div>
  <ul class="bp-cal__key muted" role="list" data-bp-cal-key></ul>
  <div class="bp-cal__day" aria-live="polite" data-bp-cal-day></div>
  <div class="bp-cal__stats" data-bp-cal-stats></div>
</Sheet>

<p class="visually-hidden" aria-live="polite" data-bp-live></p>

<script>
  import { cleanups, listen, onPage } from '../lib/page';
  import { subscribe } from '../lib/storage';
  import {
    addIncome,
    addSave,
    categoryShort,
    categoryTag,
    currencySign,
    needLabel,
    daysInMonth,
    formatMoney,
    getBudget,
    monthOf,
    monthPlan,
    needOf,
    removeGoal,
    removeIncome,
    removeIncomeRepeat,
    repeatDay,
    saveGoal,
    savedFor,
    sourceLabel,
    setPlan,
    shiftMonth,
    type Category,
    type CategoryTag,
    type Goal,
    type IncomeSource,
    type MonthKey,
    type Split,
  } from '../lib/budget';
  import { dayKey, formatDay, fromDayKey } from '../lib/dates';
  import { el } from '../lib/dom';
  import { offerUndo } from '../lib/undo';
  import { dateFormat, t, tn } from '../lib/i18n';

  const monthName = dateFormat({ month: 'long' });
  const monthLong = dateFormat({ month: 'long', year: 'numeric' });
  const weekday = dateFormat({ weekday: 'short' });
  const CROSS =
    '<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>';

  onPage('budget-plan', () => {
    const found = document.querySelector<HTMLElement>('[data-bplan]');
    if (!found) return;
    const card = found;
    const c = cleanups();
    const $ = <E extends Element = HTMLElement>(s: string) => document.querySelector<E>(s)!;
    const $$ = <E extends Element = HTMLElement>(s: string) => [...document.querySelectorAll<E>(s)];
    const today = () => dayKey(new Date());
    let month: MonthKey = monthOf(today());
    /** The day picked in the calendar. */
    let picked: string | null = null;
    /** Removals still offered for Undo. */
    const removing = new Set<string>();

    const setText = (sel: string, text: string) => ($(sel).textContent = text);
    const announce = (text: string) => {
      const live = $('[data-bp-live]');
      live.textContent = '';
      window.setTimeout(() => (live.textContent = text), 50);
    };
    const store = () => {
      const s = getBudget();
      return {
        ...s,
        incomes: s.incomes.filter((i) => !removing.has(i.id)),
        incomeRepeats: s.incomeRepeats.filter((r) => !removing.has(r.id)),
        goals: s.goals.filter((g) => !removing.has(g.id)),
      };
    };
    const whole = (n: number, sign: string) => formatMoney(Math.round(n), sign, 0);

    function iconButton(label: string, onClick: () => void): HTMLButtonElement {
      const b = el('button', 'icon-btn');
      b.type = 'button';
      b.setAttribute('aria-label', label);
      b.innerHTML = CROSS;
      b.addEventListener('click', onClick);
      return b;
    }

    /** Days with nothing spent (bills left out) up to today, and the longest run of them. */
    function noSpend(byDay: number[], upto: number): { days: number; best: number } {
      let days = 0;
      let run = 0;
      let best = 0;
      for (let i = 0; i < upto; i++) {
        if (byDay[i] === 0) {
          days++;
          best = Math.max(best, ++run);
        } else run = 0;
      }
      return { days, best };
    }

    // ---- The card ----
    function render(): void {
      const s = store();
      const sign = s.currency;
      const p = monthPlan(s, month, today());
      const current = month === monthOf(today());
      const name = monthName.format(fromDayKey(`${month}-01`));
      const planned = p.income > 0;
      card.querySelector<HTMLElement>('[data-bp-empty]')!.hidden = planned;
      card.querySelector<HTMLElement>('[data-bp-main]')!.hidden = !planned;
      document.querySelector('[data-budget]')?.toggleAttribute('data-planned', planned);
      setText('#bp-label-empty', current ? t('budget.planTheMonth') : t('budget.p.nothingCameIn', { month: name }));

      if (planned) {
        const keep = Math.max(p.saved, p.planned.savings);
        if (current) {
          const over = p.leftToday < 0;
          setText('[data-bp-label]', over ? t('budget.p.overToday') : `${t('budget.p.safeToday')} · ${formatDay(fromDayKey(today()))}`);
          setText('[data-bp-big]', whole(Math.abs(over ? p.leftToday : Math.max(0, p.leftToday)), sign));
          $('[data-bp-big]').classList.toggle('is-over', over || p.free < 0);
          const bills = p.billsLater ? t('budget.v.afterBills', { amount: whole(p.billsLater, sign) }) : '';
          setText(
            '[data-bp-line]',
            p.free > 0
              ? t('budget.p.leftFor', { amount: whole(p.free - p.spentToday, sign), days: tn('budget.v.days', p.daysLeft) }) + bills
              : t('budget.p.overPlan', { amount: whole(-p.free, sign), month: name }) + bills,
          );
        } else {
          const left = p.income - keep - p.spent;
          setText('[data-bp-label]', left >= 0 ? t('budget.p.leftFrom', { month: name }) : t('budget.p.overIn', { month: name }));
          setText('[data-bp-big]', whole(Math.abs(left), sign));
          $('[data-bp-big]').classList.toggle('is-over', left < 0);
          setText('[data-bp-line]', t('budget.p.cameIn', { income: whole(p.income, sign), spent: whole(p.spent, sign) }));
        }
        setText(
          '[data-bp-saved]',
          p.saved
            ? t('budget.p.putInSavings', { amount: whole(p.saved, sign) }) +
              (p.saved < p.planned.savings ? t('budget.p.stillToPut', { amount: whole(p.planned.savings - p.saved, sign) }) : '')
            : t('budget.p.toPutInSavings', { amount: whole(p.planned.savings, sign) }),
        );
        const [n, w, sv] = s.plan.split;
        const bars = [
          { label: t('budget.p.needs'), savings: false, got: p.needs, of: p.planned.needs, pct: n, color: 'var(--cat-visual)' },
          { label: t('budget.p.wants'), savings: false, got: p.wants, of: p.planned.wants, pct: w, color: 'var(--cat-reward)' },
          { label: t('budget.p.savings'), savings: true, got: p.saved, of: p.planned.savings, pct: sv, color: 'var(--cat-structure)' },
        ];
        $('[data-bp-bars]').replaceChildren(
          ...bars.map((b) => {
            const li = el('li', 'bp__bar');
            const head = el('span', 'bp__bar-head');
            const over = !b.savings && b.got > b.of;
            head.append(el('strong', '', b.label), el('span', over ? 'bp__over' : 'muted', `${whole(b.got, sign)} / ${whole(b.of, sign)} · ${b.pct}%`));
            const track = el('span', 'bp__track');
            const fill = el('i');
            fill.style.width = `${b.of ? Math.min(100, (b.got / b.of) * 100) : 0}%`;
            fill.style.background = over ? 'var(--color-danger)' : b.color;
            track.append(fill);
            li.append(head, track);
            return li;
          }),
        );
        const unsorted = $('[data-bp-unsorted]');
        unsorted.hidden = !p.unsorted;
        unsorted.textContent = t('budget.p.unsorted', { amount: whole(p.unsorted, sign), ask: t('budget.needOrWant') });
        const goals = s.goals.filter((g) => g.deletedAt === undefined);
        setText('[data-bp-goals]', goals.length ? `${goals.length} · ${whole(savedFor(s.saves, '') + goals.reduce((a, g) => a + savedFor(s.saves, g.id), 0), sign)}` : t('budget.p.addOne'));
        setText('[data-bp-split]', s.plan.split.join('/'));
        const upto = current ? Number(today().slice(8)) : daysInMonth(month);
        const ns = noSpend(p.byDay, upto);
        setText('[data-bp-nospend]', `${ns.days}${ns.best > 1 ? ` · ${t('budget.p.bestRun', { n: ns.best })}` : ''}`);
      }
      renderIncome();
      renderGoals();
      renderPlan();
      renderCalendar();
    }

    // ---- Income ----
    const iForm = $<HTMLFormElement>('[data-bp-i-form]');
    const iAmount = $<HTMLInputElement>('[data-bp-i-amount]');
    const iDay = $<HTMLInputElement>('[data-bp-i-day]');

    function renderIncome(): void {
      const s = store();
      const sign = s.currency;
      setText('[data-bp-sign]', currencySign(sign));
      setText('[data-bp-i-save-label]', t('budget.p.saveFirst', { pct: s.plan.split[2] }) + (s.goals.length ? t('budget.p.sharedOverGoals') : ''));
      const name = monthName.format(fromDayKey(`${month}-01`));
      const mine = s.incomes.filter((i) => monthOf(i.day) === month);
      setText('[data-bp-i-list-title]', mine.length ? t('budget.p.inMonth', { month: name }) : t('budget.p.nothingInMonth', { month: name }));
      $('[data-bp-i-list]').replaceChildren(
        ...mine.map((i) => {
          const li = el('li', 'bp-list__row');
          const main = el('span', 'bp-list__main');
          main.append(el('strong', '', i.what), el('span', 'muted', [formatDay(fromDayKey(i.day)), sourceLabel(i.source), i.repeatId ? t('budget.p.monthly') : ''].filter(Boolean).join(' · ')));
          li.append(
            main,
            el('span', 'bp-list__amount', `+${formatMoney(i.amount, sign)}`),
            iconButton(t('budget.p.deleteWhat', { what: i.what }), () => {
              removing.add(i.id);
              render();
              offerUndo({
                message: t('budget.v.deleted', { what: i.what }),
                commit: () => {
                  removing.delete(i.id);
                  removeIncome(i.id);
                },
                undo: () => {
                  removing.delete(i.id);
                  render();
                },
              });
            }),
          );
          return li;
        }),
      );
      const repeats = s.incomeRepeats;
      $('[data-bp-ir-title]').hidden = !repeats.length;
      $('[data-bp-ir-list]').replaceChildren(
        ...repeats.map((r) => {
          const li = el('li', 'bp-list__row');
          const main = el('span', 'bp-list__main');
          main.append(el('strong', '', r.what), el('span', 'muted', `${t('budget.p.day', { n: r.dayOfMonth })} · ${sourceLabel(r.source)}${r.saveFirst ? ` · ${t('budget.p.savingsFirst')}` : ''}`));
          li.append(
            main,
            el('span', 'bp-list__amount', `+${formatMoney(r.amount, sign)}`),
            iconButton(t('budget.p.stopWhat', { what: r.what }), () => {
              removing.add(r.id);
              render();
              offerUndo({
                message: t('budget.p.stoppedRepeating', { what: r.what }),
                commit: () => {
                  removing.delete(r.id);
                  removeIncomeRepeat(r.id);
                },
                undo: () => {
                  removing.delete(r.id);
                  render();
                },
              });
            }),
          );
          return li;
        }),
      );
    }

    function fillIncome(): void {
      iForm.reset();
      iDay.value = month === monthOf(today()) ? today() : `${month}-01`;
      renderIncome();
    }

    c.add(listen($('[data-sheet="income"]'), 'sheet:open', fillIncome));
    c.add(
      listen(iForm, 'submit', (e) => {
        e.preventDefault();
        const source = ($<HTMLInputElement>('input[name="bp-i-source"]:checked')?.value ?? 'salary') as IncomeSource;
        const income = addIncome(
          { what: $<HTMLInputElement>('[data-bp-i-what]').value, source, amount: Number(iAmount.value), day: iDay.value },
          { repeat: $<HTMLInputElement>('[data-bp-i-repeat]').checked, saveFirst: $<HTMLInputElement>('[data-bp-i-save]').checked },
        );
        if (!income) return;
        month = monthOf(income.day);
        announce(t('budget.v.added', { what: income.what, amount: formatMoney(income.amount, getBudget().currency) }));
        $<HTMLDialogElement>('[data-sheet="income"]').close();
      }),
    );

    // ---- Goals ----
    const gForm = $<HTMLFormElement>('[data-bp-g-form]');
    let editingGoal: Goal | null = null;

    function renderGoals(): void {
      const s = store();
      const sign = s.currency;
      const goals = s.goals;
      const loose = savedFor(s.saves, '');
      const p = monthPlan(s, month, today());
      const monthly = goals.reduce((a, g) => a + g.monthly, 0);
      setText(
        '[data-bp-g-intro]',
        p.planned.savings
          ? t('budget.p.goalsIntro', { amount: whole(p.planned.savings, sign), pct: s.plan.split[2] }) +
            (monthly > p.planned.savings ? ' ' + t('budget.p.theyAsk', { amount: whole(monthly, sign) }) : '')
          : t('budget.p.goalsIntroNone'),
      );
      const now = monthOf(today());
      $('[data-bp-g-list]').replaceChildren(
        ...goals.map((g) => {
          const saved = savedFor(s.saves, g.id);
          const li = el('li', 'bp-goal');
          const head = el('span', 'bp-goal__head');
          head.append(el('strong', '', g.name), el('span', 'muted', `${whole(saved, sign)} / ${whole(g.target, sign)}`));
          const track = el('span', 'bp__track');
          const fill = el('i');
          fill.style.width = `${Math.min(100, (saved / g.target) * 100)}%`;
          fill.style.background = 'var(--cat-structure)';
          track.append(fill);
          let note = g.monthly ? t('budget.p.aMonth', { amount: whole(g.monthly, sign) }) : t('budget.p.noMonthly');
          let behind = false;
          if (saved >= g.target) note = t('budget.p.reached');
          else if (g.by) {
            let months = 0;
            for (let m = now; m <= g.by && months < 600; m = shiftMonth(m, 1)) months++;
            const need = months ? (g.target - saved) / months : g.target - saved;
            const by = monthLong.format(fromDayKey(`${g.by}-01`));
            behind = g.monthly < need;
            note += ' · ' + (behind ? t('budget.p.behind', { amount: whole(need, sign), by }) : t('budget.p.onTrackFor', { by }));
          }
          const edit = el('button', 'btn btn--ghost btn--small', t('budget.p.change'));
          edit.type = 'button';
          edit.addEventListener('click', () => openGoal(g));
          const foot = el('span', 'bp-goal__foot');
          foot.append(el('span', behind ? 'bp__over' : 'muted', note), edit);
          li.append(head, track, foot);
          return li;
        }),
        ...(loose ? [el('li', 'bp-goal bp-goal--loose', t('budget.p.looseSaved', { amount: whole(loose, sign) }))] : []),
      );
      const suggest = $<HTMLButtonElement>('[data-bp-g-suggest]');
      const needs = Math.max(p.needs, p.planned.needs);
      suggest.hidden = goals.length > 0 || !needs;
      suggest.textContent = t('budget.p.suggest', { amount: whole(needs * 3, sign) });
      suggest.dataset.target = String(Math.round(needs * 3));
      const select = $<HTMLSelectElement>('[data-bp-s-goal]');
      const was = select.value;
      select.replaceChildren(
        ...goals.map((g) => new Option(g.name, g.id)),
        new Option(t('budget.p.noGoal'), ''),
      );
      select.value = [...select.options].some((o) => o.value === was) ? was : (goals[0]?.id ?? '');
    }

    function openGoal(goal: Goal | null, preset?: { name: string; target: number }): void {
      editingGoal = goal;
      gForm.hidden = false;
      $('[data-bp-g-new]').hidden = true;
      setText('[data-bp-g-form-title]', goal ? t('budget.p.changeGoal') : t('budget.newGoal'));
      $<HTMLInputElement>('[data-bp-g-name]').value = goal?.name ?? preset?.name ?? '';
      $<HTMLInputElement>('[data-bp-g-target]').value = String(goal?.target ?? preset?.target ?? '');
      $<HTMLInputElement>('[data-bp-g-monthly]').value = goal?.monthly ? String(goal.monthly) : '';
      $<HTMLInputElement>('[data-bp-g-by]').value = goal?.by ?? '';
      $('[data-bp-g-delete]').hidden = !goal;
      $<HTMLInputElement>('[data-bp-g-name]').focus();
    }

    function closeGoal(): void {
      editingGoal = null;
      gForm.hidden = true;
      $('[data-bp-g-new]').hidden = false;
    }

    c.add(
      listen($('[data-sheet="goals"]'), 'sheet:open', () => {
        closeGoal();
        // Money put aside goes to the first goal unless you pick another.
        const select = $<HTMLSelectElement>('[data-bp-s-goal]');
        select.value = store().goals[0]?.id ?? '';
      }),
    );
    c.add(listen($('[data-bp-g-new]'), 'click', () => openGoal(null)));
    c.add(listen($('[data-bp-g-cancel]'), 'click', closeGoal));
    c.add(
      listen($('[data-bp-g-suggest]'), 'click', () => openGoal(null, { name: t('budget.p.emergencyFund'), target: Number($('[data-bp-g-suggest]').dataset.target) })),
    );
    c.add(
      listen(gForm, 'submit', (e) => {
        e.preventDefault();
        const goal = saveGoal(
          {
            name: $<HTMLInputElement>('[data-bp-g-name]').value,
            target: Number($<HTMLInputElement>('[data-bp-g-target]').value),
            monthly: Number($<HTMLInputElement>('[data-bp-g-monthly]').value) || 0,
            by: $<HTMLInputElement>('[data-bp-g-by]').value || null,
          },
          editingGoal?.id,
        );
        if (!goal) return;
        announce(t('budget.p.savedGoal', { name: goal.name }));
        closeGoal();
      }),
    );
    c.add(
      listen($('[data-bp-g-delete]'), 'click', () => {
        const goal = editingGoal;
        closeGoal();
        if (!goal) return;
        removing.add(goal.id);
        render();
        offerUndo({
          message: t('budget.p.deletedGoal', { name: goal.name }),
          commit: () => {
            removing.delete(goal.id);
            removeGoal(goal.id);
          },
          undo: () => {
            removing.delete(goal.id);
            render();
          },
        });
      }),
    );
    c.add(
      listen($('[data-bp-s-form]'), 'submit', (e) => {
        e.preventDefault();
        const amount = $<HTMLInputElement>('[data-bp-s-amount]');
        const save = addSave($<HTMLSelectElement>('[data-bp-s-goal]').value, Number(amount.value));
        if (!save) return;
        amount.value = '';
        announce(t('budget.p.putAsideDone', { amount: formatMoney(save.amount, getBudget().currency) }));
      }),
    );

    // ---- The plan: split and tags, saved as you change them ----
    function renderPlan(): void {
      const s = store();
      const p = monthPlan(s, month, today());
      const split = s.plan.split.join('/');
      for (const r of $$<HTMLInputElement>('input[name="bp-split"]')) r.checked = r.value === split;
      for (const span of $$<HTMLElement>('[data-bp-split-amounts]')) {
        const parts = span.dataset.bpSplitAmounts!.split('/').map(Number);
        span.textContent = p.income ? parts.map((n) => whole((p.income * n) / 100, s.currency)).join(' · ') : '';
      }
      for (const r of $$<HTMLInputElement>('[data-bp-tag]')) r.checked = r.value === categoryTag(s.plan, r.dataset.bpTag as Category);
    }

    c.add(
      listen($('[data-sheet="plan"]'), 'change', (e) => {
        const x = e.target as HTMLInputElement;
        const plan = getBudget().plan;
        if (x.name === 'bp-split') setPlan({ ...plan, split: x.value.split('/').map(Number) as Split });
        else if (x.dataset.bpTag) setPlan({ ...plan, tags: { ...plan.tags, [x.dataset.bpTag]: x.value as CategoryTag } });
        announce(t('budget.p.planSaved'));
      }),
    );

    // ---- Calendar: each day against the day's share, no-spend days and bills ----
    function renderCalendar(): void {
      const s = store();
      const sign = s.currency;
      const p = monthPlan(s, month, today());
      const days = daysInMonth(month);
      const current = month === monthOf(today());
      const upto = month < monthOf(today()) ? days : current ? Number(today().slice(8)) : 0;
      // The day's share of the month: income less savings and all the bills, over the days.
      const bills = p.billsByDay.reduce((a, b) => a + b, 0);
      const share = p.income ? (p.income - Math.max(p.saved, p.planned.savings) - bills) / days : 0;
      setText('[data-bp-cal-title]', monthLong.format(fromDayKey(`${month}-01`)));
      const first = fromDayKey(`${month}-01`);
      const lead = (first.getDay() + 6) % 7;
      $('[data-bp-cal-week]').replaceChildren(
        ...Array.from({ length: 7 }, (_, i) => el('span', '', weekday.format(new Date(2024, 0, 1 + i)))),
      );
      if (!picked || monthOf(picked) !== month) picked = current ? today() : `${month}-01`;
      const cells: HTMLElement[] = Array.from({ length: lead }, () => el('span'));
      for (let d = 1; d <= days; d++) {
        const key = `${month}-${String(d).padStart(2, '0')}`;
        const spent = p.byDay[d - 1] ?? 0;
        const past = d <= upto;
        const bill = p.billsByDay[d - 1] ?? 0;
        const b = el('button', 'bp-cal__cell');
        b.type = 'button';
        if (past) b.classList.add(spent === 0 ? 'is-none' : share && spent > share ? 'is-over' : 'is-under');
        else b.classList.add('is-later');
        if (bill) b.classList.add('has-bill');
        b.setAttribute('aria-pressed', String(key === picked));
        const amount = past ? (spent ? whole(spent, sign) : '—') : bill ? t('budget.p.bill') : '';
        b.append(el('strong', '', String(d)), el('span', '', amount));
        b.setAttribute('aria-label', `${formatDay(fromDayKey(key))}: ${past ? (spent ? formatMoney(spent, sign) : t('budget.p.noSpendLower')) : bill ? t('budget.p.billDueLower') : t('budget.p.toCome')}`);
        b.addEventListener('click', () => {
          picked = key;
          renderCalendar();
        });
        cells.push(b);
      }
      $('[data-bp-cal-grid]').replaceChildren(...cells);
      $('[data-bp-cal-key]').replaceChildren(
        ...[
          ['is-under', share ? t('budget.p.under', { amount: whole(share, sign) }) : t('budget.p.spent')],
          ...(share ? [['is-over', t('budget.p.over')]] : []),
          ['is-none', t('budget.p.noSpend')],
          ['has-bill', t('budget.p.billDue')],
        ].map(([cls, text]) => {
          const li = el('li');
          li.append(el('i', `bp-cal__swatch ${cls}`), document.createTextNode(text!));
          return li;
        }),
      );

      // The picked day.
      const day = $('[data-bp-cal-day]');
      const entries = s.entries.filter((e) => e.deletedAt === undefined && e.day === picked);
      const incomes = s.incomes.filter((i) => i.day === picked);
      const dueBills = picked! > today() ? s.repeats.filter((r) => r.deletedAt === undefined && r.from <= month && repeatDay(r, month) === picked) : [];
      const rows: [string, string][] = [
        ...entries.map((e): [string, string] => {
          const need = needOf(e, s.plan);
          return [`${e.what} · ${categoryShort(e.category)}${need ? ` · ${needLabel(need)}` : ''}${e.repeatId ? ` · ${t('budget.p.bill')}` : ''}`, formatMoney(e.amount, sign)];
        }),
        ...incomes.map((i): [string, string] => [`${i.what} · ${t('budget.p.incomeLower')}`, `+${formatMoney(i.amount, sign)}`]),
        ...dueBills.map((r): [string, string] => [`${r.what} · ${t('budget.p.billDueLower')}`, formatMoney(r.amount, sign)]),
      ];
      const pickedDate = fromDayKey(picked!);
      const titleText = `${formatDay(pickedDate)}${picked === today() ? ` · ${t('budget.p.todayLower')}` : ''}`;
      day.replaceChildren(el('strong', '', titleText));
      if (!rows.length) day.append(el('span', 'muted', picked! <= today() ? t('budget.p.noSpendDot') : t('budget.p.nothingPlanned')));
      for (const [what, amount] of rows) {
        const row = el('span', 'bp-cal__row');
        row.append(el('span', '', what), el('strong', '', amount));
        day.append(row);
      }

      const ns = noSpend(p.byDay, upto);
      const over = share ? p.byDay.slice(0, upto).filter((v) => v > share).length : 0;
      const stat = (label: string, value: string) => {
        const d = el('div');
        d.append(el('span', 'muted', label), el('strong', '', value));
        return d;
      };
      $('[data-bp-cal-stats]').replaceChildren(
        stat(t('budget.noSpendDays'), `${ns.days}${ns.best > 1 ? ` · ${t('budget.p.bestRun', { n: ns.best })}` : ''}`),
        ...(share ? [stat(t('budget.p.overAmount', { amount: whole(share, sign) }), tn('budget.v.days', over))] : []),
        stat(t('budget.p.billsLeft'), whole(p.billsLater, sign)),
      );
    }

    c.add(
      listen(card.querySelector('[data-bp-expense]')!, 'click', () => document.querySelector<HTMLButtonElement>('[data-bv-add]')?.click()),
    );
    c.add(
      listen(document, 'budget:month', (e) => {
        month = (e as CustomEvent<MonthKey>).detail;
        render();
      }),
    );
    c.add(subscribe('health', render));
    c.add(listen(document, 'budget:refresh', render));
    render();
    return c.run;
  });
</script>

<!-- Global: most of what is styled here is built by the script, which scoped styles miss. Every class starts with bp. -->
