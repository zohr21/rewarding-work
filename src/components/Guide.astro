---
/**
 * Help, on every page (BaseLayout, not on bare pages like Welcome). Four layers, each optional:
 *
 * - Tours (src/lib/tours.ts): a spotlight on one real thing at a time. In the app a tour starts
 *   by itself the first time a screen, or one of its tabs, is opened; tabs not seen yet get a
 *   dot. Never while the timer runs. `?tour=<id>` starts one.
 * - Tips & tricks (src/lib/help.ts): `?tip=<id>` opens the page with a spotlight on the thing.
 * - Playbooks: one goal in a few steps across screens, with progress from your own data.
 * - "Did you know?": one tip a day at most, picked from what you do, shown on Today
 *   ([data-help-nudge]) and when a session ends ([data-done-tip] in TimerWidget).
 *
 * The ? in the header opens help for this screen; the guides sheet (also under You › Help)
 * holds everything, with search.
 */
import Sheet from './Sheet.astro';
import { NATIVE_APP } from '../config/app';
import { url } from '../lib/paths';
import { en } from '../lib/i18n/en';
import { AREAS, areaKey, tourSlots } from '../lib/tours';
import { helpSlots } from '../lib/help';

// Build-time check: the tours, tips and playbooks are written in English in code and found by
// keys made from their ids, so en.ts must say exactly the same for every line.
const words = en as Record<string, unknown>;
for (const [o, field, key] of [...tourSlots(), ...helpSlots()]) {
  const said = (o as Record<string | number, unknown>)[field];
  if (words[key] !== said) throw new Error(`Help: en.ts '${key}' must be ${JSON.stringify(said)} (as in tours.ts / help.ts). Update ru.ts and az.ts too.`);
}
for (const a of AREAS) if (words[areaKey(a)] !== a) throw new Error(`Help: en.ts has no '${areaKey(a)}': '${a}'.`);
---

<Sheet id="help" labelledby="help-title">
  <div class="guide" data-help>
    <h2 data-t="guide.help" id="help-title" class="guide__title" data-help-title>Help</h2>
    <button type="button" class="guide__tour" data-help-tour hidden>
      <span class="guide__play" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="18" height="18"><path d="M8 5l11 7-11 7z" fill="currentColor"></path></svg>
      </span>
      <span class="guide__tour-text">
        <strong data-t="guide.showMeAround">Show me around</strong>
        <small data-help-tour-sub></small>
      </span>
    </button>
    <div class="guide__block" data-help-tabs-wrap hidden>
      <h3 data-t="guide.eachTab" class="guide__label">Each tab</h3>
      <ul class="guide__list" data-help-tabs></ul>
    </div>
    <div class="guide__block" data-help-tips-wrap hidden>
      <h3 data-t="guide.tipsForThisScreen" class="guide__label">Tips for this screen</h3>
      <div class="guide__cards" data-help-tips></div>
    </div>
    <div class="guide__block guide__faq" data-help-faq-wrap hidden>
      <h3 data-t="guide.quickAnswers" class="guide__label">Quick answers</h3>
      <div data-help-faq></div>
    </div>
    <button data-t="guide.allToursTipsAndPlaybooks" type="button" class="btn btn--ghost guide__all" data-sheet-open="guides">All tours, tips and playbooks</button>
  </div>
</Sheet>

<Sheet id="guides" title="Help & guides" titleKey="guide.helpAndGuides">
  <div class="guide" data-guides>
    <label class="guide__search">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="2"></circle><path d="M16 16l4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
      <span data-t="guide.searchHelp" class="visually-hidden">Search help</span>
      <input data-t-placeholder="guide.searchHelpEGExam" type="search" placeholder="Search help, e.g. exam or bank" autocomplete="off" data-guides-q />
    </label>

    <div data-t-aria-label="guide.kindOfHelp" class="guide__kinds" role="group" aria-label="Kind of help" data-guides-kinds>
      <button data-t="guide.tours" type="button" aria-pressed="true" data-guides-kind="tours">Tours</button>
      <button data-t="guide.playbooks" type="button" aria-pressed="false" data-guides-kind="playbooks">Playbooks</button>
      <button data-t="guide.tips" type="button" aria-pressed="false" data-guides-kind="tips">Tips</button>
    </div>

    <div class="guide__block" data-guides-results hidden></div>

    <section class="guide__block" data-guides-panel="tours">
      <div class="guide__block" data-guides-tours></div>
      <h3 data-t="guide.settings" class="guide__label">Settings</h3>
      <div class="guide__list">
        {
          NATIVE_APP && (
            <a class="guide__row" href={url('/welcome')}>
              <span class="guide__row-main">
                <span data-t="guide.seeWelcomeAgain">See Welcome again</span><small data-t="guide.pickYourSections">Pick your sections</small>
              </span>
            </a>
          )
        }
        {
          NATIVE_APP && (
            <label class="guide__row">
              <span class="guide__row-main">
                <span data-t="guide.toursOnNewScreens">Tours on new screens</span><small data-t="guide.aShortTourTheFirst">A short tour the first time you open a screen or tab</small>
              </span>
              <input type="checkbox" role="switch" data-guides-auto />
            </label>
          )
        }
        <label class="guide__row">
          <span class="guide__row-main">
            <span data-t="guide.didYouKnow">Did you know?</span><small data-t="guide.oneTipAtATime">One tip at a time, picked from what you do</small>
          </span>
          <input type="checkbox" role="switch" data-guides-nudges />
        </label>
      </div>
      <button data-t="guide.showEveryTourAndTip" type="button" class="btn btn--ghost guide__all" data-guides-reset>Show every tour and tip again</button>
      <p data-t="guide.whatYouHaveSeenIs" class="guide__note muted">What you have seen is kept on this device.</p>
    </section>

    <section class="guide__block" data-guides-panel="playbooks" hidden>
      <div class="guide__block" data-guides-books>
        <p data-t="guide.pickAGoalEachPlaybook" class="muted guide__intro">Pick a goal. Each playbook walks you through the screens that help with it.</p>
        <ul class="guide__list" data-guides-book-list></ul>
      </div>
      <div class="guide__block" data-guides-book hidden></div>
    </section>

    <section class="guide__block" data-guides-panel="tips" hidden>
      <div data-t-aria-label="guide.area" class="guide__chips" role="group" aria-label="Area" data-guides-areas></div>
      <div class="guide__cards" data-guides-tips></div>
    </section>
  </div>
</Sheet>

<script>
  import { NATIVE_APP } from '../config/app';
  import { getProfile, getTours, setTours } from '../lib/profile';
  import { AREAS, TOURS, areaLabel, pathOf, tabToursFor, tourById, tourFor, type Area, type Tour } from '../lib/tours';
  import { t, tn } from '../lib/i18n';
  import { PLAYBOOKS, TIPS, areaOn, helpContext, pickNudge, playbookById, stepDone, tipById, type Playbook, type Tip } from '../lib/help';
  import { runSpotlight, stopSpotlight, visible } from '../scripts/tour-engine';
  import { readJson } from '../lib/storage';
  import { dayKey } from '../lib/dates';
  import { url } from '../lib/paths';
  import { el } from '../lib/dom';
  import { cleanups, listen, onPage } from '../lib/page';
  import { navigate } from 'astro:transitions/client';

  const wait = (ms: number) => new Promise<void>((r) => setTimeout(r, ms));

  function timerRunning(): boolean {
    try {
      const t = JSON.parse(readJson('timer') ?? 'null') as { status?: string; phase?: string } | null;
      return t?.status === 'running';
    } catch {
      return false;
    }
  }

  const modules = () => getProfile().modules;
  const tourOn = (t: Tour) => !t.module || modules()[t.module];
  const tipOn = (t: Tip) => areaOn(t.area, modules()) && (!t.appOnly || NATIVE_APP);
  const bookOn = (p: Playbook) => !p.module || modules()[p.module];

  function markSeen(id: string): void {
    const t = getTours();
    if (!t.seen.includes(id)) setTours({ seen: [...t.seen, id] });
  }

  /** Open a tab first when the thing lives on one. */
  async function openTab(selector?: string): Promise<void> {
    if (!selector) return;
    const tab = document.querySelector<HTMLElement>(selector);
    if (tab && tab.getAttribute('aria-selected') !== 'true') {
      tab.click();
      await wait(300);
    }
  }

  async function runTour(tour: Tour): Promise<void> {
    markSeen(tour.id);
    await openTab(tour.tab);
    runSpotlight({ name: t('guide.s.tourName', { name: tour.name }), steps: tour.steps, sayWhere: true });
  }

  async function runTip(tip: Tip): Promise<void> {
    if (!tip.show) return;
    await openTab(tip.show.tab);
    const step = { title: tip.title, text: tip.text };
    // When the thing isn't on screen right now (locked, no data yet), still say the tip.
    const name = t('guide.s.tip');
    if (!tip.show.target || !runSpotlight({ name, steps: [{ ...step, target: tip.show.target }] }))
      runSpotlight({ name, steps: [{ ...step, target: '[data-guide-help]' }] });
  }

  const tourHref = (t: Tour) => url(`${t.path}?tour=${t.id}`);
  const tipHref = (t: Tip) => (t.show ? url(`${t.show.path}?tip=${t.id}`) : null);

  /** A tip as a card: area, title, text, Show me. */
  function tipCard(tip: Tip): HTMLElement {
    const card = el('article', 'guide-card');
    card.append(el('span', 'guide-card__area', areaLabel(tip.area)), el('h4', 'guide-card__title', tip.title), el('p', 'guide-card__text', tip.text));
    const href = tipHref(tip);
    if (href) {
      const a = el('a', 'guide-card__go', t('guide.s.showMe'));
      a.href = href;
      a.setAttribute('aria-label', t('guide.s.showMeWhat', { what: tip.title }));
      card.append(a);
    }
    return card;
  }

  function row(href: string | null, title: string, sub: string, go: string, isNew = false): HTMLElement {
    const r = href ? el('a', 'guide__row') : el('div', 'guide__row');
    if (r instanceof HTMLAnchorElement && href) r.href = href;
    const dot = el('span', `guide__dot${isNew ? ' is-new' : ''}`);
    dot.setAttribute('aria-hidden', 'true');
    const main = el('span', 'guide__row-main', title);
    main.append(el('small', '', sub));
    r.append(dot, main, el('span', `guide__go${isNew ? ' is-new' : ''}`, go));
    return r;
  }

  function tourRow(tour: Tour): HTMLElement {
    const seen = getTours().seen.includes(tour.id);
    const li = el('li');
    li.append(
      row(
        tourHref(tour),
        tour.name,
        `${seen ? t('guide.s.seen') : t('guide.s.new')} · ${tn('guide.s.nTips', tour.steps.length)}`,
        seen ? t('guide.s.replay') : t('guide.s.start'),
        !seen,
      ),
    );
    return li;
  }

  /* ---------- Starting tours and tips ---------- */

  onPage('guide-tour', () => {
    const c = cleanups();
    const params = new URLSearchParams(location.search);
    const askedTour = params.get('tour');
    const askedTip = params.get('tip');
    if (askedTour || askedTip) {
      params.delete('tour');
      params.delete('tip');
      const q = params.toString();
      history.replaceState(history.state, '', `${location.pathname}${q ? `?${q}` : ''}${location.hash}`);
    }

    const prefs = getTours();
    const auto = NATIVE_APP && getProfile().welcomed && !prefs.off;
    const page = tourFor(location.pathname);
    const tabs = tabToursFor(location.pathname).filter(tourOn);
    const isNew = (t: Tour) => auto && !getTours().seen.includes(t.id);

    // Tabs whose tour hasn't been seen get a small dot.
    const dots = () => {
      for (const t of tabs) document.querySelector<HTMLElement>(t.tab!)?.toggleAttribute('data-tour-new', isNew(t));
    };
    dots();
    c.add(() => tabs.forEach((t) => document.querySelector(t.tab!)?.removeAttribute('data-tour-new')));

    const later = (fn: () => void, ms = 700) => {
      const id = setTimeout(() => {
        if (!document.querySelector('dialog[open]')) fn();
      }, ms);
      c.add(() => clearTimeout(id));
    };

    if (askedTip) {
      const tip = tipById(askedTip);
      if (tip) later(() => void runTip(tip));
    } else if (askedTour) {
      const tour = tourById(askedTour);
      if (tour && tourOn(tour)) later(() => void runTour(tour).then(dots));
    } else if (!timerRunning()) {
      const selected = tabs.find((t) => document.querySelector(t.tab!)?.getAttribute('aria-selected') === 'true');
      const first = page && tourOn(page) && isNew(page) ? page : selected && isNew(selected) ? selected : null;
      if (first) later(() => void runTour(first).then(dots));
    }

    // Opening a tab for the first time starts its tour.
    for (const t of tabs) {
      const tab = document.querySelector<HTMLElement>(t.tab!);
      if (!tab) continue;
      c.add(
        listen(tab, 'click', () => {
          if (!isNew(t) || timerRunning()) return;
          later(() => void runTour(t).then(dots), 350);
        }),
      );
    }
    // Show me / Replay links in the sheets and the nudge. Capture phase, before the router:
    // save first (a store write while the router is navigating cancels it), close the sheet,
    // then run it right here when it's this page, or go there.
    c.add(
      listen(
        document,
        'click',
        (e) => {
          const a = (e.target as HTMLElement).closest?.<HTMLAnchorElement>('a[href]');
          if (!a || !a.closest('[data-sheet="help"], [data-sheet="guides"], [data-help-nudge], [data-done-tip]')) return;
          const to = new URL(a.href, location.href);
          const tip = to.searchParams.get('tip');
          const tour = to.searchParams.get('tour');
          if (!tip && !tour) return;
          e.preventDefault();
          const step = a.dataset.guidesTried;
          const prefs = getTours();
          if (step && !prefs.tried?.includes(step)) setTours({ tried: [...(prefs.tried ?? []), step] });
          const away = a.dataset.guidesAway;
          if (away && !prefs.tips?.includes(away)) setTours({ tips: [...(getTours().tips ?? []), away] });
          a.closest('dialog')?.close();
          if (pathOf(to.pathname) !== pathOf(location.pathname)) return void navigate(to.href);
          const t = tip ? tipById(tip) : null;
          const r = tour ? tourById(tour) : null;
          if (t) later(() => void runTip(t), 250);
          else if (r && tourOn(r)) later(() => void runTour(r).then(dots), 250);
        },
        { capture: true },
      ),
    );
    c.add(stopSpotlight);
    return c.run;
  });

  /* ---------- The ? sheet: this screen ---------- */

  onPage('guide-help', () => {
    const sheet = document.querySelector<HTMLDialogElement>('[data-sheet="help"]');
    if (!sheet) return;
    const $ = <E extends HTMLElement = HTMLElement>(s: string) => sheet.querySelector<E>(s)!;
    const page = tourFor(location.pathname);
    const pageOn = !!page && tourOn(page);
    const tabs = tabToursFor(location.pathname).filter(tourOn);

    const render = () => {
      $('[data-help-title]').textContent = pageOn ? t('guide.s.helpWith', { name: page.name }) : t('guide.help');
      $('[data-help-tour]').hidden = !pageOn;
      if (pageOn) $('[data-help-tour-sub]').textContent = tn('guide.s.tipsOnScreen', page.steps.length);

      $('[data-help-tabs-wrap]').hidden = !tabs.length;
      $('[data-help-tabs]').replaceChildren(...tabs.map(tourRow));

      const areas = new Set<Area>([page, ...tabs].filter((x): x is Tour => !!x).map((x) => x.area));
      const tips = TIPS.filter((tip) => areas.has(tip.area) && tipOn(tip)).slice(0, 4);
      $('[data-help-tips-wrap]').hidden = !tips.length;
      $('[data-help-tips]').replaceChildren(...tips.map(tipCard));

      const faq = [page, ...tabs].filter((x): x is Tour => !!x && tourOn(x)).flatMap((x) => x.faq);
      $('[data-help-faq-wrap]').hidden = !faq.length;
      $('[data-help-faq]').replaceChildren(
        ...faq.map(([q, a]) => {
          const d = el('details', 'guide__q');
          d.append(el('summary', '', q), el('p', 'muted', a));
          return d;
        }),
      );
    };

    const c = cleanups();
    c.add(listen(sheet, 'sheet:open', render));
    c.add(
      listen($('[data-help-tour]'), 'click', () => {
        sheet.close();
        if (page) void runTour(page);
      }),
    );
    render();
    return c.run;
  });

  /* ---------- The guides sheet: everything ---------- */

  onPage('guide-list', () => {
    const sheet = document.querySelector<HTMLDialogElement>('[data-sheet="guides"]');
    if (!sheet) return;
    const $ = <E extends HTMLElement = HTMLElement>(s: string) => sheet.querySelector<E>(s)!;
    const q = $<HTMLInputElement>('[data-guides-q]');
    const kinds = [...sheet.querySelectorAll<HTMLButtonElement>('[data-guides-kind]')];
    const panels = [...sheet.querySelectorAll<HTMLElement>('[data-guides-panel]')];
    const auto = sheet.querySelector<HTMLInputElement>('[data-guides-auto]');
    const nudges = $<HTMLInputElement>('[data-guides-nudges]');
    let kind = 'tours';
    let area: Area | 'All' = 'All';
    let book: string | null = null;

    const renderTours = () => {
      const groups = AREAS.map((a) => [a, TOURS.filter((x) => x.area === a && tourOn(x))] as const).filter(([, ts]) => ts.length);
      $('[data-guides-tours]').replaceChildren(
        ...groups.map(([a, ts]) => {
          const wrap = el('div', 'guide__block');
          const ul = el('ul', 'guide__list');
          ul.append(...ts.map(tourRow));
          wrap.append(el('h3', 'guide__label', areaLabel(a)), ul);
          return wrap;
        }),
      );
      const prefs = getTours();
      if (auto) auto.checked = !prefs.off;
      nudges.checked = !prefs.nudgesOff;
    };

    const renderBooks = () => {
      const ctx = helpContext();
      const tried = getTours().tried ?? [];
      const list = PLAYBOOKS.filter(bookOn);
      $('[data-guides-book-list]').replaceChildren(
        ...list.map((p) => {
          const n = p.steps.filter((s) => stepDone(s, ctx, tried)).length;
          const li = el('li');
          const b = el('button', 'guide__row');
          b.type = 'button';
          b.dataset.guidesOpen = p.id;
          const badge = el('span', `guide__badge${n ? ' is-going' : ''}`, n === p.steps.length ? '✓' : `${n}/${p.steps.length}`);
          badge.setAttribute('aria-hidden', 'true');
          const main = el('span', 'guide__row-main', p.name);
          main.append(el('small', '', `${p.sub} · ${t('guide.s.nOfDone', { n, total: p.steps.length })}`));
          b.append(badge, main);
          li.append(b);
          return li;
        }),
      );
      const open = book ? playbookById(book) : undefined;
      $('[data-guides-books]').hidden = !!open;
      $('[data-guides-book]').hidden = !open;
      if (open) renderBook(open, ctx, tried);
    };

    const renderBook = (p: Playbook, ctx: ReturnType<typeof helpContext>, tried: string[]) => {
      const box = $('[data-guides-book]');
      const back = el('button', 'guide__back', `‹ ${t('guide.s.allPlaybooks')}`);
      back.type = 'button';
      back.dataset.guidesBack = '';
      const n = p.steps.filter((s) => stepDone(s, ctx, tried)).length;
      const bar = el('span', 'guide__bar');
      bar.setAttribute('role', 'progressbar');
      bar.setAttribute('aria-label', t('guide.s.nOfStepsDone', { n, total: p.steps.length }));
      const fill = el('span');
      fill.style.inlineSize = `${(n / p.steps.length) * 100}%`;
      bar.append(fill);
      const ol = el('ol', 'guide__steps');
      p.steps.forEach((s, i) => {
        const ok = stepDone(s, ctx, tried);
        const li = el('li', ok ? 'is-done' : '');
        const mark = el('span', 'guide__step-n', ok ? '✓' : String(i + 1));
        mark.setAttribute('aria-hidden', 'true');
        const main = el('span', 'guide__row-main', s.title);
        main.append(el('small', '', s.how));
        if (ok) main.append(el('span', 'visually-hidden', ` (${t('guide.s.done')})`));
        li.append(mark, main);
        if (!ok) {
          const a = el('a', 'guide-card__go', t('guide.s.showMe'));
          const qs = s.go.tour ? `?tour=${s.go.tour}` : s.go.tip ? `?tip=${s.go.tip}` : '';
          a.href = url(`${s.go.path}${qs}`);
          a.dataset.guidesTried = s.id;
          a.setAttribute('aria-label', t('guide.s.showMeWhat', { what: s.title }));
          li.append(a);
        }
        ol.append(li);
      });
      const why = el('details', 'guide__q guide__why');
      const whyText = el('p', 'muted', p.why);
      why.append(el('summary', '', t('guide.s.whyWorks')), whyText);
      if (p.techniques.length) {
        const more = el('p', 'guide__techs');
        more.append(`${t('guide.s.readMore')} `);
        p.techniques.forEach((tech, i) => {
          const a = el('a', '', tech.name);
          a.href = url(`/techniques/${tech.slug}`);
          more.append(...(i ? [', ', a] : [a]));
        });
        why.append(more);
      }
      const coach = el('a', 'guide__all guide__coach', t('guide.s.stillStuck'));
      coach.href = url('/techniques');
      box.replaceChildren(back, el('h3', 'guide__book-title', p.name), bar, el('p', 'muted guide__count', t('guide.s.nOfDone', { n, total: p.steps.length })), ol, why, coach);
    };

    const renderTips = () => {
      const areas = (['All', ...AREAS] as const).filter((a) => a === 'All' || TIPS.some((tip) => tip.area === a && tipOn(tip)));
      $('[data-guides-areas]').replaceChildren(
        ...areas.map((a) => {
          const b = el('button', 'guide__chip', a === 'All' ? t('guide.s.all') : areaLabel(a));
          b.type = 'button';
          b.dataset.guidesArea = a;
          b.setAttribute('aria-pressed', String(a === area));
          return b;
        }),
      );
      $('[data-guides-tips]').replaceChildren(...TIPS.filter((tip) => tipOn(tip) && (area === 'All' || tip.area === area)).map(tipCard));
    };

    /** Search across tours, playbooks and tips; every word must match. */
    const renderSearch = (text: string) => {
      const words = text.toLowerCase().split(/\s+/).filter(Boolean);
      const hit = (...parts: string[]) => {
        const hay = parts.join(' ').toLowerCase();
        return words.every((w) => hay.includes(w));
      };
      const tours = TOURS.filter((x) => tourOn(x) && hit(x.name, x.area, areaLabel(x.area), ...x.steps.flatMap((s) => [s.title, s.text]), ...x.faq.flat()));
      const books = PLAYBOOKS.filter((p) => bookOn(p) && hit(p.name, p.sub, p.why, ...p.steps.flatMap((s) => [s.title, s.how])));
      const tips = TIPS.filter((tip) => tipOn(tip) && hit(tip.title, tip.text, tip.area, areaLabel(tip.area)));
      const box = $('[data-guides-results]');
      const parts: HTMLElement[] = [];
      if (tours.length) {
        const ul = el('ul', 'guide__list');
        ul.append(...tours.map(tourRow));
        parts.push(el('h3', 'guide__label', t('guide.tours')), ul);
      }
      if (books.length) {
        const ul = el('ul', 'guide__list');
        ul.append(
          ...books.map((p) => {
            const li = el('li');
            const b = el('button', 'guide__row');
            b.type = 'button';
            b.dataset.guidesOpen = p.id;
            const main = el('span', 'guide__row-main', p.name);
            main.append(el('small', '', p.sub));
            b.append(main);
            li.append(b);
            return li;
          }),
        );
        parts.push(el('h3', 'guide__label', t('guide.playbooks')), ul);
      }
      if (tips.length) {
        const cards = el('div', 'guide__cards');
        cards.append(...tips.map(tipCard));
        parts.push(el('h3', 'guide__label', t('guide.tips')), cards);
      }
      if (!parts.length) parts.push(el('p', 'muted guide__intro', t('guide.s.nothingFound')));
      box.replaceChildren(...parts);
    };

    const render = () => {
      const searching = q.value.trim().length > 0;
      $('[data-guides-kinds]').hidden = searching;
      $('[data-guides-results]').hidden = !searching;
      for (const b of kinds) b.setAttribute('aria-pressed', String(b.dataset.guidesKind === kind));
      for (const p of panels) p.hidden = searching || p.dataset.guidesPanel !== kind;
      if (searching) return renderSearch(q.value);
      if (kind === 'tours') renderTours();
      else if (kind === 'playbooks') renderBooks();
      else renderTips();
    };

    const c = cleanups();
    c.add(
      listen(sheet, 'sheet:open', (e) => {
        const d = (e as CustomEvent<Record<string, string | undefined>>).detail ?? {};
        if (d.guidesKind) kind = d.guidesKind;
        book = d.guidesBook ?? null;
        if (book) kind = 'playbooks';
        render();
      }),
    );
    c.add(listen(q, 'input', render));
    c.add(
      listen(sheet, 'click', (e) => {
        const x = e.target as HTMLElement;
        const k = x.closest<HTMLElement>('[data-guides-kind]');
        const open = x.closest<HTMLElement>('[data-guides-open]');
        const a = x.closest<HTMLElement>('[data-guides-area]');
        if (k) {
          kind = k.dataset.guidesKind!;
          book = null;
        } else if (open) {
          q.value = '';
          kind = 'playbooks';
          book = open.dataset.guidesOpen!;
        } else if (x.closest('[data-guides-back]')) book = null;
        else if (a) area = a.dataset.guidesArea as Area | 'All';
        else return;
        render();
      }),
    );
    if (auto) c.add(listen(auto, 'change', () => setTours({ off: !auto.checked })));
    c.add(listen(nudges, 'change', () => setTours({ nudgesOff: !nudges.checked })));
    c.add(
      listen($('[data-guides-reset]'), 'click', () => {
        setTours({ seen: [], questsHidden: false, tips: [], nudge: undefined });
        render();
      }),
    );
    render();
    return c.run;
  });

  /* ---------- "Did you know?" ---------- */

  function nudgeCard(tip: Tip, onAway: () => void): HTMLElement {
    const card = el('section', 'help-nudge');
    card.setAttribute('aria-label', t('guide.didYouKnow'));
    const actions = el('div', 'help-nudge__actions');
    const putAway = () => {
      const prefs = getTours();
      if (!prefs.tips?.includes(tip.id)) setTours({ tips: [...(prefs.tips ?? []), tip.id] });
    };
    const away = () => {
      putAway();
      onAway();
    };
    const href = tipHref(tip);
    if (href) {
      const go = el('a', 'btn btn--small', t('guide.s.showMe'));
      go.href = href;
      // The shared link handler in 'guide-tour' puts it away, then goes.
      go.dataset.guidesAway = tip.id;
      actions.append(go);
    }
    const no = el('button', 'help-nudge__no', href ? t('guide.s.notNow') : t('guide.s.gotIt'));
    no.type = 'button';
    no.addEventListener('click', away);
    actions.append(no);
    card.append(
      el('span', 'help-nudge__label', t('guide.didYouKnow')),
      el('strong', 'help-nudge__title', tip.title),
      el('p', 'help-nudge__text', tip.text),
      actions,
      el('p', 'help-nudge__why', `${tip.because ?? ''} ${t('guide.s.turnOff')}`.trim()),
    );
    return card;
  }

  /** Today's tip, picked once a day; null when there is none to show. */
  function todaysNudge(): Tip | null {
    const today = dayKey(new Date());
    const prefs = getTours();
    const tip = pickNudge(helpContext(), prefs, modules(), today, NATIVE_APP);
    if (tip && prefs.nudge?.day !== today) setTours({ nudge: { day: today, id: tip.id } });
    return tip;
  }

  onPage('guide-nudge', () => {
    const c = cleanups();
    // On Today, at a calm moment.
    const slot = document.querySelector<HTMLElement>('[data-help-nudge]');
    if (slot && getProfile().welcomed && !timerRunning()) {
      const tip = todaysNudge();
      slot.hidden = !tip;
      slot.replaceChildren(...(tip ? [nudgeCard(tip, () => (slot.hidden = true))] : []));
    }
    // When a session ends.
    const done = document.querySelector<HTMLDialogElement>('dialog[data-done]');
    const doneSlot = done?.querySelector<HTMLElement>('[data-done-tip]');
    if (done && doneSlot) {
      const fill = () => {
        if (!done.open) return;
        const tip = todaysNudge();
        doneSlot.hidden = !tip;
        doneSlot.replaceChildren(...(tip ? [nudgeCard(tip, () => (doneSlot.hidden = true))] : []));
      };
      const watch = new MutationObserver(fill);
      watch.observe(done, { attributes: true, attributeFilter: ['open'] });
      c.add(() => watch.disconnect());
    }
    return c.run;
  });
</script>

