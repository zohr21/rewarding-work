---
import BaseLayout from '../layouts/BaseLayout.astro';
import FocusTabs from '../components/FocusTabs.astro';
import TaskGlance from '../components/TaskGlance.astro';
import TaskList from '../components/TaskList.astro';
import BreakdownTool from '../components/BreakdownTool.astro';
import Sheet from '../components/Sheet.astro';
import { NATIVE_APP } from '../config/app';
import { url } from '../lib/paths';

const breakdown = {
  heading: 'Steps',
  headingT: 'tasks.steps',
  linkToTasks: false,
  intro: 'Make each step small enough to start in two minutes.',
  introT: 'tasks.stepsIntro',
} as const;
---

<BaseLayout title="Tasks" titleKey="nav.tasks" description="Your tasks, broken into small steps, with the focus time you've spent on each.">
  <div class="container">
    <FocusTabs />
    <header class="page-header">
      <h1 data-t="tasks.tasks" class:list={{ 'visually-hidden': NATIVE_APP }}>Tasks</h1>
      {
        /* The Android app goes straight to the lists. */
        !NATIVE_APP && (
          <p>
            <span data-t="tasks.introBefore">
              Keep what you're working on in one place. Break a task into small steps, then press Focus to start a
            </span>
            <a data-t="tasks.timer" href={url('/timer')}>timer</a>
            <span data-t="tasks.introAfter">session on it — the time shows up here.</span>
          </p>
        )
      }
    </header>

    <TaskList />
    {/* A task's steps open over the list from its Steps button (TaskList.astro), so the list keeps its room. */}
    <Sheet id="task-steps" labelledby="bd-heading">
      <BreakdownTool {...breakdown} />
      <div class="task-steps__foot">
        <a data-t="tasks.startFocusing" class="btn" href={url('/timer')} data-task-steps-focus data-sheet-close>Start focusing</a>
      </div>
    </Sheet>
    <TaskGlance />
  </div>
</BaseLayout>

<style>
  /* The breakdown sits flat in the sheet, not as a card of its own. */
  :global([data-sheet='task-steps'] .breakdown) {
    padding: 0;
    background: none;
    border: 0;
    box-shadow: none;
  }

  .task-steps__foot {
    position: sticky;
    bottom: calc(-1 * (var(--space-5) + env(safe-area-inset-bottom, 0px)));
    margin: var(--space-5) calc(-1 * var(--space-5)) calc(-1 * (var(--space-5) + env(safe-area-inset-bottom, 0px)));
    padding: var(--space-3) var(--space-5) calc(var(--space-4) + env(safe-area-inset-bottom, 0px));
    background: var(--color-surface-solid);
    border-top: 1px solid var(--color-border);
  }

  .task-steps__foot .btn {
    inline-size: 100%;
    min-height: 52px;
    border-radius: 16px;
    font-weight: 700;
  }
</style>
