---
import BaseLayout from '../layouts/BaseLayout.astro';
import FocusTabs from '../components/FocusTabs.astro';
import TimerWidget from '../components/TimerWidget.astro';
import { NATIVE_APP } from '../config/app';
import { TIMER_MODES } from '../data/taxonomy';
import { getTechniques } from '../lib/techniques';
import { url } from '../lib/paths';

/** Each rhythm with the technique page it comes from, for "Why it works" in the rhythm sheet. */
const techniques = await getTechniques();
const rhythms = TIMER_MODES.flatMap((mode) => {
  const technique = techniques.find((t) => t.data.timer_mode === mode);
  return technique ? [{ mode, href: url(`/techniques/${technique.id}`) }] : [];
});
---

<BaseLayout title="Focus timer" titleKey="title.focusTimer" description="A calm focus timer with Pomodoro, 52/17, Flowtime and custom modes.">
  <div class="container">
    <FocusTabs />
    <header class="page-header">
      {/* In the app the Timer tab already names the screen. */}
      <h1 data-t="timer.focusTimer" class:list={{ 'visually-hidden': NATIVE_APP }}>Focus timer</h1>
      {/* The Android app keeps the top of the screen for the timer itself. */}
      {!NATIVE_APP && <p data-t="timer.pickARhythmNameYour">Pick a rhythm, name your task if you like, and start.</p>}
    </header>

    {/* One column: the task, the dial and Start. Rhythm, sound and the task list open as sheets. */}
    <div class="timer-page">
      <TimerWidget standalone rhythms={rhythms} />
    </div>
  </div>
</BaseLayout>

<style>
  .timer-page {
    max-width: 34rem;
    margin-inline: auto;
  }
</style>
