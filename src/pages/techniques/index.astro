---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TechniqueRow from '../../components/TechniqueRow.astro';
import FocusTabs from '../../components/FocusTabs.astro';
import Coach from '../../components/Coach.astro';
import { getTechniques } from '../../lib/techniques';
import { CATEGORIES, CATEGORY_SLUGS, PROBLEMS, PROBLEM_SLUGS } from '../../data/taxonomy';
import { NATIVE_APP } from '../../config/app';

const techniques = await getTechniques();
---

<BaseLayout title="Coach" description="Tap what is in the way and get a technique to try now, or answer four questions for a plan that fits how you work.">
  <div class="container">
    <FocusTabs />
    <header class="page-header">
      <h1>Coach</h1>
      {!NATIVE_APP && <p>Tap what is in the way. Four more questions turn it into a plan for the week.</p>}
    </header>

    <Coach />

    {/* The whole library, folded away. Opens by itself when a link arrives with a filter. */}
    <details class="library-fold" data-library>
      <summary>
        <span id="all-heading">All {techniques.length} techniques</span>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </summary>
      <!-- Works without JS (all rows shown); the script below adds filtering. -->
      <form class="filters" role="search" aria-label="Filter techniques" data-filters>
        <div class="filters__search">
          <label for="q" class="visually-hidden">Search by title</label>
          <input id="q" name="q" type="search" autocomplete="off" placeholder="Search, e.g. Pomodoro" />
        </div>
        {/* Opens by itself when a link arrives with ?problem= or ?category=. */}
        <details class="filters__more" data-filters-more>
          <summary>Filter</summary>
          <div class="filters__body">
            <fieldset class="chips">
              <legend>What's in the way?</legend>
              <label class="chip"><input type="radio" name="problem" value="" checked /> <span>All</span></label>
              {
                PROBLEM_SLUGS.map((p) => (
                  <label class="chip">
                    <input type="radio" name="problem" value={p} /> <span>{PROBLEMS[p].title}</span>
                  </label>
                ))
              }
            </fieldset>
            <fieldset class="chips">
              <legend>Type</legend>
              <label class="chip"><input type="radio" name="category" value="" checked /> <span>All</span></label>
              {
                CATEGORY_SLUGS.map((c) => (
                  <label class="chip">
                    <input type="radio" name="category" value={c} /> <span>{CATEGORIES[c].label}</span>
                  </label>
                ))
              }
            </fieldset>
          </div>
        </details>
      </form>

      <section class="card library" aria-labelledby="all-heading">
        <div class="library__head">
          <p class="muted" aria-live="polite" data-count>Showing all {techniques.length} techniques</p>
        </div>
        <ul class="library__list" role="list" data-grid>
          {techniques.map((t) => <TechniqueRow technique={t} />)}
        </ul>
      </section>

      <div class="empty card" data-empty hidden>
        <p>No techniques match these filters.</p>
        <button type="button" class="btn btn--ghost" data-reset>Clear filters</button>
      </div>

    </details>
  </div>
</BaseLayout>

<script>
  import { initLibraryFilters } from '../../scripts/library-filters';
  import { onPage } from '../../lib/page';
  onPage('library-filters', () => {
    initLibraryFilters();
    // A link with a filter in it shows the filters it set.
    const more = document.querySelector<HTMLDetailsElement>('[data-filters-more]');
    const fold = document.querySelector<HTMLDetailsElement>('[data-library]');
    const params = new URLSearchParams(location.search);
    if (more && (params.get('problem') || params.get('category'))) more.open = true;
    if (fold && (params.get('problem') || params.get('category') || params.get('q'))) fold.open = true;
  });
</script>

<style>
  .library-fold {
    margin-top: var(--space-6);
  }

  .library-fold > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 56px;
    padding: 0 var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  .library-fold > summary::-webkit-details-marker {
    display: none;
  }

  .library-fold > summary svg {
    color: var(--color-text-muted);
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .library-fold[open] > summary {
    margin-bottom: var(--space-4);
  }

  .library-fold[open] > summary svg {
    transform: rotate(180deg);
  }

  .library-fold[hidden] {
    display: none;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .filters__search {
    flex: 1 1 14rem;
  }

  .filters__more {
    flex: 0 1 auto;
  }

  .filters__more[open] {
    flex-basis: 100%;
    order: 2;
  }

  .filters__more > summary {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  .filters__more > summary::-webkit-details-marker {
    display: none;
  }

  .filters__body {
    display: grid;
    gap: var(--space-4);
    padding-top: var(--space-3);
  }

  .chips legend {
    display: block;
    margin-bottom: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .filters__search input {
    width: 100%;
    min-height: 44px;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--well-bg);
    box-shadow: var(--well-shadow);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    border: 0;
    padding: 0;
    min-width: 0;
  }

  .chips legend {
    width: 100%;
    float: left; /* lets the chips wrap below the legend inside flex fieldsets */
  }

  .chip {
    position: relative;
  }

  .chip input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }

  .chip span {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  .chip:hover span {
    color: var(--color-text);
  }

  .chip input:checked + span {
    background: var(--color-accent-soft);
    border-color: color-mix(in srgb, var(--color-accent) 45%, transparent);
    color: var(--color-accent);
  }

  .chip input:focus-visible + span {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }

  .library {
    margin-top: var(--space-5);
    padding: 0;
    overflow: hidden;
  }

  .library__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-1) var(--space-5);
    padding: var(--space-4) var(--space-5);
    font-size: var(--text-sm);
  }

  .library__head a {
    font-weight: 600;
  }

  .library__list {
    padding: 0;
    list-style: none;
  }

  .library__list :global([data-technique][hidden]) {
    display: none;
  }

  .empty {
    margin-top: var(--space-4);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .empty[hidden] {
    display: none;
  }

</style>
