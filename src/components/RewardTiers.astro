---
/**
 * Reward tiers on the grove's first tab: the three tiers closest to being reached ("Next up"),
 * then one compact row per track, each a ladder of five tiers (src/lib/rewards.ts). Any row
 * opens a sheet with that track's ladder, when each tier was reached and the pace to the next.
 * With Health on, body markers (src/lib/bodytiers.ts) join in, behind a Focus / Body switch.
 * Before anything has counted towards a tier it is one seed instead, with the first goal.
 * Sprig stands at the top, grown as far as the focus-time tier.
 */
import Sprig from './Sprig.astro';
import Sheet from './Sheet.astro';
import { url } from '../lib/paths';
---

<section class="card tiers" id="tiers" data-reward-tiers aria-labelledby="tiers-heading">
  <h2 data-t="grove.yourTiers" id="tiers-heading" class="visually-hidden">Your tiers</h2>
  <div class="tiers__sprig" data-tiers-sprig>
    <div class="tiers__sprig-art" data-tiers-sprig-art>
      <Sprig mood="auto" size={96} bob />
      <canvas aria-hidden="true"></canvas>
    </div>
    <div class="tiers__sprig-text">
      <p class="tiers__sprig-name" data-tiers-sprig-name></p>
      <p class="tiers__sprig-tree" data-tiers-sprig-tree></p>
      <p class="muted" data-tiers-sprig-next></p>
      <div data-t-aria-label="grove.sprigSGrowthToThe" class="tiers__sprig-bar" role="progressbar" aria-label="Sprig's growth to the next stage" aria-valuemin="0" aria-valuemax="100" data-tiers-sprig-bar>
        <span></span>
      </div>
    </div>
  </div>
  <section class="tiers__soon" data-tiers-soon aria-labelledby="tiers-soon-heading">
    <h3 data-t="grove.nextUp" id="tiers-soon-heading" class="tiers__markers">Next up</h3>
    <ul class="tiers__soon-list" data-tiers-soon-list></ul>
  </section>
  {/* Rows the page adds between "Next up" and all the markers (the grove's Done row). */}
  <slot />
  <div class="tiers__head" data-tiers-head>
    <h3 data-t="grove.allMarkers" class="tiers__markers">All markers</h3>
    <div data-t-aria-label="grove.whichMarkers" class="tiers__groups" role="group" aria-label="Which markers" data-tiers-groups hidden>
      <button data-t="grove.focus" type="button" class="tiers__group" aria-pressed="true" data-tiers-group="focus">Focus</button>
      <button data-t="grove.body" type="button" class="tiers__group" aria-pressed="false" data-tiers-group="body">Body</button>
    </div>
    <details class="tiers__about">
      <summary data-t="grove.whatAreThese">What are these?</summary>
      <p data-t="grove.markersAlongTheWayThere" class="muted">
        Markers along the way — there to show how far you've come, not to keep score. Green to start, then bronze, silver
        and gold, with diamond for the hardest runs. The chain counts your best run, so a missed day never takes a tier
        away.
      </p>
      <p data-t="grove.bodyMarkersCountDaysYou" class="muted">
        Body markers count days you reached a sensible goal, never calories, weight or how hard you pushed. They stay on
        this device.
      </p>
    </details>
  </div>
  <ul class="tiers__grid" data-tiers-list></ul>
  <p class="muted tiers__body-empty" data-tiers-body-empty hidden>
    <span data-t="grove.bodyEmpty">Sleep, steps and workouts start to count here once they're on</span> <a data-t="grove.health" href={url('/health')}>Health</a>.
  </p>

  <div class="seed" data-tiers-seed hidden>
    <Sprig stage={0} size={100} bob />
    <h3 data-t="grove.sprigIsASeedWaiting" class="seed__title">Sprig is a seed, waiting</h3>
    <p class="muted" data-tiers-seed-text></p>
    <div class="seed__bar" aria-hidden="true"><span></span></div>
    <p class="muted seed__count" data-tiers-seed-count></p>
    <h3 data-t="grove.markersAhead" class="seed__ahead">Markers ahead</h3>
    <ol class="seed__coins" data-tiers-seed-coins></ol>
  </div>
</section>

<Sheet id="tier" labelledby="tier-sheet-title">
  <div class="tier-sheet" data-tier-sheet>
    <h2 id="tier-sheet-title" class="tier-sheet__title" data-ts-title></h2>
    <p class="muted" data-ts-how></p>
    <ol class="tier-sheet__ladder" data-ts-ladder></ol>
    <p class="tier-sheet__pace" data-ts-pace></p>
  </div>
</Sheet>

<script>
  import { getChain, getDone, getSessions, subscribe } from '../lib/storage';
  import { allProgress, chainInput, closestTiers, daysToNext, tierLabel, tierName, TIER_NAMES, type NextTier, type TrackId, type TrackProgress } from '../lib/rewards';
  import { dateFormat, locale, t, tn } from '../lib/i18n';
  import { bodyInput } from '../lib/bodytiers';
  import { el } from '../lib/dom';
  import { tierIcon } from '../lib/tier-icons';
  import { sprigGrowth, sprigStageName, sprigTree } from '../lib/sprig';
  import { cleanups, listen, onPage } from '../lib/page';
  import { url } from '../lib/paths';
  import { webglAvailable } from '../lib/scene';
  import type { Sprig3D } from '../lib/scene/sprig3d';

  /**
   * Swap the drawn Sprig for the 3D one at `stage` (three.js loads only now). The drawing stays
   * until the model is ready, and is what shows without WebGL. Returns a cleanup.
   */
  function show3D(art: HTMLElement, stage: number): () => void {
    const canvas = art.querySelector('canvas');
    if (!canvas || !webglAvailable()) return () => {};
    const root = document.documentElement;
    const motion = root.dataset.motion !== 'off' && !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let sprig: Sprig3D | null = null;
    let gone = false;
    art.dataset.stage = String(stage);
    void import('../lib/scene/sprig3d')
      .then(({ createSprig3D }) => createSprig3D(canvas, url(`/sprig/sprig-${stage}.glb`), motion))
      .then((s) => {
        if (gone) return s?.destroy();
        sprig = s;
        art.classList.toggle('is-3d', !!s);
      });
    return () => {
      gone = true;
      sprig?.destroy();
      art.classList.remove('is-3d');
    };
  }

  const dateFmt = dateFormat({ day: 'numeric', month: 'short', year: 'numeric' });

  const LEAF_SVG =
    '<svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M5 19c0-8 5-13 14-14-1 9-6 14-14 14zm0 0l7-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>';

  /** Focus hours read better with one decimal below 10. */
  function amount(p: TrackProgress): string {
    if (p.track.id !== 'focus') return p.value.toLocaleString(locale());
    const v = p.value < 10 ? Math.floor(p.value * 10) / 10 : Math.floor(p.value);
    return v.toLocaleString(locale());
  }

  /** The row's name, as a button that covers the whole row and opens the track's sheet. */
  function opener(track: TrackId, text: string): HTMLButtonElement {
    const b = el('button', 'tier__open', text);
    b.type = 'button';
    b.dataset.sheetOpen = 'tier';
    b.dataset.track = track;
    return b;
  }

  const capital = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
  /** "2 more nights", "1.5 more hours". */
  const more = ({ p, left }: NextTier) => t('tier.more', { n: left.toLocaleString(locale()), unit: p.track.unit(left) });

  /** One of the closest tiers: the coin it will be, how much is left, and a bar to it. */
  function renderSoon(n: NextTier): HTMLLIElement {
    const { p, next, share } = n;
    const li = el('li', 'soon');
    const coin = el('span', `tier-coin tier-coin--t${p.level}`);
    coin.innerHTML = tierIcon(p.level, 18);
    const head = el('p', 'soon__head');
    head.append(opener(p.track.id, p.track.title), el('span', 'soon__left', more(n)));
    const bar = el('span', 'soon__bar');
    bar.setAttribute('aria-hidden', 'true');
    bar.style.setProperty('--share', `${Math.round(share * 100)}%`);
    bar.style.setProperty('--next', `var(--tier-${p.level})`);
    bar.append(el('span'));
    const line = el('p', 'soon__line muted', t('tier.ofTo', { amount: amount(p), next, unit: p.track.unit(next), tier: tierLabel(p.level) }));
    li.append(coin, head, bar, line);
    return li;
  }

  /** "At your pace", and honest when there is no pace yet. */
  function paceLine(n: NextTier | undefined): string {
    if (!n) return t('tier.everyTier');
    const days = daysToNext(n);
    const goal = t('tier.goalFor', { more: capital(more(n)), tier: tierLabel(n.p.level) });
    if (n.p.track.id === 'streak') return tn('tier.keepChain', days ?? 0, { tier: tierLabel(n.p.level) });
    if (days === null) return t('tier.noGuess', { goal });
    const when = days <= 1 ? t('tier.when.day') : days < 14 ? tn('tier.when.days', days) : days < 60 ? tn('tier.when.weeks', Math.round(days / 7)) : t('tier.when.months');
    return t('tier.atPace', { goal, when });
  }

  function renderSheet(root: HTMLElement, p: TrackProgress): void {
    const { track, level, reachedAt } = p;
    root.querySelector('[data-ts-title]')!.textContent = track.title;
    root.querySelector('[data-ts-how]')!.textContent = track.how;
    root.querySelector('[data-ts-ladder]')!.replaceChildren(
      ...track.thresholds.map((n, i) => {
        const at = reachedAt[i];
        const li = el('li', `tier-sheet__step${i === level ? ' is-next' : ''}`);
        const coin = el('span', `tier-coin ${at !== null ? `tier-coin--t${i}` : 'tier-coin--blank'}`);
        coin.innerHTML = tierIcon(i, 16);
        const name = el('span', 'tier-sheet__name', tierLabel(i));
        name.append(el('span', 'muted', ` · ${track.describe(n)}`));
        const when = el('span', 'tier-sheet__when', at !== null ? dateFmt.format(at) : i === level ? t('tier.next') : '');
        li.append(coin, name, when);
        return li;
      }),
    );
    root.querySelector('[data-ts-pace]')!.textContent = paceLine(closestTiers([p], 1)[0]);
  }

  function renderTrack(p: TrackProgress): HTMLLIElement {
    const { track, level, reachedAt } = p;
    const li = document.createElement('li');
    li.className = 'tier';

    const head = document.createElement('div');
    head.className = 'tier__head';
    const title = document.createElement('h3');
    title.className = 'tier__title';
    title.append(opener(track.id, track.title));
    const current = document.createElement('p');
    current.className = `tier__current${level ? '' : ' muted'}`;
    current.innerHTML = level ? LEAF_SVG : '';
    current.append(level ? tierLabel(level - 1) : t('tier.none'));
    const text = document.createElement('div');
    text.className = 'tier__text';
    text.append(title, current);

    // A 3D coin in the tier's material, a dark blank before the first one.
    const coin = document.createElement('span');
    coin.className = `tier-coin ${level ? `tier-coin--t${level - 1}` : 'tier-coin--blank'}`;
    coin.innerHTML = tierIcon(Math.max(0, level - 1), 20);
    head.append(coin, text);

    // One segment per tier; the next one fills partway with progress towards it.
    const pips = document.createElement('ol');
    pips.className = 'tier__pips';
    track.thresholds.forEach((n, i) => {
      const pip = document.createElement('li');
      const at = reachedAt[i];
      pip.className = `tier__pip${at !== null ? ' is-reached' : ''}`;
      pip.style.setProperty('--pip', `var(--tier-${i})`);
      pip.style.setProperty('--pip-edge', `var(--tier-${i}-edge)`);
      if (i === level) {
        const prev = level ? track.thresholds[level - 1]! : 0;
        const fill = document.createElement('span');
        fill.className = 'tier__fill';
        fill.style.inlineSize = `${Math.min(100, Math.max(0, ((p.value - prev) / (n - prev)) * 100))}%`;
        pip.append(fill);
      }
      const label = `${tierLabel(i)}: ${track.describe(n)}`;
      pip.title = at !== null ? t('tier.reachedOn', { label, date: dateFmt.format(at) }) : label;
      const name = document.createElement('span');
      name.className = 'visually-hidden';
      name.textContent = at !== null ? pip.title.replace(/\.?$/, '.') : t('tier.notReached', { label });
      pip.append(name);
      pips.append(pip);
    });

    li.append(head, pips);

    const next = track.thresholds[level];
    const foot = document.createElement('p');
    foot.className = 'tier__next muted';
    if (next === undefined) {
      foot.textContent = t('tier.allFive', { what: track.describe(track.thresholds.at(-1)!) });
    } else {
      foot.textContent = t('tier.ofTo', { amount: amount(p), next, unit: track.unit(next), tier: tierLabel(level) });
    }
    li.append(foot);
    return li;
  }


  onPage('reward-tiers', () => {
    const c = cleanups();
    document.querySelectorAll<HTMLElement>('[data-reward-tiers]').forEach((root) => {
      const list = root.querySelector<HTMLElement>('[data-tiers-list]')!;
      const head = root.querySelector<HTMLElement>('[data-tiers-head]')!;
      const seed = root.querySelector<HTMLElement>('[data-tiers-seed]')!;
      const sprig = root.querySelector<HTMLElement>('[data-tiers-sprig]')!;
      const art = root.querySelector<HTMLElement>('[data-tiers-sprig-art]')!;
      const soon = root.querySelector<HTMLElement>('[data-tiers-soon]')!;
      const groups = root.querySelector<HTMLElement>('[data-tiers-groups]')!;
      const bodyEmpty = root.querySelector<HTMLElement>('[data-tiers-body-empty]')!;
      const sheet = document.querySelector<HTMLElement>('[data-sheet="tier"]');
      let group: 'focus' | 'body' = 'focus';
      let progress: TrackProgress[] = [];
      c.add(
        listen(groups, 'click', (e) => {
          const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-tiers-group]');
          if (!b) return;
          group = b.dataset.tiersGroup === 'body' ? 'body' : 'focus';
          render();
        }),
      );
      if (sheet) {
        c.add(
          listen(sheet, 'sheet:open', (e) => {
            const id = (e as CustomEvent<{ track?: string }>).detail.track;
            const p = progress.find((x) => x.track.id === id);
            if (p) renderSheet(sheet, p);
          }),
        );
      }
      let stage3D = -1;
      let stop3D = () => {};
      c.add(() => stop3D());
      const render = () => {
        const body = bodyInput();
        progress = allProgress({ sessions: getSessions(), done: getDone(), ...chainInput(getChain()), body });
        // Nothing has counted yet: one seed and the first goal, not four ladders of "not yet".
        const bare = progress.every((p) => p.value === 0);
        seed.hidden = !bare;
        head.hidden = list.hidden = sprig.hidden = soon.hidden = bare;
        if (!body) group = 'focus';
        groups.hidden = bare || !body;
        bodyEmpty.hidden = true;
        if (bare) {
          const focus = progress.find((p) => p.track.id === 'focus') ?? progress[0]!;
          const goal = focus.track.thresholds[0]!;
          root.querySelector('[data-tiers-seed-text]')!.textContent =
            t('tier.seedText', { goal, unit: focus.track.unit(goal), tier: tierName(0) });
          root.querySelector('[data-tiers-seed-count]')!.textContent = t('tier.of', { amount: 0, next: goal, unit: focus.track.unit(goal) });
          root.querySelector('[data-tiers-seed-coins]')!.replaceChildren(
            ...TIER_NAMES.map((_, i) => {
              const li = document.createElement('li');
              const coin = document.createElement('span');
              coin.className = `tier-coin tier-coin--t${i}`;
              coin.innerHTML = tierIcon(i, 18);
              li.append(coin, tierName(i));
              return li;
            }),
          );
          return;
        }
        // Sprig grows with focus time only, so its size always means real focus.
        const focus = progress.find((p) => p.track.id === 'focus')!;
        const goal = focus.track.thresholds[focus.level];
        root.querySelector('[data-tiers-sprig-name]')!.textContent = focus.level
          ? t('tier.sprigIs', { tier: tierLabel(focus.level - 1) })
          : t('tier.sprigSeed');
        root.querySelector('[data-tiers-sprig-tree]')!.textContent = sprigTree(focus.level);
        // A new canvas for each model: a WebGL context can't be handed on cleanly.
        if (focus.level !== stage3D) {
          stage3D = focus.level;
          stop3D();
          art.querySelector('canvas')!.replaceWith(Object.assign(document.createElement('canvas'), { ariaHidden: 'true' }));
          stop3D = show3D(art, focus.level);
        }
        root.querySelector('[data-tiers-sprig-next]')!.textContent =
          goal === undefined
            ? t('tier.sprigDone')
            : t('tier.sprigNext', { n: (Math.ceil((goal - focus.value) * 10) / 10).toLocaleString(locale()), unit: focus.track.unit(goal - focus.value), stage: sprigStageName(focus.level + 1) });
        // The bar fills in the next stage's colour, a bud for each quarter of it.
        const bar = root.querySelector<HTMLElement>('[data-tiers-sprig-bar]')!;
        const { share } = sprigGrowth(getSessions());
        bar.hidden = goal === undefined;
        bar.setAttribute('aria-valuenow', String(Math.round(share * 100)));
        bar.style.setProperty('--share', `${share * 100}%`);
        bar.style.setProperty('--next', `var(--tier-${Math.min(4, focus.level)})`);
        const next = closestTiers(progress.filter((p) => p.value > 0));
        soon.hidden = !next.length;
        root.querySelector('[data-tiers-soon-list]')!.replaceChildren(...next.map(renderSoon));
        groups.querySelectorAll<HTMLElement>('[data-tiers-group]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.tiersGroup === group)));
        const shown = progress.filter((p) => p.track.group === group);
        bodyEmpty.hidden = group !== 'body' || shown.some((p) => p.value > 0);
        list.replaceChildren(...(bodyEmpty.hidden ? shown.map(renderTrack) : []));
      };
      render();
      c.add(subscribe('sessions', render));
      c.add(subscribe('done', render));
      c.add(subscribe('chain', render));
      for (const name of ['body', 'body-manual', 'workouts', 'profile'] as const) c.add(subscribe(name, render));
    });
    return c.run;
  });
</script>

<style>
  .tiers [hidden] {
    display: none;
  }

  /* On a phone the page is the card: Sprig's patch is the only box, the lists sit on the page. */
  @media (max-width: 30rem) {
    .tiers {
      padding: 0;
      border: 0;
      background: none;
      box-shadow: none;
    }

    .tiers__sprig {
      margin-top: 0;
    }
  }

  /* Sprig, on its own patch of ground, with what it is and how far to the next stage. */
  .tiers__sprig {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--space-4);
    margin-top: var(--space-3);
    padding: var(--space-3) var(--space-4) 0 var(--space-2);
    background: var(--well-bg);
    border-radius: var(--radius-lg);
    box-shadow: var(--well-shadow);
  }

  /* The drawing until the 3D model is ready (and without WebGL); then the model, a bit bigger,
     with room for the Grove's wide crown. Drag to turn it. */
  .tiers__sprig-art {
    position: relative;
    display: grid;
    flex: none;
    /* Centred on its own row when the text has wrapped below it (narrow phones, wide Grove). */
    margin-inline: auto;
    align-items: end;
  }

  .tiers__sprig-art :global(canvas) {
    display: none;
    inline-size: 128px;
    block-size: 152px;
    touch-action: pan-y;
    cursor: grab;
  }

  .tiers__sprig-art[data-stage='5'] :global(canvas) {
    inline-size: 210px;
    block-size: 168px;
  }

  .tiers__sprig-art.is-3d :global(canvas) {
    display: block;
  }

  .tiers__sprig-art.is-3d :global(.sprig) {
    display: none;
  }

  .tiers__sprig-tree {
    color: var(--color-text-muted);
    font-style: italic;
  }

  .tiers__sprig-text {
    display: grid;
    flex: 1;
    gap: 2px;
    align-self: center;
    min-width: 11rem;
    padding-block-end: var(--space-3);
    font-size: var(--text-sm);
  }

  .tiers__sprig-bar {
    margin-top: var(--space-2);
    block-size: 8px;
    border-radius: var(--radius-pill);
    background: var(--color-surface-2);
    box-shadow: inset 0 1px 2px rgb(0 0 0 / 0.35);
    overflow: hidden;
  }

  .tiers__sprig-bar > span {
    display: block;
    inline-size: var(--share, 0%);
    block-size: 100%;
    border-radius: inherit;
    background: var(--next);
    transition: inline-size var(--duration-base) var(--ease-out);
  }

  .tiers__sprig-name {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    line-height: 1.15;
  }

  .seed {
    display: grid;
    justify-items: center;
    gap: var(--space-2);
    text-align: center;
  }

  .seed__title {
    font-size: var(--text-lg);
  }

  .seed__bar {
    justify-self: stretch;
    block-size: 10px;
    border-radius: 5px;
    background: var(--well-bg);
    box-shadow: var(--well-shadow);
  }

  .seed__count {
    justify-self: end;
    font-size: var(--text-xs);
  }

  .seed__ahead {
    justify-self: start;
    margin-top: var(--space-3);
    font-size: var(--text-base);
  }

  .seed__coins {
    justify-self: stretch;
    display: flex;
    justify-content: space-between;
    gap: var(--space-1);
    padding: 0;
    list-style: none;
  }

  .seed__coins :global(li) {
    display: grid;
    justify-items: center;
    gap: var(--space-1);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  /* Ahead, not reached: the coins sit back until they are earned. */
  .seed__coins :global(.tier-coin) {
    --coin-size: 36px;
    margin: 0;
    opacity: 0.45;
  }

  /* "Markers" and its fold-out explanation, on one line. */
  .tiers__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-1) var(--space-3);
    margin-top: var(--space-5);
  }

  .tiers__markers {
    font-size: var(--text-base);
  }

  .tiers__about summary {
    color: var(--color-accent);
    font-size: var(--text-sm);
    cursor: pointer;
  }

  .tiers__about[open] {
    flex-basis: 100%;
  }

  .tiers__about p {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
  }

  /* One row per track: the coin on the left, then its tier, ladder and what is next. */
  .tiers__grid {
    display: grid;
    margin-top: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .tiers__grid :global(.tier) {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: var(--space-4);
    row-gap: var(--space-2);
    align-items: center;
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--color-border);
    min-width: 0;
  }

  .tiers__grid :global(.tier:last-child) {
    border-bottom: 0;
    padding-bottom: 0;
  }

