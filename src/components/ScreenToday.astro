---
/**
 * Today's screen-time card, in the Android app with the Screen time section on: yesterday's
 * phone time against your usual, the top apps, and one button to plan a phone-free block.
 * Without Usage access it asks once, and "Not now" turns the section off.
 */
import { url } from '../lib/paths';
import ScreenSetup from './ScreenSetup.astro';
---

<section class="card screen-today" data-screen-today data-module="screen" data-timer-url={url('/timer')} aria-labelledby="screen-today-h" hidden>
  <div class="screen-today__ask" data-st-ask hidden>
    <h2 id="screen-today-h" class="screen-today__ask-title">See where your phone time goes</h2>
    <p class="muted">Yesterday's phone time next to your plan, and a check after each focus session.</p>
    <div class="screen-today__ask-go">
      <button type="button" class="btn" data-screen-setup-open>Turn on</button>
      <button type="button" class="btn btn--ghost" data-st-off>Not now</button>
    </div>
  </div>

  <div class="screen-today__body" data-st-body hidden>
    <div class="screen-today__head">
      <div class="screen-today__sum">
        <h2 class="screen-today__label" data-st-label>Phone yesterday</h2>
        <strong class="screen-today__value" data-st-total></strong>
        <span class="muted screen-today__vs" data-st-vs></span>
      </div>
      <a class="screen-today__week" href={`${url('/progress')}#stats`}>Week</a>
    </div>
    <ul class="screen-today__apps" data-st-apps></ul>
    <a class="btn screen-today__plan" data-st-plan>
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><rect x="7" y="2" width="10" height="20" rx="2"></rect><path d="M4 4l16 16"></path></svg>
      Plan a phone-free block
    </a>
  </div>
</section>
<ScreenSetup />

<script>
  import { getProfile, setModule } from '../lib/profile';
  import { dayOf, formatMinutes, formatPhone, getScreen, hasAccess, refreshDays, weekAverage } from '../lib/screen';
  import { addDays, dayKey } from '../lib/dates';
  import { subscribe } from '../lib/storage';
  import { cleanups, listen, onPage } from '../lib/page';
  import { el } from '../lib/dom';

  onPage('screen-today', () => {
    const found = document.querySelector<HTMLElement>('[data-screen-today]');
    if (!found) return;
    const root = found;
    const c = cleanups();
    const $ = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
    $<HTMLAnchorElement>('[data-st-plan]').href = `${root.dataset.timerUrl}?label=${encodeURIComponent('Phone-free block')}`;

    function render(access: boolean): void {
      if (!getProfile().modules.screen) {
        root.hidden = true;
        return;
      }
      root.hidden = false;
      $('[data-st-ask]').hidden = access;
      $('[data-st-body]').hidden = !access;
      if (!access) return;

      const store = getScreen();
      const now = new Date();
      const yesterday = dayOf(store, dayKey(addDays(now, -1)));
      // Just turned on: yesterday may be missing, so show today so far.
      const showToday = !yesterday || yesterday.totalMin === 0;
      const day = showToday ? dayOf(store, dayKey(now)) : yesterday;
      $('[data-st-label]').textContent = showToday ? 'Phone today so far' : 'Phone yesterday';
      $('[data-st-total]').textContent = formatPhone(day?.totalMin ?? 0);

      const avg = showToday ? null : weekAverage(store, addDays(now, -1));
      const diff = avg === null || !day ? 0 : day.totalMin - avg;
      $('[data-st-vs]').textContent =
        avg === null || !day ? (showToday ? 'Other apps, not Grovyn' : '') : Math.abs(diff) < 10 ? 'About your usual' : `${formatMinutes(Math.abs(diff))} ${diff < 0 ? 'under' : 'over'} your weekly average`;

      const apps = (day?.apps ?? []).slice(0, 3);
      const max = apps[0]?.min ?? 1;
      $('[data-st-apps]').replaceChildren(
        ...apps.map((a) => {
          const li = el('li');
          const row = el('div', 'screen-today__app');
          row.append(el('span', '', a.label), el('span', 'muted', formatPhone(a.min)));
          const bar = el('span', 'screen-today__bar');
          bar.setAttribute('aria-hidden', 'true');
          const fill = el('span');
          fill.style.inlineSize = `${Math.max(4, Math.round((a.min / max) * 100))}%`;
          bar.append(fill);
          li.append(row, bar);
          return li;
        }),
      );
    }

    let access = false;
    async function load(): Promise<void> {
      if (!getProfile().modules.screen) return render(false);
      access = Boolean(await hasAccess());
      if (access) await refreshDays();
      render(access);
    }
    void load();

    const onClick = (e: Event) => {
      if ((e.target as HTMLElement).closest('[data-st-off]')) {
        setModule('screen', false);
        root.hidden = true;
      }
    };
    root.addEventListener('click', onClick);
    c.add(() => root.removeEventListener('click', onClick));
    const onAccess = () => void load();
    document.addEventListener('screen:access', onAccess);
    c.add(() => document.removeEventListener('screen:access', onAccess));
    c.add(listen(document, 'visibilitychange', () => document.visibilityState === 'visible' && void load()));
    c.add(subscribe('screen', () => render(access)));
    c.add(subscribe('profile', () => void load()));
    return c.run;
  });
</script>

<style>
  .screen-today {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-4);
  }

  .screen-today[hidden],
  .screen-today [hidden] {
    display: none;
  }

  .screen-today__ask {
    display: grid;
    gap: var(--space-2);
  }

  .screen-today__ask-title {
    font-size: var(--text-base);
  }

  .screen-today__ask p {
    font-size: var(--text-sm);
  }

  .screen-today__ask-go {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2);
    margin-top: var(--space-1);
  }

  .screen-today__ask-go .btn {
    min-height: 48px;
  }

  .screen-today__body {
    display: grid;
    gap: var(--space-4);
  }

  .screen-today__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .screen-today__sum {
    display: grid;
    gap: 2px;
  }

  .screen-today__label {
    color: var(--color-text-muted);
    font-family: inherit;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .screen-today__value {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: 1.1;
  }

  .screen-today__vs {
    font-size: var(--text-sm);
  }

  .screen-today__week {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
  }

  .screen-today__apps {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .screen-today__apps:empty {
    display: none;
  }

  .screen-today__apps :global(li) {
    display: grid;
    gap: 5px;
  }

  .screen-today__apps :global(.screen-today__app) {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    font-size: var(--text-sm);
  }

  .screen-today__apps :global(.screen-today__bar) {
    display: block;
    block-size: 8px;
    border-radius: var(--radius-pill);
    background: var(--well-bg);
    box-shadow: var(--well-shadow);
    overflow: hidden;
  }

  .screen-today__apps :global(.screen-today__bar > span) {
    display: block;
    block-size: 100%;
    border-radius: inherit;
    background: var(--cat-visual);
  }

  .screen-today__plan {
    gap: var(--space-2);
    min-height: 52px;
    font-weight: 700;
  }

  .screen-today__plan svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
